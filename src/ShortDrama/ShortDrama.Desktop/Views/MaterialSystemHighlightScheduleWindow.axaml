<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShortDrama.Desktop.Views.MaterialSystemHighlightScheduleWindow"
        Width="860"
        Height="540"
        MinWidth="760"
        MinHeight="460"
        Title="系统高光自动发布配置">
    <Grid Margin="14"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="10">
        <TextBlock Text="每条规则可指定账号、工作目录、执行时间或频率，并为多部剧配置本轮发布个数。到点后会自动按规则串行执行系统高光发布。"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="1"
              ColumnDefinitions="210,*"
              ColumnSpacing="12">
            <Grid RowDefinitions="Auto,*,Auto"
                  RowSpacing="8">
                <TextBlock Text="规则列表"
                           FontWeight="SemiBold" />
                <ListBox x:Name="RuleListBox"
                         Grid.Row="1" />
                <WrapPanel Grid.Row="2">
                    <Button x:Name="AddRuleButton"
                            Classes="compact"
                            Margin="0,0,6,0"
                            Content="新增规则" />
                    <Button x:Name="CopyRuleButton"
                            Classes="compact"
                            Margin="0,0,6,0"
                            Content="复制规则" />
                    <Button x:Name="RemoveRuleButton"
                            Classes="compact"
                            Content="删除规则" />
                </WrapPanel>
            </Grid>

            <TabControl Grid.Column="1"
                        x:Name="RuleTabs">
                <TabItem Header="发布设置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="10"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnDefinitions="120,*"
                              RowSpacing="10"
                              ColumnSpacing="10">
                            <CheckBox x:Name="EnabledCheckBox"
                                      Grid.Column="1"
                                      Content="启用该规则" />
                            <TextBlock Grid.Row="1"
                                       VerticalAlignment="Center"
                                       Text="规则名称" />
                            <TextBox x:Name="NameTextBox"
                                     Grid.Row="1"
                                     Grid.Column="1" />
                            <TextBlock Grid.Row="2"
                                       VerticalAlignment="Center"
                                       Text="执行账号" />
                            <ComboBox x:Name="ProfileComboBox"
                                      Grid.Row="2"
                                      Grid.Column="1"
                                      Width="240"
                                      HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="3"
                                       VerticalAlignment="Center"
                                       Text="工作目录" />
                            <Grid Grid.Row="3"
                                  Grid.Column="1"
                                  ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="8">
                                <TextBox x:Name="WorkspaceTextBox" />
                                <Button x:Name="BrowseWorkspaceButton"
                                        Grid.Column="1"
                                        Classes="compact"
                                        Content="浏览" />
                                <Button x:Name="UseCurrentWorkspaceButton"
                                        Grid.Column="2"
                                        Classes="compact"
                                        Content="填入当前目录" />
                            </Grid>
                            <TextBlock Grid.Row="4"
                                       VerticalAlignment="Top"
                                       Text="默认视频描述" />
                            <TextBox x:Name="DefaultDescriptionTextBox"
                                     Grid.Row="4"
                                     Grid.Column="1"
                                     AcceptsReturn="True"
                                     MinHeight="58"
                                     TextWrapping="Wrap" />
                            <TextBlock Grid.Row="5"
                                       VerticalAlignment="Top"
                                       Text="本次发布" />
                            <StackPanel Grid.Row="5"
                                        Grid.Column="1"
                                        Spacing="6">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <RadioButton x:Name="PublishByCountRadioButton"
                                                 Content="按编号/数量发布"
                                                 GroupName="SchedulePublishMode"
                                                 IsChecked="True" />
                                    <NumericUpDown x:Name="PublishCountUpDown"
                                                   Width="120"
                                                   Minimum="1"
                                                   Maximum="999"
                                                   Increment="1"
                                                   FormatString="0"
                                                   Value="10" />
                                </StackPanel>
                                <RadioButton x:Name="PublishByTypeRadioButton"
                                             Content="按左下角类型发布"
                                             GroupName="SchedulePublishMode" />
                            </StackPanel>
                            <TextBlock Grid.Row="6"
                                       VerticalAlignment="Center"
                                       Text="本次发布类型" />
                            <StackPanel Grid.Row="6"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="16">
                                <CheckBox x:Name="PublishMashupCheckBox"
                                          Content="混剪" />
                                <CheckBox x:Name="PublishCommentaryCheckBox"
                                          Content="解说" />
                                <CheckBox x:Name="PublishSliceCheckBox"
                                          Content="切片" />
                            </StackPanel>
                            <CheckBox x:Name="RegenerateAfterPublishCheckBox"
                                      Grid.Row="7"
                                      Grid.Column="1"
                                      Content="发布完成后重新生成高光视频" />
                            <TextBlock Grid.Row="8"
                                       VerticalAlignment="Center"
                                       Text="重新生成类型" />
                            <StackPanel Grid.Row="8"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="16">
                                <CheckBox x:Name="RegenerateMashupCheckBox"
                                          Content="混剪" />
                                <CheckBox x:Name="RegenerateCommentaryCheckBox"
                                          Content="解说" />
                                <CheckBox x:Name="RegenerateSliceCheckBox"
                                          Content="切片" />
                            </StackPanel>
                            <TextBlock x:Name="ValidationMessageTextBlock"
                                       Grid.Row="9"
                                       Grid.ColumnSpan="2"
                                       Foreground="{DynamicResource DesktopDangerBrush}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="调度配置">
                    <Grid Margin="10"
                          RowDefinitions="Auto,Auto,Auto,Auto,*"
                          ColumnDefinitions="120,*,120,*"
                          RowSpacing="12"
                          ColumnSpacing="10">
                        <TextBlock VerticalAlignment="Center"
                                   Text="触发方式" />
                        <ComboBox x:Name="TriggerModeComboBox"
                                  Grid.Column="1" />
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Text="执行频率" />
                        <NumericUpDown x:Name="IntervalMinutesUpDown"
                                       Grid.Column="3"
                                       Minimum="1"
                                       Maximum="1440"
                                       Increment="1"
                                       FormatString="0"
                                       Value="30" />

                        <TextBlock Grid.Row="1"
                                   VerticalAlignment="Center"
                                   Text="执行周期" />
                        <ComboBox x:Name="ScheduleModeComboBox"
                                  Grid.Row="1"
                                  Grid.Column="1" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Text="执行时间" />
                        <TextBox x:Name="TimeTextBox"
                                 Grid.Row="1"
                                 Grid.Column="3"
                                 Watermark="HH:MM，例如 09:00" />

                        <TextBlock Grid.Row="2"
                                   VerticalAlignment="Center"
                                   Text="每周执行日" />
                        <WrapPanel Grid.Row="2"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="3">
                            <CheckBox x:Name="Weekday1CheckBox"
                                      Margin="0,0,8,0"
                                      Content="周一" />
                            <CheckBox x:Name="Weekday2CheckBox"
                                      Margin="0,0,8,0"
                                      Content="周二" />
                            <CheckBox x:Name="Weekday3CheckBox"
                                      Margin="0,0,8,0"
                                      Content="周三" />
                            <CheckBox x:Name="Weekday4CheckBox"
                                      Margin="0,0,8,0"
                                      Content="周四" />
                            <CheckBox x:Name="Weekday5CheckBox"
                                      Margin="0,0,8,0"
                                      Content="周五" />
                            <CheckBox x:Name="Weekday6CheckBox"
                                      Margin="0,0,8,0"
                                      Content="周六" />
                            <CheckBox x:Name="Weekday7CheckBox"
                                      Content="周日" />
                        </WrapPanel>

                        <CheckBox x:Name="CatchUpOnStartupCheckBox"
                                  Grid.Row="3"
                                  Grid.Column="1"
                                  Content="启动软件后若错过本次计划则补跑一次" />
                        <CheckBox x:Name="OnlyWhenIdleCheckBox"
                                  Grid.Row="3"
                                  Grid.Column="3"
                                  Content="仅在当前无运行任务时执行" />
                    </Grid>
                </TabItem>

                <TabItem Header="剧集列表">
                    <Grid Margin="10"
                          RowDefinitions="Auto,*"
                          RowSpacing="8">
                        <TextBlock Text="每行一部剧；所有剧集使用上方相同的本次发布配置和发布后重新生成配置。"
                                   TextWrapping="Wrap" />
                        <TextBox x:Name="DramaTitlesTextBox"
                                 Grid.Row="1"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Watermark="例如：&#x0a;七零带着空间下乡&#x0a;不嫁火坑&#x0a;巷陌福妻" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">
            <Button x:Name="RunNowButton"
                    MinWidth="112"
                    Content="立即执行规则" />
            <Button x:Name="SaveButton"
                    Classes="primary"
                    MinWidth="82"
                    Content="保存" />
            <Button x:Name="CancelButton"
                    MinWidth="72"
                    Content="取消" />
        </StackPanel>
    </Grid>
</Window>
