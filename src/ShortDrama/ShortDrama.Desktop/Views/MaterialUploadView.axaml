<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShortDrama.Desktop.ViewModels"
             x:Class="ShortDrama.Desktop.Views.MaterialUploadView">
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        <Border Classes="page-panel">
            <StackPanel Spacing="12">
                <Border Classes="toolbar-panel">
                    <WrapPanel Orientation="Horizontal">
                        <Button x:Name="RunMaterialUploadQueueButton"
                                Classes="primary compact"
                                MinWidth="170"
                                Margin="0,0,8,8"
                                Content="{Binding MaterialUploadQueueButtonText}" />
                        <Button x:Name="CheckAllVisibleButton"
                                Classes="compact"
                                MinWidth="92"
                                Margin="0,0,8,8"
                                Content="&#x5168;&#x9009;" />
                        <Button x:Name="UncheckAllVisibleButton"
                                Classes="compact"
                                MinWidth="100"
                                Margin="0,0,8,8"
                                Content="&#x53D6;&#x6D88;&#x5168;&#x9009;" />
                        <Button Classes="compact"
                                MinWidth="92"
                                Margin="0,0,8,8"
                                Command="{Binding StopCurrentRunCommand}"
                                Content="&#x505C;&#x6B62;" />
                        <Button x:Name="OpenPublishConfigButton"
                                Classes="compact"
                                MinWidth="118"
                                Margin="0,0,8,8"
                                Content="&#x53D1;&#x8868;&#x914D;&#x7F6E;" />
                        <Button x:Name="OpenClipConfigButton"
                                Classes="compact"
                                MinWidth="118"
                                Margin="0,0,8,8"
                                Content="&#x526A;&#x8F91;&#x914D;&#x7F6E;" />
                        <Button x:Name="OpenAsrConfigButton"
                                Classes="compact"
                                MinWidth="100"
                                Margin="0,0,8,8"
                                Content="ASR &#x914D;&#x7F6E;" />
                        <Button x:Name="DeleteChannelMaterialsButton"
                                Classes="compact"
                                MinWidth="150"
                                Margin="0,0,8,8"
                                Content="&#x5220;&#x9664;&#x89C6;&#x9891;&#x53F7;&#x7D20;&#x6750;" />
                        <Button x:Name="ShowMaterialLogsButton"
                                Classes="compact"
                                MinWidth="126"
                                Margin="0,0,8,8"
                                Content="&#x67E5;&#x770B;&#x7D20;&#x6750;&#x65E5;&#x5FD7;" />
                        <Button x:Name="CreateManualMaterialProjectButton"
                                Classes="compact"
                                MinWidth="168"
                                Margin="0,0,0,8"
                                Content="&#x624B;&#x52A8;&#x521B;&#x5EFA;&#x7D20;&#x6750;&#x9879;&#x76EE;" />
                    </WrapPanel>
                </Border>

                <WrapPanel Orientation="Horizontal">
                    <CheckBox x:Name="GenerateHighlightsCheckBox"
                              Margin="0,0,16,0"
                              Content="&#x751F;&#x6210;&#x7D20;&#x6750;&#x9AD8;&#x5149;"
                              IsChecked="{Binding MaterialUploadGenerateHighlights}" />
                    <CheckBox Margin="0,0,16,0"
                              Content="&#x7D20;&#x6750;&#x4E0A;&#x4F20;"
                              IsChecked="{Binding QueueStepMaterialUploadEnabled}" />
                    <CheckBox Margin="0,0,16,0"
                              Content="&#x5141;&#x8BB8;&#x91CD;&#x590D;&#x53D1;&#x5E03;&#x7D20;&#x6750;"
                              IsChecked="{Binding MaterialUploadAllowDuplicatePublish}" />
                </WrapPanel>

                <TextBlock Text="&#x805A;&#x7126;&#x6E90;&#x89C6;&#x9891;&#x3001;&#x53D1;&#x8868;&#x914D;&#x7F6E;&#x548C;&#x7D20;&#x6750;&#x4E0A;&#x4F20;&#x6D41;&#x7A0B;&#x3002;&#x52FE;&#x9009;&#x201C;&#x751F;&#x6210;&#x7D20;&#x6750;&#x9AD8;&#x5149;&#x201D;&#x540E;&#xFF0C;&#x4F1A;&#x5728;&#x4E0A;&#x4F20;&#x524D;&#x81EA;&#x52A8;&#x9884;&#x5904;&#x7406; material_clips &#x7D20;&#x6750;&#x3002;"
                           Foreground="{DynamicResource DesktopTextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="page-panel">
            <Grid ColumnDefinitions="96,*,Auto,Auto" ColumnSpacing="10">
                <TextBlock VerticalAlignment="Center"
                           Text="&#x5DE5;&#x4F5C;&#x76EE;&#x5F55;"
                           Foreground="{DynamicResource DesktopTextSecondaryBrush}" />
                <TextBox Grid.Column="1"
                         Classes="compact"
                         Text="{Binding RootDir}"
                         Watermark="&#x8BF7;&#x8F93;&#x5165;&#x6216;&#x9009;&#x62E9;&#x9879;&#x76EE;&#x6839;&#x76EE;&#x5F55;" />
                <Button Grid.Column="2"
                        Classes="compact"
                        MinWidth="126"
                        Click="PickRootDir_Click"
                        Content="&#x9009;&#x62E9;&#x5DE5;&#x4F5C;&#x76EE;&#x5F55;" />
                <Button Grid.Column="3"
                        Classes="compact"
                        MinWidth="108"
                        Command="{Binding ScanCommand}"
                        Content="&#x626B;&#x63CF;&#x9879;&#x76EE;" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Classes="page-panel">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                <TextBox Classes="compact"
                         Text="{Binding MaterialUploadFilterText}"
                         Watermark="&#x641C;&#x7D22;&#x539F;&#x5267;&#x540D; / &#x65B0;&#x5267;&#x540D; / &#x53D1;&#x8868;&#x914D;&#x7F6E; / &#x5DF2;&#x4E0A;&#x4F20;&#x7D20;&#x6750; / &#x8DEF;&#x5F84;" />
                <TextBlock Grid.Row="1"
                           Text="{Binding MaterialUploadSummary}"
                           Foreground="{DynamicResource DesktopTextSecondaryBrush}" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Classes="table-shell">
            <Grid RowDefinitions="Auto,*">
                <Border Classes="table-header">
                    <Grid ColumnDefinitions="148,220,220,96,120,120"
                          ColumnSpacing="12">
                        <TextBlock Text="&#x6267;&#x884C;" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="&#x539F;&#x5267;&#x540D;" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="&#x65B0;&#x5267;&#x540D;" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="&#x7D20;&#x6750;&#x6570;" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="&#x5DF2;&#x4E0A;&#x4F20;&#x7D20;&#x6750;" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="&#x72B6;&#x6001;" FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="MaterialUploadProjectsListBox"
                             Classes="table-list"
                             ItemsSource="{Binding MaterialUploadProjects}"
                             SelectedItem="{Binding SelectedProject}"
                             MinWidth="980"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectListItemViewModel">
                                <Border Classes="table-row">
                                    <Grid ColumnDefinitions="148,220,220,96,120,120"
                                          ColumnSpacing="12">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding IsChecked}"
                                                      VerticalAlignment="Center" />
                                            <Button Classes="compact"
                                                    MinWidth="58"
                                                    Content="&#x6267;&#x884C;"
                                                    Click="RunSingleMaterialUpload_Click" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding OriginalTitle}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding NewTitle}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding MaterialPublishConfiguredCount}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding MaterialPublishUploadedSummary}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding MaterialUploadNodeStatus}"
                                                   Foreground="{Binding MaterialUploadNodeForegroundBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
