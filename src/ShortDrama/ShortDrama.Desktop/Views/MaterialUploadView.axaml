<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShortDrama.Desktop.ViewModels"
             x:Class="ShortDrama.Desktop.Views.MaterialUploadView">
    <Grid ColumnDefinitions="232,*"
          ColumnSpacing="12">
        <Border Classes="page-panel">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
                  RowSpacing="10">
                <TextBlock Text="账号管理"
                           FontWeight="SemiBold" />

                <Grid Grid.Row="1"
                      ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="8"
                      RowSpacing="8">
                    <Button x:Name="AddMaterialUploadAccountButton"
                            Classes="compact"
                            Content="+ 新增" />
                    <Button x:Name="RenameMaterialUploadAccountButton"
                            Grid.Column="1"
                            Classes="compact"
                            Content="重命名" />
                    <Button x:Name="SetCurrentMaterialUploadAccountButton"
                            Grid.Row="1"
                            Classes="compact"
                            Content="设为当前" />
                    <Button x:Name="DeleteMaterialUploadAccountButton"
                            Grid.Row="1"
                            Grid.Column="1"
                            Classes="compact"
                            Content="删除" />
                </Grid>

                <TextBox Grid.Row="2"
                         Classes="compact"
                         Text="{Binding MaterialUploadAccountFilterText}"
                         Watermark="昵称 / ID / 授权文件" />

                <ListBox x:Name="MaterialUploadAccountsListBox"
                         Grid.Row="3"
                         ItemsSource="{Binding VisibleMaterialUploadAccounts}"
                         SelectedItem="{Binding SelectedMaterialUploadAccount}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:MaterialUploadAccountItemViewModel">
                            <Border Padding="8"
                                    MinHeight="60">
                                <Grid RowDefinitions="Auto,Auto"
                                      RowSpacing="4">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding ActiveBadge}"
                                                   Foreground="{DynamicResource DesktopAccentBrush}"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding SecondaryText}"
                                               Foreground="{DynamicResource DesktopTextSecondaryBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="4"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="8">
                    <TextBox Classes="compact"
                             Text="{Binding SelectedMaterialUploadAccount.Name}"
                             Watermark="账号昵称" />

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <TextBox Classes="compact"
                                 Text="{Binding SelectedMaterialUploadAccount.AuthFile}"
                                 Watermark="授权文件" />
                        <Button x:Name="BrowseMaterialUploadAuthFileButton"
                                Grid.Column="1"
                                Classes="compact"
                                MinWidth="54"
                                Content="浏览" />
                    </Grid>

                    <TextBox Grid.Row="2"
                             Classes="compact"
                             Text="{Binding SelectedMaterialUploadAccount.BrowserProfileDir}"
                             Watermark="浏览器目录" />

                    <Grid Grid.Row="3"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="8">
                        <Button x:Name="LoginMaterialUploadAccountButton"
                                Classes="compact"
                                Content="登录账号" />
                        <Button x:Name="ReloginMaterialUploadAccountButton"
                                Grid.Column="1"
                                Classes="compact"
                                Content="重新登录" />
                    </Grid>

                    <Grid Grid.Row="4"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="8">
                        <Button x:Name="OpenMaterialUploadAccountBrowserButton"
                                Classes="compact"
                                Content="打开浏览器" />
                        <Button x:Name="BindCheckedMaterialUploadAccountButton"
                                Grid.Column="1"
                                Classes="compact"
                                Content="绑定勾选" />
                    </Grid>

                    <Button x:Name="SaveMaterialUploadAccountButton"
                            Grid.Row="5"
                            Classes="primary compact"
                            HorizontalAlignment="Stretch"
                            Content="保存账号配置" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              RowDefinitions="Auto,Auto,Auto,*"
              RowSpacing="12">
            <Border Classes="page-panel">
                <StackPanel Spacing="10">
                    <Border Classes="toolbar-panel">
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="RunMaterialUploadQueueButton"
                                    Classes="primary compact"
                                    MinWidth="170"
                                    Margin="0,0,8,8"
                                    Content="{Binding MaterialUploadQueueButtonText}" />
                            <Button x:Name="CheckAllVisibleButton"
                                    Classes="compact"
                                    MinWidth="92"
                                    Margin="0,0,8,8"
                                    Content="全选" />
                            <Button x:Name="UncheckAllVisibleButton"
                                    Classes="compact"
                                    MinWidth="100"
                                    Margin="0,0,8,8"
                                    Content="取消全选" />
                            <Button Classes="compact"
                                    MinWidth="92"
                                    Margin="0,0,8,8"
                                    Command="{Binding StopCurrentRunCommand}"
                                    Content="停止" />
                            <Button x:Name="OpenPublishConfigButton"
                                    Classes="compact"
                                    MinWidth="118"
                                    Margin="0,0,8,8"
                                    Content="发表配置" />
                            <Button x:Name="OpenClipConfigButton"
                                    Classes="compact"
                                    MinWidth="118"
                                    Margin="0,0,8,8"
                                    Content="剪辑配置" />
                            <Button x:Name="DeleteChannelMaterialsButton"
                                    Classes="compact"
                                    MinWidth="150"
                                    Margin="0,0,8,8"
                                    Content="删除视频号素材" />
                            <Button x:Name="ShowMaterialLogsButton"
                                    Classes="compact"
                                    MinWidth="126"
                                    Margin="0,0,8,8"
                                    Content="查看素材日志" />
                            <Button x:Name="CreateManualMaterialProjectButton"
                                    Classes="compact"
                                    MinWidth="168"
                                    Margin="0,0,8,8"
                                    Content="手动创建素材项目" />
                            <Button x:Name="GenerateClipsFullEngineButton"
                                    Classes="compact"
                                    MinWidth="176"
                                    Margin="0,0,8,8"
                                    Content="生成剪辑(完整引擎)" />
                            <TextBlock Margin="0,0,8,8"
                                       VerticalAlignment="Center"
                                       Text="并发账号" />
                            <NumericUpDown Width="78"
                                           Margin="0,0,0,8"
                                           Minimum="1"
                                           Maximum="8"
                                           Increment="1"
                                           FormatString="0"
                                           Value="{Binding MaterialUploadMaxParallelAccounts}" />
                        </WrapPanel>
                    </Border>

                    <WrapPanel Orientation="Horizontal">
                        <CheckBox x:Name="GenerateHighlightsCheckBox"
                                  Margin="0,0,16,0"
                                  Content="生成素材高光"
                                  IsChecked="{Binding MaterialUploadGenerateHighlights}" />
                        <CheckBox Margin="0,0,16,0"
                                  Content="素材上传"
                                  IsChecked="{Binding QueueStepMaterialUploadEnabled}" />
                        <CheckBox Margin="0,0,16,0"
                                  Content="允许重复发布素材"
                                  IsChecked="{Binding MaterialUploadAllowDuplicatePublish}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Classes="page-panel">
                <Grid ColumnDefinitions="96,*,Auto,Auto" ColumnSpacing="10">
                    <TextBlock VerticalAlignment="Center"
                               Text="工作目录"
                               Foreground="{DynamicResource DesktopTextSecondaryBrush}" />
                    <TextBox Grid.Column="1"
                             Classes="compact"
                             Text="{Binding RootDir}"
                             Watermark="请输入或选择项目根目录" />
                    <Button Grid.Column="2"
                            Classes="compact"
                            MinWidth="126"
                            Click="PickRootDir_Click"
                            Content="选择工作目录" />
                    <Button Grid.Column="3"
                            Classes="compact"
                            MinWidth="108"
                            Command="{Binding ScanCommand}"
                            Content="扫描项目" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Classes="page-panel">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                    <TextBox Classes="compact"
                             Text="{Binding MaterialUploadFilterText}"
                             Watermark="搜索原剧名 / 新剧名 / 账号档 / 发表配置 / 已上传素材 / 路径" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding MaterialUploadSummary}"
                               Foreground="{DynamicResource DesktopTextSecondaryBrush}" />
                </Grid>
            </Border>

            <Border Grid.Row="3" Classes="table-shell">
                <Grid RowDefinitions="Auto,*">
                    <Border Classes="table-header">
                        <Grid ColumnDefinitions="148,132,220,220,96,120,120"
                              ColumnSpacing="12">
                            <TextBlock Text="执行" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="账号档" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="原剧名" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="新剧名" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="素材数" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="5" Text="已上传素材" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="6" Text="状态" FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="MaterialUploadProjectsListBox"
                                 Classes="table-list"
                                 ItemsSource="{Binding MaterialUploadProjects}"
                                 SelectedItem="{Binding SelectedProject}"
                                 MinWidth="1120"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProjectListItemViewModel">
                                    <Border Classes="table-row">
                                        <Grid ColumnDefinitions="148,132,220,220,96,120,120"
                                              ColumnSpacing="12">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding IsChecked}"
                                                          VerticalAlignment="Center" />
                                                <Button Classes="compact"
                                                        MinWidth="58"
                                                        Content="执行"
                                                        Click="RunSingleMaterialUpload_Click" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding MaterialUploadAccountDisplay}"
                                                       Foreground="{DynamicResource DesktopTextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding OriginalTitle}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding NewTitle}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2" />
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding MaterialPublishConfiguredCount}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding MaterialPublishUploadedSummary}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="6"
                                                       Text="{Binding MaterialUploadNodeStatus}"
                                                       Foreground="{Binding MaterialUploadNodeForegroundBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
