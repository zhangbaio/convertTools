<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ShortDrama.Desktop.Views.TaskQueue.TaskQueueProjectMaterialDetailView">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Border Classes="toolbar-panel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding SelectedProject.DisplayName}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedProject.ProjectMaterialNodeStatus}"
                               Foreground="{Binding SelectedProject.ProjectMaterialNodeForegroundBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="compact"
                        MinWidth="128"
                        Command="{Binding StopCurrentRunCommand}"
                        Content="&#x505C;&#x6B62;&#x5F53;&#x524D;&#x6B65;&#x9AA4;" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="toolbar-panel">
            <WrapPanel ItemWidth="150" Orientation="Horizontal">
                <Button Classes="compact" MinWidth="130" Margin="0,0,8,8" Command="{Binding RunSelectedTranscodeCommand}" Content="&#x53EA;&#x6267;&#x884C;&#x8F6C;&#x7801;" />
                <Button Classes="compact" MinWidth="140" Margin="0,0,8,8" Click="RunSelectedRewriteDetail_Click" Content="&#x6539;&#x5199;&#x4FE1;&#x606F;" />
                <Button Classes="compact" MinWidth="140" Margin="0,0,8,8" Click="RunSelectedPosterDetail_Click" Content="&#x751F;&#x6210;&#x6D77;&#x62A5;" />
                <Button Classes="compact" MinWidth="130" Margin="0,0,8,8" Click="RunSelectedProjectImageDetail_Click" Content="&#x751F;&#x6210;&#x5DE5;&#x7A0B;&#x56FE;" />
                <Button Classes="compact" MinWidth="140" Margin="0,0,8,8" Click="RunSelectedCostReportDetail_Click" Content="&#x751F;&#x6210;&#x6210;&#x672C;&#x62A5;&#x8868;" />
                <Button Classes="compact" MinWidth="150" Margin="0,0,8,8" Click="RunSelectedBatchRenameDetail_Click" Content="&#x91CD;&#x547D;&#x540D;&#x89C6;&#x9891;&#x6587;&#x4EF6;" />
                <Button Classes="compact" MinWidth="150" Margin="0,0,8,8" Click="RunSelectedMaterialConvertDetail_Click" Content="&#x8F6C;&#x6362;&#x7D20;&#x6750;&#x89C6;&#x9891;" />
                <Button Classes="compact" MinWidth="140" Margin="0,0,8,8" Click="RenameSelectedProjectTitle_Click" Content="&#x4FEE;&#x6539;&#x65B0;&#x5267;&#x540D;" />
                <Button Classes="compact" MinWidth="130" Margin="0,0,8,8" Command="{Binding ValidateSelectedProjectMaterialCommand}" Content="&#x7D20;&#x6750;&#x6821;&#x9A8C;" />
                <Button Classes="compact" MinWidth="130" Margin="0,0,8,8" Click="FixAllMaterialValidationIssues_Click" Content="&#x4E00;&#x952E;&#x4FEE;&#x590D;" />
                <Button Classes="primary compact" MinWidth="170" Margin="0,0,0,8" Command="{Binding RunSelectedProjectMaterialCommand}" Content="&#x4E00;&#x952E;&#x751F;&#x6210;&#x9879;&#x76EE;&#x7D20;&#x6750;" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2" MinHeight="0" ColumnDefinitions="0.9*,1.1*" ColumnSpacing="12">
            <Border Classes="page-panel">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <TextBlock Text="&#x9879;&#x76EE;&#x7D20;&#x6750;&#x6B65;&#x9AA4;" FontSize="18" FontWeight="SemiBold" />
                    <Border Grid.Row="1" Classes="table-shell">
                        <ListBox Grid.Row="1"
                                 Classes="table-list"
                                 ItemsSource="{Binding ProjectMaterialSteps}"
                                 SelectedItem="{Binding SelectedProjectMaterialStep}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="table-row">
                                        <Grid ColumnDefinitions="44,*">
                                            <StackPanel Spacing="0" HorizontalAlignment="Center">
                                                <Border Width="36"
                                                        Height="36"
                                                        CornerRadius="18"
                                                        BorderThickness="3"
                                                        BorderBrush="{Binding AccentBrush}"
                                                        Background="Transparent">
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Index}"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding AccentBrush}" />
                                                </Border>
                                                <Border Width="3"
                                                        Height="42"
                                                        IsVisible="{Binding ShowConnector}"
                                                        Background="{Binding SummaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding TitleBrush}" />
                                                <TextBlock Text="{Binding Summary}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{Binding SummaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" MinHeight="0" RowDefinitions="Auto,Auto,*" RowSpacing="12">
                <Border Classes="page-panel">
                    <StackPanel Spacing="6">
                        <TextBlock Text="&#x5F53;&#x524D;&#x6B65;&#x9AA4;" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedProjectMaterialStep.Label}" />
                        <TextBlock Text="{Binding SelectedProjectMaterialStep.Status}"
                                   Foreground="{Binding SelectedProjectMaterialStep.TitleBrush}" />
                        <TextBlock Text="{Binding SelectedProjectMaterialStep.Summary}"
                                   Foreground="{DynamicResource DesktopTextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Classes="table-shell">
                    <Grid RowDefinitions="Auto,*">
                        <Border Classes="table-header">
                            <TextBlock Text="&#x7D20;&#x6750;&#x6821;&#x9A8C;&#x7ED3;&#x679C;" FontSize="18" FontWeight="SemiBold" />
                        </Border>
                        <ListBox Grid.Row="1"
                                 Classes="table-list"
                                 ItemsSource="{Binding MaterialValidationIssues}"
                                 MaxHeight="170"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="table-row">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Classes="compact"
                                                    Content="&#x4FEE;&#x590D;"
                                                    IsEnabled="{Binding CanAutoFix}"
                                                    Click="FixMaterialValidationIssue_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Row="2" MinHeight="0" Classes="table-shell">
                    <Grid MinHeight="0" RowDefinitions="Auto,*">
                        <Border Classes="table-header">
                            <TextBlock Text="&#x5F53;&#x524D;&#x6B65;&#x9AA4;&#x65E5;&#x5FD7;" FontSize="18" FontWeight="SemiBold" />
                        </Border>
                        <ListBox Grid.Row="1"
                                 MinHeight="0"
                                 Classes="table-list"
                                 ItemsSource="{Binding ProjectMaterialStepLogs}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="table-row">
                                        <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
