<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShortDrama.Desktop.ViewModels"
             xmlns:models="using:ShortDrama.Desktop.Models"
             x:Class="ShortDrama.Desktop.Views.TaskQueue.TaskQueueRunLogView">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Border Classes="page-panel">
            <TabStrip ItemsSource="{Binding RunLogTabOptions}"
                      SelectedItem="{Binding SelectedRunLogTabOption}">
                <TabStrip.ItemTemplate>
                    <DataTemplate x:DataType="models:WorkflowStepOption">
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </TabStrip.ItemTemplate>
            </TabStrip>
        </Border>

        <Border Grid.Row="1" Classes="page-panel">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding RunLogHeaderTitle}"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RunLogHeaderContextText}"
                                   Foreground="{DynamicResource DesktopTextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              Content="&#x8DDF;&#x968F;&#x6700;&#x8FD1;&#x6D3B;&#x8DC3;&#x9879;&#x76EE;"
                              IsVisible="{Binding IsRunLogFollowControlsVisible}"
                              IsChecked="{Binding FollowLatestActiveLogProject}"
                              VerticalAlignment="Center" />
                    <CheckBox Grid.Column="2"
                              Content="&#x4EC5;&#x770B;&#x95EE;&#x9898;"
                              IsVisible="{Binding IsRunLogFollowControlsVisible}"
                              IsChecked="{Binding OnlyShowFailedLogs}"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="10">
                        <Button Classes="compact"
                                MinWidth="92"
                                IsVisible="{Binding IsRunLogStopButtonVisible}"
                                Command="{Binding StopCurrentRunCommand}"
                                Content="&#x505C;&#x6B62;" />
                        <Button Classes="compact"
                                MinWidth="108"
                                Click="CopyRunLog_Click"
                                Content="&#x590D;&#x5236;&#x65E5;&#x5FD7;" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding RunLogHeaderSummaryText}"
                           Foreground="{DynamicResource DesktopTextSecondaryBrush}" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="2"
                   LastChildFill="True">
            <Border DockPanel.Dock="Left"
                    Width="300"
                    Margin="0,0,12,0"
                    IsVisible="{Binding IsRunLogProjectPaneVisible}"
                    Classes="page-panel">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <Button Classes="compact"
                            Content="&#x67E5;&#x770B;&#x5168;&#x90E8;&#x52FE;&#x9009;&#x9879;&#x76EE;"
                            Click="ShowAllProjectsLog_Click" />

                    <Border Grid.Row="1" Classes="table-shell">
                        <ListBox Classes="table-list"
                                 ItemsSource="{Binding RunLogProjects}"
                                 SelectedItem="{Binding SelectedRunLogProject}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProjectListItemViewModel">
                                    <Border Classes="table-row">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SchedulingStatus}"
                                                       Foreground="{Binding SchedulingStatusBrush}" />
                                            <TextBlock Text="{Binding CurrentStepLabel}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding CurrentStepProgressText}"
                                                       Foreground="{DynamicResource DesktopTextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <Border Classes="page-panel">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding ActivityTitle}"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding RunLogCurrentScopeLabel, StringFormat=&#x5F53;&#x524D;&#x8303;&#x56F4;: {0}}"
                                       Foreground="{DynamicResource DesktopTextSecondaryBrush}" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  Classes="compact"
                                  Width="180"
                                  IsVisible="{Binding IsRunLogStepFilterVisible}"
                                  ItemsSource="{Binding StepLogFilters}"
                                  SelectedItem="{Binding SelectedStepLogFilter}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Border Grid.Row="1" Classes="toolbar-panel">
                        <TextBox Text="{Binding VisibleActivityLogText}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="Consolas, Cascadia Mono, monospace"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="Transparent"
                                 VerticalContentAlignment="Top"
                                 MinHeight="420"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>
            </Border>
        </DockPanel>

        <TextBlock Grid.Row="2"
                   Margin="0,0,18,12"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Foreground="{DynamicResource DesktopTextSecondaryBrush}"
                   Text="{Binding RunLogFooterHintText}" />
    </Grid>
</UserControl>
