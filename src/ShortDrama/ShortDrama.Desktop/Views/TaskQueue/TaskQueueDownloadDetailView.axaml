<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShortDrama.Desktop.ViewModels"
             x:Class="ShortDrama.Desktop.Views.TaskQueue.TaskQueueDownloadDetailView">
    <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Border Classes="toolbar-panel">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10">
                <Button Classes="compact"
                        MinWidth="108"
                        Click="RunSelectedDownloadDetail_Click"
                        Content="&#x5F00;&#x59CB;&#x4E0B;&#x8F7D;" />
                <Button Grid.Column="1"
                        Classes="compact"
                        MinWidth="92"
                        Command="{Binding StopCurrentRunCommand}"
                        Content="&#x505C;&#x6B62;" />
                <Button Grid.Column="2"
                        Classes="compact"
                        MinWidth="118"
                        Click="RunSelectedDownloadDetail_Click"
                        Content="&#x91CD;&#x65B0;&#x4E0B;&#x8F7D;" />

                <WrapPanel Grid.Column="3"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right">
                    <Border Classes="status-pill" Margin="0,0,8,0">
                        <TextBlock Text="{Binding SelectedProject.DownloadPendingCount, StringFormat=&#x5F85;&#x4E0B;&#x8F7D; {0}}" />
                    </Border>
                    <Border Classes="status-pill" Margin="0,0,8,0">
                        <TextBlock Text="{Binding SelectedProject.DownloadRunningCount, StringFormat=&#x4E0B;&#x8F7D;&#x4E2D; {0}}" />
                    </Border>
                    <Border Classes="status-pill" Margin="0,0,8,0">
                        <TextBlock Text="{Binding SelectedProject.DownloadCompletedCount, StringFormat=&#x5DF2;&#x5B8C;&#x6210; {0}}" />
                    </Border>
                    <Border Classes="status-pill">
                        <TextBlock Text="{Binding SelectedProject.DownloadConcurrency, StringFormat=&#x5E76;&#x53D1;&#x6570; {0}}" />
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="table-shell">
            <Grid RowDefinitions="Auto,*">
                <Border Classes="table-header">
                    <Grid ColumnDefinitions="220,180,180,140,140,220" ColumnSpacing="12">
                        <TextBlock Text="&#x5267;&#x540D;" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="&#x96C6;&#x6570;" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="&#x72B6;&#x6001;" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="&#x8FDB;&#x5EA6;" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="&#x901F;&#x5EA6;" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="&#x64CD;&#x4F5C;" FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="1"
                         Classes="table-list"
                         ItemsSource="{Binding SelectedProject.DownloadEpisodes}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DownloadEpisodeItemViewModel">
                            <Border Classes="table-row">
                                <Grid ColumnDefinitions="220,180,180,140,140,220" ColumnSpacing="12">
                                    <TextBlock Text="{Binding DramaTitle}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding EpisodeLabel}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding StatusText}"
                                               Foreground="{Binding StatusBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="3"
                                                Spacing="6"
                                                VerticalAlignment="Center">
                                        <ProgressBar Minimum="0"
                                                     Maximum="100"
                                                     Height="10"
                                                     Value="{Binding ProgressPercent}" />
                                        <TextBlock Text="{Binding ProgressText}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource DesktopTextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding SpeedText}"
                                               VerticalAlignment="Center" />
                                    <Grid Grid.Column="5" ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <Button Classes="compact"
                                                Content="&#x91CD;&#x8BD5;"
                                                IsEnabled="{Binding CanRetry}"
                                                Click="RetryDownloadEpisode_Click" />
                                        <Button Grid.Column="1"
                                                Classes="compact"
                                                Content="&#x79FB;&#x9664;"
                                                Click="RemoveDownloadEpisode_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
