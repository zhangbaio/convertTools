<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShortDrama.Desktop.Views.MaterialClipAsrConfigWindow"
        Width="720"
        Height="360"
        Title="ASR 配置">
    <Grid Margin="20"
          RowDefinitions="Auto,*,Auto"
          ColumnDefinitions="180,*"
          RowSpacing="14"
          ColumnSpacing="12">
        <TextBlock Grid.ColumnSpan="2"
                   Text="建议先在这里完成 ASR 渠道配置。当前先迁移配置保存能力，测试联调后续再补。"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="1"
              Grid.ColumnSpan="2"
              RowDefinitions="Auto,Auto,Auto,Auto"
              ColumnDefinitions="180,*"
              RowSpacing="12"
              ColumnSpacing="12">
            <TextBlock VerticalAlignment="Center" Text="ASR 渠道" />
            <ComboBox x:Name="ProviderComboBox"
                      Grid.Column="1" />

            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="识别语言" />
            <ComboBox x:Name="LanguageComboBox"
                      Grid.Row="1"
                      Grid.Column="1" />

            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="APP ID / X-Api-Key" />
            <TextBox x:Name="AppIdTextBox"
                     Grid.Row="2"
                     Grid.Column="1"
                     Watermark="AppID 或 X-Api-Key" />

            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Access Token" />
            <TextBox x:Name="AccessTokenTextBox"
                     Grid.Row="3"
                     Grid.Column="1"
                     PasswordChar="*"
                     Watermark="Access Token" />
        </Grid>

        <StackPanel Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12">
            <Button x:Name="TutorialButton"
                    Content="查看教程" />
            <Button x:Name="CancelButton"
                    Content="关闭" />
            <Button x:Name="SaveButton"
                    Content="保存" />
        </StackPanel>
    </Grid>
</Window>
