<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShortDrama.Desktop.Views.MaterialClipConfigWindow"
        Width="700"
        Height="420"
        Title="剪辑配置">
    <Grid Margin="20"
          RowDefinitions="Auto,*,Auto"
          ColumnDefinitions="220,*"
          RowSpacing="14"
          ColumnSpacing="12">
        <TextBlock Grid.ColumnSpan="2"
                   Text="这里只保留自动切片当前真实生效的参数：目标时长、最小时长、每集候选数、单视频拆分条数和 AI 复评分。"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="1"
              Grid.ColumnSpan="2"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              ColumnDefinitions="220,*"
              RowSpacing="12"
              ColumnSpacing="12">
            <TextBlock VerticalAlignment="Center" Text="目标时长模式" />
            <ComboBox x:Name="TargetDurationModeComboBox"
                      Grid.Column="1" />

            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="目标时长(秒)" />
            <NumericUpDown x:Name="TargetDurationSecondsUpDown"
                           Grid.Row="1"
                           Grid.Column="1"
                           Minimum="10"
                           Maximum="180" />

            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="目标占比(%)" />
            <NumericUpDown x:Name="TargetDurationRatioUpDown"
                           Grid.Row="2"
                           Grid.Column="1"
                           Minimum="0.1"
                           Maximum="100"
                           Increment="0.5"
                           FormatString="0.0" />

            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="最小时长(秒)" />
            <NumericUpDown x:Name="MinOutputDurationUpDown"
                           Grid.Row="3"
                           Grid.Column="1"
                           Minimum="0"
                           Maximum="180" />

            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="最大时长(秒)" />
            <NumericUpDown x:Name="MaxOutputDurationUpDown"
                           Grid.Row="4"
                           Grid.Column="1"
                           Minimum="1"
                           Maximum="300" />

            <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="每集保留候选数" />
            <NumericUpDown x:Name="PerEpisodeTopNUpDown"
                           Grid.Row="5"
                           Grid.Column="1"
                           Minimum="1"
                           Maximum="6" />

            <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="单视频拆分最多条数" />
            <NumericUpDown x:Name="SplitClipLimitUpDown"
                           Grid.Row="6"
                           Grid.Column="1"
                           Minimum="1"
                           Maximum="12" />
        </Grid>

        <StackPanel Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12">
            <CheckBox x:Name="EnableLlmCheckBox"
                      VerticalAlignment="Center"
                      Content="启用 AI 复评分" />
            <Button x:Name="CancelButton"
                    Content="关闭" />
            <Button x:Name="SaveButton"
                    Content="保存" />
        </StackPanel>
    </Grid>
</Window>
