<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatformPublisher.Desktop.ViewModels"
             xmlns:charts="using:TikTokPublisher.Ui.Controls"
             x:Class="PlatformPublisher.Desktop.Views.AnalyticsView"
             x:DataType="vm:AnalyticsViewModel"
             Background="#F8FAFC">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="16" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel>
                    <TextBlock Text="数据统计" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="快手分账播放量 · 保留最近 30 天"
                               Foreground="#6B7280" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="更新全部账号" MinWidth="120" Margin="0,0,8,0"
                        Command="{Binding UpdateAllCommand}" Classes="primary" />
                <Button Grid.Column="2" Content="停止" MinWidth="72" Command="{Binding StopCommand}" />
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <charts:AnalyticsDashboardSummary x:Name="DashboardSummary" />
            </ScrollViewer>

            <Grid Grid.Row="2" ColumnDefinitions="2*,*" ColumnSpacing="12">
                <Border Background="White" CornerRadius="8" Padding="14">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="{Binding RangeTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Content="7天" Command="{Binding ShowSevenDaysCommand}" Margin="0,0,6,0" />
                            <Button Content="30天" Command="{Binding ShowThirtyDaysCommand}" />
                            <ToggleButton Content="账号对比" IsChecked="{Binding CompareAccounts, Mode=TwoWay}" Margin="8,0,0,0" />
                        </WrapPanel>
                        <TextBlock x:Name="HoverText" DockPanel.Dock="Top" Foreground="#475569" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ChartScope}" DockPanel.Dock="Top" Foreground="#475569" FontSize="12" />
                        <charts:AnalyticsLineChart x:Name="DailyChart" Series="{Binding ChartSeries}" Height="245" />
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="账号排行 · 区间播放" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ScrollViewer MaxHeight="270">
                            <charts:AnalyticsAccountRanking x:Name="AccountRanking" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                    <TextBlock Text="账号明细" FontSize="16" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="2*,*,*,*,92" Background="#F1F5F9" Height="30">
                        <TextBlock Text="账号" Margin="8,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="类型" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="近30日播放" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="最近一天" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:KuaishouPlayCardViewModel">
                                <Border BorderThickness="0,0,0,1" BorderBrush="#E2E8F0" Padding="0,4">
                                    <Grid ColumnDefinitions="2*,*,*,*,92">
                                        <TextBlock Text="{Binding Title}" Margin="8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Edition}" Foreground="{Binding EditionForeground}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding TotalText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding LatestText}" VerticalAlignment="Center" />
                                        <Button Grid.Column="4" Content="更新" Command="{Binding UpdateCommand}" CommandParameter="{Binding Key}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="4" Spacing="4">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#475569" TextWrapping="Wrap" />
                <TextBlock Text="{Binding LastCollectedText}" Foreground="#475569" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
