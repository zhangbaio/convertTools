<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PlatformPublisher.Desktop.Views.KuaishouDraftReplaceDialog"
        Title="新剧替换草稿" Width="520" Height="230"
        MinWidth="460" MinHeight="210" WindowStartupLocation="CenterOwner"
        CanResize="False">
  <Grid RowDefinitions="Auto,Auto,Auto" Margin="16" RowSpacing="12">
    <TextBlock Text="填写要占用的短剧 ID。只会更新这部已有短剧，不新建。审核未通过或待提交、并且没有上架的才能替换。集数必须和本地视频一样。"
               TextWrapping="Wrap" />
    <TextBox x:Name="SeriesIdBox" Grid.Row="1" Watermark="例如：56506737" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="取消" Click="OnCancelClick" />
      <Button Content="核对短剧" Click="OnConfirmClick" Classes="primaryAction" />
    </StackPanel>
  </Grid>
</Window>
