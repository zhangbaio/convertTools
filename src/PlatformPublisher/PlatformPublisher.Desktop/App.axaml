<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PlatformPublisher.Desktop.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="Background" Value="#0B2438" />
            <Setter Property="Foreground" Value="#F4FAFF" />
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#1688D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#2FA7F5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#A9C6DD" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#11334D" />
            <Setter Property="BorderBrush" Value="#28546F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0D2B42" />
            <Setter Property="BorderBrush" Value="#315E78" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#0D2B42" />
            <Setter Property="BorderBrush" Value="#315E78" />
        </Style>
    </Application.Styles>
</Application>
