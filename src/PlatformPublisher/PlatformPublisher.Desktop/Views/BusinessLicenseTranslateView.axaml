<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PlatformPublisher.Desktop.Views.BusinessLicenseTranslateView"
             x:Name="LicenseRoot">
  <Grid Margin="16" RowDefinitions="Auto,Auto,*" RowSpacing="10">
    <StackPanel Spacing="8">
      <TextBlock Text="执照翻译" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="选择营业执照图片并识别中文。名称、地址、经营范围、类型和登记机关用系统设置里的大模型翻译，生成后会记住这版译文。" Opacity="0.75" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="选择图片" Click="PickImages_Click" />
        <Button Content="识别" Click="Recognize_Click" />
        <Button Content="按中文重新翻译" Click="Retranslate_Click" />
        <Button Content="生成 Word 和 PDF" Click="Generate_Click" />
      </StackPanel>
      <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
    </StackPanel>
    <ComboBox x:Name="FileBox" Grid.Row="1" HorizontalAlignment="Stretch" SelectionChanged="FileBox_SelectionChanged" />
    <ScrollViewer Grid.Row="2">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <StackPanel Spacing="6">
          <TextBlock Text="中文" FontWeight="SemiBold" />
          <TextBlock Text="统一社会信用代码" />
          <TextBox x:Name="CreditBox" />
          <TextBlock Text="名称" />
          <TextBox x:Name="NameBox" />
          <TextBlock Text="类型" />
          <TextBox x:Name="TypeBox" />
          <TextBlock x:Name="PersonLabel" Text="法定代表人" />
          <TextBox x:Name="PersonBox" />
          <TextBlock x:Name="ExtraLabel" Text="注册资本" />
          <TextBox x:Name="ExtraBox" />
          <TextBlock x:Name="DateLabel" Text="成立日期" />
          <TextBox x:Name="DateBox" />
          <TextBlock x:Name="AddressLabel" Text="住所" />
          <TextBox x:Name="AddressBox" />
          <TextBlock Text="经营范围" />
          <TextBox x:Name="ScopeBox" AcceptsReturn="True" MinHeight="120" TextWrapping="Wrap" />
          <TextBlock Text="登记机关" />
          <TextBox x:Name="AuthorityBox" />
          <TextBlock Text="发照日期" />
          <TextBox x:Name="IssueBox" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock Text="英文" FontWeight="SemiBold" />
          <TextBlock Text="Unified Social Credit Code" />
          <TextBox x:Name="EnglishCreditBox" IsReadOnly="True" />
          <TextBlock Text="Name" />
          <TextBox x:Name="EnglishNameBox" />
          <TextBlock Text="Type" />
          <TextBox x:Name="EnglishTypeBox" />
          <TextBlock x:Name="EnglishPersonLabel" Text="Legal Representative" />
          <TextBox x:Name="EnglishPersonBox" />
          <TextBlock x:Name="EnglishExtraLabel" Text="Registered Capital" />
          <TextBox x:Name="EnglishExtraBox" />
          <TextBlock x:Name="EnglishDateLabel" Text="Date of Establishment" />
          <TextBox x:Name="EnglishDateBox" />
          <TextBlock x:Name="EnglishAddressLabel" Text="Domicile" />
          <TextBox x:Name="EnglishAddressBox" />
          <TextBlock Text="Business Scope" />
          <TextBox x:Name="EnglishScopeBox" AcceptsReturn="True" MinHeight="120" TextWrapping="Wrap" />
          <TextBlock Text="Registration Authority" />
          <TextBox x:Name="EnglishAuthorityBox" />
          <TextBlock Text="Issue Date" />
          <TextBox x:Name="EnglishIssueBox" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
