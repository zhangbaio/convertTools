<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatformPublisher.Desktop.ViewModels"
             x:Class="PlatformPublisher.Desktop.Views.WeixinMaterialUploadView"
             x:DataType="vm:WeixinMaterialsWorkspaceViewModel"
             Background="#F4F7FB">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" Margin="16,12,16,10">
        <Grid ColumnDefinitions="*,230" ColumnSpacing="24">
            <StackPanel Spacing="3">
                <TextBlock Text="WEIXIN CHANNELS MATERIAL CENTER" Foreground="#2563EB"
                           FontSize="10" FontWeight="SemiBold" LetterSpacing="1.4" />
                <TextBlock Text="素材发布" FontSize="25" FontWeight="Bold" Foreground="#101828" />
                <TextBlock Text="扫描项目，按原剧名从 ADX 选择并下载素材。" FontSize="13" Foreground="#667085" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Bottom">
                <TextBlock Text="工作账号" FontSize="11" Foreground="#667085" />
                <ComboBox x:Name="AccountSelector" ItemsSource="{Binding Accounts}"
                          SelectedItem="{Binding SelectedAccount}" DisplayMemberBinding="{Binding Name}"
                          MinHeight="36" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Classes="panel" Padding="16,14">
            <Grid RowDefinitions="Auto,1,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="76,*" ColumnSpacing="10">
                    <TextBlock Text="素材工具" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <WrapPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="目录批量发表" Click="OnDirectoryMaterialsClick" Classes="materialTool" Margin="0,0,8,0" />
                        <Button Content="下载系统高光视频" Click="OnDownloadSystemHighlightClick" Classes="materialTool" Margin="0,0,8,0" />
                        <Button Content="按标签发现并下载" Click="OnDiscoverMaterialsClick" Classes="materialTool" Margin="0,0,8,0" />
                        <Button Content="发布系统高光视频" Click="OnSystemHighlightClick" Classes="materialTool" Margin="0,0,8,0" />
                        <Button Content="系统高光自动发布" Click="OnHighlightScheduleClick" Classes="materialTool" Margin="0,0,8,0" />
                        <Button Content="删除视频号素材" Click="OnDeleteChannelMaterialsClick" Classes="materialTool" />
                    </WrapPanel>
                </Grid>
                <Border Grid.Row="1" Background="#EAECF0" Height="1" />
                <Grid Grid.Row="2" ColumnDefinitions="76,*,Auto,Auto" ColumnSpacing="9">
                    <TextBlock Text="工作目录" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding WorkspaceRoot}" Watermark="当前账号尚未配置工作目录" MinHeight="35" />
                    <Button Grid.Column="2" Content="选择目录" Click="OnPickProjectDirectoryClick" Classes="secondaryAction" />
                    <Button Grid.Column="3" Content="扫描项目" Click="OnScanProjectsClick" Classes="primaryAction" IsEnabled="{Binding !IsBusy}" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Classes="panel" ClipToBounds="True">
            <Grid RowDefinitions="56,*">
                <Border Background="#F8FAFC" Padding="14,10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding Query}" Watermark="搜索原剧名 / 新剧名 / 来源 / 路径" MinHeight="34" />
                        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="6" Padding="10,6">
                            <TextBlock Text="{Binding SelectionSummary}" FontSize="11" Foreground="#667085" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" RowDefinitions="38,*">
                    <Border Background="#EAF0F7" BorderBrush="#D9E2EC" BorderThickness="0,1,0,1" Padding="10,0">
                        <Grid ColumnDefinitions="48,1.15*,1.15*,62,76,118,1.35*,500" ColumnSpacing="10">
                            <TextBlock Text="执行" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="原剧名" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="新剧名" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="集数" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="本地素材" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="5" Text="来源" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="6" Text="工作目录" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="7" Text="操作" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Grid>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Projects}" Background="#FFFFFF" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="#F0F5FF" /></Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MaterialProjectRowViewModel">
                                <Border BorderBrush="#D7E0EA" BorderThickness="0,0,0,1" Padding="10,7" MinWidth="1180">
                                    <Grid ColumnDefinitions="48,1.15*,1.15*,62,76,118,1.35*,500" ColumnSpacing="10">
                                        <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" />
                                        <Button Grid.Column="1" Content="{Binding OriginalTitle}" Tag="{Binding}"
                                                Click="OnOpenSourceProjectClick" Classes="materialLink" HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="2" Content="{Binding NewTitle}" Tag="{Binding}"
                                                Click="OnOpenWorkflowProjectClick" Classes="materialLink" HorizontalAlignment="Stretch" />
                                        <TextBlock Grid.Column="3" Text="{Binding EpisodeCount}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding MaterialCount}" VerticalAlignment="Center" />
                                        <Border Grid.Column="5" Background="#EAF2FF" CornerRadius="5" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SourceLabel}" Foreground="#245BD6" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Button Grid.Column="6" Content="{Binding WorkflowDirectory}" Tag="{Binding}"
                                                Click="OnOpenWorkflowProjectClick" Classes="materialLink" HorizontalAlignment="Stretch" />
                                        <WrapPanel Grid.Column="7" IsVisible="{Binding !IsDownloadedSystemHighlight}" VerticalAlignment="Center">
                                            <Button Content="ADX素材下载" Tag="{Binding}" Click="OnAdxProjectClick" Classes="materialAdx compactAction" Margin="0,0,6,0" />
                                            <Button Content="自选发布" Tag="{Binding}" Click="OnCustomProjectClick" Classes="materialCustom compactAction" Margin="0,0,6,0" />
                                            <Button Content="发布ADX素材" Tag="{Binding}" Click="OnPublishAdxProjectClick" Classes="materialPublish compactAction" Margin="0,0,6,0" />
                                            <Button Content="发布已下载视频" Tag="{Binding}" Click="OnPublishDownloadedProjectClick" Classes="secondaryAction compactAction" />
                                        </WrapPanel>
                                        <Button Grid.Column="7" Content="进入一键发布" Tag="{Binding}" Click="OnPublishDownloadedProjectClick"
                                                IsVisible="{Binding IsDownloadedSystemHighlight}" Classes="materialPublish compactAction" HorizontalAlignment="Left" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="请选择工作目录并扫描项目。" IsVisible="{Binding !HasProjects}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#98A2B3" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="12,8">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#667085" FontSize="11" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
