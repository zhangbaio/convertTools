<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PlatformPublisher.Desktop.ViewModels"
        x:Class="PlatformPublisher.Desktop.Views.MainWindow"
        Width="1496"
        Height="860"
        MinWidth="1180"
        MinHeight="720"
        Title="云帆多平台发布助手">
    <Grid RowDefinitions="58,*,30">
        <Border Grid.Row="0" Background="#0E2D45" BorderBrush="#28546F" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="230,*">
                <Border BorderBrush="#28546F" BorderThickness="0,0,1,0" Padding="18,0">
                    <TextBlock Text="云帆多平台发布助手"
                               VerticalAlignment="Center"
                               FontSize="17"
                               FontWeight="Bold" />
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0">
                    <Button Classes="nav" Content="生产流水线" FontWeight="SemiBold" />
                    <Button Classes="nav" Content="发布账号" IsEnabled="False" />
                    <Button Classes="nav" Content="网页工具" IsEnabled="False" />
                    <Button Classes="nav" Content="查看报告" IsEnabled="False" />
                    <Button Classes="nav" Content="应用配置" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="230,*">
            <Border Grid.Column="0" Background="#0E2D45" BorderBrush="#28546F" BorderThickness="0,0,1,0" Padding="12">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <StackPanel Spacing="4" Margin="4,4,4,8">
                        <TextBlock Text="发布平台" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="各平台账号和任务相互隔离"
                                   FontSize="11"
                                   Foreground="#8FB0C8" />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Platforms}"
                             SelectedItem="{Binding SelectedPlatform}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="10" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="CornerRadius" Value="7" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="#17689A" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlatformOptionViewModel">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="11"
                                               Foreground="#A9C6DD"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Classes="panel" Padding="10">
                        <StackPanel Spacing="5">
                            <TextBlock Text="隔离状态" FontWeight="SemiBold" />
                            <TextBlock Text="独立程序 / 独立队列 / 独立配置"
                                       Foreground="#61D7B0"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="不会写入 TikTok 助手数据"
                                       Foreground="#A9C6DD"
                                       FontSize="11" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="16,14" RowDefinitions="Auto,Auto,*" RowSpacing="10">
                <Border Classes="panel" Padding="14">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="8" ColumnSpacing="10">
                        <TextBlock Text="任务类型" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding JobKinds}"
                                  SelectedItem="{Binding SelectedJobKind}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PublishJobKindOptionViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Foreground="#91AEC3" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="项目目录" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding DraftProjectDirectory}"
                                 Watermark="剧集上传选择项目；目录发表选择包含多个素材子目录的根目录" />
                        <Button Grid.Row="1" Grid.Column="2" Click="PickProjectDirectory_Click" Content="选择目录" />

                        <TextBlock Grid.Row="2" Text="视频号配置" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding DraftConfigPath}"
                                 Watermark="可选；目录发表会继承其中的授权文件和浏览器目录" />
                        <Button Grid.Row="2" Grid.Column="2" Click="PickConfigFile_Click" Content="选择配置" />

                        <TextBlock Grid.Row="3" Text="账号备注" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding DraftAccountName}"
                                 Watermark="例如：视频号主账号" />
                        <Button Grid.Row="3" Grid.Column="2"
                                Classes="primary"
                                Command="{Binding AddJobCommand}"
                                Content="加入当前平台" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Classes="panel" Padding="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding SelectedPlatformCapability}"
                                       Foreground="#8FD5FF"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding QueueSummary}" Foreground="#9CB8CC" FontSize="12" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Command="{Binding OpenLoginCommand}"
                                    Content="登录 / 打开浏览器" />
                            <Button Margin="0,0,8,0"
                                    Classes="primary"
                                    Command="{Binding RunSelectedCommand}"
                                    Content="开始选中任务" />
                            <Button Margin="0,0,8,0"
                                    Command="{Binding StopCommand}"
                                    Content="停止" />
                            <Button Command="{Binding RemoveSelectedCommand}"
                                    Content="移出队列" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Classes="panel" ClipToBounds="True">
                    <Grid RowDefinitions="42,*">
                        <Border Background="#173E5E" BorderBrush="#28546F" BorderThickness="0,0,0,1" Padding="12,0">
                            <Grid ColumnDefinitions="150,130,1.2*,1.7*,110,2*" ColumnSpacing="12">
                                <TextBlock Text="平台" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="任务类型" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="项目" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="目录" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="状态" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="5" Text="当前信息" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding VisibleJobs}"
                                 SelectedItem="{Binding SelectedJob}"
                                 Background="#11334D"
                                 BorderThickness="0">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#204F72" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PublishJobRowViewModel">
                                    <Border BorderBrush="#28546F" BorderThickness="0,0,0,1" Padding="12,9">
                                        <Grid ColumnDefinitions="150,130,1.2*,1.7*,110,2*" ColumnSpacing="12">
                                            <TextBlock Text="{Binding PlatformName}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding KindName}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding AccountName}" FontSize="11" Foreground="#91AEC3" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding ProjectDirectory}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding StatusText}"
                                                       VerticalAlignment="Center"
                                                       Foreground="#61D7B0"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding StatusMessage}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#0E2D45" BorderBrush="#28546F" BorderThickness="0,1,0,0" Padding="12,0">
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
