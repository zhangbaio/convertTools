<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PlatformPublisher.Desktop.Views.WeixinSeriesPresetView">
    <UserControl.Styles>
        <StyleInclude Source="avares://TikTokPublisher.Ui/Themes/ConfigurationFormStyles.axaml" />
        <Style Selector="Border.publishActionBar">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="14,8,14,12" RowSpacing="10">
        <TextBlock x:Name="AccountSummary" Classes="pageSummary" TextWrapping="Wrap" />
        <Grid x:Name="Editor" Grid.Row="1">
            <ScrollViewer x:Name="AccountEditor" HorizontalScrollBarVisibility="Disabled" Background="#FFFFFF">
                <StackPanel x:Name="AccountFields" Margin="10,4,14,12" Spacing="12" />
            </ScrollViewer>

            <Grid x:Name="ProjectEditor" IsVisible="False" RowDefinitions="Auto,Auto,*" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="项目表单" Classes="configurationHeading" />
                    <Button Grid.Column="1" Content="返回账号发布配置" Click="OnReturnToAccountClick" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="125,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnSpacing="8" RowSpacing="7">
                    <TextBlock Text="项目目录" VerticalAlignment="Center" Classes="configurationLabel" />
                    <TextBox x:Name="ProjectDirectoryBox" Grid.Column="1" Classes="configurationInput" Watermark="选择要预览的剧集项目" />
                    <Button Grid.Column="2" Content="选择目录" Click="OnChooseProjectClick" />
                    <TextBlock Grid.Row="1" Text="剧集配置文件" VerticalAlignment="Center" Classes="configurationLabel" />
                    <TextBox x:Name="ConfigPathBox" Grid.Row="1" Grid.Column="1" Classes="configurationInput" Watermark="留空时在项目目录查找" />
                    <Button Grid.Row="1" Grid.Column="2" Content="选择 JSON" Click="OnChooseConfigClick" />
                    <TextBlock Grid.Row="2" Text="按上传方式校验" VerticalAlignment="Center" Classes="configurationLabel" />
                    <ComboBox x:Name="PreviewModePicker" Grid.Row="2" Grid.Column="1" Classes="configurationInput"
                              SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="浏览器" />
                        <ComboBoxItem Content="接口仅上传" />
                        <ComboBoxItem Content="接口提审" />
                    </ComboBox>
                    <Button Grid.Row="2" Grid.Column="3" Content="生成表单" Click="OnGenerateClick" Classes="primaryAction" />
                    <TextBlock Grid.Row="3" Grid.ColumnSpan="4" x:Name="PreviewNotes" Classes="pageSummary" TextWrapping="Wrap" />
                </Grid>
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PreviewFields" Spacing="9" Margin="0,0,10,10" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Classes="publishActionBar">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock x:Name="StatusText" Classes="pageSummary" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button x:Name="CancelButton" Grid.Column="1" Content="取消生成" IsVisible="False" Click="OnCancelClick" />
                <Button x:Name="ApplyButton" Grid.Column="2" Content="保存到此项目" IsVisible="False"
                        Click="OnApplyClick" Classes="primaryAction" />
                <Button x:Name="SaveButton" Grid.Column="3" Content="保存发布配置" Click="OnSaveClick"
                        Classes="primaryAction" MinWidth="120" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
