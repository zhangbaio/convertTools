<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:PlatformPublisher.Desktop.Views"
        x:Class="PlatformPublisher.Desktop.Views.KuaishouAuditTimeoutDialog"
        Title="审核超时重提" Width="760" Height="520"
        MinWidth="560" MinHeight="370" WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="12">
        <StackPanel Spacing="6">
            <TextBlock x:Name="AccountText" FontWeight="SemiBold" />
            <TextBlock Text="勾选要按原资料重新提审的剧集。摘要混合提示的项目可单独重提一部。"
                       TextWrapping="Wrap" Classes="pageSummary" />
        </StackPanel>
        <ListBox Grid.Row="1" x:Name="CandidatesList">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="views:KuaishouAuditTimeoutRow">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="4,6">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding Target.CanSelect}"
                                  AutomationProperties.Name="{Binding Target.Title}" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding Caption}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Reasons}" Classes="pageSummary" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Classes="pageSummary" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="取消" Click="OnCancelClick" />
                <Button x:Name="SubmitButton" Content="重提勾选" Click="OnConfirmClick"
                        IsEnabled="False" Classes="primaryAction" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
