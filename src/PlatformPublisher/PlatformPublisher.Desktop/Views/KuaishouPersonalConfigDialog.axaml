<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PlatformPublisher.Desktop.Views.KuaishouPersonalConfigDialog"
             Background="#F3F6FA">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3">
                <TextBlock x:Name="AccountHeading" Text="快手分账配置" FontSize="20" FontWeight="Bold" Foreground="#0B74D1" />
                <TextBlock x:Name="AccountHint" Text="每个账号只保存一份快手分账配置。账号类型决定生成产物和上传走个人版还是企业版。" Foreground="#64748B" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="账号与上传">
                <ScrollViewer>
                    <StackPanel Margin="16" Spacing="18">
                        <StackPanel Spacing="6">
                            <TextBlock Text="账号类型" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="18">
                                <RadioButton x:Name="EditionPersonalBox" Content="个人版" GroupName="KuaishouAccountEdition" />
                                <RadioButton x:Name="EditionEnterpriseBox" Content="企业版" GroupName="KuaishouAccountEdition" />
                            </StackPanel>
                            <TextBlock Text="未选择时不能生成产物或上传。改成另一种类型会删除另一版本的任务记录，不删除项目文件。"
                                       Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="账号资料" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                <TextBlock Text="用户快手号 ID" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" x:Name="AdvertiserIdBox" />
                                <TextBlock Grid.Row="1" Text="快手昵称" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="NicknameBox" Watermark="个人分账制作机构使用快手昵称和快手号 ID" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="上传与提交" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                <TextBlock Text="上传方式" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="UploadTransportBox" SelectionChanged="UploadTransportBox_SelectionChanged" />
                                <TextBlock Grid.Row="1" Text="任务执行到" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SubmissionTargetBox" SelectionChanged="SubmissionTargetBox_SelectionChanged" />
                                <TextBlock Grid.Row="2" Text="任务队列并发数" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="QueueParallelBox" ToolTip.Tip="当前账号同时执行的项目数，范围 1 到 5" />
                            </Grid>
                            <CheckBox x:Name="RemoteDispatchBox" Content="远程分发" />
                            <TextBlock Text="启用远程分发后，账号可接收服务端派发的剧集。" Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>

                        <Expander Header="高级上传设置" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                    <TextBlock Text="入口 URL" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" x:Name="EntryUrlBox" />
                                    <TextBlock Grid.Row="1" Text="登录超时（秒）" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="LoginTimeoutBox" Watermark="登录等待秒数，默认 300" />
                                    <TextBlock Grid.Row="2" Text="浏览器模式" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="RevenueShareBrowserModeBox" />
                                </Grid>
                                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12" x:Name="PageUploadOptions">
                                    <TextBlock Text="出错时手工介入" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" x:Name="KeepBrowserBox" Content="启用" />
                                    <TextBlock x:Name="SubmitPreCheckLabel" Grid.Row="1" Text="提交前预等待" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SubmitPreCheckBox" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="剧集资料">
                <ScrollViewer>
                    <StackPanel Margin="16" Spacing="18">
                        <StackPanel Spacing="8">
                            <TextBlock Text="内容与售卖" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                <TextBlock Text="内容类型" VerticalAlignment="Center" />
                                <ComboBox x:Name="ContentTypeBox" Grid.Column="1" />
                                <TextBlock Grid.Row="1" Text="漫剧制作方式" VerticalAlignment="Center" />
                                <ComboBox x:Name="ComicMethodBox" Grid.Row="1" Grid.Column="1" />
                                <TextBlock Grid.Row="2" Text="作者声明" VerticalAlignment="Center" />
                                <ComboBox x:Name="AuthorDeclarationBox" Grid.Row="2" Grid.Column="1" />
                                <TextBlock Grid.Row="3" Text="制作形式" VerticalAlignment="Center" />
                                <ComboBox x:Name="ProductionFormBox" Grid.Row="3" Grid.Column="1" />
                                <TextBlock Grid.Row="4" Text="出品年份" VerticalAlignment="Center" />
                                <TextBox x:Name="ProductionYearBox" Grid.Row="4" Grid.Column="1" />
                                <TextBlock Grid.Row="5" Text="单集平均时长" VerticalAlignment="Center" />
                                <TextBox x:Name="AverageDurationBox" Grid.Row="5" Grid.Column="1" />
                                <TextBlock Grid.Row="6" Text="制作成本（万元）" VerticalAlignment="Center" />
                                <TextBox x:Name="ProductionCostBox" Grid.Row="6" Grid.Column="1" Watermark="单位：万元，例如 1.0" />
                                <TextBlock Grid.Row="7" Text="售卖类型" VerticalAlignment="Center" />
                                <ComboBox x:Name="SaleTypeBox" Grid.Row="7" Grid.Column="1" SelectionChanged="SaleTypeBox_SelectionChanged" />
                                <TextBlock x:Name="FreeEpisodeLabel" Grid.Row="8" Text="免费集数" VerticalAlignment="Center" />
                                <TextBox x:Name="FreeEpisodeCountBox" Grid.Row="8" Grid.Column="1" Watermark="默认 1，如 3" />
                                <TextBlock x:Name="UnlockCountLabel" Grid.Row="9" Text="广告解锁集数" VerticalAlignment="Center" />
                                <TextBox x:Name="UnlockEpisodeCountBox" Grid.Row="9" Grid.Column="1" Watermark="默认 1，限制 1~8；saleType 为 3 时有效" />
                                <TextBlock x:Name="SmallAmountLabel" Grid.Row="10" Text="小额解锁" VerticalAlignment="Center" />
                                <CheckBox x:Name="SmallAmountUnlockBox" Grid.Row="10" Grid.Column="1" Content="是" />
                                <TextBlock x:Name="EpisodePriceLabel" Grid.Row="11" Text="单集价格（元）" VerticalAlignment="Center" />
                                <TextBox x:Name="EpisodePriceBox" Grid.Row="11" Grid.Column="1" Watermark="saleType=2 时有效，单位：元，例如 0.11" />
                                <TextBlock x:Name="SeriesPriceLabel" Grid.Row="12" Text="整剧价格（元）" VerticalAlignment="Center" />
                                <TextBox x:Name="SeriesPriceBox" Grid.Row="12" Grid.Column="1" Watermark="saleType=0/2 时必填，单位：元，例如 1.00" />
                                <TextBlock Grid.Row="13" Text="版权证明类型" VerticalAlignment="Center" />
                                <ComboBox x:Name="CopyrightProofTypeBox" Grid.Row="13" Grid.Column="1" />
                                <TextBlock Grid.Row="14" Text="完结" VerticalAlignment="Center" />
                                <CheckBox x:Name="FinishedBox" Grid.Row="14" Grid.Column="1" Content="是" />
                                <TextBlock Grid.Row="15" Text="备案号" VerticalAlignment="Center" />
                                <CheckBox x:Name="HasRecordNumberBox" Grid.Row="15" Grid.Column="1" Content="是" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="播出与人员" FontWeight="SemiBold" />
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                    <TextBlock Text="播出平台" VerticalAlignment="Center" />
                                    <TextBox x:Name="BroadcastPlatformBox" Grid.Column="1" />
                                    <TextBlock Grid.Row="1" Text="播出途径" VerticalAlignment="Center" />
                                    <ComboBox x:Name="BroadcastChannelBox" Grid.Row="1" Grid.Column="1" />
                                    <TextBlock Grid.Row="2" Text="播出时间模式" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <ComboBox x:Name="BroadcastTimeModeBox" Width="140" SelectionChanged="BroadcastTimeModeBox_SelectionChanged" />
                                        <TextBox x:Name="BroadcastDateBox" Width="160" Watermark="yyyy-MM-dd" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" Text="演员库" VerticalAlignment="Top" />
                                    <TextBox x:Name="ActorLibraryBox" Grid.Row="3" Grid.Column="1" AcceptsReturn="True" MinHeight="140" TextWrapping="Wrap"
                                             Watermark="格式：姓名|性别|角色1,角色2&#10;例如：沈清秋|女|许初夏,林晚意" />
                                    <TextBlock Grid.Row="4" Text="演员 JSON" VerticalAlignment="Top" />
                                    <TextBox x:Name="ActorInfoBox" Grid.Row="4" Grid.Column="1" AcceptsReturn="True" MinHeight="100" TextWrapping="Wrap"
                                             Watermark='[{"name":"演员A","gender":"男","role":"男主"}]' />
                                </Grid>
                                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                    <TextBlock Text="用户名" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" x:Name="UsernameBox" Watermark="用于人员署名和承诺函" />
                                    <TextBlock Grid.Row="1" Text="性别" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="GenderBox" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="剧名与合规" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                <TextBlock Text="新剧名别名" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" x:Name="NewTitleAliasEnabledBox" Content="启用" />
                                <TextBlock Grid.Row="1" Text="别名位置" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="NewTitleAliasPositionBox" />
                                <TextBlock Grid.Row="2" Text="别名值" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="NewTitleAliasValueBox" Watermark="例如 2" />
                            </Grid>
                            <Expander Header="内容合规词库" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="下方展示当前完整有效词库，可直接增加、修改或删除词语。每行格式：分类：词1、词2。保存后会写进生成新剧名、短标题和简介的提示词，由 AI 生成时直接避开；生成后若仍命中会自动重写，上传时不再拦截。软件升级新增的系统词会自动合并。"
                                               TextWrapping="Wrap" Foreground="#64748B" />
                                    <TextBlock Text="快手新剧名敏感词（普通上传、分账个人版、分账企业版）" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TitlePolicySummary" Foreground="#64748B" />
                                    <TextBox x:Name="TitlePolicyBox" AcceptsReturn="True" MinHeight="140" TextWrapping="Wrap" />
                                    <TextBlock Text="快手简介敏感词（普通上传、分账个人版、分账企业版）" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SynopsisTermsSummary" Foreground="#64748B" />
                                    <TextBox x:Name="SynopsisTermsBox" AcceptsReturn="True" MinHeight="140" TextWrapping="Wrap" />
                                    <TextBlock Text="快手简介语义概念组（用于识别同义词和跨句组合）" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ConceptGroupsSummary" Foreground="#64748B" />
                                    <TextBox x:Name="ConceptGroupsBox" AcceptsReturn="True" MinHeight="120" TextWrapping="Wrap" />
                                    <TextBlock Text="快手简介组合语义规则" FontWeight="SemiBold" />
                                    <TextBlock Text="每行格式：风险分类：概念组1+概念组2；删除整行即可停用该组合。" Foreground="#64748B" TextWrapping="Wrap" />
                                    <TextBox x:Name="CombinationRulesBox" AcceptsReturn="True" MinHeight="100" TextWrapping="Wrap" />
                                    <Button Content="恢复系统默认词库" Click="RestoreContentPolicy_Click" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="项目资料高级设置" HorizontalContentAlignment="Stretch">
                                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto" RowSpacing="10" ColumnSpacing="12">
                                    <TextBlock Text="全场景展示" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" x:Name="RevenueShareFullSceneBox" Content="是" />
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="证明材料">
                <ScrollViewer>
                    <StackPanel Margin="16" Spacing="18">
                        <StackPanel Spacing="8">
                            <TextBlock Text="承诺函" FontWeight="SemiBold" />
                            <TextBlock Text="上传优先使用已有的承诺函 PDF，缺少 PDF 时可用模板生成。" Foreground="#64748B" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="180,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                <TextBlock Text="固定 PDF" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" x:Name="CommitmentPdfBox" />
                                <Button Grid.Column="2" Content="选择" Click="PickCommitmentPdf_Click" />
                                <TextBlock Grid.Row="1" Text="制作机构" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="CommitmentRecipientBox" />
                                <TextBlock Grid.Row="2" Text="承诺函模板" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="CommitmentTemplateBox" />
                                <Button Grid.Row="2" Grid.Column="2" Content="选择" Click="PickCommitmentTemplate_Click" />
                                <TextBlock Grid.Row="3" Text="盖章图片" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="CommitmentSealBox" Watermark="留空则使用成本报表的印章地址" />
                                <Button Grid.Row="3" Grid.Column="2" Content="选择" Click="PickCommitmentSeal_Click" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="工程图" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto" RowSpacing="10" ColumnSpacing="12">
                                <TextBlock Text="分账工程图模板" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="PersonalTemplateBox" />
                            </Grid>
                            <Expander Header="工程图高级设置" HorizontalContentAlignment="Stretch">
                                <Grid ColumnDefinitions="180,*,Auto" RowDefinitions="Auto" RowSpacing="10" ColumnSpacing="12">
                                    <TextBlock Text="模板根目录" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" x:Name="ProjectImageRootBox" Watermark="留空时使用系统工程图模板根目录和内置模板" />
                                    <Button Grid.Column="2" Content="浏览" Click="PickProjectImageRoot_Click" />
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="剧集上架">
                <ScrollViewer>
                    <StackPanel Margin="16" Spacing="18">
                        <StackPanel Spacing="8">
                            <TextBlock Text="审核通过后自动上架" FontWeight="SemiBold" />
                            <CheckBox x:Name="AutoOnlineBox" Content="提交审核后登记待上架队列" />
                            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12" IsVisible="{Binding #AutoOnlineBox.IsChecked}">
                                <TextBlock Text="检查间隔（分钟）" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" x:Name="AutoOnlineIntervalBox" />
                                <TextBlock Grid.Row="1" Text="每轮最多处理" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="AutoOnlineMaxItemsBox" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="定时恢复已下架短剧" FontWeight="SemiBold" />
                            <CheckBox x:Name="ScheduledShelfBox" Content="定时扫描并恢复可上架短剧" />
                            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" IsVisible="{Binding #ScheduledShelfBox.IsChecked}" RowSpacing="10" ColumnSpacing="12">
                                <TextBlock Text="上架方式" VerticalAlignment="Center" />
                                <ComboBox x:Name="ScheduledShelfModeBox" Grid.Column="1" SelectionChanged="ScheduledShelfModeBox_SelectionChanged" />
                                <TextBlock x:Name="ScheduledShelfIntervalLabel" Grid.Row="1" Text="检查间隔(小时)" VerticalAlignment="Center" />
                                <TextBox x:Name="ScheduledShelfIntervalBox" Grid.Row="1" Grid.Column="1" Watermark="1 到 24，例如 1 表示每小时" />
                                <TextBlock x:Name="ScheduledShelfDailyLabel" Grid.Row="2" Text="每天时刻" VerticalAlignment="Center" />
                                <TextBox x:Name="ScheduledShelfDailyBox" Grid.Row="2" Grid.Column="1" Watermark="例如 10:00" />
                                <TextBlock Grid.Row="3" Text="上传中跳过" VerticalAlignment="Center" />
                                <CheckBox x:Name="ScheduledShelfOnlyWhenIdleBox" Grid.Row="3" Grid.Column="1" Content="该账号正在上传时跳过本轮，上传结束后再检查" />
                                <TextBlock Grid.Row="4" Text="每轮最多上架" VerticalAlignment="Center" />
                                <TextBox x:Name="ScheduledShelfMaxBox" Grid.Row="4" Grid.Column="1" Watermark="例如 50" />
                                <TextBlock Grid.Row="5" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="#64748B"
                                           Text="固定间隔在开启后的下一次检查先跑一轮，之后按间隔计算。每天固定时间过了今天的时刻且今天还没跑过，会补跑一次。登录失效时本轮停止，并记入日志。" />
                            </Grid>
                        </StackPanel>

                        <Expander Header="兼容接口设置" HorizontalContentAlignment="Stretch" x:Name="LegacyOnlineOptions">
                            <StackPanel Spacing="10">
                                <TextBlock Text="页面上传模式下，提交后的自动上架队列使用这些接口设置。" Foreground="#64748B" TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                    <TextBlock Text="API Base URL" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" x:Name="ApiBaseUrlBox" />
                                    <TextBlock Grid.Row="1" Text="Access Token" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="AccessTokenBox" PasswordChar="●" />
                                    <TextBlock Grid.Row="2" Text="Token Header" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TokenHeaderBox" />
                                    <TextBlock Grid.Row="3" Text="短剧基本信息查询路径" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="SeriesBaseInfoPathBox" />
                                    <TextBlock Grid.Row="4" Text="上下架接口路径" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="OnlineOfflinePathBox" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
            <TextBlock x:Name="ValidationText" Foreground="#DC2626" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="导入配置">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="导入微信工具配置" Click="ImportExportedSettings_Click" />
                        <MenuItem Header="导入旧版配置" Click="ImportLegacy_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button Grid.Column="2" Content="放弃修改" Click="Cancel_Click" />
            <Button Grid.Column="3" Classes="primary" Content="保存配置" Click="Save_Click" />
        </Grid>
    </Grid>
</UserControl>
