<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:PlatformPublisher.Desktop.Views"
             x:Class="PlatformPublisher.Desktop.Views.KuaishouPersonalConfigDialog"
             Background="White">
    <UserControl.Styles>
        <StyleInclude Source="avares://TikTokPublisher.Ui/Themes/ConfigurationFormStyles.axaml" />
        <Style Selector="ComboBox.configurationInput">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="TabControl.publishTabs">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TabControl.publishTabs TabItem">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="12,10,12,0" RowSpacing="10">
        <TextBlock x:Name="AccountHeading" Text="快手分账配置" FontSize="18" FontWeight="SemiBold" />

        <TabControl x:Name="ConfigurationTabs" Grid.Row="1" Classes="publishTabs">
            <TabItem Header="发布配置">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="2,4,14,12" SizeChanged="PublishViewport_SizeChanged">
                        <StackPanel Spacing="10" x:Name="PublishForm" MaxWidth="1080" HorizontalAlignment="Left">
                            <TextBlock Classes="configurationHeading" Text="账号与上传" />
                            <ContentControl x:Name="WorkDirectoryHost" IsVisible="False" />
                            <TextBlock x:Name="LoginStatusText" Foreground="#64748B" TextWrapping="Wrap" />
                            <StackPanel Spacing="5">
                                <TextBlock Classes="configurationLabel" Text="账号类型" />
                                <StackPanel Spacing="18" Orientation="Horizontal">
                                    <RadioButton x:Name="EditionPersonalBox" Content="个人版" GroupName="KuaishouAccountEdition" />
                                    <RadioButton x:Name="EditionEnterpriseBox" Content="企业版" GroupName="KuaishouAccountEdition" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="切换账号类型时，需要确认是否删除另一版本的任务记录。" Foreground="#64748B" TextWrapping="Wrap" />
                            <UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="10">
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="快手昵称" />
                                    <TextBox x:Name="NicknameBox" Classes="configurationInput" AutomationProperties.Name="快手昵称" Watermark="个人版制作机构使用快手昵称和快手号 ID" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="用户快手号 ID" />
                                    <TextBox x:Name="AdvertiserIdBox" Classes="configurationInput" AutomationProperties.Name="用户快手号 ID" />
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="10">
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="上传方式" />
                                    <ComboBox x:Name="UploadTransportBox" Classes="configurationInput" AutomationProperties.Name="上传方式" SelectionChanged="UploadTransportBox_SelectionChanged" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="任务执行到" />
                                    <ComboBox x:Name="SubmissionTargetBox" Classes="configurationInput" AutomationProperties.Name="任务执行到" SelectionChanged="SubmissionTargetBox_SelectionChanged" />
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="10">
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="任务队列并发数" />
                                    <TextBox x:Name="QueueParallelBox" Classes="configurationInput" AutomationProperties.Name="任务队列并发数" ToolTip.Tip="当前账号同时执行的项目数，范围 1 到 5" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Bottom">
                                    <ToggleSwitch x:Name="RemoteDispatchBox" OnContent="远程分发" OffContent="远程分发" AutomationProperties.Name="远程分发" />
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel x:Name="PageUploadOptions" Spacing="10" IsVisible="False">
                                <UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="10">
                                    <StackPanel Spacing="5">
                                        <TextBlock Classes="configurationLabel" Text="浏览器模式" />
                                        <ComboBox x:Name="RevenueShareBrowserModeBox" Classes="configurationInput" AutomationProperties.Name="浏览器模式" />
                                    </StackPanel>
                                    <StackPanel Spacing="5" x:Name="SubmitPreCheckOptions">
                                        <TextBlock Classes="configurationLabel" Text="提交前预等待" />
                                        <ComboBox x:Name="SubmitPreCheckBox" Classes="configurationInput" AutomationProperties.Name="提交前预等待" />
                                    </StackPanel>
                                </UniformGrid>
                                <ToggleSwitch x:Name="KeepBrowserBox" OnContent="出错时手工介入" OffContent="出错时手工介入" AutomationProperties.Name="出错时手工介入" />
                            </StackPanel>
                            <Border Height="1" Background="#E4E9F0" Margin="0,4" />

                            <TextBlock Classes="configurationHeading" Text="剧集与售卖" />
                            <UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="10">
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="内容类型" />
                                    <ComboBox x:Name="ContentTypeBox" Classes="configurationInput" AutomationProperties.Name="内容类型" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="漫剧制作方式" />
                                    <ComboBox x:Name="ComicMethodBox" Classes="configurationInput" AutomationProperties.Name="漫剧制作方式" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="作者声明" />
                                    <ComboBox x:Name="AuthorDeclarationBox" Classes="configurationInput" AutomationProperties.Name="作者声明" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="制作形式" />
                                    <ComboBox x:Name="ProductionFormBox" Classes="configurationInput" AutomationProperties.Name="制作形式" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="出品年份" />
                                    <TextBox x:Name="ProductionYearBox" Classes="configurationInput" AutomationProperties.Name="出品年份" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="制作成本（万元）" />
                                    <TextBox x:Name="ProductionCostBox" Classes="configurationInput" AutomationProperties.Name="制作成本（万元）" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="单集平均时长" />
                                    <TextBox x:Name="AverageDurationBox" Classes="configurationInput" AutomationProperties.Name="单集平均时长" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="版权证明类型" />
                                    <ComboBox x:Name="CopyrightProofTypeBox" Classes="configurationInput" AutomationProperties.Name="版权证明类型" />
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="10">
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="售卖类型" />
                                    <ComboBox x:Name="SaleTypeBox" Classes="configurationInput" AutomationProperties.Name="售卖类型" SelectionChanged="SaleTypeBox_SelectionChanged" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="免费集数" />
                                    <TextBox x:Name="FreeEpisodeCountBox" Classes="configurationInput" AutomationProperties.Name="免费集数" Watermark="例如 3" />
                                </StackPanel>
                                <StackPanel Spacing="5" x:Name="UnlockCountField">
                                    <TextBlock Classes="configurationLabel" Text="广告解锁集数" />
                                    <TextBox x:Name="UnlockEpisodeCountBox" Classes="configurationInput" AutomationProperties.Name="广告解锁集数" Watermark="1 至 8" />
                                </StackPanel>
                                <StackPanel Spacing="5" x:Name="EpisodePriceField">
                                    <TextBlock Classes="configurationLabel" Text="单集价格（元）" />
                                    <TextBox x:Name="EpisodePriceBox" Classes="configurationInput" AutomationProperties.Name="单集价格（元）" Watermark="例如 0.11" />
                                </StackPanel>
                                <StackPanel Spacing="5" x:Name="SeriesPriceField">
                                    <TextBlock Classes="configurationLabel" Text="整剧价格（元）" />
                                    <TextBox x:Name="SeriesPriceBox" Classes="configurationInput" AutomationProperties.Name="整剧价格（元）" Watermark="例如 1.00" />
                                </StackPanel>
                            </UniformGrid>
                            <Border Height="1" Background="#E4E9F0" Margin="0,4" />

                            <TextBlock Classes="configurationHeading" Text="播出与人员" />
                            <UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="10">
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="播出平台" />
                                    <TextBox x:Name="BroadcastPlatformBox" Classes="configurationInput" AutomationProperties.Name="播出平台" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="播出途径" />
                                    <ComboBox x:Name="BroadcastChannelBox" Classes="configurationInput" AutomationProperties.Name="播出途径" />
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="10">
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="播出时间模式" />
                                    <ComboBox x:Name="BroadcastTimeModeBox" Classes="configurationInput" AutomationProperties.Name="播出时间模式" SelectionChanged="BroadcastTimeModeBox_SelectionChanged" />
                                </StackPanel>
                                <StackPanel Spacing="5" x:Name="BroadcastDateField">
                                    <TextBlock Classes="configurationLabel" Text="播出日期" />
                                    <TextBox x:Name="BroadcastDateBox" Classes="configurationInput" AutomationProperties.Name="播出日期" Watermark="yyyy-MM-dd" />
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="10">
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="用户名" />
                                    <TextBox x:Name="UsernameBox" Classes="configurationInput" AutomationProperties.Name="用户名" Watermark="用于人员署名和承诺函" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="性别" />
                                    <ComboBox x:Name="GenderBox" Classes="configurationInput" AutomationProperties.Name="性别" />
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Spacing="5">
                                <TextBlock Classes="configurationLabel" Text="演员库" />
                                <TextBox x:Name="ActorLibraryBox" Classes="configurationInput" AutomationProperties.Name="演员库" AcceptsReturn="True" MinHeight="108" TextWrapping="Wrap" Watermark="格式：姓名|性别|角色1,角色2&#10;例如：沈清秋|女|许初夏,林晚意" />
                            </StackPanel>
                            <Border Height="1" Background="#E4E9F0" Margin="0,4" />

                            <TextBlock Classes="configurationHeading" Text="承诺函与工程图" />
                            <StackPanel Spacing="5">
                                <TextBlock Classes="configurationLabel" Text="固定承诺函 PDF" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox x:Name="CommitmentPdfBox" Classes="configurationInput" AutomationProperties.Name="固定承诺函 PDF" Watermark="项目没有承诺函 PDF 时，使用此账号的固定 PDF" />
                                    <Button Grid.Column="1" Content="选择" Click="PickCommitmentPdf_Click" AutomationProperties.Name="选择固定承诺函 PDF" VerticalAlignment="Stretch" />
                                </Grid>
                            </StackPanel>
                            <UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="10">
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="制作机构" />
                                    <TextBox x:Name="CommitmentRecipientBox" Classes="configurationInput" AutomationProperties.Name="制作机构" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="configurationLabel" Text="分账工程图模板" />
                                    <ComboBox x:Name="PersonalTemplateBox" Classes="configurationInput" AutomationProperties.Name="分账工程图模板" />
                                </StackPanel>
                            </UniformGrid>
                            <Border Height="1" Background="#E4E9F0" Margin="0,4" />

                            <TextBlock Classes="configurationHeading" Text="剧名与合规" />
                            <Expander Header="内容合规词库" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="下方展示当前完整有效词库，可直接增加、修改或删除词语。每行格式：分类：词1、词2。保存后会写进生成新剧名、短标题和简介的提示词，由 AI 生成时直接避开；生成后若仍命中会自动重写，上传时不再拦截。软件升级新增的系统词会自动合并。"
                                               TextWrapping="Wrap" Foreground="#64748B" />
                                    <TextBlock Text="快手新剧名敏感词（普通上传、分账个人版、分账企业版）" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TitlePolicySummary" Foreground="#64748B" />
                                    <TextBox Classes="configurationInput" x:Name="TitlePolicyBox" AcceptsReturn="True" MinHeight="140" TextWrapping="Wrap" />
                                    <TextBlock Text="快手简介敏感词（普通上传、分账个人版、分账企业版）" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SynopsisTermsSummary" Foreground="#64748B" />
                                    <TextBox Classes="configurationInput" x:Name="SynopsisTermsBox" AcceptsReturn="True" MinHeight="140" TextWrapping="Wrap" />
                                    <TextBlock Text="快手简介语义概念组（用于识别同义词和跨句组合）" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ConceptGroupsSummary" Foreground="#64748B" />
                                    <TextBox Classes="configurationInput" x:Name="ConceptGroupsBox" AcceptsReturn="True" MinHeight="120" TextWrapping="Wrap" />
                                    <TextBlock Text="快手简介组合语义规则" FontWeight="SemiBold" />
                                    <TextBlock Text="每行格式：风险分类：概念组1+概念组2；删除整行即可停用该组合。" Foreground="#64748B" TextWrapping="Wrap" />
                                    <TextBox Classes="configurationInput" x:Name="CombinationRulesBox" AcceptsReturn="True" MinHeight="100" TextWrapping="Wrap" />
                                    <Button Content="恢复系统默认词库" Click="RestoreContentPolicy_Click" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Expander>
                            <Border Height="1" Background="#E4E9F0" Margin="0,4" />
                            <views:KuaishouAccountAiEditor x:Name="AiEditor" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="剧集上架">
                <ScrollViewer>
                    <StackPanel Margin="16" Spacing="18">
                        <StackPanel Spacing="8">
                            <TextBlock Text="审核通过后自动上架" FontWeight="SemiBold" />
                            <CheckBox x:Name="AutoOnlineBox" Content="提交审核后登记待上架队列" />
                            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12" IsVisible="{Binding #AutoOnlineBox.IsChecked}">
                                <TextBlock Text="检查间隔（分钟）" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" x:Name="AutoOnlineIntervalBox" />
                                <TextBlock Grid.Row="1" Text="每轮最多处理" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="AutoOnlineMaxItemsBox" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="定时恢复已下架短剧" FontWeight="SemiBold" />
                            <CheckBox x:Name="ScheduledShelfBox" Content="定时扫描并恢复可上架短剧" />
                            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" IsVisible="{Binding #ScheduledShelfBox.IsChecked}" RowSpacing="10" ColumnSpacing="12">
                                <TextBlock Text="上架方式" VerticalAlignment="Center" />
                                <ComboBox x:Name="ScheduledShelfModeBox" Grid.Column="1" SelectionChanged="ScheduledShelfModeBox_SelectionChanged" />
                                <TextBlock x:Name="ScheduledShelfIntervalLabel" Grid.Row="1" Text="检查间隔(小时)" VerticalAlignment="Center" />
                                <TextBox x:Name="ScheduledShelfIntervalBox" Grid.Row="1" Grid.Column="1" Watermark="1 到 24，例如 1 表示每小时" />
                                <TextBlock x:Name="ScheduledShelfDailyLabel" Grid.Row="2" Text="每天时刻" VerticalAlignment="Center" />
                                <TextBox x:Name="ScheduledShelfDailyBox" Grid.Row="2" Grid.Column="1" Watermark="例如 10:00" />
                                <TextBlock Grid.Row="3" Text="上传中跳过" VerticalAlignment="Center" />
                                <CheckBox x:Name="ScheduledShelfOnlyWhenIdleBox" Grid.Row="3" Grid.Column="1" Content="该账号正在上传时跳过本轮，上传结束后再检查" />
                                <TextBlock Grid.Row="4" Text="每轮最多上架" VerticalAlignment="Center" />
                                <TextBox x:Name="ScheduledShelfMaxBox" Grid.Row="4" Grid.Column="1" Watermark="例如 50" />
                                <TextBlock Grid.Row="5" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="#64748B"
                                           Text="固定间隔在开启后的下一次检查先跑一轮，之后按间隔计算。每天固定时间过了今天的时刻且今天还没跑过，会补跑一次。登录失效时本轮停止，并记入日志。" />
                            </Grid>
                        </StackPanel>

                        <Expander Header="兼容接口设置" HorizontalContentAlignment="Stretch" x:Name="LegacyOnlineOptions">
                            <StackPanel Spacing="10">
                                <TextBlock Text="页面上传模式下，提交后的自动上架队列使用这些接口设置。" Foreground="#64748B" TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                    <TextBlock Text="API Base URL" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" x:Name="ApiBaseUrlBox" />
                                    <TextBlock Grid.Row="1" Text="Access Token" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="AccessTokenBox" PasswordChar="●" />
                                    <TextBlock Grid.Row="2" Text="Token Header" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TokenHeaderBox" />
                                    <TextBlock Grid.Row="3" Text="短剧基本信息查询路径" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="SeriesBaseInfoPathBox" />
                                    <TextBlock Grid.Row="4" Text="上下架接口路径" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="OnlineOfflinePathBox" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="StandaloneDedupTab" Header="视频去重">
                <ContentControl x:Name="StandaloneDedupHost" />
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="12,10"
                IsVisible="{Binding !IsSelected, ElementName=StandaloneDedupTab}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <Button Content="导入配置">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="导入微信工具配置" Click="ImportExportedSettings_Click" />
                            <MenuItem Header="导入旧版配置" Click="ImportLegacy_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <TextBlock Grid.Column="1" x:Name="ValidationText" Foreground="#DC2626" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="2" Content="放弃修改" Click="Cancel_Click" />
                <Button Grid.Column="3" Classes="primaryAction" Content="保存配置" Click="Save_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
