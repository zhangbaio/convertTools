<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:TikTokPublisher.Ui.Views"
             x:Class="PlatformPublisher.Desktop.Views.KuaishouVideoDedupView">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8" Margin="10,8,10,8">
        <TextBlock x:Name="AccountSummary" TextWrapping="Wrap" Classes="pageSummary" />
        <views:VideoDedupPresetEditor x:Name="PresetEditor" Grid.Row="1" />
        <Border Grid.Row="2" Classes="controlsFrame" Padding="10,8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock x:Name="FeedbackText" Classes="pageSummary" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button x:Name="SaveButton" Grid.Column="1" Content="保存去重配置" Classes="primaryAction" Click="Save_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
