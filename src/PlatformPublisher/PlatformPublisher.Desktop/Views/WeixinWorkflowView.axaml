<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatformPublisher.Desktop.ViewModels"
             x:Class="PlatformPublisher.Desktop.Views.WeixinWorkflowView"
             x:DataType="vm:MainWindowViewModel"
             Background="#F3F6FA">
    <UserControl.Styles>
        <Style Selector="UserControl.kuaishouQueue Button.compactAction">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Border.kuaishouButtonGroup">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.contentAction">
            <Setter Property="Background" Value="#EAF4FF" />
            <Setter Property="Foreground" Value="#0F63C7" />
            <Setter Property="BorderBrush" Value="#9CCBFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.contentAction:pointerover">
            <Setter Property="Background" Value="#DCEBFF" />
        </Style>
        <Style Selector="Button.selectionAction">
            <Setter Property="Background" Value="#F2F5FF" />
            <Setter Property="Foreground" Value="#3730A3" />
            <Setter Property="BorderBrush" Value="#C7D2FE" />
        </Style>
        <Style Selector="Button.selectionAction:pointerover">
            <Setter Property="Background" Value="#E7ECFF" />
        </Style>
        <Style Selector="Button.repairAction">
            <Setter Property="Background" Value="#FFF7E6" />
            <Setter Property="Foreground" Value="#B45309" />
            <Setter Property="BorderBrush" Value="#FBBF24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.repairAction:pointerover">
            <Setter Property="Background" Value="#FFEFC2" />
        </Style>
        <Style Selector="Button.fileAction">
            <Setter Property="Background" Value="#EAF8F0" />
            <Setter Property="Foreground" Value="#047857" />
            <Setter Property="BorderBrush" Value="#86D9A8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.fileAction:pointerover">
            <Setter Property="Background" Value="#DDFBEA" />
        </Style>
        <Style Selector="Button.browserAction">
            <Setter Property="Background" Value="#EEF6FF" />
            <Setter Property="Foreground" Value="#0B5CAD" />
            <Setter Property="BorderBrush" Value="#B8D8FF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.browserAction:pointerover">
            <Setter Property="Background" Value="#DCEBFF" />
        </Style>
        <Style Selector="Button.toolAction">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#0F4F86" />
            <Setter Property="BorderBrush" Value="#BFD3E8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.toolAction:pointerover">
            <Setter Property="Background" Value="#E6EEF8" />
        </Style>
        <Style Selector="Button.logAction">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
        </Style>
        <Style Selector="Button.logAction:pointerover">
            <Setter Property="Background" Value="#EEF2F6" />
        </Style>
        <Style Selector="Button.neutralAction">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
        </Style>
        <Style Selector="Button.neutralAction:pointerover">
            <Setter Property="Background" Value="#EEF2F6" />
        </Style>
        <Style Selector="Button.dangerSoftAction">
            <Setter Property="Background" Value="#FFE3E3" />
            <Setter Property="Foreground" Value="#B42318" />
            <Setter Property="BorderBrush" Value="#F97066" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.dangerSoftAction:pointerover">
            <Setter Property="Background" Value="#FFD4D4" />
        </Style>
        <Style Selector="Button.stopAction">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DC2626" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.stopAction:pointerover">
            <Setter Property="Background" Value="#B91C1C" />
            <Setter Property="BorderBrush" Value="#B91C1C" />
        </Style>
        <Style Selector="Button.queueLink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.queueLink:pointerover">
            <Setter Property="Background" Value="#EAF4FF" />
        </Style>
        <Style Selector="Button.queueLink:pressed">
            <Setter Property="Background" Value="#DCEBFF" />
        </Style>
        <Style Selector="TextBlock.kuaishouTableHeader">
            <Setter Property="Foreground" Value="#23364D" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="4,10" />
            <Setter Property="Background" Value="#EDF3F9" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.kuaishouStepHeader">
            <Setter Property="Background" Value="#E5F1FF" />
            <Setter Property="Foreground" Value="#0F4F86" />
        </Style>
        <Style Selector="Border.queueTableRow">
            <Setter Property="BorderBrush" Value="#DCE7F3" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#KuaishouQueueList">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
        <Style Selector="ListBox#KuaishouQueueList ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="#23364D" />
        </Style>
        <Style Selector="ListBox#KuaishouQueueList ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#EAF4FF" />
            <Setter Property="Foreground" Value="#23364D" />
        </Style>
        <Style Selector="ListBox#KuaishouQueueList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#DDEEFF" />
            <Setter Property="Foreground" Value="#23364D" />
        </Style>
        <Style Selector="ListBox#KuaishouQueueList ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#DDEEFF" />
            <Setter Property="Foreground" Value="#23364D" />
        </Style>
        <Style Selector="ListBox#KuaishouQueueList ListBoxItem:selected:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="#DDEEFF" />
            <Setter Property="Foreground" Value="#23364D" />
        </Style>
        <Style Selector="ListBox#KuaishouQueueList ListBoxItem CheckBox">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.kuaishouStepFrame">
            <Setter Property="Background" Value="#F8FBFF" />
            <Setter Property="BorderBrush" Value="#CFE2F6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style Selector="Border.stepStatusBadge">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.stepStatusText">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,Auto,*,30" RowSpacing="8">
        <Border x:Name="KuaishouChrome" Grid.Row="0" Grid.RowSpan="3" Classes="panel" Padding="8" IsVisible="False">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="工作目录" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBox Grid.Column="1" Text="{Binding DraftProjectDirectory}" Watermark="选择快手分账工作目录" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Button Content="选择工作目录" Click="OnPickProjectDirectoryClick" Classes="secondaryAction compactAction" />
                        <Button Content="重置" Command="{Binding ResetSelectedJobCommand}" Classes="secondaryAction compactAction" />
                    </StackPanel>
                </Grid>
                <WrapPanel Orientation="Horizontal">
                    <Border Classes="kuaishouButtonGroup" Background="#F8FBFF" BorderBrush="#D6E8FA">
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="扫描目录" Command="{Binding ScanWorkspaceCommand}" Classes="neutralAction compactAction" Margin="0,0,6,0"
                                    ToolTip.Tip="扫描所选目录下的短剧项目并加入剧集任务队列" />
                            <Button x:Name="KuaishouUploadDramasButton" Content="上传短剧" Click="OnUploadDramasClick" Classes="contentAction compactAction" Margin="0,0,6,0" />
                            <Button Content="导入本地短剧" Click="OnImportLocalProjectsClick" Classes="contentAction compactAction" Margin="0,0,6,0"
                                    ToolTip.Tip="扫描工作目录里已有视频的短剧，生成项目信息后加入列表。本地导入会跳过下载。" />
                            <Button Content="加入任务" Command="{Binding AddJobCommand}" Classes="contentAction compactAction" />
                        </WrapPanel>
                    </Border>
                    <Border Classes="kuaishouButtonGroup" Background="#F3F8FF" BorderBrush="#B9D7F5">
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="执行勾选队列" Command="{Binding RunCheckedCommand}" Classes="primaryAction compactAction" Margin="0,0,6,0" />
                            <Button Content="执行选中" Command="{Binding RunSelectedCommand}" Classes="primaryAction compactAction" Margin="0,0,6,0" />
                            <Button Content="执行全部待办" Command="{Binding RunRunnableCommand}" Classes="primaryAction compactAction" Margin="0,0,6,0" />
                            <Button Content="执行勾选步骤" Command="{Binding RunSharedPipelineCommand}" Classes="primaryAction compactAction" Margin="0,0,6,0"
                                    ToolTip.Tip="对勾选的项目执行步骤区已勾选的步骤。已完成的步骤会跳过，除非勾选强制重跑。" />
                            <Button Content="重试失败" Command="{Binding RetryFailedCommand}" Classes="repairAction compactAction" Margin="0,0,6,0" />
                            <Button Content="停止" Command="{Binding StopCommand}" Classes="stopAction compactAction" />
                        </WrapPanel>
                    </Border>
                    <Border Classes="kuaishouButtonGroup" Background="#F7F8FF" BorderBrush="#D9DEF8">
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="勾选待执行" Command="{Binding CheckPendingCommand}" Classes="selectionAction compactAction" Margin="0,0,6,0" />
                            <Button Content="勾选到当前项目" Command="{Binding CheckToCurrentCommand}" Classes="selectionAction compactAction" Margin="0,0,6,0" />
                            <Button Content="全选" Command="{Binding CheckAllVisibleCommand}" Classes="selectionAction compactAction" Margin="0,0,6,0" />
                            <Button Content="全选已完成" Command="{Binding CheckCompletedCommand}" Classes="selectionAction compactAction" Margin="0,0,6,0" />
                            <Button Content="取消" Command="{Binding UncheckAllVisibleCommand}" Classes="selectionAction compactAction" Margin="0,0,6,0" />
                            <Button Content="删除勾选" Command="{Binding RemoveCheckedJobsCommand}" Classes="dangerSoftAction compactAction"
                                    ToolTip.Tip="只从任务队列删除，保留项目目录和文件" />
                        </WrapPanel>
                    </Border>
                    <Border Classes="kuaishouButtonGroup" Background="#FFF9EE" BorderBrush="#F3D7A1">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="自动上架" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B45309" />
                            <NumericUpDown Width="60" Value="{Binding AutoShelfMaxPages}" Minimum="1" Maximum="100" Margin="0,0,4,0" />
                            <TextBlock Text="页" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <NumericUpDown Width="60" Value="{Binding AutoShelfMaxRounds}" Minimum="1" Maximum="100" Margin="0,0,4,0" />
                            <TextBlock Text="轮" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Content="开始" Command="{Binding AutoShelfCommand}" Classes="repairAction compactAction" Margin="0,0,8,0" />
                            <Button Content="重置当前任务" Command="{Binding ResetSelectedJobCommand}" Classes="repairAction compactAction" Margin="0,0,6,0" />
                            <Button Content="批量重置" Command="{Binding ResetCheckedJobsCommand}" Classes="repairAction compactAction" />
                        </WrapPanel>
                    </Border>
                    <Border Classes="kuaishouButtonGroup" Background="#FFF5F5" BorderBrush="#F3C7C3">
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="归档勾选" Click="OnArchiveCheckedClick" Classes="dangerSoftAction compactAction" Margin="0,0,6,0"
                                    ToolTip.Tip="按快手分账规则归档勾选项目：移动 source/workflow，并删除原视频、转码视频和素材视频。" />
                            <Button Content="已归档项目" Click="OnOpenArchiveClick" Classes="dangerSoftAction compactAction" />
                        </WrapPanel>
                    </Border>
                    <Border Classes="kuaishouButtonGroup" Background="#F3FBF6" BorderBrush="#C6E8D4">
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="导出上传记录" Click="OnExportUploadReportClick" Classes="fileAction compactAction" Margin="0,0,6,0"
                                    ToolTip.Tip="把快手分账上传记录导出到本软件数据目录中的 Excel。个人版和企业版分开保存。" />
                            <Button Content="查看上传记录" Click="OnOpenUploadReportClick" Classes="fileAction compactAction"
                                    ToolTip.Tip="打开当前版本的上传记录 Excel。文件被占用时会另存为 pending 副本。" />
                        </WrapPanel>
                    </Border>
                    <Border Classes="kuaishouButtonGroup" Background="#F7FAFC" BorderBrush="#D5E2EE">
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="查看日志" Click="OnViewKuaishouLogsClick" Classes="logAction compactAction" Margin="0,0,6,0" />
                            <Button Content="快手分账配置" Click="OnKuaishouConfigClick" Classes="toolAction compactAction" Margin="0,0,6,0" />
                            <Button Content="经营者管理平台" Command="{Binding OpenLoginCommand}" Classes="browserAction compactAction" Margin="0,0,6,0" />
                            <Button Content="同步管理系统" Command="{Binding SyncCheckedManagementCommand}" Classes="repairAction compactAction" Margin="0,0,6,0" />
                            <Button Content="保存设置" Command="{Binding SaveWorkflowSettingsCommand}" Classes="toolAction compactAction" />
                        </WrapPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" IsVisible="False">
                        <NumericUpDown x:Name="KuaishouAdxCount" Width="58" Minimum="1" Maximum="20" Value="8" />
                        <Button Content="下载ADX素材" Click="OnKuaishouAdxDownloadClick" />
                        <Button Content="发布ADX素材" Click="OnKuaishouAdxPublishClick" />
                    </StackPanel>
                </WrapPanel>
                <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="搜索" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBox Grid.Column="1" Text="{Binding WorkflowFilterText}" Watermark="搜索原剧名 / 新剧名 / 账号 / 状态 / 问题" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="每页" VerticalAlignment="Center" Foreground="#64748B" />
                        <NumericUpDown Width="64" Value="{Binding WorkflowPageSize}" Minimum="5" Maximum="200" Increment="5" />
                        <Button Content="‹" Command="{Binding PreviousWorkflowPageCommand}" Classes="secondaryAction compactAction" />
                        <TextBlock Text="{Binding WorkflowPageSummary}" VerticalAlignment="Center" Foreground="#64748B" />
                        <Button Content="›" Command="{Binding NextWorkflowPageCommand}" Classes="secondaryAction compactAction" />
                    </StackPanel>
                </Grid>
                <Border Classes="kuaishouStepFrame">
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="本地" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,2" />
                        <CheckBox Content="下载" IsChecked="{Binding PipelineDownloadEnabled}" Margin="0,0,12,2" />
                        <CheckBox Content="改写信息" IsChecked="{Binding PipelineRewriteEnabled}" Margin="0,0,12,2" />
                        <CheckBox Content="生成海报" IsChecked="{Binding PipelinePosterEnabled}" Margin="0,0,12,2" />
                        <CheckBox Content="生成工程图" IsChecked="{Binding PipelineProjectImageEnabled}" Margin="0,0,12,2" />
                        <CheckBox Content="补齐字段" IsChecked="{Binding PipelineAutoFillEnabled}" Margin="0,0,16,2" />
                        <TextBlock Text="浏览器" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,2" />
                        <CheckBox Content="上传剧集" IsChecked="{Binding PipelineUploadEpisodesEnabled}" Margin="0,0,12,2" />
                        <CheckBox Content="强制重跑已完成步骤" IsChecked="{Binding PipelineForceRerun}" Margin="0,0,12,2" />
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>
        <Border x:Name="WeixinChrome" Grid.Row="0" Grid.RowSpan="3" IsVisible="True">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
        <Border Grid.Row="0" Classes="panel" Padding="10">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                <Grid ColumnDefinitions="78,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="工作目录" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBox Grid.Column="1" Text="{Binding DraftProjectDirectory}"
                             Watermark="选择工作根目录、剧集项目或素材目录" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Button Content="选择工作目录" Click="OnPickProjectDirectoryClick" Classes="secondaryAction compactAction" />
                        <Button Content="重置" Command="{Binding ResetSelectedJobCommand}" Classes="secondaryAction compactAction" />
                        <Button x:Name="KuaishouConfigButton" Content="快手分账配置" Click="OnKuaishouConfigClick"
                                Classes="secondaryAction compactAction" IsVisible="False" />
                    </StackPanel>
                </Grid>

                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBlock x:Name="TaskTypeLabel" Text="任务类型" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0" />
                    <Border x:Name="TaskTypeSummary" Background="#EEF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="剧集上传" FontWeight="SemiBold" Foreground="#0B74D1" />
                            <TextBlock Text="使用项目内剧集配置创建并上传分集" Foreground="#64748B" />
                        </StackPanel>
                    </Border>
                    <Button Content="扫描目录" Command="{Binding ScanWorkspaceCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,0"
                            ToolTip.Tip="扫描所选目录下的短剧项目并加入剧集任务队列" />
                    <Button x:Name="UploadDramasButton" Content="上传短剧" Click="OnUploadDramasClick" Classes="primaryAction compactAction" Margin="0,0,6,0"
                             ToolTip.Tip="按剧名精确搜索，创建项目并加入执行队列" />
                    <TextBlock Text="ADX素材数" VerticalAlignment="Center" Margin="2,0,4,0" IsVisible="False" />
                    <NumericUpDown Width="58" Minimum="1" Maximum="20" Value="8" Margin="0,0,6,0" IsVisible="False" />
                    <Button x:Name="KuaishouAdxDownloadButton" Content="下载ADX素材" Click="OnKuaishouAdxDownloadClick"
                            Classes="secondaryAction compactAction" Margin="0,0,6,0" IsVisible="False" />
                    <Button x:Name="KuaishouAdxPublishButton" Content="发布ADX素材" Click="OnKuaishouAdxPublishClick"
                            Classes="primaryAction compactAction" Margin="0,0,6,0" IsVisible="False" />
                    <Button Content="加入任务" Command="{Binding AddJobCommand}" Classes="primaryAction compactAction" Margin="0,0,6,0" />
                    <Button Content="导入本地项目" Click="OnImportLocalProjectsClick" Classes="secondaryAction compactAction" Margin="0,0,6,0" />
                    <TextBox x:Name="CreateProjectNameBox" Width="220" Text="{Binding DraftNewProjectName}" Watermark="按剧名创建项目" Margin="0,0,6,0" />
                    <Button x:Name="CreateProjectButton" Content="创建并入队" Command="{Binding CreateNamedProjectCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,0" />
                    <Button x:Name="OpenLoginButton" Content="登录 / 打开浏览器" Command="{Binding OpenLoginCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,0" />
                    <Button Content="执行勾选队列" Command="{Binding RunCheckedCommand}" Classes="primaryAction compactAction" Margin="0,0,6,0" />
                    <Button Content="重试失败" Command="{Binding RetryFailedCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,0" />
                    <Button Content="停止" Command="{Binding StopCommand}" Classes="dangerAction compactAction" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding ActiveWeixinAccountName}" VerticalAlignment="Center"
                               Foreground="#0B74D1" FontWeight="SemiBold" Margin="0,0,6,0" />
                    <Button Content="刷新账号" Click="OnRefreshAccountClick" Classes="secondaryAction compactAction" />
                </WrapPanel>

                <TextBlock Grid.Row="2"
                           Text="{Binding DramaSourceStatusText}"
                           Foreground="#B45309"
                           FontSize="12"
                           TextWrapping="Wrap" />

            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="panel" Padding="10">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="启用步骤" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="执行勾选步骤" Command="{Binding RunSharedPipelineCommand}" Classes="primaryAction compactAction" />
                    <Button Grid.Column="2" Content="保存设置" Command="{Binding SaveWorkflowSettingsCommand}" Classes="secondaryAction compactAction" />
                </Grid>
                <WrapPanel Grid.Row="1">
                    <CheckBox Content="下载剧集" IsChecked="{Binding PipelineDownloadEnabled}" Margin="0,0,14,3" />
                    <CheckBox x:Name="SmartRecutStep" Content="智能重剪" IsChecked="{Binding PipelineSmartRecutEnabled}" Margin="0,0,14,3" />
                    <CheckBox Content="改写信息" IsChecked="{Binding PipelineRewriteEnabled}" Margin="0,0,14,3" />
                    <CheckBox Content="生成海报" IsChecked="{Binding PipelinePosterEnabled}" Margin="0,0,14,3" />
                    <CheckBox x:Name="TranscodeStep" Content="素材转码" IsChecked="{Binding PipelineTranscodeEnabled}" Margin="0,0,14,3" />
                    <CheckBox x:Name="AutoRepairStep" Content="一键修复" IsChecked="{Binding PipelineAutoRepairEnabled}" Margin="0,0,14,3" />
                    <CheckBox Content="补齐字段" IsChecked="{Binding PipelineAutoFillEnabled}" Margin="0,0,14,3" />
                    <CheckBox x:Name="CostReportStep" Content="成本报表" IsChecked="{Binding PipelineCostReportEnabled}" Margin="0,0,14,3" />
                    <CheckBox Content="工程图" IsChecked="{Binding PipelineProjectImageEnabled}" Margin="0,0,14,3" />
                    <CheckBox x:Name="AiProofStep" Content="AI制作证明" IsChecked="{Binding PipelineGenerateAiProofEnabled}" Margin="0,0,14,3" />
                    <CheckBox x:Name="TimestampStep" Content="可信时间戳" IsChecked="{Binding PipelineGenerateTimestampCertificateEnabled}" Margin="0,0,14,3"
                              ToolTip.Tip="本地模板，非 TSA 认证" />
                    <CheckBox x:Name="MaterialValidateStep" Content="素材校验" IsChecked="{Binding PipelineMaterialValidateEnabled}" Margin="0,0,14,3" />
                    <CheckBox x:Name="RemuxStep" Content="无损重封装" IsChecked="{Binding PipelineRemuxEnabled}" Margin="0,0,14,3" />
                </WrapPanel>
                <WrapPanel Grid.Row="2">
                    <TextBlock Text="执行策略" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,14,3" />
                    <CheckBox Content="强制重跑" IsChecked="{Binding PipelineForceRerun}" Margin="0,0,14,3" />
                    <CheckBox Content="上传后自动归档" IsChecked="{Binding PipelineAutoArchiveAfterUpload}" Margin="0,0,14,3" />
                    <CheckBox Content="有待上传项目时优先上传" IsChecked="{Binding PipelinePreferUploadWhenReady}" Margin="0,0,14,3" />
                    <CheckBox Content="上传成功后同步管理系统" IsChecked="{Binding PipelineSyncManagementAfterUpload}" Margin="0,0,14,3" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Classes="panel" Padding="9">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                <Grid ColumnDefinitions="58,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="搜索" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBox Grid.Column="1" Text="{Binding WorkflowFilterText}" Watermark="搜索原剧名 / 新剧名 / 账号 / 状态 / 问题" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Button Content="勾选待执行" Command="{Binding CheckPendingCommand}" Classes="secondaryAction compactAction" />
                        <Button Content="勾选到当前项目" Command="{Binding CheckToCurrentCommand}" Classes="secondaryAction compactAction" />
                        <Button Content="全选已完成" Command="{Binding CheckCompletedCommand}" Classes="secondaryAction compactAction" />
                        <Button Content="全选筛选结果" Command="{Binding CheckAllVisibleCommand}" Classes="secondaryAction compactAction" />
                        <Button Content="取消筛选结果" Command="{Binding UncheckAllVisibleCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,0" />
                        <Button Content="删除勾选项目" Command="{Binding RemoveCheckedJobsCommand}" Classes="dangerAction compactAction"
                                ToolTip.Tip="只从任务队列删除，保留项目目录和文件" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <WrapPanel>
                        <Button Content="执行选中" Command="{Binding RunSelectedCommand}" Classes="primaryAction compactAction" Margin="0,0,6,0" />
                        <Button Content="执行全部待办" Command="{Binding RunRunnableCommand}" Classes="primaryAction compactAction" Margin="0,0,6,0" />
                        <Button Content="执行勾选队列" Command="{Binding RunCheckedCommand}" Classes="primaryAction compactAction" Margin="0,0,6,0" />
                        <Button Content="重试失败" Command="{Binding RetryFailedCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,0" />
                        <TextBlock Text="自动上架" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,0,6,0" />
                        <TextBlock Text="页" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,4,0" />
                        <NumericUpDown Width="60" Value="{Binding AutoShelfMaxPages}" Minimum="1" Maximum="100" Margin="0,0,6,0" />
                        <TextBlock Text="轮" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,4,0" />
                        <NumericUpDown Width="60" Value="{Binding AutoShelfMaxRounds}" Minimum="1" Maximum="100" Margin="0,0,6,0" />
                        <Button Content="开始" Command="{Binding AutoShelfCommand}" Classes="secondaryAction compactAction" />
                    </WrapPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="每页" VerticalAlignment="Center" Foreground="#64748B" />
                        <NumericUpDown Width="64" Value="{Binding WorkflowPageSize}" Minimum="5" Maximum="200" Increment="5" />
                        <Button Content="‹" Command="{Binding PreviousWorkflowPageCommand}" Classes="secondaryAction compactAction" />
                        <TextBlock Text="{Binding WorkflowPageSummary}" VerticalAlignment="Center" Foreground="#64748B" />
                        <Button Content="›" Command="{Binding NextWorkflowPageCommand}" Classes="secondaryAction compactAction" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="{Binding SelectedPlatformCapability}" Foreground="#0B74D1" FontWeight="SemiBold" />
                        <Run Text="  |  " Foreground="#94A3B8" />
                        <Run Text="{Binding QueueSummary}" Foreground="#475569" />
                    </TextBlock>
                    <Expander Grid.Column="1" Header="更多操作" IsExpanded="False">
                        <Border Classes="toolbarGroup" Margin="0,6,0,0" MinWidth="760">
                            <WrapPanel>
                                <Button Content="重置当前任务" Command="{Binding ResetSelectedJobCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,6" />
                                <Button Content="移出当前任务" Command="{Binding RemoveSelectedCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,6" />
                                <Button Content="批量重置" Command="{Binding ResetCheckedJobsCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,6" />
                                <ComboBox Width="105" ItemsSource="{Binding JobStatusChoices}" SelectedItem="{Binding SelectedJobStatusChoice}" Margin="0,0,6,6">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PublishJobStatusOptionViewModel"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="修改状态" Command="{Binding ApplyCheckedStatusCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,6" />
                                <Button Content="归属当前账号" Command="{Binding AssignCheckedToCurrentAccountCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,6" />
                                <Button Content="同步管理系统" Command="{Binding SyncCheckedManagementCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,6" />
                                <Button Content="批量移出" Command="{Binding RemoveCheckedJobsCommand}" Classes="dangerAction compactAction" Margin="0,0,6,6" />
                            </WrapPanel>
                        </Border>
                    </Expander>
                </Grid>
            </Grid>
        </Border>
        </Grid>
        </Border>

        <Border Grid.Row="3" Classes="panel" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
                <Border Background="#F5F3FF" BorderBrush="#C4B5FD" BorderThickness="0,0,0,1" Padding="10"
                        IsVisible="{Binding HasInteractionRequest}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel>
                            <TextBlock Text="{Binding InteractionTitle}" FontWeight="Bold" Foreground="#6D28D9" />
                            <TextBlock Text="{Binding InteractionMessage}" Foreground="#4C1D95" TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1">
                            <Button Content="人工接管" Command="{Binding TakeoverInteractionCommand}" Margin="0,0,6,0" />
                            <Button Content="继续执行" Command="{Binding ResumeInteractionCommand}" Margin="0,0,6,0" />
                            <Button Content="跳过视频" Command="{Binding SkipCurrentVideoCommand}" Margin="0,0,6,0" />
                            <Button Content="跳过项目" Command="{Binding SkipCurrentProjectCommand}" Margin="0,0,6,0" />
                            <Button Content="停止任务" Command="{Binding StopInteractionCommand}" />
                        </WrapPanel>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid MinWidth="1480" RowDefinitions="Auto,*">
                        <Border x:Name="KuaishouQueueHeader" Background="#EDF3F9" BorderBrush="#DCE7F3" BorderThickness="0,0,0,1" Padding="0" IsVisible="False">
                            <Grid ColumnDefinitions="52,52,220,220,70,128,96,104,104,112,96,104,96">
                                <TextBlock Text="序号" Classes="kuaishouTableHeader" />
                                <TextBlock Grid.Column="1" Text="执行" Classes="kuaishouTableHeader" />
                                <TextBlock Grid.Column="2" Text="原剧名" Classes="kuaishouTableHeader" />
                                <TextBlock Grid.Column="3" Text="新剧名" Classes="kuaishouTableHeader" />
                                <TextBlock Grid.Column="4" Text="集数" Classes="kuaishouTableHeader" />
                                <TextBlock Grid.Column="5" Text="加入时间" Classes="kuaishouTableHeader" />
                                <TextBlock Grid.Column="6" Text="下载" Classes="kuaishouTableHeader kuaishouStepHeader" />
                                <TextBlock Grid.Column="7" Text="改写信息" Classes="kuaishouTableHeader kuaishouStepHeader" />
                                <TextBlock Grid.Column="8" Text="生成海报" Classes="kuaishouTableHeader kuaishouStepHeader" />
                                <TextBlock Grid.Column="9" Text="生成工程图" Classes="kuaishouTableHeader kuaishouStepHeader" />
                                <TextBlock Grid.Column="10" Text="补齐字段" Classes="kuaishouTableHeader kuaishouStepHeader" />
                                <TextBlock Grid.Column="11" Text="上传剧集" Classes="kuaishouTableHeader kuaishouStepHeader" />
                                <TextBlock Grid.Column="12" Text="状态" Classes="kuaishouTableHeader kuaishouStepHeader" />
                            </Grid>
                        </Border>
                        <ListBox x:Name="KuaishouQueueList" Grid.Row="1" ItemsSource="{Binding PagedJobs}" SelectedItem="{Binding SelectedJob}"
                                 Background="#FFFFFF" BorderThickness="0" IsVisible="False">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PublishJobRowViewModel">
                                    <Border Classes="queueTableRow" Height="42">
                                        <Grid ColumnDefinitions="52,52,220,220,70,128,96,104,104,112,96,104,96">
                                            <TextBlock Text="{Binding QueueIndex}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked}" />
                                            <Button Grid.Column="2" Classes="queueLink" Click="OnOpenSourceDirectoryClick" ToolTip.Tip="{Binding SourceDirectory}">
                                                <TextBlock Text="{Binding OriginalTitle}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{Binding DramaTitleBrush}" />
                                            </Button>
                                            <Button Grid.Column="3" Classes="queueLink" Click="OnOpenWorkflowDirectoryClick" ToolTip.Tip="{Binding WorkflowDirectory}">
                                                <TextBlock Text="{Binding NewTitle}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{Binding DramaTitleBrush}" />
                                            </Button>
                                            <TextBlock Grid.Column="4" Text="{Binding EpisodeCountText}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{Binding CreatedAtText}" VerticalAlignment="Center" Margin="6,0" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="6" Classes="stepStatusBadge" Background="{Binding DownloadStepBackgroundBrush}" BorderBrush="{Binding DownloadStepBorderBrush}" ToolTip.Tip="{Binding DownloadStepStatus}">
                                                <TextBlock Text="{Binding DownloadStepStatus}" Foreground="{Binding DownloadStepBrush}" Classes="stepStatusText" />
                                            </Border>
                                            <Border Grid.Column="7" Classes="stepStatusBadge" Background="{Binding RewriteStepBackgroundBrush}" BorderBrush="{Binding RewriteStepBorderBrush}" ToolTip.Tip="{Binding RewriteStepStatus}">
                                                <TextBlock Text="{Binding RewriteStepStatus}" Foreground="{Binding RewriteStepBrush}" Classes="stepStatusText" />
                                            </Border>
                                            <Border Grid.Column="8" Classes="stepStatusBadge" Background="{Binding PosterStepBackgroundBrush}" BorderBrush="{Binding PosterStepBorderBrush}" ToolTip.Tip="{Binding PosterStepStatus}">
                                                <TextBlock Text="{Binding PosterStepStatus}" Foreground="{Binding PosterStepBrush}" Classes="stepStatusText" />
                                            </Border>
                                            <Border Grid.Column="9" Classes="stepStatusBadge" Background="{Binding ProjectImageStepBackgroundBrush}" BorderBrush="{Binding ProjectImageStepBorderBrush}" ToolTip.Tip="{Binding ProjectImageStepStatus}">
                                                <TextBlock Text="{Binding ProjectImageStepStatus}" Foreground="{Binding ProjectImageStepBrush}" Classes="stepStatusText" />
                                            </Border>
                                            <Border Grid.Column="10" Classes="stepStatusBadge" Background="{Binding AutoFillStepBackgroundBrush}" BorderBrush="{Binding AutoFillStepBorderBrush}" ToolTip.Tip="{Binding AutoFillStepStatus}">
                                                <TextBlock Text="{Binding AutoFillStepStatus}" Foreground="{Binding AutoFillStepBrush}" Classes="stepStatusText" />
                                            </Border>
                                            <Border Grid.Column="11" Classes="stepStatusBadge" Background="{Binding UploadStepBackgroundBrush}" BorderBrush="{Binding UploadStepBorderBrush}" ToolTip.Tip="{Binding UploadStepStatus}">
                                                <TextBlock Text="{Binding UploadStepStatus}" Foreground="{Binding UploadStepBrush}" Classes="stepStatusText" />
                                            </Border>
                                            <Border Grid.Column="12" Classes="stepStatusBadge" Background="{Binding StatusBackgroundBrush}" BorderBrush="{Binding StatusBorderBrush}" ToolTip.Tip="{Binding StatusText}">
                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrushValue}" Classes="stepStatusText" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border x:Name="QueueHeader" Grid.Row="0" Background="#EDF3F9" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1" Padding="10,7">
                            <Grid ColumnDefinitions="44,110,210,210,90,60,100,64,72,64,64,64,64,64,64,80,80,64,72,64,64,64,90,240" ColumnSpacing="8">
                                <TextBlock Text="勾选" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="账号" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="原剧名" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="新剧名" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="来源" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="5" Text="集数" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="6" Text="加入时间" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="7" Text="下载" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="8" Text="智能重剪" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="9" Text="改写" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="10" Text="海报" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="11" Text="转码" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="12" Text="修复" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="13" Text="补齐" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="14" Text="报表" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="15" Text="工程图" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="16" Text="AI证明" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="17" Text="时间戳" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="18" Text="校验" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="19" Text="上传" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="20" Text="上架" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="21" Text="管理同步" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="22" Text="状态" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="23" Text="当前信息" FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                        <ListBox x:Name="WeixinQueueList" Grid.Row="1" ItemsSource="{Binding PagedJobs}" SelectedItem="{Binding SelectedJob}"
                                 Background="#FFFFFF" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PublishJobRowViewModel">
                                    <Grid ColumnDefinitions="44,110,210,210,90,60,100,64,72,64,64,64,64,64,64,80,80,64,72,64,64,64,90,240" ColumnSpacing="8" Margin="8,2">
                                        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding AccountName}" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2" Click="OnOpenSourceDirectoryClick" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand" ToolTip.Tip="{Binding SourceDirectory}">
                                            <TextBlock Text="{Binding OriginalTitle}" Foreground="#047857" TextTrimming="CharacterEllipsis" TextDecorations="Underline" />
                                        </Button>
                                        <Button Grid.Column="3" Click="OnOpenWorkflowDirectoryClick" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand" ToolTip.Tip="{Binding WorkflowDirectory}">
                                            <TextBlock Text="{Binding NewTitle}" Foreground="#0369A1" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextDecorations="Underline" />
                                        </Button>
                                        <TextBlock Grid.Column="4" Text="{Binding SourceText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="5" Text="{Binding EpisodeCountText}" />
                                        <TextBlock Grid.Column="6" Text="{Binding CreatedAtText}" />
                                        <TextBlock Grid.Column="7" Text="{Binding DownloadStepStatus}" />
                                        <TextBlock Grid.Column="8" Text="{Binding SmartRecutStepStatus}" />
                                        <TextBlock Grid.Column="9" Text="{Binding RewriteStepStatus}" />
                                        <TextBlock Grid.Column="10" Text="{Binding PosterStepStatus}" />
                                        <TextBlock Grid.Column="11" Text="{Binding TranscodeStepStatus}" />
                                        <TextBlock Grid.Column="12" Text="{Binding RepairStepStatus}" />
                                        <TextBlock Grid.Column="13" Text="{Binding AutoFillStepStatus}" />
                                        <TextBlock Grid.Column="14" Text="{Binding CostReportStepStatus}" />
                                        <TextBlock Grid.Column="15" Text="{Binding ProjectImageStepStatus}" />
                                        <TextBlock Grid.Column="16" Text="{Binding AiProofStepStatus}" />
                                        <TextBlock Grid.Column="17" Text="{Binding TimestampStepStatus}" />
                                        <TextBlock Grid.Column="18" Text="{Binding ValidateStepStatus}" />
                                        <TextBlock Grid.Column="19" Text="{Binding UploadStepStatus}" />
                                        <TextBlock Grid.Column="20" Text="{Binding ShelfStepStatus}" />
                                        <TextBlock Grid.Column="21" Text="{Binding ManagementSyncStepStatus}" />
                                        <TextBlock Grid.Column="22" Text="{Binding StatusText}" Foreground="#047857" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="23" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="#EEF3F8" BorderBrush="#D9E2EC" BorderThickness="1,0,1,1">
            <TextBlock Text="{Binding StatusMessage}" Margin="10,0" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" />
        </Border>
    </Grid>
</UserControl>
