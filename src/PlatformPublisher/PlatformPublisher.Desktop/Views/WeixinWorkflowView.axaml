<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatformPublisher.Desktop.ViewModels"
             x:Class="PlatformPublisher.Desktop.Views.WeixinWorkflowView"
             x:DataType="vm:MainWindowViewModel"
             Background="#F3F6FA">
    <Grid RowDefinitions="Auto,Auto,Auto,1.15*,0.85*,30" RowSpacing="8">
        <Border Grid.Row="0" Classes="panel" Padding="10">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
                <Grid ColumnDefinitions="78,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="工作目录" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBox Grid.Column="1" Text="{Binding DraftProjectDirectory}"
                             Watermark="选择工作根目录、剧集项目或素材目录" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Button Content="选择工作目录" Click="OnPickProjectDirectoryClick" Classes="secondaryAction compactAction" />
                        <Button Content="重置" Command="{Binding ResetSelectedJobCommand}" Classes="secondaryAction compactAction" />
                    </StackPanel>
                </Grid>

                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBlock Text="任务类型" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0" />
                    <Border Background="#EEF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="剧集上传" FontWeight="SemiBold" Foreground="#0B74D1" />
                            <TextBlock Text="使用项目内剧集配置创建并上传分集" Foreground="#64748B" />
                        </StackPanel>
                    </Border>
                    <Button Content="扫描目录" Command="{Binding ScanWorkspaceCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,0"
                            ToolTip.Tip="扫描所选目录下的短剧项目并加入剧集任务队列" />
                    <Button Content="加入任务" Command="{Binding AddJobCommand}" Classes="primaryAction compactAction" Margin="0,0,6,0" />
                    <Button Content="导入本地项目" Click="OnImportLocalProjectsClick" Classes="secondaryAction compactAction" Margin="0,0,6,0" />
                    <TextBox Width="220" Text="{Binding DraftNewProjectName}" Watermark="按剧名创建项目" Margin="0,0,6,0" />
                    <Button Content="创建并入队" Command="{Binding CreateNamedProjectCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,0" />
                    <Button Content="登录 / 打开浏览器" Command="{Binding OpenLoginCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,0" />
                    <Button Content="执行勾选队列" Command="{Binding RunCheckedCommand}" Classes="primaryAction compactAction" Margin="0,0,6,0" />
                    <Button Content="重试失败" Command="{Binding RetryFailedCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,0" />
                    <Button Content="停止" Command="{Binding StopCommand}" Classes="dangerAction compactAction" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding ActiveWeixinAccountName}" VerticalAlignment="Center"
                               Foreground="#0B74D1" FontWeight="SemiBold" Margin="0,0,6,0" />
                    <Button Content="刷新账号" Click="OnRefreshAccountClick" Classes="secondaryAction compactAction" />
                </WrapPanel>

            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="panel" Padding="10">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="启用步骤" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="执行勾选步骤" Command="{Binding RunSharedPipelineCommand}" Classes="primaryAction compactAction" />
                    <Button Grid.Column="2" Content="保存设置" Command="{Binding SaveWorkflowSettingsCommand}" Classes="secondaryAction compactAction" />
                </Grid>
                <WrapPanel Grid.Row="1">
                    <CheckBox Content="下载剧集" IsChecked="{Binding PipelineDownloadEnabled}" Margin="0,0,14,3" />
                    <CheckBox Content="智能重剪" IsChecked="{Binding PipelineSmartRecutEnabled}" Margin="0,0,14,3" />
                    <CheckBox Content="改写信息" IsChecked="{Binding PipelineRewriteEnabled}" Margin="0,0,14,3" />
                    <CheckBox Content="生成海报" IsChecked="{Binding PipelinePosterEnabled}" Margin="0,0,14,3" />
                    <CheckBox Content="素材转码" IsChecked="{Binding PipelineTranscodeEnabled}" Margin="0,0,14,3" />
                    <CheckBox Content="一键修复" IsChecked="{Binding PipelineAutoRepairEnabled}" Margin="0,0,14,3" />
                    <CheckBox Content="补齐字段" IsChecked="{Binding PipelineAutoFillEnabled}" Margin="0,0,14,3" />
                    <CheckBox Content="成本报表" IsChecked="{Binding PipelineCostReportEnabled}" Margin="0,0,14,3" />
                    <CheckBox Content="工程图" IsChecked="{Binding PipelineProjectImageEnabled}" Margin="0,0,14,3" />
                    <CheckBox Content="AI制作证明" IsChecked="{Binding PipelineGenerateAiProofEnabled}" Margin="0,0,14,3" />
                    <CheckBox Content="可信时间戳" IsChecked="{Binding PipelineGenerateTimestampCertificateEnabled}" Margin="0,0,14,3"
                              ToolTip.Tip="本地模板，非 TSA 认证" />
                    <CheckBox Content="素材校验" IsChecked="{Binding PipelineMaterialValidateEnabled}" Margin="0,0,14,3" />
                    <CheckBox Content="无损重封装" IsChecked="{Binding PipelineRemuxEnabled}" Margin="0,0,14,3" />
                </WrapPanel>
                <WrapPanel Grid.Row="2">
                    <TextBlock Text="执行策略" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,14,3" />
                    <CheckBox Content="强制重跑" IsChecked="{Binding PipelineForceRerun}" Margin="0,0,14,3" />
                    <CheckBox Content="上传后自动归档" IsChecked="{Binding PipelineAutoArchiveAfterUpload}" Margin="0,0,14,3" />
                    <CheckBox Content="有待上传项目时优先上传" IsChecked="{Binding PipelinePreferUploadWhenReady}" Margin="0,0,14,3" />
                    <CheckBox Content="上传成功后同步管理系统" IsChecked="{Binding PipelineSyncManagementAfterUpload}" Margin="0,0,14,3" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Classes="panel" Padding="9">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                <Grid ColumnDefinitions="58,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="搜索" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBox Grid.Column="1" Text="{Binding WorkflowFilterText}" Watermark="搜索原剧名 / 新剧名 / 账号 / 状态 / 问题" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Button Content="勾选待执行" Command="{Binding CheckPendingCommand}" Classes="secondaryAction compactAction" />
                        <Button Content="勾选到当前项目" Command="{Binding CheckToCurrentCommand}" Classes="secondaryAction compactAction" />
                        <Button Content="全选已完成" Command="{Binding CheckCompletedCommand}" Classes="secondaryAction compactAction" />
                        <Button Content="全选筛选结果" Command="{Binding CheckAllVisibleCommand}" Classes="secondaryAction compactAction" />
                        <Button Content="取消筛选结果" Command="{Binding UncheckAllVisibleCommand}" Classes="secondaryAction compactAction" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <WrapPanel>
                        <Button Content="执行选中" Command="{Binding RunSelectedCommand}" Classes="primaryAction compactAction" Margin="0,0,6,0" />
                        <Button Content="执行全部待办" Command="{Binding RunRunnableCommand}" Classes="primaryAction compactAction" Margin="0,0,6,0" />
                        <Button Content="执行勾选队列" Command="{Binding RunCheckedCommand}" Classes="primaryAction compactAction" Margin="0,0,6,0" />
                        <Button Content="重试失败" Command="{Binding RetryFailedCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,0" />
                        <TextBlock Text="自动上架" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,0,6,0" />
                        <TextBlock Text="页" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,4,0" />
                        <NumericUpDown Width="60" Value="{Binding AutoShelfMaxPages}" Minimum="1" Maximum="100" Margin="0,0,6,0" />
                        <TextBlock Text="轮" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,4,0" />
                        <NumericUpDown Width="60" Value="{Binding AutoShelfMaxRounds}" Minimum="1" Maximum="100" Margin="0,0,6,0" />
                        <Button Content="开始" Command="{Binding AutoShelfCommand}" Classes="secondaryAction compactAction" />
                    </WrapPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="每页" VerticalAlignment="Center" Foreground="#64748B" />
                        <NumericUpDown Width="64" Value="{Binding WorkflowPageSize}" Minimum="5" Maximum="200" Increment="5" />
                        <Button Content="‹" Command="{Binding PreviousWorkflowPageCommand}" Classes="secondaryAction compactAction" />
                        <TextBlock Text="{Binding WorkflowPageSummary}" VerticalAlignment="Center" Foreground="#64748B" />
                        <Button Content="›" Command="{Binding NextWorkflowPageCommand}" Classes="secondaryAction compactAction" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="{Binding SelectedPlatformCapability}" Foreground="#0B74D1" FontWeight="SemiBold" />
                        <Run Text="  |  " Foreground="#94A3B8" />
                        <Run Text="{Binding QueueSummary}" Foreground="#475569" />
                    </TextBlock>
                    <Expander Grid.Column="1" Header="更多操作" IsExpanded="False">
                        <Border Classes="toolbarGroup" Margin="0,6,0,0" MinWidth="760">
                            <WrapPanel>
                                <Button Content="重置当前任务" Command="{Binding ResetSelectedJobCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,6" />
                                <Button Content="移出当前任务" Command="{Binding RemoveSelectedCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,6" />
                                <Button Content="批量重置" Command="{Binding ResetCheckedJobsCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,6" />
                                <ComboBox Width="105" ItemsSource="{Binding JobStatusChoices}" SelectedItem="{Binding SelectedJobStatusChoice}" Margin="0,0,6,6">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PublishJobStatusOptionViewModel"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="修改状态" Command="{Binding ApplyCheckedStatusCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,6" />
                                <Button Content="归属当前账号" Command="{Binding AssignCheckedToCurrentAccountCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,6" />
                                <Button Content="同步管理系统" Command="{Binding SyncCheckedManagementCommand}" Classes="secondaryAction compactAction" Margin="0,0,6,6" />
                                <Button Content="批量移出" Command="{Binding RemoveCheckedJobsCommand}" Classes="dangerAction compactAction" Margin="0,0,6,6" />
                            </WrapPanel>
                        </Border>
                    </Expander>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Classes="panel" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
                <Border Background="#F5F3FF" BorderBrush="#C4B5FD" BorderThickness="0,0,0,1" Padding="10"
                        IsVisible="{Binding HasInteractionRequest}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel>
                            <TextBlock Text="{Binding InteractionTitle}" FontWeight="Bold" Foreground="#6D28D9" />
                            <TextBlock Text="{Binding InteractionMessage}" Foreground="#4C1D95" TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1">
                            <Button Content="人工接管" Command="{Binding TakeoverInteractionCommand}" Margin="0,0,6,0" />
                            <Button Content="继续执行" Command="{Binding ResumeInteractionCommand}" Margin="0,0,6,0" />
                            <Button Content="跳过视频" Command="{Binding SkipCurrentVideoCommand}" Margin="0,0,6,0" />
                            <Button Content="跳过项目" Command="{Binding SkipCurrentProjectCommand}" Margin="0,0,6,0" />
                            <Button Content="停止任务" Command="{Binding StopInteractionCommand}" />
                        </WrapPanel>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid MinWidth="2300" RowDefinitions="Auto,*">
                        <Border Background="#EDF3F9" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1" Padding="10,7">
                            <Grid ColumnDefinitions="44,110,210,210,90,60,100,64,72,64,64,64,64,64,64,80,80,64,72,64,64,64,90,240" ColumnSpacing="8">
                                <TextBlock Text="勾选" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="账号" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="原剧名" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="新剧名" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="来源" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="5" Text="集数" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="6" Text="加入时间" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="7" Text="下载" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="8" Text="智能重剪" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="9" Text="改写" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="10" Text="海报" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="11" Text="转码" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="12" Text="修复" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="13" Text="补齐" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="14" Text="报表" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="15" Text="工程图" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="16" Text="AI证明" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="17" Text="时间戳" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="18" Text="校验" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="19" Text="上传" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="20" Text="上架" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="21" Text="管理同步" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="22" Text="状态" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="23" Text="当前信息" FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                        <ListBox Grid.Row="1" ItemsSource="{Binding PagedJobs}" SelectedItem="{Binding SelectedJob}"
                                 Background="#FFFFFF" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PublishJobRowViewModel">
                                    <Grid ColumnDefinitions="44,110,210,210,90,60,100,64,72,64,64,64,64,64,64,80,80,64,72,64,64,64,90,240" ColumnSpacing="8" Margin="10,7">
                                        <CheckBox IsChecked="{Binding IsChecked}" />
                                        <TextBlock Grid.Column="1" Text="{Binding AccountName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding OriginalTitle}" Foreground="#047857" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding NewTitle}" Foreground="#0369A1" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{Binding SourceText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="5" Text="{Binding EpisodeCountText}" />
                                        <TextBlock Grid.Column="6" Text="{Binding CreatedAtText}" />
                                        <TextBlock Grid.Column="7" Text="{Binding DownloadStepStatus}" />
                                        <TextBlock Grid.Column="8" Text="{Binding SmartRecutStepStatus}" />
                                        <TextBlock Grid.Column="9" Text="{Binding RewriteStepStatus}" />
                                        <TextBlock Grid.Column="10" Text="{Binding PosterStepStatus}" />
                                        <TextBlock Grid.Column="11" Text="{Binding TranscodeStepStatus}" />
                                        <TextBlock Grid.Column="12" Text="{Binding RepairStepStatus}" />
                                        <TextBlock Grid.Column="13" Text="{Binding AutoFillStepStatus}" />
                                        <TextBlock Grid.Column="14" Text="{Binding CostReportStepStatus}" />
                                        <TextBlock Grid.Column="15" Text="{Binding ProjectImageStepStatus}" />
                                        <TextBlock Grid.Column="16" Text="{Binding AiProofStepStatus}" />
                                        <TextBlock Grid.Column="17" Text="{Binding TimestampStepStatus}" />
                                        <TextBlock Grid.Column="18" Text="{Binding ValidateStepStatus}" />
                                        <TextBlock Grid.Column="19" Text="{Binding UploadStepStatus}" />
                                        <TextBlock Grid.Column="20" Text="{Binding ShelfStepStatus}" />
                                        <TextBlock Grid.Column="21" Text="{Binding ManagementSyncStepStatus}" />
                                        <TextBlock Grid.Column="22" Text="{Binding StatusText}" Foreground="#047857" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="23" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="4" Classes="panel" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
                <Border Background="#EDF3F9" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1" Padding="10,6">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="剧集列表" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding EpisodeListSummary}" Foreground="#64748B" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="刷新列表" Command="{Binding RefreshSelectedEpisodesCommand}"
                                Classes="secondaryAction compactAction" Margin="0,0,6,0" />
                        <Button Grid.Column="2" Content="打开所在目录" Command="{Binding OpenSelectedEpisodeDirectoryCommand}"
                                Classes="secondaryAction compactAction" />
                    </Grid>
                </Border>
                <Grid Grid.Row="1" RowDefinitions="36,*">
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,0">
                        <Grid ColumnDefinitions="70,1.6*,90,90,100,100,100,80,1.2*" ColumnSpacing="10">
                            <TextBlock Text="集号" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="文件名" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="视频大小" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="时长" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="分辨率" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="5" Text="准备状态" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="6" Text="上传状态" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="7" Text="尝试" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="8" Text="当前信息" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Grid>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding SelectedProjectEpisodes}" SelectedItem="{Binding SelectedEpisode}"
                             Background="#FFFFFF" BorderThickness="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="#DCEBFF" /></Style>
                        </ListBox.Styles>
                    <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:EpisodeRowViewModel">
                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,6">
                                    <Grid ColumnDefinitions="70,1.6*,90,90,100,100,100,80,1.2*" ColumnSpacing="10">
                                        <TextBlock Text="{Binding EpisodeText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding FileSizeText}" />
                                        <TextBlock Grid.Column="3" Text="{Binding DurationText}" />
                                        <TextBlock Grid.Column="4" Text="{Binding ResolutionText}" />
                                        <TextBlock Grid.Column="5" Text="{Binding PreparationStatus}" Foreground="#047857" />
                                        <TextBlock Grid.Column="6" Text="{Binding UploadStatus}" />
                                        <TextBlock Grid.Column="7" Text="{Binding AttemptText}" />
                                        <TextBlock Grid.Column="8" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="5" Background="#EEF3F8" BorderBrush="#D9E2EC" BorderThickness="1,0,1,1">
            <TextBlock Text="{Binding StatusMessage}" Margin="10,0" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" />
        </Border>
    </Grid>
</UserControl>
