<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatformPublisher.Desktop.ViewModels"
             x:Class="PlatformPublisher.Desktop.Views.AnalyticsView"
             x:DataType="vm:AnalyticsViewModel"
             Background="#F3F6FA">
    <Grid RowDefinitions="Auto,Auto,*" Margin="16" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel>
                <TextBlock Text="数据统计" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="汇总本地发布记录与视频号、快手个人版线上指标" Foreground="#64748B" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <TextBox Width="112" Text="{Binding FromDate}" Watermark="yyyy-MM-dd" />
                <TextBlock Text="至" VerticalAlignment="Center" />
                <TextBox Width="112" Text="{Binding ToDate}" Watermark="yyyy-MM-dd" />
                <ComboBox Width="125" ItemsSource="{Binding PlatformChoices}" SelectedItem="{Binding SelectedPlatform}" />
                <TextBox Width="150" Text="{Binding Keyword}" Watermark="账号关键词" />
                <Button Content="读取缓存" Command="{Binding ReloadCommand}" />
                <Button Content="刷新数据" Command="{Binding RefreshCommand}" Classes="primary" />
                <Button Content="补采视频号" Command="{Binding BackfillCommand}" />
                <Button Content="导入云帆历史" Command="{Binding ImportLegacyCommand}" />
                <Button Content="停止" Command="{Binding StopCommand}" />
                <Button Content="导出 CSV" Click="OnExportClick" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*,*,*" ColumnSpacing="8">
            <Border Classes="panel" Padding="10"><StackPanel><TextBlock Text="账号" Foreground="#64748B"/><TextBlock Text="{Binding AccountCount}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
            <Border Grid.Column="1" Classes="panel" Padding="10"><StackPanel><TextBlock Text="本地任务" Foreground="#64748B"/><TextBlock Text="{Binding TaskCount}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
            <Border Grid.Column="2" Classes="panel" Padding="10"><StackPanel><TextBlock Text="成功" Foreground="#64748B"/><TextBlock Text="{Binding SucceededCount}" FontSize="20" FontWeight="Bold" Foreground="#047857"/></StackPanel></Border>
            <Border Grid.Column="3" Classes="panel" Padding="10"><StackPanel><TextBlock Text="失败" Foreground="#64748B"/><TextBlock Text="{Binding FailedCount}" FontSize="20" FontWeight="Bold" Foreground="#B91C1C"/></StackPanel></Border>
            <Border Grid.Column="4" Classes="panel" Padding="10"><StackPanel><TextBlock Text="视频总数" Foreground="#64748B"/><TextBlock Text="{Binding VideoTotal}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
            <Border Grid.Column="5" Classes="panel" Padding="10"><StackPanel><TextBlock Text="关注者" Foreground="#64748B"/><TextBlock Text="{Binding FollowerTotal}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
            <Border Grid.Column="6" Classes="panel" Padding="10"><StackPanel><TextBlock Text="视频号收入" Foreground="#64748B"/><TextBlock Text="{Binding WeixinIncome}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
            <Border Grid.Column="7" Classes="panel" Padding="10"><StackPanel><TextBlock Text="快手收入" Foreground="#64748B"/><TextBlock Text="{Binding KuaishouIncome}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="*,Auto" RowSpacing="7">
            <TabControl>
                <TabItem Header="总览">
                    <Grid ColumnDefinitions="1.2*,1*" ColumnSpacing="10" Margin="0,10,0,0">
                        <Border Classes="panel" Padding="10"><ListBox ItemsSource="{Binding PlatformRows}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:AnalyticsPlatformRowViewModel"><Grid ColumnDefinitions="1.2*,80,80,80,80,100" Margin="4"><TextBlock Text="{Binding Platform}"/><TextBlock Grid.Column="1" Text="{Binding Accounts}"/><TextBlock Grid.Column="2" Text="{Binding Tasks}"/><TextBlock Grid.Column="3" Text="{Binding Succeeded}"/><TextBlock Grid.Column="4" Text="{Binding Failed}"/><TextBlock Grid.Column="5" Text="{Binding Income}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
                        <Border Grid.Column="1" Classes="panel" Padding="10"><ListBox ItemsSource="{Binding DailyRows}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:AnalyticsDailyRowViewModel"><Grid ColumnDefinitions="*,80,80,80" Margin="4"><TextBlock Text="{Binding Date}"/><TextBlock Grid.Column="1" Text="{Binding Succeeded}" Foreground="#047857"/><TextBlock Grid.Column="2" Text="{Binding Failed}" Foreground="#B91C1C"/><TextBlock Grid.Column="3" Text="{Binding Drafts}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
                    </Grid>
                </TabItem>
                <TabItem Header="数据分析">
                    <Border Classes="panel" Margin="0,10,0,0" Padding="10"><StackPanel><TextBlock Text="本月每日活动趋势" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/><ListBox ItemsSource="{Binding DailyRows}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:AnalyticsDailyRowViewModel"><Grid ColumnDefinitions="120,*,*,*" Margin="4"><TextBlock Text="{Binding Date}"/><TextBlock Grid.Column="1" Text="{Binding Succeeded, StringFormat='成功 {0}'}"/><TextBlock Grid.Column="2" Text="{Binding Failed, StringFormat='失败 {0}'}"/><TextBlock Grid.Column="3" Text="{Binding Drafts, StringFormat='草稿 {0}'}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
                </TabItem>
                <TabItem Header="平台数据"><Border Classes="panel" Margin="0,10,0,0" Padding="10"><ListBox ItemsSource="{Binding PlatformRows}"/></Border></TabItem>
                <TabItem Header="账号数据">
                    <Border Classes="panel" Margin="0,10,0,0" Padding="10"><ListBox ItemsSource="{Binding AccountRows}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:AnalyticsAccountRowViewModel"><Grid ColumnDefinitions="1.3*,110,70,70,70,90,90,100,100" Margin="4"><TextBlock Text="{Binding Account}"/><TextBlock Grid.Column="1" Text="{Binding Platform}"/><TextBlock Grid.Column="2" Text="{Binding Tasks}"/><TextBlock Grid.Column="3" Text="{Binding Succeeded}"/><TextBlock Grid.Column="4" Text="{Binding Failed}"/><TextBlock Grid.Column="5" Text="{Binding Videos}"/><TextBlock Grid.Column="6" Text="{Binding Followers}"/><TextBlock Grid.Column="7" Text="{Binding YesterdayViews}"/><TextBlock Grid.Column="8" Text="{Binding Income}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
                </TabItem>
                <TabItem Header="收入数据">
                    <Border Classes="panel" Margin="0,10,0,0" Padding="10"><ListBox ItemsSource="{Binding IncomeRows}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:AnalyticsIncomeRowViewModel"><Grid ColumnDefinitions="1.3*,110,150,120,120" Margin="4"><TextBlock Text="{Binding Account}"/><TextBlock Grid.Column="1" Text="{Binding Platform}"/><TextBlock Grid.Column="2" Text="{Binding Range}"/><TextBlock Grid.Column="3" Text="{Binding YesterdayIncome}"/><TextBlock Grid.Column="4" Text="{Binding TotalIncome}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
                </TabItem>
            </TabControl>
            <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="#64748B" />
        </Grid>
    </Grid>
</UserControl>
