<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatformPublisher.Desktop.ViewModels"
             xmlns:charts="using:TikTokPublisher.Ui.Controls"
             x:Class="PlatformPublisher.Desktop.Views.AnalyticsView"
             x:DataType="vm:AnalyticsViewModel"
             Background="#F8FAFC">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="16" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel>
                    <TextBlock Text="数据统计" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="只统计快手分账。每个账号按已选的个人版或企业版统计，保留最近连续 30 天的每日播放量。第一次补齐近 30 天，之后每天 12 点后自动更新前一天。"
                               Foreground="#6B7280" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="更新全部账号" MinWidth="120" Margin="0,0,8,0"
                        Command="{Binding UpdateAllCommand}" Classes="primary" />
                <Button Grid.Column="2" Content="停止" MinWidth="72" Command="{Binding StopCommand}" />
            </Grid>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KuaishouPlayCardViewModel">
                        <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,12,12">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="14">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1" Background="{Binding EditionBackground}" CornerRadius="4" Padding="8,2" Margin="8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Edition}" Foreground="{Binding EditionForeground}" FontSize="12" />
                                    </Border>
                                    <Button Grid.Column="2" Content="更新" Command="{Binding UpdateCommand}" CommandParameter="{Binding Key}" MinWidth="64" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="*,*">
                                    <StackPanel>
                                        <TextBlock Text="近30日播放" Foreground="#6B7280" FontSize="12" />
                                        <TextBlock Text="{Binding TotalText}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="最近一天" Foreground="#6B7280" FontSize="12" />
                                        <TextBlock Text="{Binding LatestText}" FontSize="22" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                        <TextBlock Text="{Binding RangeTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="HoverText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#374151" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Button Content="7天" Command="{Binding ShowSevenDaysCommand}" MinWidth="52" />
                            <Button Content="30天" Command="{Binding ShowThirtyDaysCommand}" MinWidth="52" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Legend}" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:KuaishouPlayLegendViewModel">
                                <Button Command="{Binding ToggleCommand}" CommandParameter="{Binding Key}" Background="Transparent" BorderThickness="0" Padding="0,2" Margin="0,0,14,0" Opacity="{Binding Opacity}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Color}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="230">
                        <charts:AnalyticsLineChart x:Name="DailyChart" Series="{Binding ChartSeries}" PointSpacing="36" Height="220" HorizontalAlignment="Left" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <ItemsControl Grid.Row="3" ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KuaishouPlayTabViewModel">
                        <Button Content="{Binding Name}" Command="{Binding SelectCommand}" CommandParameter="{Binding Key}"
                                Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="{Binding Foreground}"
                                Foreground="{Binding Foreground}" FontWeight="{Binding Weight}" Margin="0,0,8,0" Padding="8,6" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="#6B7280" TextWrapping="Wrap" />
        </Grid>
    </ScrollViewer>
</UserControl>
