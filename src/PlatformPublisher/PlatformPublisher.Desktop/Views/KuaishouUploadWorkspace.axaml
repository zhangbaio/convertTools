<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:PlatformPublisher.Desktop.Views"
             Background="{StaticResource PythonPageBgBrush}"
             x:Class="PlatformPublisher.Desktop.Views.KuaishouUploadWorkspace">
    <Grid x:Name="WorkspaceLayout" ColumnDefinitions="198,*">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" SharedSizeGroup="UploadTabs" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SubNavigation" Margin="10,5,10,3" Orientation="Horizontal" Spacing="5" IsEnabled="False">
                <Button Content="任务队列" Tag="queue" Classes="topNavItem" Click="SubPage_Click" />
                <Button Content="发布配置" Tag="config" Classes="topNavItem" Click="SubPage_Click" />
                <Button Content="视频去重" Tag="dedup" Classes="topNavItem" Click="SubPage_Click" />
                <Button Content="全局账号配置" Tag="global" Classes="topNavItem" Click="SubPage_Click" />
                <Button Content="剧集上架" Tag="shelf" Classes="topNavItem" Click="SubPage_Click" />
                <Button Content="运行日志" Tag="logs" Classes="topNavItem" Click="SubPage_Click" />
                <Button Content="已归档项目" Tag="archived" Classes="topNavItem" Click="SubPage_Click" />
            </StackPanel>
        </ScrollViewer>
        <Border x:Name="Sidebar" Grid.RowSpan="2" Classes="accountSidebarFrame" Padding="8,10" IsEnabled="False">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Spacing="7">
                    <TextBlock Text="账号" Classes="pageSummary accountSidebarHeading" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="添加账号" Click="AddAccount_Click" />
                        <Button Content="删除" Classes="dangerAction" Click="RemoveAccount_Click" />
                    </StackPanel>
                    <TextBox x:Name="AccountSearch" Watermark="昵称 / ID" TextChanged="AccountSearch_TextChanged" />
                    <TextBlock Text="今日已上传" FontSize="12" Classes="pageSummary"
                               HorizontalAlignment="Right" Margin="0,0,10,0" />
                </StackPanel>
                <ListBox x:Name="AccountList" Classes="uploadAccountList" SelectionChanged="AccountList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" FontSize="12" Classes="pageSummary" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding UploadCountText}"
                                           FontSize="12" Classes="pageSummary" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*,Auto">
            <CheckBox x:Name="AllHistoryAccounts" Content="全部账号" Margin="12,4" IsVisible="False"
                      IsCheckedChanged="OnHistoryScopeChanged" />
            <Panel Grid.Row="1">
                <views:WeixinWorkflowView x:Name="Workflow" Background="{StaticResource PythonPageBgBrush}" IsKuaishouMode="True" IsVisible="False" />
                <views:KuaishouPersonalConfigDialog x:Name="Configuration" IsVisible="False" />
                <views:KuaishouVideoDedupView x:Name="DedupConfiguration" IsVisible="False" />
                <ScrollViewer x:Name="GlobalConfiguration" IsVisible="False">
                    <StackPanel Margin="16" Spacing="12">
                        <TextBlock Text="全局队列并发数" FontWeight="SemiBold" />
                        <NumericUpDown x:Name="GlobalConcurrency" Minimum="1" Maximum="12" Value="4"
                                       FormatString="0" Width="120" HorizontalAlignment="Left" />
                        <TextBlock Text="本机所有快手账号共享此上限，默认 4 部。保存后按新上限安排后续任务。"
                                   Classes="pageSummary" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="保存配置" Classes="primaryAction" Click="SaveGlobalConfiguration_Click" />
                            <TextBlock x:Name="GlobalConfigurationMessage" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <views:KuaishouQueueLogView x:Name="LogView" IsVisible="False" />
                <views:KuaishouArchivedProjectsView x:Name="ArchiveView" IsVisible="False" />
                <StackPanel x:Name="Unavailable" Margin="20" Spacing="10" IsVisible="False">
                    <TextBlock x:Name="StartupError" TextWrapping="Wrap" />
                    <Button Content="重试" Click="Retry_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Panel>
            <Grid Grid.Row="2" Classes="uploadQueueFooter" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="{Binding StatusMessage}" Classes="pageSummary" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding KuaishouTodayUploadText}" Classes="pageSummary" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
