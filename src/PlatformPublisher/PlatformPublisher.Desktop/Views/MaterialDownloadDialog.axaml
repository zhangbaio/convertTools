<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PlatformPublisher.Desktop.Views.MaterialDownloadDialog"
        Width="700" Height="470" MinWidth="620" MinHeight="420"
        Title="下载素材" WindowStartupLocation="CenterOwner">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="14">
        <StackPanel Spacing="4">
            <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="Bold" />
            <TextBlock x:Name="DescriptionText" Foreground="#667085" TextWrapping="Wrap" />
        </StackPanel>
        <TextBox x:Name="ValuesTextBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                 Watermark="每行一项" VerticalContentAlignment="Top" Padding="10" />
        <Grid Grid.Row="2" ColumnDefinitions="Auto,140,*" ColumnSpacing="10">
            <TextBlock x:Name="LimitLabel" Text="每项下载数量" VerticalAlignment="Center" />
            <NumericUpDown x:Name="LimitInput" Grid.Column="1" Minimum="1" Maximum="50" Value="10" />
            <TextBlock Grid.Column="2" Text="下载过程会打开视频号浏览器，完成后自动刷新项目清单。"
                       Foreground="#667085" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock x:Name="ValidationText" Foreground="#B42318" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="取消" Click="OnCancelClick" />
            <Button Grid.Column="2" Content="开始下载" Click="OnAcceptClick" Classes="primaryAction" />
        </Grid>
    </Grid>
</Window>
