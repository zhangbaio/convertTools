<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlatformPublisher.Desktop.ViewModels"
             x:Class="PlatformPublisher.Desktop.Views.WeixinDramaDownloadView"
             x:DataType="vm:WeixinDramaDownloadViewModel"
             Background="#F3F6FA">
    <Grid RowDefinitions="Auto,Auto,*,30" RowSpacing="10">
        <Border Classes="panel" Padding="12">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                <TextBlock Text="工作根目录" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding RootDirectory}" Watermark="下载项目保存目录" />
                <Button Grid.Column="2" Content="选择目录" Click="OnPickRootClick" Classes="secondaryAction" />
                <Button Grid.Column="3" Content="今日短剧" Command="{Binding TodayCommand}" Classes="secondaryAction" />

                <TextBlock Grid.Row="1" Text="搜索" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Keyword}" Watermark="输入短剧名称" />
                <Button Grid.Row="1" Grid.Column="2" Content="搜索" Command="{Binding SearchCommand}" Classes="primaryAction" />
                <Button Grid.Row="1" Grid.Column="3" Content="停止" Command="{Binding StopCommand}" Classes="dangerAction" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="panel" Padding="10">
            <WrapPanel Orientation="Horizontal">
                <Button Content="全选" Click="OnCheckAllClick" Classes="secondaryAction" Margin="0,0,8,0" />
                <Button Content="取消全选" Click="OnUncheckAllClick" Classes="secondaryAction" Margin="0,0,8,0" />
                <TextBlock Text="下载集数" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Width="120" Text="{Binding Episodes}" Watermark="all / 1-20" Margin="0,0,8,0" />
                <TextBlock Text="清晰度" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Width="100" ItemsSource="{Binding QualityChoices}" SelectedItem="{Binding Quality}" Margin="0,0,8,0" />
                <TextBlock Text="并发" VerticalAlignment="Center" Margin="0,0,4,0" />
                <NumericUpDown Width="80" Value="{Binding Concurrent}" Minimum="1" Maximum="16" Margin="0,0,8,0" />
                <Button Content="导入并加入视频号队列" Command="{Binding ImportCheckedCommand}" Classes="secondaryAction" Margin="0,0,8,0" />
                <Button Content="下载并加入视频号队列" Command="{Binding DownloadCheckedCommand}" Classes="primaryAction" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Classes="panel" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
                <Border Background="#EDF3F9" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1" Padding="10,7">
                    <Grid ColumnDefinitions="48,220,100,80,120,*" ColumnSpacing="10">
                        <TextBlock Text="勾选" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="剧名" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="分类" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="集数" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="BookId" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="简介" FontWeight="SemiBold" />
                    </Grid>
                </Border>
                <ListBox Grid.Row="1" ItemsSource="{Binding Results}" Background="#FFFFFF" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DramaSearchRowViewModel">
                            <Grid ColumnDefinitions="48,220,100,80,120,*" ColumnSpacing="10" Margin="10,7">
                                <CheckBox IsChecked="{Binding IsChecked}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="{Binding Category}" />
                                <TextBlock Grid.Column="3" Text="{Binding EpisodeSummary}" />
                                <TextBlock Grid.Column="4" Text="{Binding BookId}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5" Text="{Binding Intro}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#EEF3F8" BorderBrush="#D9E2EC" BorderThickness="1,0,1,1">
            <TextBlock Text="{Binding StatusMessage}" Margin="10,0" VerticalAlignment="Center" Foreground="#64748B" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
