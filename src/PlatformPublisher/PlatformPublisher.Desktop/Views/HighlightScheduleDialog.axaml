<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PlatformPublisher.Desktop.Views.HighlightScheduleDialog"
        Width="920" Height="650" MinWidth="820" MinHeight="560"
        Title="系统高光自动发布配置" WindowStartupLocation="CenterOwner">
    <Grid Margin="18" ColumnDefinitions="210,*" RowDefinitions="*,Auto" ColumnSpacing="16" RowSpacing="12">
        <Border Classes="panel" Padding="10">
            <Grid RowDefinitions="*,Auto,Auto" RowSpacing="8">
                <ListBox x:Name="RuleList" SelectionChanged="OnRuleSelectionChanged" />
                <Button Grid.Row="1" Content="新增规则" Click="OnAddRuleClick" />
                <Button Grid.Row="2" Content="删除当前规则" Click="OnDeleteRuleClick" />
            </Grid>
        </Border>
        <Border Grid.Column="1" Classes="panel" Padding="14">
            <ScrollViewer>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="130,*" RowSpacing="12" ColumnSpacing="10">
                    <TextBlock Text="规则名称" VerticalAlignment="Center" />
                    <TextBox x:Name="NameInput" Grid.Column="1" />
                    <TextBlock Grid.Row="1" Text="启用状态" VerticalAlignment="Center" />
                    <CheckBox x:Name="EnabledInput" Grid.Row="1" Grid.Column="1" Content="启用该规则" />
                    <TextBlock Grid.Row="2" Text="触发方式" VerticalAlignment="Center" />
                    <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="180,Auto,120" ColumnSpacing="8">
                        <ComboBox x:Name="TriggerInput" SelectionChanged="OnTriggerChanged">
                            <ComboBoxItem Tag="fixed_time">按计划时间</ComboBoxItem>
                            <ComboBoxItem Tag="interval">按固定间隔</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Grid.Column="1" Text="间隔分钟" VerticalAlignment="Center" />
                        <NumericUpDown x:Name="IntervalInput" Grid.Column="2" Minimum="1" Maximum="1440" Value="30" />
                    </Grid>
                    <TextBlock Grid.Row="3" Text="计划时间" VerticalAlignment="Center" />
                    <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="180,Auto,170" ColumnSpacing="8">
                        <ComboBox x:Name="ScheduleModeInput">
                            <ComboBoxItem Tag="daily">每天</ComboBoxItem>
                            <ComboBoxItem Tag="weekly">每周</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Grid.Column="1" Text="时间" VerticalAlignment="Center" />
                        <TextBox x:Name="TimeInput" Grid.Column="2" Watermark="09:00" />
                    </Grid>
                    <TextBlock Grid.Row="4" Text="每周日期" VerticalAlignment="Center" />
                    <TextBox x:Name="WeekdaysInput" Grid.Row="4" Grid.Column="1" Watermark="0,1,2,3,4,5,6（0 为周日）" />
                    <TextBlock Grid.Row="5" Text="剧名" VerticalAlignment="Top" />
                    <TextBox x:Name="TitlesInput" Grid.Row="5" Grid.Column="1" Height="120" AcceptsReturn="True"
                             TextWrapping="Wrap" Watermark="每行一个剧名" VerticalContentAlignment="Top" />
                    <TextBlock Grid.Row="6" Text="发布设置" VerticalAlignment="Center" />
                    <Grid Grid.Row="6" Grid.Column="1" ColumnDefinitions="Auto,100,Auto,*" ColumnSpacing="8">
                        <TextBlock Text="每部数量" VerticalAlignment="Center" />
                        <NumericUpDown x:Name="CountInput" Grid.Column="1" Minimum="1" Maximum="100" Value="10" />
                        <TextBlock Grid.Column="2" Text="类型" VerticalAlignment="Center" />
                        <TextBox x:Name="TypesInput" Grid.Column="3" Watermark="混剪,解说,切片" />
                    </Grid>
                    <TextBlock Grid.Row="7" Text="默认描述" VerticalAlignment="Top" />
                    <TextBox x:Name="DescriptionInput" Grid.Row="7" Grid.Column="1" Height="75" AcceptsReturn="True" TextWrapping="Wrap" />
                </Grid>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
            <CheckBox x:Name="CatchUpInput" Content="启动时补跑" VerticalAlignment="Center" />
            <TextBlock x:Name="ValidationText" Grid.Column="1" Foreground="#B42318" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="关闭" Click="OnCancelClick" />
            <Button Grid.Column="3" Content="保存规则" Click="OnSaveClick" />
            <Button Grid.Column="4" Content="保存并立即执行" Click="OnRunNowClick" Classes="primaryAction" />
        </Grid>
    </Grid>
</Window>
