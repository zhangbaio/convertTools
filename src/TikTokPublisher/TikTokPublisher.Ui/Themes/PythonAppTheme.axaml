<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
    <!-- 对齐 Python tiktok_uploader_client/theme.py -->
    <Color x:Key="PythonBg">#F3F5FA</Color>
    <Color x:Key="PythonPageBg">#F3F5FA</Color>
    <Color x:Key="PythonPanelBg">#FFFFFF</Color>
    <Color x:Key="PythonPanelSubtleBg">#FAFAFD</Color>
    <Color x:Key="PythonPanelBorder">#D7DCEB</Color>
    <Color x:Key="PythonText">#1E2433</Color>
    <Color x:Key="PythonMuted">#677086</Color>
    <Color x:Key="PythonPrimary">#4B4FBF</Color>
    <Color x:Key="PythonPrimaryHover">#393D9B</Color>
    <Color x:Key="PythonSecondary">#16869B</Color>
    <Color x:Key="PythonDangerText">#CC4055</Color>
    <Color x:Key="PythonDangerBg">#FFF0F3</Color>
    <Color x:Key="PythonTableHeader">#EEF0F7</Color>
    <Color x:Key="PythonTableHeaderStep">#E9ECF7</Color>
    <Color x:Key="PythonTableRowAlt">#F8F9FC</Color>
    <Color x:Key="PythonTableRowHover">#F0F1FA</Color>
    <Color x:Key="PythonTableRowSelected">#E5E7FA</Color>
    <Color x:Key="PythonInputBg">#FFFFFF</Color>
    <Color x:Key="PythonInputBorder">#C9CFDF</Color>
    <Color x:Key="PythonInputFocus">#777BE0</Color>
    <Color x:Key="PythonStatusBar">#ECEEF6</Color>
    <Color x:Key="PythonNavSelectedBg">#E5E7FA</Color>
    <Color x:Key="PythonSuccessText">#168568</Color>
    <Color x:Key="PythonPendingText">#B97812</Color>

    <SolidColorBrush x:Key="PythonBgBrush" Color="{StaticResource PythonBg}" />
    <SolidColorBrush x:Key="PythonPageBgBrush" Color="{StaticResource PythonPageBg}" />
    <SolidColorBrush x:Key="PythonPanelBgBrush" Color="{StaticResource PythonPanelBg}" />
    <SolidColorBrush x:Key="PythonPanelSubtleBgBrush" Color="{StaticResource PythonPanelSubtleBg}" />
    <SolidColorBrush x:Key="PythonPanelBorderBrush" Color="{StaticResource PythonPanelBorder}" />
    <SolidColorBrush x:Key="PythonBorderBrush" Color="{StaticResource PythonPanelBorder}" />
    <SolidColorBrush x:Key="PythonTextBrush" Color="{StaticResource PythonText}" />
    <SolidColorBrush x:Key="PythonMutedBrush" Color="{StaticResource PythonMuted}" />
    <SolidColorBrush x:Key="PythonPrimaryBrush" Color="{StaticResource PythonPrimary}" />
    <SolidColorBrush x:Key="PythonInputFocusBrush" Color="{StaticResource PythonInputFocus}" />
    <SolidColorBrush x:Key="PythonStatusBarBrush" Color="{StaticResource PythonStatusBar}" />

    <CornerRadius x:Key="PythonPanelRadius">8</CornerRadius>
    <CornerRadius x:Key="PythonButtonRadius">6</CornerRadius>
    <Thickness x:Key="PythonPanelPadding">16,12</Thickness>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource PythonPageBgBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Inter, Microsoft YaHei UI, Segoe UI" />
        <Setter Property="Foreground" Value="{StaticResource PythonTextBrush}" />
    </Style>

    <Style Selector="Border.controlsFrame">
        <Setter Property="Background" Value="{StaticResource PythonPanelSubtleBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PythonPanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PythonPanelRadius}" />
        <Setter Property="Padding" Value="{StaticResource PythonPanelPadding}" />
    </Style>

    <Style Selector="Border.taskStepFrame">
        <Setter Property="Background" Value="#F8F8FC" />
        <Setter Property="BorderBrush" Value="#D7DCEB" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style Selector="Border.accountSidebarFrame">
        <Setter Property="Background" Value="#FAFAFD" />
        <Setter Property="BorderBrush" Value="#D7DCEB" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style Selector="Border.topNavFrame">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#D7DCEB" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Border.browserFrame">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#D7DCEB" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="TextBlock.topBrandLabel">
        <Setter Property="Foreground" Value="{StaticResource PythonPrimaryBrush}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.pageSummary">
        <Setter Property="Foreground" Value="{StaticResource PythonMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.formLabel">
        <Setter Property="Foreground" Value="#2B3142" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.pageTitle">
        <Setter Property="Foreground" Value="{StaticResource PythonTextBrush}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.tableHeader">
        <Setter Property="Foreground" Value="#343A52" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="8,10" />
        <Setter Property="Background" Value="{StaticResource PythonTableHeader}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource PythonInputBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource PythonInputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PythonButtonRadius}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Foreground" Value="{StaticResource PythonTextBrush}" />
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="#F0F1F7" />
        <Setter Property="BorderBrush" Value="#AEB5CA" />
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="#E5E7F0" />
        <Setter Property="BorderBrush" Value="#969DB6" />
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.64" />
    </Style>

    <Style Selector="Button.primaryAction">
        <Setter Property="Background" Value="{StaticResource PythonPrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#4246AD" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.primaryAction:pointerover">
        <Setter Property="Background" Value="{StaticResource PythonPrimaryHover}" />
    </Style>

    <Style Selector="Button.secondaryAction">
        <Setter Property="Background" Value="#ECEEFA" />
        <Setter Property="Foreground" Value="{StaticResource PythonPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="#C4C7EF" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.secondaryAction:pointerover">
        <Setter Property="Background" Value="#E2E4F7" />
    </Style>

    <Style Selector="Button.secondaryAction.primaryFill">
        <Setter Property="Background" Value="{StaticResource PythonSecondary}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#117589" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.dangerAction">
        <Setter Property="Background" Value="{StaticResource PythonDangerBg}" />
        <Setter Property="Foreground" Value="{StaticResource PythonDangerText}" />
        <Setter Property="BorderBrush" Value="#E7AEB8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.sidebarPrimaryAction">
        <Setter Property="Background" Value="{StaticResource PythonPrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#4246AD" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBox, ComboBox, NumericUpDown">
        <Setter Property="Background" Value="{StaticResource PythonInputBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource PythonInputBorder}" />
        <Setter Property="CornerRadius" Value="{StaticResource PythonButtonRadius}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBox:focus, ComboBox:focus, NumericUpDown:focus">
        <Setter Property="BorderBrush" Value="{StaticResource PythonInputFocusBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style Selector="TextBox:pointerover, ComboBox:pointerover, NumericUpDown:pointerover">
        <Setter Property="BorderBrush" Value="#AEB5CA" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="{StaticResource PythonInputBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource PythonPanelBorderBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="ListBox#GlobalAccountList">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ListBox#GlobalAccountList ListBoxItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="0,2" />
    </Style>

    <Style Selector="ListBox#GlobalAccountList ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource PythonNavSelectedBg}" />
    </Style>

    <Style Selector="ListBox#GlobalAccountList ListBoxItem:selected TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PythonPrimaryBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="ListBox#TopModuleNav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ListBox#TopModuleNav ListBoxItem">
        <Setter Property="Padding" Value="16,11,16,9" />
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="BorderThickness" Value="0,0,0,3" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="#343A4A" />
    </Style>

    <Style Selector="ListBox#TopModuleNav ListBoxItem:selected">
        <Setter Property="Background" Value="{StaticResource PythonNavSelectedBg}" />
        <Setter Property="Foreground" Value="{StaticResource PythonPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PythonPrimaryBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Border.statusBarFrame">
        <Setter Property="Background" Value="{StaticResource PythonStatusBarBrush}" />
        <Setter Property="BorderBrush" Value="#D7DCEB" />
        <Setter Property="BorderThickness" Value="1,1,0,0" />
    </Style>

    <!-- 顶部水平一级 TAB（对齐 Python Qt 客户端） -->
    <Style Selector="Button.topNavItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,3" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="18,12,18,10" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource PythonTextBrush}" />
    </Style>

    <Style Selector="Button.topNavItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#F1F2F8" />
    </Style>

    <Style Selector="Button.topNavItemActive">
        <Setter Property="BorderBrush" Value="{StaticResource PythonPrimaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PythonPrimaryBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.topNavItemActive /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource PythonNavSelectedBg}" />
    </Style>

    <Style Selector="TabControl">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#4B5563" />
    </Style>

    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{StaticResource PythonPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TabControl.secondaryTabs">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="TabControl.secondaryTabs TabItem">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#6B7280" />
        <Setter Property="Padding" Value="0,0,0,6" />
        <Setter Property="Margin" Value="0,0,22,8" />
    </Style>

    <Style Selector="TabControl.secondaryTabs TabItem:selected">
        <Setter Property="Foreground" Value="{StaticResource PythonPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.stepStatusCompleted">
        <Setter Property="Foreground" Value="{StaticResource PythonSuccessText}" />
    </Style>

    <Style Selector="TextBlock.stepStatusPending">
        <Setter Property="Foreground" Value="{StaticResource PythonPendingText}" />
    </Style>

</Styles>
