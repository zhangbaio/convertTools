<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TikTokPublisher.Ui.ViewModels"
             x:Class="TikTokPublisher.Ui.Views.ArchivedProjectsView"
             x:DataType="vm:ArchivedProjectsViewModel"
             Background="{StaticResource PythonPageBgBrush}">

    <UserControl.Styles>
        <Style Selector="Button.archiveLink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.archiveLink:pointerover">
            <Setter Property="Background" Value="#EEF6FF" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="16,14,16,16">
        <Border DockPanel.Dock="Top" Classes="controlsFrame" Margin="0,0,0,10">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="归档目录" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Text="{Binding ArchiveRootDir}" IsReadOnly="True" Watermark="请选择归档目录" />
                    <Button Grid.Column="2" Content="选择归档目录" Click="OnChooseArchiveRootClick" Margin="10,0,0,0" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="搜索" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Watermark="搜索项目名、原剧名、新剧名..." />
                </Grid>

                <WrapPanel Orientation="Horizontal">
                    <Button Content="刷新归档列表" Command="{Binding RefreshCommand}" Margin="0,0,8,8" />
                    <Button Content="打开归档目录" Click="OnOpenArchiveDirClick" Margin="0,0,8,8" />
                    <Button Content="打开 Source" Click="OnOpenSourceClick" Margin="0,0,8,8" />
                    <Button Content="打开 Workflow" Click="OnOpenWorkflowClick" Margin="0,0,8,8" />
                    <Button Content="勾选到当前项目" Click="OnSelectToCurrentClick" Margin="0,0,8,8" />
                    <Button Content="全选" Click="OnSelectAllClick" Margin="0,0,8,8" />
                    <Button Content="取消全选" Click="OnClearSelectionClick" Margin="0,0,8,8" />
                    <Button Content="回退归档项目" Click="OnRestoreSelectedClick" Margin="0,0,8,8" />
                    <Button Content="迁移旧归档" Click="OnMigrateLegacyArchiveClick" Margin="0,0,8,8" />
                    <Button Content="删除归档项目" Click="OnDeleteSelectedClick" Classes="dangerAction" Margin="0,0,8,8" />
                    <Button Content="同步勾选任务" Click="OnSyncSelectedClick" Margin="0,0,8,8" />
                </WrapPanel>

                <TextBlock Text="{Binding StatusMessage}" Classes="pageSummary" />
                <TextBlock Text="{Binding RootSummary}" Classes="pageSummary" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border BorderBrush="#DFD1C0" BorderThickness="1" CornerRadius="6">
            <Grid RowDefinitions="Auto,*">
                <ScrollViewer x:Name="ArchivedHeaderScrollViewer"
                              Grid.Row="0"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              AllowAutoHide="False">
                    <Grid Width="1682" ColumnDefinitions="56,56,220,220,90,160,160,280,220,220">
                        <TextBlock Grid.Column="0" Text="序号" Classes="tableHeader" />
                        <TextBlock Grid.Column="1" Text="选择" Classes="tableHeader" />
                        <TextBlock Grid.Column="2" Text="原剧名" Classes="tableHeader" />
                        <TextBlock Grid.Column="3" Text="新剧名" Classes="tableHeader" />
                        <TextBlock Grid.Column="4" Text="归档来源" Classes="tableHeader" />
                        <TextBlock Grid.Column="5" Text="加入时间" Classes="tableHeader" />
                        <TextBlock Grid.Column="6" Text="归档时间" Classes="tableHeader" />
                        <TextBlock Grid.Column="7" Text="归档目录" Classes="tableHeader" />
                        <TextBlock Grid.Column="8" Text="Source" Classes="tableHeader" />
                        <TextBlock Grid.Column="9" Text="Workflow" Classes="tableHeader" />
                    </Grid>
                </ScrollViewer>

                <ListBox x:Name="ArchivedList"
                         Grid.Row="1"
                         ItemsSource="{Binding FilteredRows}"
                         SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                         Background="{StaticResource PythonInputBg}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         ScrollViewer.AllowAutoHide="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ArchivedProjectRowViewModel">
                                <Grid ColumnDefinitions="56,56,220,220,90,160,160,280,220,220" MinHeight="36" Width="1682" ClipToBounds="True">
                                    <TextBlock Grid.Column="0" Text="{Binding RowIndex}" VerticalAlignment="Center" Margin="8,0" />
                                    <CheckBox Grid.Column="1" IsChecked="{Binding Selected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Button Grid.Column="2"
                                            Classes="archiveLink"
                                            Click="OnOpenRowSourceClick"
                                            ToolTip.Tip="{Binding SourceDir}">
                                        <TextBlock Text="{Binding OriginalTitle}"
                                                   Foreground="#55CFFF"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Button>
                                    <Button Grid.Column="3"
                                            Classes="archiveLink"
                                            Click="OnOpenRowWorkflowClick"
                                            ToolTip.Tip="{Binding WorkflowDir}">
                                        <TextBlock Text="{Binding NewTitle}"
                                                   Foreground="#55CFFF"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Button>
                                    <TextBlock Grid.Column="4" Text="{Binding ArchiveSource}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBlock Grid.Column="5" Text="{Binding QueuedAt}" VerticalAlignment="Center" Margin="8,0" FontSize="12" ToolTip.Tip="{Binding QueuedAtTooltip}" />
                                    <TextBlock Grid.Column="6" Text="{Binding ArchivedAt}" VerticalAlignment="Center" Margin="8,0" FontSize="12" />
                                    <TextBlock Grid.Column="7" Text="{Binding ArchiveDisplayPath}" VerticalAlignment="Center" Margin="8,0" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="8" Text="{Binding SourceDir}" VerticalAlignment="Center" Margin="8,0" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="9" Text="{Binding WorkflowDir}" VerticalAlignment="Center" Margin="8,0" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
