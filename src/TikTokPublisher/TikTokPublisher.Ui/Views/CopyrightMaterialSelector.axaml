<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TikTokPublisher.Ui.Views.CopyrightMaterialSelector">
    <UserControl.Styles>
        <Style Selector="Border.materialGroup">
            <Setter Property="BorderBrush" Value="#DCE3EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="Border.materialRow">
            <Setter Property="Padding" Value="4,8" />
        </Style>
        <Style Selector="TextBlock.materialHint">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="StackPanel.materialContents">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="Spacing" Value="8" />
        </Style>
        <Style Selector="ToggleSwitch.materialOption">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <StyleInclude Source="avares://TikTokPublisher.Ui/Themes/ConfigurationFormStyles.axaml" />
        <Style Selector="UniformGrid > StackPanel">
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style Selector="TextBlock.materialFieldLabel">
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid SizeChanged="OnMaterialFormSizeChanged">
        <StackPanel x:Name="MaterialForm" Spacing="10" MaxWidth="1080" HorizontalAlignment="Left">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2">
                    <TextBlock Text="材料上传类型" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="平台要求：至少选择 1 项核心材料；若无法提供，则至少选择 2 项辅助材料"
                               Classes="materialHint" />
                    <TextBlock x:Name="MinimumStatusText" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="仅选择最低标准"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Click="OnSelectMinimumStandardClick" />
            </Grid>

            <Border Classes="materialGroup">
                <StackPanel Spacing="2">
                    <TextBlock Text="核心材料" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="选择任意 1 项即可满足平台最低标准" Classes="materialHint" Margin="0,0,0,4" />

                    <Border Classes="materialRow">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <ToggleSwitch x:Name="ProductionAgreementMaterialBox"
                                          Classes="materialOption"
                                          OnContent="合作协议" OffContent="合作协议" AutomationProperties.Name="合作协议" IsCheckedChanged="OnMaterialSelectionChanged" />
                                <TextBlock Grid.Column="1" Text="最低标准推荐" Foreground="#16803C"
                                           FontSize="12" VerticalAlignment="Center" IsVisible="{Binding IsChecked, ElementName=ProductionAgreementMaterialBox}" />
                            </Grid>
                            <TextBlock Text="制作协议、联合出品协议等合作协议；系统自动生成当前项目的证明材料。"
                                       Classes="materialHint" IsVisible="{Binding IsChecked, ElementName=ProductionAgreementMaterialBox}" />
                            <StackPanel Classes="materialContents"
                                        IsVisible="{Binding IsChecked, ElementName=ProductionAgreementMaterialBox}">
                                <TextBlock Classes="materialHint" Text="上传：证明材料.pdf（自动生成）" />
                                <UniformGrid x:Name="AgreementPeopleRow" Columns="2">
                                    <StackPanel Spacing="5">
                                        <TextBlock Classes="materialFieldLabel" Text="本公司／声明人" TextWrapping="Wrap" />
                                        <TextBox Classes="configurationInput" x:Name="ProofDeclarantCompanyNameBox" Watermark="用于正文和声明人" />
                                    </StackPanel>
                                    <StackPanel Spacing="5">
                                        <TextBlock Classes="materialFieldLabel" Text="致贵方名称" TextWrapping="Wrap" />
                                        <TextBox Classes="configurationInput" x:Name="ProofCopyrightCompanyNameBox" Watermark="用于“致【…】（下称贵方）”" />
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="materialFieldLabel" Text="印章图片" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Classes="configurationInput" x:Name="ProofSealPathBox" Watermark="PNG、JPG、JPEG 或 BMP 图片" />
                                        <Button Grid.Column="1" Content="浏览…" Click="OnBrowseProofSealClick" VerticalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>
                                <TextBlock Classes="materialHint" Text="Word 模板在系统设置中统一配置，留空时使用内置中文模板。" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="#EEF1F5" />

                    <Border Classes="materialRow">
                        <StackPanel>
                            <ToggleSwitch x:Name="WorkRegistrationMaterialBox"
                                      Classes="materialOption"
                                          OnContent="作品登记证书" OffContent="作品登记证书" AutomationProperties.Name="作品登记证书" IsCheckedChanged="OnMaterialSelectionChanged" />
                            <TextBlock Text="登记的作品类别需为影视作品，并与当前短剧作品及合同签约主体一致。"
                                       Classes="materialHint" IsVisible="{Binding IsChecked, ElementName=WorkRegistrationMaterialBox}" />
                            <TextBlock Text="当前自动上传流程未支持，请仅在已另行配置独立文件时选择。"
                                       Classes="materialHint" Foreground="#C2410C" Margin="28,3,0,0"
                                       IsVisible="{Binding IsChecked, ElementName=WorkRegistrationMaterialBox}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="materialGroup">
                <StackPanel Spacing="2">
                    <TextBlock Text="辅助材料" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="未选择核心材料时，至少选择 2 项辅助材料" Classes="materialHint" Margin="0,0,0,4" />

                    <Border Classes="materialRow">
                        <StackPanel>
                            <ToggleSwitch x:Name="FilingLicenseMaterialBox"
                                      Classes="materialOption"
                                          OnContent="网络剧片备案、发行许可、监管审批文件" OffContent="网络剧片备案、发行许可、监管审批文件" AutomationProperties.Name="网络剧片备案、发行许可、监管审批文件" IsCheckedChanged="OnMaterialSelectionChanged" />
                            <TextBlock Text="用于识别短剧备案主体、制片方、申报主体或许可主体。"
                                       Classes="materialHint" IsVisible="{Binding IsChecked, ElementName=FilingLicenseMaterialBox}" />
                            <StackPanel Classes="materialContents"
                                        IsVisible="{Binding IsChecked, ElementName=FilingLicenseMaterialBox}">
                                <TextBlock Classes="materialHint" Text="上传：可信时间戳认证证书（自动生成）" />
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="materialFieldLabel" Text="可信时间戳申请人" TextWrapping="Wrap" />
                                    <TextBox Classes="configurationInput" x:Name="TimestampApplicantNameBox" Watermark="留空时使用本公司/声明人" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="#EEF1F5" />

                    <Border Classes="materialRow">
                        <StackPanel>
                            <ToggleSwitch x:Name="RightsNoticeMaterialBox"
                                      Classes="materialOption"
                                          OnContent="片头片尾及权利标识" OffContent="片头片尾及权利标识" AutomationProperties.Name="片头片尾及权利标识" IsCheckedChanged="OnMaterialSelectionChanged" />
                            <TextBlock Text="包含片头片尾署名、标识等，可识别的制片方、出品方、发行方应与合同主体一致。"
                                       Classes="materialHint" IsVisible="{Binding IsChecked, ElementName=RightsNoticeMaterialBox}" />
                            <TextBlock Text="当前自动上传流程未支持，请仅在已另行配置独立文件时选择。"
                                       Classes="materialHint" Foreground="#C2410C" Margin="28,3,0,0"
                                       IsVisible="{Binding IsChecked, ElementName=RightsNoticeMaterialBox}" />
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="#EEF1F5" />

                    <Border Classes="materialRow">
                        <StackPanel>
                            <ToggleSwitch x:Name="AiScreenshotsMaterialBox"
                                      Classes="materialOption"
                                          OnContent="AI 生成过程截图" OffContent="AI 生成过程截图" AutomationProperties.Name="AI 生成过程截图" IsCheckedChanged="OnMaterialSelectionChanged" />
                            <TextBlock Text="提供生成过程、提示词、操作步骤及对应生成结果的截图。"
                                       Classes="materialHint" IsVisible="{Binding IsChecked, ElementName=AiScreenshotsMaterialBox}" />
                            <StackPanel Classes="materialContents"
                                        IsVisible="{Binding IsChecked, ElementName=AiScreenshotsMaterialBox}">
                                <TextBlock Classes="materialHint" Text="上传：AI 生成截图（共4张，自动生成）"
                                          ToolTip.Tip="01_分镜工作台.png、02_分镜工作台.png、03_分镜工作台.png、04_分镜工作台.png" />
                                <ToggleSwitch x:Name="UploadAiScriptOutlineWithScreenshotsBox"
                                          OnContent="同时上传 AI剧本大纲.pdf（可选）" OffContent="同时上传 AI剧本大纲.pdf（可选）" AutomationProperties.Name="同时上传 AI剧本大纲.pdf（可选）" />
                                <StackPanel Spacing="5" IsVisible="{Binding IsChecked, ElementName=UploadAiScriptOutlineWithScreenshotsBox}">
                                    <TextBlock Classes="materialFieldLabel" Text="AI 大纲集数" TextWrapping="Wrap" />
                                    <NumericUpDown Classes="configurationInput" x:Name="AiScriptOutlineEpisodeCountBox" Minimum="1" Maximum="120" Value="5" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="#EEF1F5" />

                    <Border Classes="materialRow">
                        <StackPanel>
                            <ToggleSwitch x:Name="EditingProjectMaterialBox"
                                      Classes="materialOption"
                                          OnContent="剪辑工程文件" OffContent="剪辑工程文件" AutomationProperties.Name="剪辑工程文件" IsCheckedChanged="OnMaterialSelectionChanged" />
                            <TextBlock Text="工程图应包含短剧或漫画画面及清晰的分轨、剪辑或后期编辑过程。"
                                       Classes="materialHint" IsVisible="{Binding IsChecked, ElementName=EditingProjectMaterialBox}" />
                            <StackPanel Classes="materialContents"
                                        IsVisible="{Binding IsChecked, ElementName=EditingProjectMaterialBox}">
                                <TextBlock Classes="materialHint" Text="上传：工程图（至少4张，自动生成）" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="#EEF1F5" />

                    <Border Classes="materialRow">
                        <StackPanel>
                            <ToggleSwitch x:Name="SourceInfoMaterialBox"
                                      Classes="materialOption"
                                          OnContent="原始文件或素材文件信息" OffContent="原始文件或素材文件信息" AutomationProperties.Name="原始文件或素材文件信息" IsCheckedChanged="OnMaterialSelectionChanged" />
                            <TextBlock Text="用于证明项目原始文件、角色及素材信息。"
                                       Classes="materialHint" IsVisible="{Binding IsChecked, ElementName=SourceInfoMaterialBox}" />
                            <StackPanel Classes="materialContents"
                                        IsVisible="{Binding IsChecked, ElementName=SourceInfoMaterialBox}">
                                <TextBlock Classes="materialHint" Text="上传包（按生产流水线已启用步骤自动整理）" />
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="materialFieldLabel" Text="剧本集数" TextWrapping="Wrap" />
                                    <NumericUpDown Classes="configurationInput" x:Name="EpisodeScriptEpisodeCountBox" Minimum="1" Maximum="120" Value="5" />
                                </StackPanel>
                                <TextBlock Text="固定生成01_剧本与项目资料.png；AI大纲、剧本仅在对应生产步骤启用时加入上传包"
                                           Classes="materialHint" />
                                <ToggleSwitch x:Name="UploadSourceInfoRoleVectorBox"
                                          OnContent="上传：角色矢量图.png（可选）" OffContent="上传：角色矢量图.png（可选）" AutomationProperties.Name="上传：角色矢量图.png（可选）" />
                                <UniformGrid x:Name="RoleVectorPeopleRow" Columns="2" IsVisible="{Binding IsChecked, ElementName=UploadSourceInfoRoleVectorBox}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Classes="materialFieldLabel" Text="角色矢量图目标人数" TextWrapping="Wrap" />
                                        <NumericUpDown Classes="configurationInput" x:Name="RoleVectorCharacterCountBox" Minimum="2" Maximum="6" Value="3" />
                                    </StackPanel>
                                    <StackPanel Spacing="5">
                                        <TextBlock Classes="materialFieldLabel" Text="角色矢量图最低人数" TextWrapping="Wrap" />
                                        <NumericUpDown Classes="configurationInput" x:Name="RoleVectorMinimumCharacterCountBox" Minimum="2" Maximum="6" Value="3" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="使用“生成角色矢量图”步骤产出的角色图"
                                           Classes="materialHint" IsVisible="{Binding IsChecked, ElementName=UploadSourceInfoRoleVectorBox}" />
                                <ToggleSwitch x:Name="UploadSourceInfoRoleSceneScreenshotBox"
                                          OnContent="同时上传 02_角色场景或项目素材.png（可选）" OffContent="同时上传 02_角色场景或项目素材.png（可选）" AutomationProperties.Name="同时上传 02_角色场景或项目素材.png（可选）" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
