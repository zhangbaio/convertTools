<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TikTokPublisher.Ui.Views.VideoDedupPresetEditor">
    <UserControl.Styles>
        <Style Selector="TextBlock.dedupLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource PythonTextBrush}" />
        </Style>
        <Style Selector="TextBlock.dedupHint">
            <Setter Property="Foreground" Value="{StaticResource PythonMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer>
        <StackPanel Spacing="14" Margin="2,4,2,8">
            <StackPanel Spacing="4">
                <TextBlock Text="视频去重" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Classes="dedupHint"
                           Text="只作用于当前账号。下载完成后按这里的方案处理，改写、剧本、证明材料和上传都使用去重后的成片。原片保留在项目的 source-originals 目录。" />
                <Button Content="同步到所有账号"
                        Classes="secondaryAction"
                        HorizontalAlignment="Left"
                        MinWidth="140"
                        Margin="0,6,0,0"
                        Click="OnApplyToAllAccountsClick" />
            </StackPanel>

            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto" ColumnSpacing="10">
                <TextBlock Classes="dedupLabel" Text="编码器" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <WrapPanel Orientation="Horizontal">
                        <RadioButton x:Name="EncoderAutoBox" GroupName="DedupEncoder" Content="自动选择" IsChecked="True" Margin="0,0,16,4" />
                        <RadioButton x:Name="EncoderSoftwareBox" GroupName="DedupEncoder" Content="CPU" Margin="0,0,16,4" />
                        <RadioButton x:Name="EncoderNvencBox" GroupName="DedupEncoder" Content="NVIDIA" Margin="0,0,16,4" />
                        <RadioButton x:Name="EncoderAmfBox" GroupName="DedupEncoder" Content="AMD" Margin="0,0,16,4" />
                        <RadioButton x:Name="EncoderQsvBox" GroupName="DedupEncoder" Content="Intel" Margin="0,0,16,4" />
                    </WrapPanel>
                    <TextBlock Classes="dedupHint" Text="自动选择会按本机显卡试编码，检测到的 NVIDIA、AMD 或 Intel 优先，都不可用时用 CPU。指定某一张显卡时，不可用就失败，不会改用别的显卡。" />
                </StackPanel>
            </Grid>

            <TextBlock Text="单集时长" FontWeight="SemiBold" />
            <TextBlock Classes="dedupHint" Text="两个都留 0 表示不重新分集。都大于 0 时按原片时长切开再拼接，每一集再做开头、结尾裁剪和变速。过短的尾集在不超过最大时长时并入上一集。成片仍短于 15 秒时并入相邻集，这时可以超过最大时长。" />
            <Grid ColumnDefinitions="140,*,140,*" ColumnSpacing="10">
                <TextBlock Classes="dedupLabel" Text="单集最小时长" />
                <NumericUpDown x:Name="MinDurationBox" Grid.Column="1" Minimum="0" Maximum="3600" Increment="1" FormatString="0" />
                <TextBlock Grid.Column="2" Classes="dedupLabel" Text="单集最大时长" />
                <NumericUpDown x:Name="MaxDurationBox" Grid.Column="3" Minimum="0" Maximum="7200" Increment="1" FormatString="0" />
            </Grid>

            <TextBlock Text="拼接转场" FontWeight="SemiBold" />
            <CheckBox x:Name="TransitionsEnabledBox" Content="启用转场" />
            <WrapPanel Orientation="Horizontal">
                <CheckBox x:Name="FadeBlackBox" Content="淡黑" Margin="0,0,16,6" />
                <CheckBox x:Name="DissolveBox" Content="交叉溶解" Margin="0,0,16,6" />
                <CheckBox x:Name="PushBox" Content="推拉" Margin="0,0,16,6" />
                <CheckBox x:Name="SlideBox" Content="滑动" Margin="0,0,16,6" />
                <CheckBox x:Name="ZoomBox" Content="缩放" Margin="0,0,16,6" />
            </WrapPanel>
            <TextBlock Classes="dedupHint" Text="只在不同原片拼成一集时使用，每处 0.3 到 0.6 秒。启用时至少选一种。短于 0.8 秒的片段改为直接拼接。" />

            <TextBlock Text="画面" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="140,*,140,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                <TextBlock Classes="dedupLabel" Text="开头裁剪（秒）" />
                <NumericUpDown x:Name="TrimStartBox" Grid.Column="1" Minimum="0" Maximum="30" Increment="0.1" FormatString="0.0" />
                <TextBlock Grid.Column="2" Classes="dedupLabel" Text="结尾裁剪（秒）" />
                <NumericUpDown x:Name="TrimEndBox" Grid.Column="3" Minimum="0" Maximum="30" Increment="0.1" FormatString="0.0" />

                <TextBlock Grid.Row="1" Classes="dedupLabel" Text="上下裁边 %" />
                <NumericUpDown x:Name="CropVerticalBox" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="39" Increment="1" FormatString="0" />
                <TextBlock Grid.Row="1" Grid.Column="2" Classes="dedupLabel" Text="左右裁边 %" />
                <NumericUpDown x:Name="CropHorizontalBox" Grid.Row="1" Grid.Column="3" Minimum="0" Maximum="39" Increment="1" FormatString="0" />

                <TextBlock Grid.Row="2" Classes="dedupLabel" Text="分辨率" />
                <ComboBox x:Name="ResolutionBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" />
                <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Classes="dedupHint" Text="裁边后短边小于 1080 会放大到可上传尺寸。横屏自动对调宽高。" VerticalAlignment="Center" />

                <TextBlock Grid.Row="3" Classes="dedupLabel" Text="视频变速" />
                <NumericUpDown x:Name="SpeedBox" Grid.Row="3" Grid.Column="1" Minimum="0.5" Maximum="2" Increment="0.1" FormatString="0.00" />
                <TextBlock Grid.Row="3" Grid.Column="2" Classes="dedupLabel" Text="随机抽帧 %" />
                <NumericUpDown x:Name="FrameDropBox" Grid.Row="3" Grid.Column="3" Minimum="0" Maximum="40" Increment="1" FormatString="0" />
            </Grid>

            <Button Content="画面滤镜与预览..." HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnOpenEffectsClick" />
            <TextBlock x:Name="FilterSummaryText" Classes="dedupHint" Text="未启用。数值为 0 时不参与去重。" />

            <TextBlock Text="视频编码" FontWeight="SemiBold" />
            <WrapPanel Orientation="Horizontal">
                <RadioButton x:Name="CodecDefaultBox" GroupName="DedupVideoCodec" Content="默认" Margin="0,0,16,6" />
                <RadioButton x:Name="CodecH264Box" GroupName="DedupVideoCodec" Content="H.264" Margin="0,0,16,6" IsChecked="True" />
                <RadioButton x:Name="CodecHevcBox" GroupName="DedupVideoCodec" Content="HEVC" Margin="0,0,16,6" />
                <RadioButton x:Name="CodecH265Box" GroupName="DedupVideoCodec" Content="H.265" Margin="0,0,16,6" />
            </WrapPanel>
            <Grid ColumnDefinitions="140,*,140,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                <TextBlock Classes="dedupLabel" Text="帧率" />
                <NumericUpDown x:Name="FpsBox" Grid.Column="1" Minimum="15" Maximum="60" Increment="1" FormatString="0" />
                <TextBlock Grid.Column="2" Classes="dedupLabel" Text="码率模式" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12">
                    <RadioButton x:Name="RateCbrBox" GroupName="DedupRate" Content="CBR" />
                    <RadioButton x:Name="RateVbrBox" GroupName="DedupRate" Content="VBR" IsChecked="True" />
                    <RadioButton x:Name="RateCrfBox" GroupName="DedupRate" Content="CRF" />
                </StackPanel>
                <TextBlock Grid.Row="1" Classes="dedupLabel" Text="视频码率 Mbps" />
                <NumericUpDown x:Name="VideoBitrateBox" Grid.Row="1" Grid.Column="1" Minimum="0.5" Maximum="20" Increment="0.1" FormatString="0.0" />
                <TextBlock Grid.Row="1" Grid.Column="2" Classes="dedupLabel" Text="CRF 质量" />
                <NumericUpDown x:Name="CrfBox" Grid.Row="1" Grid.Column="3" Minimum="18" Maximum="32" Increment="1" FormatString="0" />
            </Grid>

            <TextBlock Text="音频" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <RadioButton x:Name="AudioDefaultBox" GroupName="DedupAudio" Content="默认" />
                <RadioButton x:Name="AudioAacBox" GroupName="DedupAudio" Content="AAC" IsChecked="True" />
            </StackPanel>
            <Grid ColumnDefinitions="140,*" ColumnSpacing="10">
                <TextBlock Classes="dedupLabel" Text="音频码率 Kbps" />
                <NumericUpDown x:Name="AudioBitrateBox" Grid.Column="1" Minimum="0" Maximum="320" Increment="16" FormatString="0" />
            </Grid>
            <TextBlock Classes="dedupHint" Text="音频码率填 0 时使用 128 Kbps。变速、抽帧、裁剪或均衡开启时会重新编码音频。" />

            <Grid ColumnDefinitions="140,*,140,*,140,*" ColumnSpacing="10">
                <TextBlock Classes="dedupLabel" Text="低频 100 Hz" />
                <NumericUpDown x:Name="LowGainBox" Grid.Column="1" Minimum="-12" Maximum="12" Increment="1" FormatString="0" />
                <TextBlock Grid.Column="2" Classes="dedupLabel" Text="中频 1 kHz" />
                <NumericUpDown x:Name="MidGainBox" Grid.Column="3" Minimum="-12" Maximum="12" Increment="1" FormatString="0" />
                <TextBlock Grid.Column="4" Classes="dedupLabel" Text="高频 8 kHz" />
                <NumericUpDown x:Name="HighGainBox" Grid.Column="5" Minimum="-12" Maximum="12" Increment="1" FormatString="0" />
            </Grid>
            <Button Content="均衡器归零" HorizontalAlignment="Left" Click="OnResetEqualizerClick" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
