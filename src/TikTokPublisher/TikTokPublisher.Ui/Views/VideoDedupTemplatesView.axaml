<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:TikTokPublisher.Ui.Views"
             x:Class="TikTokPublisher.Ui.Views.VideoDedupTemplatesView">
    <Grid x:Name="WorkspaceForm" RowDefinitions="Auto,*,Auto" RowSpacing="8" Margin="10,8,10,8">
        <Border Classes="controlsFrame" Padding="10,8">
            <StackPanel Spacing="8">
                <TextBlock x:Name="AccountSummary" TextWrapping="Wrap" Classes="pageSummary" />
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="去重模板" VerticalAlignment="Center" Margin="0,0,8,4" FontWeight="SemiBold" />
                    <ComboBox x:Name="TemplateSelector" Width="245" SelectionChanged="OnTemplateSelectionChanged"
                              AutomationProperties.Name="去重模板" Margin="0,0,8,4" />
                    <Button Content="新建" Click="OnNewClick" Classes="secondaryAction" Margin="0,0,6,4" />
                    <Button Content="复制" Click="OnCopyClick" Classes="secondaryAction" Margin="0,0,6,4" />
                    <Button x:Name="DeleteButton" Content="删除模板" Click="OnDeleteClick" Classes="dangerSoftAction" Margin="0,0,6,4" />
                </WrapPanel>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="模板名称" VerticalAlignment="Center" />
                    <TextBox x:Name="TemplateName" Grid.Column="1" Watermark="例如 保留原分集" />
                    <TextBlock x:Name="UsageSummary" Grid.Column="2" Classes="pageSummary" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>
        <views:VideoDedupPresetEditor x:Name="PresetEditor" Grid.Row="1" />
        <Border Grid.Row="2" Classes="controlsFrame" Padding="10,8">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock x:Name="FeedbackText" Classes="pageSummary" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button x:Name="ApplyButton" Grid.Column="1" Content="设为当前账号默认" Classes="secondaryAction" Click="OnApplyClick" />
                <Button x:Name="SaveButton" Grid.Column="2" Content="保存模板" Classes="primaryAction" Click="OnSaveClick" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
