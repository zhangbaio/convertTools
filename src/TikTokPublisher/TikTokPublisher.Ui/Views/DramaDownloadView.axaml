<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TikTokPublisher.Ui.ViewModels"
             x:Class="TikTokPublisher.Ui.Views.DramaDownloadView"
             x:DataType="vm:DramaDownloadViewModel"
             Background="{StaticResource PythonPageBgBrush}">

    <DockPanel Margin="16,14,16,16">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
            <TextBlock Grid.Column="0" Text="下载目录" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Grid.Column="1" Text="{Binding DownloadWorkspace}" IsReadOnly="True" Watermark="选择下载目录" />
            <Button Grid.Column="2" Content="选择下载目录" Click="OnPickDownloadDirClick" Margin="10,0,0,0" />
        </Grid>

        <TabControl>
            <TabItem Header="搜索">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBox Width="280" Watermark="搜索关键词" Text="{Binding SearchKeyword, Mode=TwoWay}" Margin="0,0,8,8" />
                        <Button Content="搜索" Command="{Binding SearchCommand}" Classes="primaryAction" Margin="0,0,8,8" />
                        <Button Content="今日上新" Command="{Binding LoadTodayCommand}" Margin="0,0,8,8" />
                        <CheckBox Content="精确搜索" IsChecked="{Binding ExactSearch}" Margin="0,0,8,8" VerticalAlignment="Center" />
                        <Button Content="下载选中" Command="{Binding DownloadSelectedCommand}" Margin="0,0,8,8" />
                        <TextBlock Text="{Binding SelectedCountText}" VerticalAlignment="Center" Classes="pageSummary" Margin="0,0,8,8" />
                    </WrapPanel>

                    <Grid DockPanel.Dock="Top" ColumnDefinitions="56,64,*,100,72,100,100,*" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="序号" Classes="tableHeader" />
                        <TextBlock Grid.Column="1" Text="选择" Classes="tableHeader" />
                        <TextBlock Grid.Column="2" Text="标题" Classes="tableHeader" />
                        <TextBlock Grid.Column="3" Text="作者" Classes="tableHeader" />
                        <TextBlock Grid.Column="4" Text="集数" Classes="tableHeader" />
                        <TextBlock Grid.Column="5" Text="收藏量" Classes="tableHeader" />
                        <TextBlock Grid.Column="6" Text="类型" Classes="tableHeader" />
                        <TextBlock Grid.Column="7" Text="简介" Classes="tableHeader" />
                    </Grid>

                    <ListBox ItemsSource="{Binding SearchResults}" Background="{StaticResource PythonInputBg}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DramaSearchRowViewModel">
                                <Grid ColumnDefinitions="56,64,*,100,72,100,100,*" MinHeight="34">
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="8,0" Text="{Binding RowIndex}" />
                                    <CheckBox Grid.Column="1" IsChecked="{Binding Selected}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" Foreground="#0F63C7" />
                                    <TextBlock Grid.Column="3" Text="{Binding Author}" VerticalAlignment="Center" Margin="8,0" FontSize="12" />
                                    <TextBlock Grid.Column="4" Text="{Binding EpisodeTotal}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBlock Grid.Column="5" Text="{Binding FavoriteText}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBlock Grid.Column="6" Text="{Binding Category}" VerticalAlignment="Center" Margin="8,0" FontSize="12" />
                                    <TextBlock Grid.Column="7" Text="{Binding Intro}" VerticalAlignment="Center" Margin="8,0" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <TabItem Header="下载队列">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Content="开始下载" Command="{Binding StartDownloadQueueCommand}" Classes="primaryAction" Margin="0,0,8,8" />
                        <Button Content="停止" Command="{Binding StopDownloadQueueCommand}" Classes="dangerAction" Margin="0,0,8,8" />
                        <Button Content="导入上传队列" Command="{Binding ImportCompletedToQueueCommand}" Margin="0,0,8,8" />
                        <Button Content="清空已完成" Command="{Binding ClearCompletedQueueCommand}" Margin="0,0,8,8" />
                        <Button Content="删除全部" Command="{Binding ClearAllQueueCommand}" Classes="dangerAction" Margin="0,0,8,8" />
                        <TextBlock Text="并发" VerticalAlignment="Center" Margin="0,0,4,8" />
                        <NumericUpDown Value="{Binding DownloadConcurrent}" Minimum="1" Maximum="10" Width="90" Margin="0,0,8,8" />
                        <TextBlock Text="{Binding QueueStatsText}" VerticalAlignment="Center" Classes="pageSummary" Margin="0,0,8,8" />
                    </WrapPanel>

                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,72,120,100,100,*" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="剧名" Classes="tableHeader" />
                        <TextBlock Grid.Column="1" Text="集数" Classes="tableHeader" />
                        <TextBlock Grid.Column="2" Text="状态" Classes="tableHeader" />
                        <TextBlock Grid.Column="3" Text="进度" Classes="tableHeader" />
                        <TextBlock Grid.Column="4" Text="速度" Classes="tableHeader" />
                        <TextBlock Grid.Column="5" Text="详情" Classes="tableHeader" />
                    </Grid>

                    <ListBox ItemsSource="{Binding QueueRows}" Background="{StaticResource PythonInputBg}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DramaQueueRowViewModel">
                                <Grid ColumnDefinitions="*,72,120,100,100,*" MinHeight="34">
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding EpisodeCount}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding Progress}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBlock Grid.Column="4" Text="{Binding Speed}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBlock Grid.Column="5" Text="{Binding Detail}" VerticalAlignment="Center" Margin="8,0" FontSize="12" TextTrimming="CharacterEllipsis" Classes="pageSummary" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <TabItem Header="设置">
                <ScrollViewer>
                    <StackPanel Spacing="10" Margin="8" MaxWidth="720">
                        <TextBlock Text="下载目录" FontWeight="SemiBold" />
                        <TextBox Text="{Binding DownloadWorkspace}" IsReadOnly="True" />
                        <CheckBox Content="下载后自动生成素材" IsChecked="{Binding AutoGenerateMaterials}" />
                        <TextBlock Text="下载清晰度" />
                        <ComboBox x:Name="QualityCombo" HorizontalAlignment="Stretch" SelectionChanged="OnQualityChanged">
                            <ComboBoxItem Content="1080P+" />
                            <ComboBoxItem Content="1080P" IsSelected="True" />
                            <ComboBoxItem Content="720P" />
                            <ComboBoxItem Content="480P" />
                        </ComboBox>
                        <TextBlock Text="剧集命名" />
                        <ComboBox x:Name="EpisodeModeCombo" HorizontalAlignment="Stretch" SelectionChanged="OnEpisodeModeChanged">
                            <ComboBoxItem Content="保留源集号" Tag="source" IsSelected="True" />
                            <ComboBoxItem Content="连续重编号" Tag="continuous" />
                        </ComboBox>
                        <TextBlock Text="分类包含（一行一个，可选）" />
                        <TextBox AcceptsReturn="True" MinHeight="60" Text="{Binding CategoryInclude, Mode=TwoWay}" />
                        <TextBlock Text="分类排除（一行一个，可选）" />
                        <TextBox AcceptsReturn="True" MinHeight="60" Text="{Binding CategoryExclude, Mode=TwoWay}" />
                        <TextBlock Text="作者排除（一行一个，可选）" />
                        <TextBox AcceptsReturn="True" MinHeight="60" Text="{Binding AuthorExclude, Mode=TwoWay}" />
                        <Button Content="保存当前页面配置" Click="OnSaveSettingsClick" Classes="primaryAction" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
