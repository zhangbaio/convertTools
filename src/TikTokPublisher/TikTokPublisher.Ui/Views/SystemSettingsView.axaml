<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TikTokPublisher.Ui.ViewModels"
             x:Class="TikTokPublisher.Ui.Views.SystemSettingsView"
             x:DataType="vm:SystemSettingsViewModel"
             Background="{StaticResource PythonPageBgBrush}">

    <DockPanel Margin="16,14,16,16">
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="pageSummary" Text="{Binding SaveMessage}" />
            <Button Grid.Column="1" Content="保存设置" Command="{Binding SaveSettingsCommand}" Classes="primaryAction" MinWidth="140" />
        </Grid>

        <TextBlock DockPanel.Dock="Top" Text="系统设置" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />

        <TabControl Classes="secondaryTabs">
            <TabItem Header="登录设置">
                <ScrollViewer>
                    <StackPanel Spacing="14" Margin="4">
                        <TextBlock Text="短剧搜索、下载和数据链路参数为全局共享配置；TikTok 登录信息请到账号管理的登录设置中维护。"
                                   TextWrapping="Wrap" Classes="pageSummary" />

                        <TextBlock Text="数据链路与下载参数" FontWeight="Bold" />
                        <TextBlock Text="选择短剧来源链路，并配置下载任务的通用参数。" Classes="pageSummary" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="数据链路" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="DramaSourceCombo" HorizontalAlignment="Stretch" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="默认清晰度" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DramaDownloadDefaultQuality}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="分集下载并发" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding DramaDownloadConcurrent}" Minimum="1" Maximum="10" Width="120" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="同时下载剧数" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding DramaDownloadMaxParallelProjects}" Minimum="1" Maximum="4" Width="120" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="单集分块连接数" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding DownloadFileSegments}" Minimum="1" Maximum="8" Width="120" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="下载超时(秒)" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding HongguoDownloadTimeoutSeconds}" Minimum="10" Maximum="300" Width="120" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="单集重试次数" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding HongguoEpisodeDownloadAttempts}" Minimum="1" Maximum="10" Width="120" HorizontalAlignment="Left" />
                        </Grid>

                        <Separator Margin="0,4" />

                        <TextBlock Text="红果新接口账号" FontWeight="Bold" />
                        <TextBlock Text="用于红果新接口搜索和下载；设备唯一标识需要与登录设备保持一致。" Classes="pageSummary" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="红果账号" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HgnewAccount}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="红果密码" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HgnewPassword}" PasswordChar="●" RevealPassword="False" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="设备唯一标识" VerticalAlignment="Center" />
                            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0"
                                         Text="{Binding HgnewUdid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="读取设备标识" Command="{Binding ReadHgnewUdidCommand}" MinWidth="120" />
                                <Button Grid.Column="2" Content="生成新设备标识" Command="{Binding GenerateHgnewUdidCommand}" MinWidth="110" />
                                <Button Grid.Column="3" Content="测试登录" Command="{Binding ProbeHgnewLoginCommand}" MinWidth="96" />
                            </Grid>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="客户端版本" VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Text="{Binding HgnewClientVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Watermark="仅支持 1.4.x（带连字符大写 GUID）" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="测试结果" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HgnewProbeStatus}" TextWrapping="Wrap" Classes="pageSummary" />
                        </Grid>

                        <Separator Margin="0,4" />

                        <TextBlock Text="本地直连链路（自建红果接口服务）" FontWeight="Bold" />
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="本地链路地址" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HongguoLocalBaseUrl}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="本地链路密钥" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HongguoLocalApiKey}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="下载模式" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1"
                                      x:Name="HongguoLocalDownloadModeCombo"
                                      Width="180"
                                      HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="转码引擎" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="3" Grid.Column="1"
                                      x:Name="HongguoLocalTranscodeEngineCombo"
                                      Width="180"
                                      HorizontalAlignment="Left" />

                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="测试本地直连" Command="{Binding ProbeHongguoLocalCommand}" MinWidth="110" />
                                <TextBlock Text="{Binding HongguoLocalProbeStatus}" VerticalAlignment="Center" Classes="pageSummary" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,4" />

                        <TextBlock Text="皮卡丘链路（红果 v1.4.9）" FontWeight="Bold" />
                        <TextBlock Text="红果短剧搜索需要番茄 Cookie；红果漫剧类型13免 Cookie。详情与视频解析走皮卡丘代理。" Classes="pageSummary" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="搜索内容类型" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="PikachuTypeCombo" HorizontalAlignment="Stretch" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="皮卡丘服务地址" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PikachuServerUrl}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="番茄 Cookie" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0"
                                         Text="{Binding PikachuFanqieCookie}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="88"
                                         Watermark="install_id=...; ttreq=...; odin_tt=..." />
                                <Button Grid.Column="1"
                                        Content="从红果读取"
                                        Command="{Binding ReadPikachuCookieCommand}"
                                        IsEnabled="{Binding !IsPikachuBusy}"
                                        MinWidth="110"
                                        VerticalAlignment="Top" />
                            </Grid>

                            <TextBlock Grid.Row="3" Grid.Column="0" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="Cookie 约数周过期；短剧搜索失败时请启动红果客户端、执行一次搜索后重新读取。"
                                       Classes="pageSummary"
                                       TextWrapping="Wrap" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="链路测试" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <StackPanel Grid.Row="4" Grid.Column="1" Spacing="8">
                                <Button Content="测试皮卡丘链路" Command="{Binding ProbePikachuConnectivityCommand}" MinWidth="140" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding PikachuProbeStatus}" TextWrapping="Wrap" Classes="pageSummary" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="ASR配置">
                <ScrollViewer>
                    <StackPanel Spacing="14" Margin="4">
                        <TextBlock Text="ASR 引擎" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="测试本地模型" Command="{Binding ProbeLocalAsrCommand}" />
                            <Button Content="测试火山 ASR" Command="{Binding ProbeVolcengineAsrCommand}" />
                            <TextBlock Text="{Binding AsrProbeStatus}" VerticalAlignment="Center" Classes="pageSummary" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ASR 引擎" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="AsrEngineCombo" HorizontalAlignment="Stretch" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="本地模型目录" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TiktokSilenceLocalModelDir}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="本地VAD路径" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TiktokSilenceLocalVadPath}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="混合复核下限" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding TiktokSilenceHybridLowSeconds}" Minimum="0" Maximum="120" Increment="0.5" Width="120" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="混合复核上限" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding TiktokSilenceHybridHighSeconds}" Minimum="0" Maximum="120" Increment="0.5" Width="120" HorizontalAlignment="Left" />
                        </Grid>

                        <TextBlock Text="ASR 凭据" FontWeight="Bold" />
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ASR AppID" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TiktokSilenceAsrAppId}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="ASR AccessToken" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TiktokSilenceAsrAccessToken}" PasswordChar="●" RevealPassword="False" />
                        </Grid>

                        <TextBlock Text="静音检测与修复" FontWeight="Bold" />
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ASR静音阈值" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding TiktokSilenceAsrThresholdSeconds}" Minimum="5" Maximum="120" Width="120" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="静音修复方式" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SilenceRepairModeCombo" HorizontalAlignment="Stretch" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="静音修复目标时长" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding TiktokSilenceRepairTargetSeconds}" Minimum="3" Maximum="120" Increment="0.5" Width="120" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="静音修复最大倍速" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding TiktokSilenceRepairMaxSpeed}" Minimum="1.1" Maximum="4" Increment="0.05" Width="120" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="静音修复失败阻断" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding TiktokSilenceRepairBlocking}" Content="修复失败时判定项目失败" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="ASR并发数" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding TiktokSilenceDetectConcurrency}" Minimum="1" Maximum="16" Width="120" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="识别语言" VerticalAlignment="Center" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding TiktokSilenceAsrLanguage}" Width="140" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="素材校验并发" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="7" Grid.Column="1" Value="{Binding TiktokMaterialValidateConcurrency}" Minimum="1" Maximum="16" Width="120" HorizontalAlignment="Left" />
                        </Grid>

                        <TextBlock Text="上传异常处理" FontWeight="Bold" />
                        <TextBlock Text="项目上传异常时自动标记失败并跳过，继续执行后续队列；单日创建上限等明确限制仍会停止队列。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="AI文本">
                <ScrollViewer>
                    <StackPanel Spacing="14" Margin="4">
                        <TextBlock Text="文本接口" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                            <Button Content="测试 AI 文本" Command="{Binding ProbeAiTextCommand}" MinWidth="110" />
                            <TextBlock Text="{Binding AiTextProbeStatus}" VerticalAlignment="Center" Classes="pageSummary" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="接口地址" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AiTextEndpoint}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="API Key" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AiTextApiKey}" PasswordChar="●" RevealPassword="False" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="模型名称" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AiTextModel}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="请求超时" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding AiTextTimeoutSeconds}" Minimum="10" Maximum="600" Width="120" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="单批项目数" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding AiTextMaxBatchSize}" Minimum="1" Maximum="50" Width="120" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="标签 System Prompt" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding AiTagSystemPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="标签 Batch Prompt" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding AiTagBatchPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="完整信息 System Prompt" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding AiFullInfoSystemPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="完整信息 Batch Prompt" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding AiFullInfoBatchPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
                        </Grid>
                        <TextBlock Text="完整信息 Retry Prompt" FontWeight="Bold" />
                        <TextBox Text="{Binding AiFullInfoRetryPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="AI图片">
                <ScrollViewer>
                    <StackPanel Spacing="14" Margin="4">
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="海报模式" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="PosterModeCombo" HorizontalAlignment="Stretch" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="图片提供商" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ImageProviderCombo" HorizontalAlignment="Stretch" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="模型 ID" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ImageModelId}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="模型 API Key" VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ImageModelApiKey}" PasswordChar="●" RevealPassword="False" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="模型 Endpoint" VerticalAlignment="Center" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ImageModelEndpoint}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="豆包分辨率" VerticalAlignment="Center" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding DoubaoImageResolution}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="豆包比例" VerticalAlignment="Center" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding DoubaoImageRatio}" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Ofox 模型 ID" VerticalAlignment="Center" />
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding OfoxImage2ModelId}" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Ofox API Key" VerticalAlignment="Center" />
                            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding OfoxImage2ApiKey}" PasswordChar="●" RevealPassword="False" />

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Ofox Endpoint" VerticalAlignment="Center" />
                            <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding OfoxImage2Endpoint}" />

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Ofox 质量" VerticalAlignment="Center" />
                            <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding OfoxImage2Quality}" />

                            <TextBlock Grid.Row="11" Grid.Column="0" Text="Ofox 尺寸" VerticalAlignment="Center" />
                            <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding OfoxImage2Size}" />

                            <TextBlock Grid.Row="12" Grid.Column="0" Text="标题校验" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <CheckBox IsChecked="{Binding PosterTitleVerifyEnabled}" Content="启用海报标题校验" />
                                <ComboBox x:Name="PosterTitleVerifyModeCombo" Width="180" />
                            </StackPanel>

                            <TextBlock Grid.Row="13" Grid.Column="0" Text="AI 修复重试" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="13" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <NumericUpDown Value="{Binding PosterTitleVerifyAiRetryCount}"
                                               Minimum="0"
                                               Maximum="3"
                                               Increment="1"
                                               Width="90" />
                                <TextBlock Text="次（标题写错时先让 AI 局部修正，耗尽后才按校验模式处理）"
                                           VerticalAlignment="Center"
                                           Foreground="#666" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="PosterModeHintText"
                                   Foreground="#666"
                                   TextWrapping="Wrap" />

                        <Border x:Name="FrameExtractSettingsPanel"
                                IsVisible="False"
                                BorderBrush="#D7DFEA"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="视频抽帧设置" FontWeight="Bold" />
                                <Grid ColumnDefinitions="140,*"
                                      RowDefinitions="Auto,Auto,Auto,Auto"
                                      RowSpacing="10"
                                      ColumnSpacing="10">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="抽帧集数" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Row="0"
                                                   Grid.Column="1"
                                                   Value="{Binding FrameExtractEpisodeIndex}"
                                                   Minimum="1"
                                                   Maximum="999"
                                                   Increment="1"
                                                   Width="120"
                                                   HorizontalAlignment="Left" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="首选抽帧时间" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <NumericUpDown Value="{Binding FrameExtractTime}"
                                                       Minimum="0.1"
                                                       Maximum="600"
                                                       Increment="0.1"
                                                       Width="120" />
                                        <TextBlock Text="秒" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="邻近补充秒数" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2"
                                             Grid.Column="1"
                                             Text="{Binding FrameExtractNeighborOffsetsSeconds}"
                                             Watermark="例如：2,4" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="兜底时间百分比" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="3"
                                             Grid.Column="1"
                                             Text="{Binding FrameExtractFallbackPercents}"
                                             Watermark="例如：10,25,50,75" />
                                </Grid>
                                <TextBlock Text="抽帧顺序：先尝试指定集数和时间点，再尝试邻近秒数，最后按全片时长百分比兜底。"
                                           Foreground="#666"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Prompt 配置" FontWeight="Bold" />
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Frame Cover" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FrameCoverPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="布局检测" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PosterLayoutDetectPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="局部改字" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PosterInpaintPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="整图改字" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PosterGenerationPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="局部改字安全重试" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PosterInpaintSafeRetryPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="整图改字安全重试" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding PosterGenerationSafeRetryPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="海报名 System" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding PosterNameSystemPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="海报名 User" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding PosterNameUserPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="工程图">
                <ScrollViewer>
                    <StackPanel Spacing="14" Margin="4">
                        <TextBlock Text="TikTok 工程图" FontWeight="Bold" />
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="生成方式" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ProjectImageGenerationModeCombo" Width="260" HorizontalAlignment="Left" />

                            <Grid Grid.Row="1" Grid.ColumnSpan="2"
                                  ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="10" ColumnSpacing="10"
                                  IsVisible="{Binding IsProjectImageTemplateMode}">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="模板根目录" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TiktokProjectImageTemplateRoot}" Watermark="留空使用内置模板" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="截图模板" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ProjectImageTemplateCombo"
                                          Width="460" HorizontalAlignment="Left" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="工程图AI台词" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ProjectImageSubtitleAiModeCombo" Width="180" HorizontalAlignment="Left" />
                            </Grid>

                            <Grid Grid.Row="1" Grid.ColumnSpan="2"
                                  ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="10" ColumnSpacing="10"
                                  IsVisible="{Binding IsProjectImageFableCutMode}">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="FableCut目录" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TiktokProjectImageFableCutRoot}" Watermark="留空使用内置 FableCut" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="时间线片段数" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding TiktokProjectImageFableCutClipCount}" Minimum="12" Maximum="36" Width="120" HorizontalAlignment="Left" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="截图样式" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="标准工程图" IsReadOnly="True" />
                            </Grid>

                            <Grid Grid.Row="2" Grid.ColumnSpan="2"
                                  ColumnDefinitions="140,*" RowDefinitions="Auto,Auto"
                                  RowSpacing="10" ColumnSpacing="10">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="工程图数量" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding TiktokProjectImageCount}" Minimum="1" Maximum="20" Width="120" HorizontalAlignment="Left" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="工程图导入集数" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding TiktokProjectImageRenderEpisodeLimit}" Minimum="1" Maximum="200" Width="120" HorizontalAlignment="Left" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="证明材料">
                <ScrollViewer>
                    <StackPanel Spacing="14" Margin="4">
                        <TextBlock Text="TikTok 证明材料" FontWeight="Bold" />
                        <TextBlock Text="以 Word 模板生成权利声明 PDF；PDF 渲染器默认使用 WPS。公司与印章信息按账号分别配置。" Classes="pageSummary" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Word 模板" VerticalAlignment="Center" />
                            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding TiktokProofTemplateDocxPath}" Watermark="留空使用软件内置模板" />
                                <Button Grid.Column="1" Content="浏览…" Click="OnBrowseProofTemplateClick" Margin="8,0,0,0" />
                            </Grid>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="WPS 路径" VerticalAlignment="Center" />
                            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding TiktokProofWpsPath}" Watermark="留空自动检测 WPS 程序" />
                                <Button Grid.Column="1" Content="浏览…" Click="OnBrowseProofWpsClick" Margin="8,0,0,0" />
                            </Grid>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="PDF 渲染器" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ProofPdfRendererCombo" Width="220" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="中间文件" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding TiktokProofKeepDocx}" Content="保留生成后的 DOCX" />
                        </Grid>
                        <TextBlock Text="本公司/声明人、印章图片和致贵方名称请在账号管理的“证明材料”页签配置；改写后剧名和当天日期由队列自动填入。"
                                   Classes="pageSummary" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="数据存储">
                <ScrollViewer>
                    <StackPanel Spacing="14" Margin="4">
                        <TextBlock Text="数据库位置" FontWeight="Bold" />
                        <TextBlock Text="主数据库保存账号、共享设置、执行历史和 AI 改写历史；工作区数据库保存当前上传队列和归档记录。"
                                   Classes="pageSummary" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="主数据库" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MainDatabasePath}" IsReadOnly="True" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="工作区数据库" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WorkspaceDatabasePath}" IsReadOnly="True" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="刷新统计" Command="{Binding RefreshDatabaseStatsCommand}" />
                            <Button Content="打开主库目录" Command="{Binding OpenMainDatabaseFolderCommand}" />
                            <Button Content="打开工作区库目录" Command="{Binding OpenWorkspaceDatabaseFolderCommand}" />
                            <Button Content="备份主库" Command="{Binding BackupMainDatabaseCommand}" />
                            <Button Content="备份工作区库" Command="{Binding BackupWorkspaceDatabaseCommand}" />
                            <Button Content="压缩主库" Command="{Binding CompactMainDatabaseCommand}" />
                        </StackPanel>

                        <TextBlock Text="TikTok 队列与管理系统" FontWeight="Bold" />
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Excel 自动导出" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding TiktokExcelAutoExportEnabled}" Content="队列状态变化后自动导出 Excel" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="管理系统去重" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding ManagementDedupEnabled}" Content="上传短剧批量导入前检查原剧名重复" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="去重范围" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ManagementDedupScopeCombo" Width="220" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="超长剧入队" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding TiktokAllowOverLimitUploadImport}" Content="超过 120 集仍加入队列，并只下载前 N 集" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="超长剧下载集数" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding TiktokOverLimitDownloadEpisodeCount}" Minimum="1" Maximum="120" Width="120" HorizontalAlignment="Left" />
                        </Grid>

                        <TextBlock Text="数据统计" FontWeight="Bold" />
                        <TextBox Text="{Binding DatabaseStatsText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
