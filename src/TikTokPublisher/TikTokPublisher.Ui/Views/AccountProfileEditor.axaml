    <UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TikTokPublisher.Ui.Views"
             x:Class="TikTokPublisher.Ui.Views.AccountProfileEditor"
             Background="{StaticResource PythonPageBgBrush}">

    <UserControl.Styles>
        <Style Selector="Border.accountActionBar">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
            <Setter Property="Padding" Value="14,10" />
        </Style>

        <Style Selector="Grid.profileForm TextBlock.formLabel">
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Grid.profileForm TextBox">
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="Grid.profileForm ComboBox">
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="Grid.profileForm NumericUpDown">
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="TabControl.accountTabs">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="TabControl.accountTabs TabItem">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="Padding" Value="0,0,0,6" />
            <Setter Property="Margin" Value="0,0,22,8" />
        </Style>

        <Style Selector="TabControl.accountTabs TabItem:selected">
            <Setter Property="Foreground" Value="{StaticResource PythonPrimaryBrush}" />
        </Style>

        <Style Selector="Window.compact TabControl.accountTabs TabItem">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,16,6" />
        </Style>
    </UserControl.Styles>

    <DockPanel Classes="pageRoot">
        <Border DockPanel.Dock="Bottom" Classes="accountActionBar" Margin="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button Content="同步账号配置" Click="OnSyncAccountsClick" Classes="secondaryAction" />
                    <Button Content="登录账号" Click="OnLoginClick" Classes="secondaryAction" />
                    <Button Content="重新登录账号" Click="OnReloginClick" Classes="secondaryAction" />
                    <Button Content="退出登录" Click="OnLogoutClick" Classes="dangerAction" />
                </StackPanel>
                <Button Grid.Column="1" Content="保存账号配置" Click="OnSaveClick" Classes="primaryAction" MinWidth="140" />
            </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="账号配置" Classes="pageTitle" Margin="0,0,0,10" />

        <Border Classes="configurationPanel">
            <TabControl x:Name="AccountTabs" Classes="accountTabs">
            <TabItem Header="发布配置">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="2,4,2,8" SizeChanged="OnPublishFormSizeChanged">
                        <StackPanel x:Name="PublishForm" MaxWidth="1080" HorizontalAlignment="Left" Spacing="10">
                            <StackPanel.Styles>
                                <StyleInclude Source="avares://TikTokPublisher.Ui/Themes/ConfigurationFormStyles.axaml" />
                                <Style Selector="StackPanel.publishField">
                                    <Setter Property="Margin" Value="0,0,12,0" />
                                </Style>
                                <Style Selector="StackPanel.publishField TextBlock.formLabel">
                                    <Setter Property="Foreground" Value="#1F2937" />
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                                <Style Selector="StackPanel.publishField ComboBox">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style>
                            </StackPanel.Styles>
                            <TextBlock Text="账号登录" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <StackPanel Classes="publishField" Spacing="4">
                                <TextBlock Classes="formLabel" Text="登录状态" />
                                <TextBlock x:Name="LoginStatusText" Classes="pageSummary" TextWrapping="Wrap" Text="尚未登录" />
                            </StackPanel>

                            <UniformGrid Classes="publishRow" Columns="2">
                                <StackPanel Classes="publishField" Spacing="5">
                                    <TextBlock Classes="formLabel" Text="账号昵称" />
                                    <TextBox Classes="configurationInput" x:Name="NicknameBox" Watermark="用于左侧账号列表显示，可留空" />
                                </StackPanel>
                                <StackPanel Classes="publishField" Spacing="5">
                                    <TextBlock Classes="formLabel" Text="TikTok 用户名" />
                                    <TextBox Classes="configurationInput" x:Name="LoginEmailBox" Watermark="邮箱或用户名" />
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Classes="publishRow" Columns="2">
                                <StackPanel Classes="publishField" Spacing="5">
                                    <TextBlock Classes="formLabel" Text="TikTok 密码" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Classes="configurationInput" x:Name="PasswordBox" PasswordChar="●" RevealPassword="False"
                                                 AutomationProperties.Name="TikTok 密码" Watermark="可选，仅本地保存" />
                                        <Button Grid.Column="1" x:Name="PasswordVisibilityButton" Click="OnPasswordVisibilityClick"
                                                AutomationProperties.Name="显示密码" ToolTip.Tip="显示密码" VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Center" Width="40">
                                            <PathIcon Width="16" Height="16"
                                                      Data="M 0,8 C 4,1 12,1 16,8 C 12,15 4,15 0,8 Z M 8,5 A 3,3 0 1 0 8,11 A 3,3 0 1 0 8,5 Z" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </UniformGrid>

                            <Border Height="1" Background="#E4E9F0" Margin="0,8,12,0" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="上传材料" Classes="configurationHeading" />
                                    <TextBlock x:Name="MaterialStatus" Classes="pageSummary" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="仅选择最低标准" VerticalAlignment="Top"
                                        Click="OnSelectMinimumMaterialsClick" />
                            </Grid>
                            <views:CopyrightMaterialSelector x:Name="CopyrightMaterials" />

                            <Border Height="1" Background="#E4E9F0" Margin="0,8,12,0" />
                            <TextBlock Text="剧集与版权" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />

                            <UniformGrid Classes="publishRow" Columns="2">
                                <StackPanel Classes="publishField" Spacing="5">
                                    <TextBlock Classes="formLabel" Text="剧集类型" TextWrapping="Wrap" />
                                    <ComboBox Classes="configurationInput"
                                              x:Name="DramaMarketCombo"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="OnDramaMarketSelectionChanged">
                                        <ComboBoxItem Tag="local">本土剧</ComboBoxItem>
                                        <ComboBoxItem Tag="overseas">海外剧</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Classes="publishField" Spacing="5">
                                    <TextBlock Classes="formLabel" Text="合同 ID" TextWrapping="Wrap" />
                                    <TextBox Classes="configurationInput" x:Name="ContractIdBox" Watermark="合同 ID" />
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Classes="publishRow" Columns="2">
                                <StackPanel Classes="publishField" Spacing="5">
                                    <TextBlock Classes="formLabel" Text="目标观众" TextWrapping="Wrap" />
                                    <ComboBox Classes="configurationInput" x:Name="AudienceCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Tag="female">女性</ComboBoxItem>
                                        <ComboBoxItem Tag="male">男性</ComboBoxItem>
                                        <ComboBoxItem Tag="ai_recommend">AI 推荐</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Classes="publishField" Spacing="5">
                                    <TextBlock Classes="formLabel" Text="源语言" TextWrapping="Wrap" />
                                    <ComboBox Classes="configurationInput" x:Name="SourceLanguageCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Tag="auto">AI识别语言</ComboBoxItem>
                                        <ComboBoxItem Tag="zh">中文</ComboBoxItem>
                                        <ComboBoxItem Tag="en">英语 / English</ComboBoxItem>
                                        <ComboBoxItem Tag="id">印尼语 / Indonesian</ComboBoxItem>
                                        <ComboBoxItem Tag="pt">葡语 / Portuguese</ComboBoxItem>
                                        <ComboBoxItem Tag="ja">日语 / Japanese</ComboBoxItem>
                                        <ComboBoxItem Tag="th">泰语 / Thai</ComboBoxItem>
                                        <ComboBoxItem Tag="es">西语 / Spanish</ComboBoxItem>
                                        <ComboBoxItem Tag="ko">韩语 / Korean</ComboBoxItem>
                                        <ComboBoxItem Tag="tr">土耳其语 / Turkish</ComboBoxItem>
                                        <ComboBoxItem Tag="hi">印地语 / Hindi</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Classes="publishRow" Columns="2">
                                <StackPanel Classes="publishField" Spacing="5">
                                    <TextBlock Classes="formLabel" Text="内容原创类型" TextWrapping="Wrap" />
                                    <ComboBox Classes="configurationInput" x:Name="ContentOriginalityCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Tag="original">原创</ComboBoxItem>
                                        <ComboBoxItem Tag="adapted">改编</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Classes="publishField" Spacing="5">
                                    <TextBlock Classes="formLabel" Text="内容创作类型" TextWrapping="Wrap" />
                                    <ComboBox Classes="configurationInput" x:Name="ContentCreationTypeCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Tag="original">原创</ComboBoxItem>
                                        <ComboBoxItem Tag="remake">成片重制</ComboBoxItem>
                                        <ComboBoxItem Tag="novel_adaptation">小说改编</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                            </UniformGrid>

                            <ToggleSwitch x:Name="OriginalRightsHolderBox" OnContent="原始权利人" OffContent="原始权利人"
                                          AutomationProperties.Name="原始权利人" IsChecked="True" />
                            <views:PublishAccountSelector x:Name="PublishAccounts" />

                            <Border Height="1" Background="#E4E9F0" Margin="0,8,12,0" />
                            <TextBlock Text="商业与发布" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />

                            <UniformGrid Classes="publishRow" Columns="2">
                                <StackPanel Classes="publishField" Spacing="5">
                                    <TextBlock Classes="formLabel" Text="发布模式" TextWrapping="Wrap" />
                                    <ComboBox Classes="configurationInput" x:Name="PublishModeCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Tag="auto_after_review">过审后自动发布</ComboBoxItem>
                                        <ComboBoxItem Tag="manual">手动发布</ComboBoxItem>
                                        <ComboBoxItem Tag="scheduled">定时发布</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Classes="publishField" Spacing="5">
                                    <ToggleSwitch x:Name="PaidEnabledBox" OnContent="付费模式" OffContent="付费模式" AutomationProperties.Name="付费模式" />
                                    <StackPanel Spacing="5" IsVisible="{Binding IsChecked, ElementName=PaidEnabledBox}">
                                        <WrapPanel>
                                            <RadioButton x:Name="PaidRatioModeBox" GroupName="ProfilePaidStrategy" Content="按比例付费" IsChecked="True" Margin="0,0,16,0" />
                                            <RadioButton x:Name="PaidAllModeBox" GroupName="ProfilePaidStrategy" Content="全部付费" />
                                        </WrapPanel>
                                        <StackPanel Spacing="4" IsVisible="{Binding IsChecked, ElementName=PaidRatioModeBox}">
                                            <TextBlock Text="付费比例（按剧计算）" />
                                            <NumericUpDown Classes="configurationInput" x:Name="PaidRatioPercentBox" Minimum="0" Maximum="100" Value="20"
                                                           AutomationProperties.Name="付费比例 %" FormatString="0.##'%'" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Classes="publishRow" Columns="2">
                                <StackPanel Classes="publishField" Spacing="5">
                                    <TextBlock Classes="formLabel" Text="个人页预览集数" TextWrapping="Wrap" />
                                    <NumericUpDown Classes="configurationInput" x:Name="ProfilePreviewBox" Minimum="1" Maximum="999" Value="3" />
                                </StackPanel>
                                <StackPanel Classes="publishField" Spacing="5">
                                    <TextBlock Classes="formLabel" Text="免费预览集数" TextWrapping="Wrap" />
                                    <NumericUpDown Classes="configurationInput" x:Name="FreePreviewBox" Minimum="1" Maximum="999" Value="3" />
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Classes="publishRow" Columns="2">
                                <StackPanel Classes="publishField" Spacing="5">
                                    <TextBlock Classes="formLabel" Text="预期价格" TextWrapping="Wrap" />
                                    <TextBox Classes="configurationInput" x:Name="ExpectedPriceValueBox" Watermark="0.3" />
                                </StackPanel>
                            </UniformGrid>

                            <WrapPanel Orientation="Horizontal">
                                <ToggleSwitch x:Name="ConsignmentBox" OnContent="寄售模式" OffContent="寄售模式" AutomationProperties.Name="寄售模式" Margin="0,0,24,4" />
                                <ToggleSwitch x:Name="AnchorPromotionBox" OnContent="锚点推广" OffContent="锚点推广" AutomationProperties.Name="锚点推广" Margin="0,0,24,4" />
                                <ToggleSwitch x:Name="ZeroCostAdsBox" OnContent="0 元投放" OffContent="0 元投放" AutomationProperties.Name="0 元投放" Margin="0,0,24,4" />
                            </WrapPanel>
                            <StackPanel Classes="publishField" IsVisible="{Binding IsChecked, ElementName=ZeroCostAdsBox}" Spacing="5">
                                <TextBlock Classes="formLabel" Text="第 0 天 ROI" TextWrapping="Wrap" />
                                <NumericUpDown Classes="configurationInput"
                                               x:Name="DayZeroRoiBox"
                                               Minimum="1.00"
                                               Maximum="1.50"
                                               Increment="0.01"
                                               FormatString="0.00"
                                               Value="1.05"
                                               Width="160"
                                               HorizontalAlignment="Left" />
                            </StackPanel>

                            <Border Height="1" Background="#E4E9F0" Margin="0,8,12,0" />
                            <TextBlock Text="内容生成" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />

                            <WrapPanel Orientation="Horizontal">
                                <ToggleSwitch x:Name="AiDramaBox" OnContent="AI 短剧" OffContent="AI 短剧" AutomationProperties.Name="AI 短剧" IsChecked="True" Margin="0,0,24,4" />
                                <ToggleSwitch x:Name="AiRewriteSynopsisBox" OnContent="AI 改写简介" OffContent="AI 改写简介" AutomationProperties.Name="AI 改写简介" Margin="0,0,24,4" />
                            </WrapPanel>

                            <UniformGrid Classes="publishRow" Columns="2">
                                <StackPanel Classes="publishField" Spacing="5">
                                    <TextBlock Classes="formLabel" Text="新剧名随机度" TextWrapping="Wrap" />
                                    <ComboBox Classes="configurationInput" x:Name="AiNewTitleRandomnessCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Tag="low">低</ComboBoxItem>
                                        <ComboBoxItem Tag="medium">中（默认）</ComboBoxItem>
                                        <ComboBoxItem Tag="high">高</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Classes="publishField" Spacing="5">
                                    <TextBlock Classes="formLabel" Text="题材数量" TextWrapping="Wrap" />
                                    <NumericUpDown Classes="configurationInput" x:Name="GenreCountBox" Minimum="1" Maximum="8" Value="3" />
                                </StackPanel>
                            </UniformGrid>

                            <Border Height="1" Background="#E4E9F0" Margin="0,8,12,0" />
                            <TextBlock Text="上传与提交" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />

                            <UniformGrid Classes="publishRow" Columns="2">
                                <StackPanel Classes="publishField" Spacing="5">
                                    <TextBlock Classes="formLabel" Text="上传方式" TextWrapping="Wrap" />
                                    <ComboBox Classes="configurationInput" x:Name="UploadStrategyCombo" HorizontalAlignment="Stretch" SelectionChanged="UploadStrategyCombo_SelectionChanged">
                                        <ComboBoxItem Tag="playwright">网页上传</ComboBoxItem>
                                        <ComboBoxItem Tag="api">接口上传</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Classes="publishField" Spacing="5">
                                    <TextBlock Classes="formLabel" Text="上传浏览器" TextWrapping="Wrap" />
                                    <ComboBox Classes="configurationInput" x:Name="UploadBrowserModeCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Tag="embedded">内置浏览器（WebView2）</ComboBoxItem>
                                        <ComboBoxItem Tag="playwright">外部浏览器（显示窗口）</ComboBoxItem>
                                        <ComboBoxItem Tag="playwright_headless">外部浏览器（无头）</ComboBoxItem>
                                    </ComboBox>
                                    <TextBlock Classes="pageSummary" Text="登录浏览器跟随此设置。" TextWrapping="Wrap" />
                                </StackPanel>
                            </UniformGrid>

                            <StackPanel x:Name="PlaywrightDeliveryPanel" Orientation="Vertical" Classes="publishField" Spacing="8">
                                <TextBlock Classes="formLabel" Text="正片投递" />
                                <ComboBox Classes="configurationInput" x:Name="PlaywrightDeliveryCombo">
                                    <ComboBoxItem Tag="classic">经典（一次传完全部）</ComboBoxItem>
                                    <ComboBoxItem Tag="batch">分批（卡死就整批重传）</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>

                            <UniformGrid Classes="publishRow" Columns="2">
                                <StackPanel Classes="publishField" Spacing="5">
                                    <TextBlock Classes="formLabel" Text="提交动作" TextWrapping="Wrap" />
                                    <ComboBox Classes="configurationInput" x:Name="SubmitActionCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Tag="none">不提交</ComboBoxItem>
                                        <ComboBoxItem Tag="save">保存</ComboBoxItem>
                                        <ComboBoxItem Tag="submit">提交</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Classes="publishField" Spacing="5">
                                    <TextBlock Classes="formLabel" Text="项目并发数" TextWrapping="Wrap" />
                                    <NumericUpDown Classes="configurationInput" x:Name="ProjectConcurrencyBox" Minimum="1" Maximum="8" Value="4" />
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Classes="publishRow" Columns="2" IsVisible="{Binding IsVisible, ElementName=UploadBatchSizeBox}">
                                <StackPanel Classes="publishField" Spacing="5" IsVisible="{Binding IsVisible, ElementName=UploadBatchSizeBox}">
                                    <TextBlock Classes="formLabel" x:Name="BatchSizeLabel" Text="分批·每批数量" TextWrapping="Wrap" />
                                    <NumericUpDown Classes="configurationInput" x:Name="UploadBatchSizeBox" Minimum="1" Maximum="20" Value="3" />
                                </StackPanel>
                                <StackPanel Classes="publishField" Spacing="5" IsVisible="{Binding IsVisible, ElementName=UploadBatchStallBox}">
                                    <TextBlock Classes="formLabel" x:Name="BatchStallLabel" Text="分批·卡死秒数" TextWrapping="Wrap" />
                                    <NumericUpDown Classes="configurationInput" x:Name="UploadBatchStallBox" Minimum="20" Maximum="600" Value="75" />
                                </StackPanel>
                                <StackPanel Classes="publishField" Spacing="5" IsVisible="{Binding IsVisible, ElementName=UploadBatchRetriesBox}">
                                    <TextBlock Classes="formLabel" x:Name="BatchRetriesLabel" Text="分批·重试次数" TextWrapping="Wrap" />
                                    <NumericUpDown Classes="configurationInput" x:Name="UploadBatchRetriesBox" Minimum="1" Maximum="10" Value="3" />
                                </StackPanel>
                            </UniformGrid>

                            <Border Height="1" Background="#E4E9F0" Margin="0,8,12,0" />
                            <TextBlock Text="网络 / IP" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <ToggleSwitch x:Name="ProxyEnabledBox" OnContent="启用账号代理" OffContent="启用账号代理"
                                          AutomationProperties.Name="启用账号代理" />
                            <StackPanel x:Name="ProxySettings" Spacing="10" IsVisible="{Binding IsChecked, ElementName=ProxyEnabledBox}">
                                <UniformGrid Classes="publishRow" Columns="2">
                                    <StackPanel Classes="publishField" Spacing="5">
                                        <TextBlock Classes="formLabel" Text="代理类型" />
                                        <ComboBox Classes="configurationInput" x:Name="ProxyTypeCombo" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Tag="http">HTTP/HTTPS</ComboBoxItem>
                                            <ComboBoxItem Tag="socks5">SOCKS5</ComboBoxItem>
                                            <ComboBoxItem Tag="socks4">SOCKS4</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                </UniformGrid>
                                <UniformGrid Classes="publishRow" Columns="2">
                                    <StackPanel Classes="publishField" Spacing="5">
                                        <TextBlock Classes="formLabel" Text="代理主机" />
                                        <TextBox Classes="configurationInput" x:Name="ProxyHostBox" />
                                    </StackPanel>
                                    <StackPanel Classes="publishField" Spacing="5">
                                        <TextBlock Classes="formLabel" Text="代理端口" />
                                        <NumericUpDown Classes="configurationInput" x:Name="ProxyPortBox" Minimum="0" Maximum="65535" Value="0" />
                                    </StackPanel>
                                </UniformGrid>
                                <UniformGrid Classes="publishRow" Columns="2">
                                    <StackPanel Classes="publishField" Spacing="5">
                                        <TextBlock Classes="formLabel" Text="代理用户名" />
                                        <TextBox Classes="configurationInput" x:Name="ProxyUsernameBox" />
                                    </StackPanel>
                                    <StackPanel Classes="publishField" Spacing="5">
                                        <TextBlock Classes="formLabel" Text="代理密码" />
                                        <TextBox Classes="configurationInput" x:Name="ProxyPasswordBox" PasswordChar="●" RevealPassword="False" />
                                    </StackPanel>
                                </UniformGrid>
                                <UniformGrid Classes="publishRow" Columns="2">
                                    <StackPanel Classes="publishField" Spacing="5">
                                        <TextBlock Classes="formLabel" Text="代理备注" />
                                        <TextBox Classes="configurationInput" x:Name="ProxyLabelBox" />
                                    </StackPanel>
                                    <StackPanel Classes="publishField" Spacing="5">
                                        <TextBlock Classes="formLabel" Text="静态 IP 备注" />
                                        <TextBox Classes="configurationInput" x:Name="StaticIpNoteBox" />
                                    </StackPanel>
                                </UniformGrid>
                                <Button x:Name="TestProxyButton" Content="测试 IP" Click="OnTestProxyClick" HorizontalAlignment="Left" />
                                <TextBlock x:Name="ProxyTestResultText" Classes="pageSummary" TextWrapping="Wrap"
                                           Text="检测代理的实际出口 IP 与归属地。" />
                            </StackPanel>
                            <StackPanel Classes="publishField" Spacing="5" x:Name="LegacyCdpSettings" IsVisible="False">
                                <TextBlock Classes="formLabel" Text="CDP 地址" />
                                <TextBox Classes="configurationInput" x:Name="CdpEndpointBox" />
                            </StackPanel>
                            <views:AccountAiEditor x:Name="AccountAi" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="基础设置">
                <TabItem.Styles>
                    <StyleInclude Source="avares://TikTokPublisher.Ui/Themes/ConfigurationFormStyles.axaml" />
                </TabItem.Styles>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="2,4,14,8" SizeChanged="OnBasicFormSizeChanged">
                        <StackPanel x:Name="BasicForm" MaxWidth="1080" HorizontalAlignment="Left" Spacing="10">
                            <TextBlock Classes="configurationHeading" Text="目录与报表" />

                            <StackPanel Spacing="5">
                                <TextBlock Classes="configurationLabel" Text="短剧中心地址" />
                                <TextBox Classes="configurationInput" x:Name="SeriesUrlBox" />
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Classes="configurationLabel" Text="上传工作目录" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Classes="configurationInput" x:Name="WorkspaceBox" Watermark="上传工作目录" />
                                    <Button Grid.Column="1" Content="浏览…" Click="OnBrowseWorkspaceClick" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Classes="configurationLabel" Text="归档目录" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Classes="configurationInput" x:Name="ArchiveRootBox" Watermark="留空时默认使用上传工作目录下的 archive" />
                                    <Button Grid.Column="1" Content="浏览…" Click="OnBrowseArchiveRootClick" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Classes="configurationLabel" Text="下载工作目录" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Classes="configurationInput" x:Name="DownloadWorkspaceBox" Watermark="下载工作目录" />
                                    <Button Grid.Column="1" Content="浏览…" Click="OnBrowseDownloadWorkspaceClick" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Classes="configurationLabel" Text="Excel 报表路径" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Classes="configurationInput" x:Name="ExcelReportBox" Watermark="Excel 报表路径" />
                                    <Button Grid.Column="1" Content="浏览…" Click="OnBrowseExcelReportClick" />
                                </Grid>
                            </StackPanel>

                            <Border Height="1" Background="#E4E9F0" Margin="0,8,0,0" />

                            <TextBlock Classes="configurationHeading" Text="归档" />

                            <WrapPanel>
                                <ToggleSwitch x:Name="DeleteVideosOnArchiveBox" OnContent="归档时删除视频文件" OffContent="归档时删除视频文件" />
                            </WrapPanel>

                            <TextBlock Classes="pageSummary" TextWrapping="Wrap" Text="关闭后归档目录会保留视频，占用更多磁盘。" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>
        </Border>
    </DockPanel>
</UserControl>
