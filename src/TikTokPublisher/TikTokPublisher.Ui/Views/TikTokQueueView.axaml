<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TikTokPublisher.Ui.ViewModels"
             x:Class="TikTokPublisher.Ui.Views.TikTokQueueView"
             x:Name="QueueViewRoot"
             x:DataType="vm:MainViewModel"
             Background="{StaticResource PythonPageBgBrush}">

    <UserControl.Styles>
        <Style Selector="Button.queueLink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.queueLink:pointerover">
            <Setter Property="Background" Value="#EAF4FF" />
        </Style>
        <Style Selector="Button.queueLink:pressed">
            <Setter Property="Background" Value="#DCEBFF" />
        </Style>
        <Style Selector="Button.compactAction">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.neutralAction">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
        </Style>
        <Style Selector="Button.neutralAction:pointerover">
            <Setter Property="Background" Value="#EEF2F6" />
        </Style>
        <Style Selector="Button.contentAction">
            <Setter Property="Background" Value="#EAF4FF" />
            <Setter Property="Foreground" Value="#0F63C7" />
            <Setter Property="BorderBrush" Value="#9CCBFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.contentAction:pointerover">
            <Setter Property="Background" Value="#DCEBFF" />
        </Style>
        <Style Selector="Button.browserAction">
            <Setter Property="Background" Value="#EEF6FF" />
            <Setter Property="Foreground" Value="#0B5CAD" />
            <Setter Property="BorderBrush" Value="#B8D8FF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.browserAction:pointerover">
            <Setter Property="Background" Value="#DCEBFF" />
        </Style>
        <Style Selector="Button.repairAction">
            <Setter Property="Background" Value="#FFF7E6" />
            <Setter Property="Foreground" Value="#B45309" />
            <Setter Property="BorderBrush" Value="#FBBF24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.repairAction:pointerover">
            <Setter Property="Background" Value="#FFEFC2" />
        </Style>
        <Style Selector="Button.selectionAction">
            <Setter Property="Background" Value="#F2F5FF" />
            <Setter Property="Foreground" Value="#3730A3" />
            <Setter Property="BorderBrush" Value="#C7D2FE" />
        </Style>
        <Style Selector="Button.selectionAction:pointerover">
            <Setter Property="Background" Value="#E7ECFF" />
        </Style>
        <Style Selector="Button.fileAction">
            <Setter Property="Background" Value="#EAF8F0" />
            <Setter Property="Foreground" Value="#047857" />
            <Setter Property="BorderBrush" Value="#86D9A8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.fileAction:pointerover">
            <Setter Property="Background" Value="#DDFBEA" />
        </Style>
        <Style Selector="Button.logAction">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
        </Style>
        <Style Selector="Button.logAction:pointerover">
            <Setter Property="Background" Value="#E2E8F0" />
        </Style>
        <Style Selector="Button.toolAction">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#0F4F86" />
            <Setter Property="BorderBrush" Value="#BFD3E8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.toolAction:pointerover">
            <Setter Property="Background" Value="#E6EEF8" />
        </Style>
        <Style Selector="Button.archiveAction">
            <Setter Property="Background" Value="#EEF2F6" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.archiveAction:pointerover">
            <Setter Property="Background" Value="#E2E8F0" />
        </Style>
        <Style Selector="Button.dangerSoftAction">
            <Setter Property="Background" Value="#FFE3E3" />
            <Setter Property="Foreground" Value="#B42318" />
            <Setter Property="BorderBrush" Value="#F97066" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.dangerSoftAction:pointerover">
            <Setter Property="Background" Value="#FFD4D4" />
        </Style>
        <Style Selector="Button.stopAction">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DC2626" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.stopAction:pointerover">
            <Setter Property="Background" Value="#B91C1C" />
            <Setter Property="BorderBrush" Value="#B91C1C" />
        </Style>
        <Style Selector="Button.stopAction:disabled">
            <Setter Property="Background" Value="#D1D5DB" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
        </Style>
        <Style Selector="Button.menuAction">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style Selector="TextBlock.stepTableHeader">
            <Setter Property="Background" Value="{StaticResource PythonTableHeaderStep}" />
            <Setter Property="Foreground" Value="#0F4F86" />
        </Style>
        <Style Selector="Border.queueTableFrame">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C9D8EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.queueTableRow">
            <Setter Property="BorderBrush" Value="#DCE7F3" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="ListBox#QueueProjectList">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
        <Style Selector="ListBox#QueueProjectList ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <!-- 斑马纹改用行 VM 绑定（Border.queueTableRow.Background），避免 nth-child 选择器在虚拟化滚动时反复重算导致卡顿 -->
        <Style Selector="ListBox#QueueProjectList ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#EAF4FF" />
        </Style>
        <Style Selector="ListBox#QueueProjectList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#DDEEFF" />
        </Style>
        <Style Selector="Border.stepStatusBadge">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.stepStatusText">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Border.queueColumnResizer">
            <Setter Property="Width" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Cursor" Value="SizeWestEast" />
        </Style>
        <Style Selector="TextBox.queueRemarkBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="16,14,16,16">
        <!-- 顶部控制区：紧凑保留高频操作，低频操作收进菜单 -->
        <Border DockPanel.Dock="Top" Classes="controlsFrame" Margin="0,0,0,8" Padding="16,10">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="工作目录" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Text="{Binding WorkspacePath}" IsReadOnly="True" Watermark="选择工作目录" />
                    <Button Grid.Column="2" Content="选择工作目录" Click="OnPickWorkspaceClick" Classes="toolAction compactAction" />
                </Grid>

                <WrapPanel Orientation="Horizontal">
                    <Button Content="刷新项目" Click="OnScanWorkspaceClick" Classes="neutralAction compactAction" Margin="0,0,8,8" />
                    <Button Content="上传短剧" Click="OnUploadTitlesClick" Classes="contentAction compactAction" Margin="0,0,8,8" />
                    <Button Content="编辑剧集" Click="OnEditSelectedClick" Classes="contentAction compactAction" Margin="0,0,8,8" />
                    <Button Content="改新剧名" Click="OnRenameNewTitleClick" Classes="contentAction compactAction" Margin="0,0,8,8" />
                    <Button Content="修复静音视频" Click="OnRepairSilenceClick" Classes="repairAction compactAction" Margin="0,0,8,8" />
                    <Button Content="全选" Click="OnSelectAllQueueClick" Classes="selectionAction compactAction" Margin="0,0,8,8" />
                    <Button Content="勾选到当前项目" Click="OnSelectToCurrentProjectClick" Classes="selectionAction compactAction" Margin="0,0,8,8" />
                    <Button Content="取消全选" Click="OnClearQueueSelectionClick" Classes="selectionAction compactAction" Margin="0,0,8,8" />
                    <Button Content="归档勾选" Click="OnArchiveSelectedClick" Classes="archiveAction compactAction" Margin="0,0,8,8" />
                    <Button Content="删除勾选" Click="OnDeleteSelectedClick" Classes="dangerSoftAction compactAction" Margin="0,0,8,8" />
                    <Button Content="全选已完成" Click="OnSelectCompletedQueueClick" Classes="selectionAction compactAction" Margin="0,0,8,8" />
                </WrapPanel>

                <WrapPanel Orientation="Horizontal">
                    <Button Content="导出 Excel" Click="OnExportExcelClick" Classes="fileAction compactAction" Margin="0,0,8,0" />
                    <Button Content="打开 Excel" Click="OnOpenExcelClick" Classes="fileAction compactAction" Margin="0,0,8,0" />
                    <Button Content="打开外部浏览器" Click="OnOpenBrowserClick" Classes="browserAction compactAction" Margin="0,0,8,0" />
                    <Button Content="同步勾选任务" Click="OnSyncSelectedManagementClick" Classes="repairAction compactAction" Margin="0,0,8,0" />
                    <Button Content="标记上传成功" Click="OnMarkSelectedUploadCompletedClick" Classes="contentAction compactAction" Margin="0,0,8,0" />
                    <Button Content="标记上传失败" Click="OnMarkSelectedUploadFailedClick" Classes="dangerSoftAction compactAction" Margin="0,0,8,0" />
                    <Button Content="运行日志" Click="OnOpenLogsClick" Classes="logAction compactAction" Margin="0,0,8,0" />
                    <Button x:Name="StartQueueButton" Content="执行勾选队列" Click="OnStartQueueClick" Classes="primaryAction compactAction" Margin="0,0,8,0" />
                    <Button x:Name="StopQueueButton" Content="停止" Click="OnStopQueueClick" Classes="stopAction compactAction" IsEnabled="False" Margin="0,0,8,0" />
                    <Button x:Name="StartAllQueuesButton" Content="执行全部账号工作目录" Click="OnStartAllQueuesClick" Classes="primaryAction compactAction" IsVisible="False" />
                </WrapPanel>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="搜索" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1"
                             Watermark="搜索原剧名 / 新剧名 / 时间 / 状态 / 问题"
                             Text="{Binding QueueSearchText, Mode=TwoWay}" />
                    <WrapPanel Grid.Column="2" Orientation="Horizontal">
                        <CheckBox Content="仅待上传" IsChecked="{Binding ShowOnlyPendingUpload}" VerticalAlignment="Center" />
                    </WrapPanel>
                </Grid>

                <Border Classes="taskStepFrame" Padding="8,6">
                    <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock Grid.Column="0" Text="启用步骤" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <WrapPanel Grid.Column="1" Orientation="Horizontal">
                                <CheckBox Content="下载剧集" IsChecked="{Binding QueueDownloadEnabled}" Margin="0,0,12,2" />
                                <CheckBox Content="改写信息" IsChecked="{Binding QueueRewriteEnabled}" Margin="0,0,12,2" />
                                <CheckBox Content="生成海报" IsChecked="{Binding QueueGeneratePosterEnabled}" Margin="0,0,12,2" />
                                <CheckBox Content="小文件修复" IsChecked="{Binding QueueSmallVideoRepairEnabled}" Margin="0,0,12,2" />
                                <CheckBox Content="静音检测" IsChecked="{Binding QueueSilenceDetectEnabled}" Margin="0,0,12,2" />
                                <CheckBox Content="静音修复" IsChecked="{Binding QueueSilenceRepairEnabled}" Margin="0,0,12,2" />
                                <CheckBox Content="素材校验" IsChecked="{Binding QueueMaterialValidateEnabled}" Margin="0,0,12,2" />
                                <CheckBox Content="删除源视频" IsChecked="{Binding QueueDeleteSourceVideosEnabled}" Margin="0,0,12,2" />
                                <CheckBox Content="上传剧集" IsChecked="{Binding QueueUploadEnabled}" Margin="0,0,12,2" />
                            </WrapPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button Content="全选步骤" Command="{Binding SelectAllQueueStepsCommand}" Classes="selectionAction compactAction" />
                                <Button Content="取消全选" Command="{Binding ClearAllQueueStepsCommand}" Classes="selectionAction compactAction" />
                            </StackPanel>
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="64,0,0,0">
                            <CheckBox Content="上传完成后自动归档" IsChecked="{Binding AutoArchiveAfterUpload}" Margin="0,0,16,0" />
                            <CheckBox Content="强制重跑已完成步骤" IsChecked="{Binding ForceRerunCompletedSteps}" Margin="0,0,16,0" />
                            <CheckBox Content="有待上传项目时优先上传" IsChecked="{Binding PreferUploadWhenReady}" Margin="0,0,16,0" />
                            <CheckBox Content="同步管理系统" IsChecked="{Binding SyncManagementAfterUpload}" Margin="0,0,16,0" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding RunningWorkspacesSummary}"
                           Foreground="#1A5F8A"
                           IsVisible="{Binding IsQueueRunning}"
                           TextWrapping="Wrap" Margin="0,-2,0,0" />
                <TextBlock x:Name="ManualInterventionHint"
                           Text="{Binding ManualInterventionHint}"
                           Foreground="#B94218"
                           IsVisible="{Binding ManualInterventionPending}"
                           TextWrapping="Wrap" Margin="0,-4,0,0" />

                <WrapPanel Orientation="Horizontal">
                    <TextBlock Classes="pageSummary" Text="{Binding WorkspaceBindingSummary}" Margin="0,0,12,0" />
                    <TextBlock Classes="pageSummary" Text="{Binding QueueSummaryText}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 手动发布区暂时隐藏：保留代码，后续需要时移除 IsVisible 即可恢复 -->
        <Border DockPanel.Dock="Bottom" Classes="controlsFrame" MaxHeight="220" Margin="0,10,0,0" IsVisible="False">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="手动发布（多账号并发）" FontWeight="SemiBold" Margin="0,0,0,8" />
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="添加素材" Click="OnAddMaterialsClick" Margin="0,0,8,8" />
                    <Button Content="导入任务(JSON)" Click="OnImportTasksClick" Margin="0,0,8,8" />
                    <TextBlock Text="结束动作" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <ComboBox ItemsSource="{Binding FinalActionChoices}" SelectedItem="{Binding SelectedFinalAction}" MinWidth="150" Margin="0,0,8,8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FinalActionChoice">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="并发账号" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <NumericUpDown Value="{Binding MaxParallel}" Minimum="1" Maximum="8" Increment="1" Width="110" Margin="0,0,8,8" />
                    <Button x:Name="StartPublishButton" Content="开始发布" Click="OnStartPublishClick" Classes="primaryAction" Margin="0,0,8,8" />
                    <Button x:Name="StopPublishButton" Content="停止" Click="OnStopPublishClick" Classes="dangerAction" IsEnabled="False" Margin="0,0,8,8" />
                    <Button Content="清空已完成" Click="OnClearDoneClick" Margin="0,0,8,8" />
                    <Button Content="清除续传记录" Click="OnClearResumeClick" Margin="0,0,8,8" />
                </WrapPanel>

                <Grid DockPanel.Dock="Top" ColumnDefinitions="140,*,150,80,*" Margin="0,0,0,4">
                    <TextBlock Grid.Column="0" Text="账号" Classes="pageSummary" />
                    <TextBlock Grid.Column="1" Text="视频" Classes="pageSummary" />
                    <TextBlock Grid.Column="2" Text="剧集" Classes="pageSummary" />
                    <TextBlock Grid.Column="3" Text="状态" Classes="pageSummary" />
                    <TextBlock Grid.Column="4" Text="信息" Classes="pageSummary" />
                </Grid>

                <ListBox ItemsSource="{Binding Tasks}" MaxHeight="100" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PublishTaskItemViewModel">
                            <Grid ColumnDefinitions="140,*,150,80,*">
                                <TextBlock Grid.Column="0" Text="{Binding AccountName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding VideoName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding DramaName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{Binding StatusText}" />
                                <TextBlock Grid.Column="4" Text="{Binding Message}" TextTrimming="CharacterEllipsis" Classes="pageSummary" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 队列表格：作为 DockPanel 最后一个未指定 Dock 的子项，自动填充剩余空间 -->
        <Border Classes="queueTableFrame">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="QueueTableRootGrid" RowDefinitions="Auto,*" Width="1608">
                    <Grid x:Name="QueueTableHeaderGrid" Grid.Row="0" ColumnDefinitions="48,56,104,210,210,60,128,68,68,68,68,68,68,68,68,68,180">
                        <TextBlock Grid.Column="0" Text="序号" Classes="tableHeader" />
                        <TextBlock Grid.Column="1" Text="启用" Classes="tableHeader" />
                        <TextBlock Grid.Column="2" Text="账号槽" Classes="tableHeader" />
                        <TextBlock Grid.Column="3" Text="原剧名" Classes="tableHeader" />
                        <TextBlock Grid.Column="4" Text="新剧名" Classes="tableHeader" />
                        <TextBlock Grid.Column="5" Text="集数" Classes="tableHeader" />
                        <TextBlock Grid.Column="6" Text="加入时间" Classes="tableHeader" />
                        <TextBlock Grid.Column="7" Text="下载" Classes="tableHeader stepTableHeader" />
                        <TextBlock Grid.Column="8" Text="改写" Classes="tableHeader stepTableHeader" />
                        <TextBlock Grid.Column="9" Text="海报" Classes="tableHeader stepTableHeader" />
                        <TextBlock Grid.Column="10" Text="修复" Classes="tableHeader stepTableHeader" />
                        <TextBlock Grid.Column="11" Text="静音检测" Classes="tableHeader stepTableHeader" />
                        <TextBlock Grid.Column="12" Text="静音修复" Classes="tableHeader stepTableHeader" />
                        <TextBlock Grid.Column="13" Text="校验" Classes="tableHeader stepTableHeader" />
                        <TextBlock Grid.Column="14" Text="删源" Classes="tableHeader stepTableHeader" />
                        <TextBlock Grid.Column="15" Text="上传" Classes="tableHeader stepTableHeader" />
                        <TextBlock Grid.Column="16" Text="备注" Classes="tableHeader" />
                        <Border Grid.Column="0" Classes="queueColumnResizer" Tag="0" PointerPressed="OnQueueColumnResizerPointerPressed" PointerMoved="OnQueueColumnResizerPointerMoved" PointerReleased="OnQueueColumnResizerPointerReleased" />
                        <Border Grid.Column="1" Classes="queueColumnResizer" Tag="1" PointerPressed="OnQueueColumnResizerPointerPressed" PointerMoved="OnQueueColumnResizerPointerMoved" PointerReleased="OnQueueColumnResizerPointerReleased" />
                        <Border Grid.Column="2" Classes="queueColumnResizer" Tag="2" PointerPressed="OnQueueColumnResizerPointerPressed" PointerMoved="OnQueueColumnResizerPointerMoved" PointerReleased="OnQueueColumnResizerPointerReleased" />
                        <Border Grid.Column="3" Classes="queueColumnResizer" Tag="3" PointerPressed="OnQueueColumnResizerPointerPressed" PointerMoved="OnQueueColumnResizerPointerMoved" PointerReleased="OnQueueColumnResizerPointerReleased" />
                        <Border Grid.Column="4" Classes="queueColumnResizer" Tag="4" PointerPressed="OnQueueColumnResizerPointerPressed" PointerMoved="OnQueueColumnResizerPointerMoved" PointerReleased="OnQueueColumnResizerPointerReleased" />
                        <Border Grid.Column="5" Classes="queueColumnResizer" Tag="5" PointerPressed="OnQueueColumnResizerPointerPressed" PointerMoved="OnQueueColumnResizerPointerMoved" PointerReleased="OnQueueColumnResizerPointerReleased" />
                        <Border Grid.Column="6" Classes="queueColumnResizer" Tag="6" PointerPressed="OnQueueColumnResizerPointerPressed" PointerMoved="OnQueueColumnResizerPointerMoved" PointerReleased="OnQueueColumnResizerPointerReleased" />
                        <Border Grid.Column="7" Classes="queueColumnResizer" Tag="7" PointerPressed="OnQueueColumnResizerPointerPressed" PointerMoved="OnQueueColumnResizerPointerMoved" PointerReleased="OnQueueColumnResizerPointerReleased" />
                        <Border Grid.Column="8" Classes="queueColumnResizer" Tag="8" PointerPressed="OnQueueColumnResizerPointerPressed" PointerMoved="OnQueueColumnResizerPointerMoved" PointerReleased="OnQueueColumnResizerPointerReleased" />
                        <Border Grid.Column="9" Classes="queueColumnResizer" Tag="9" PointerPressed="OnQueueColumnResizerPointerPressed" PointerMoved="OnQueueColumnResizerPointerMoved" PointerReleased="OnQueueColumnResizerPointerReleased" />
                        <Border Grid.Column="10" Classes="queueColumnResizer" Tag="10" PointerPressed="OnQueueColumnResizerPointerPressed" PointerMoved="OnQueueColumnResizerPointerMoved" PointerReleased="OnQueueColumnResizerPointerReleased" />
                        <Border Grid.Column="11" Classes="queueColumnResizer" Tag="11" PointerPressed="OnQueueColumnResizerPointerPressed" PointerMoved="OnQueueColumnResizerPointerMoved" PointerReleased="OnQueueColumnResizerPointerReleased" />
                        <Border Grid.Column="12" Classes="queueColumnResizer" Tag="12" PointerPressed="OnQueueColumnResizerPointerPressed" PointerMoved="OnQueueColumnResizerPointerMoved" PointerReleased="OnQueueColumnResizerPointerReleased" />
                        <Border Grid.Column="13" Classes="queueColumnResizer" Tag="13" PointerPressed="OnQueueColumnResizerPointerPressed" PointerMoved="OnQueueColumnResizerPointerMoved" PointerReleased="OnQueueColumnResizerPointerReleased" />
                        <Border Grid.Column="14" Classes="queueColumnResizer" Tag="14" PointerPressed="OnQueueColumnResizerPointerPressed" PointerMoved="OnQueueColumnResizerPointerMoved" PointerReleased="OnQueueColumnResizerPointerReleased" />
                        <Border Grid.Column="15" Classes="queueColumnResizer" Tag="15" PointerPressed="OnQueueColumnResizerPointerPressed" PointerMoved="OnQueueColumnResizerPointerMoved" PointerReleased="OnQueueColumnResizerPointerReleased" />
                        <Border Grid.Column="16" Classes="queueColumnResizer" Tag="16" PointerPressed="OnQueueColumnResizerPointerPressed" PointerMoved="OnQueueColumnResizerPointerMoved" PointerReleased="OnQueueColumnResizerPointerReleased" />
                    </Grid>

                    <ListBox x:Name="QueueProjectList"
                             Grid.Row="1"
                             ItemsSource="{Binding FilteredQueueProjectRows}"
                             Background="{StaticResource PythonInputBg}"
                             Margin="0,0,0,22"
                             SelectionMode="Multiple"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:QueueProjectRowViewModel">
                                <Border Classes="queueTableRow" Width="1608" Height="42" Loaded="OnQueueTableRowLoaded">
                                    <Grid ColumnDefinitions="48,56,104,210,210,60,128,68,68,68,68,68,68,68,68,68,180" ClipToBounds="True">
                                        <TextBlock Grid.Column="0" Text="{Binding RowIndex}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding AccountName}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="4,0" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" />
                                        <Button Grid.Column="3"
                                                Classes="queueLink"
                                                Click="OnOpenOriginalProjectFolderClick"
                                                ToolTip.Tip="{Binding OriginalProjectDir}">
                                            <TextBlock Text="{Binding OriginalTitle}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding DramaTitleBrush}" />
                                        </Button>
                                        <Button Grid.Column="4"
                                                Classes="queueLink"
                                                Click="OnOpenNewProjectFolderClick"
                                                ToolTip.Tip="{Binding NewProjectDir}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="修改新剧名" Click="OnRenameNewTitleClick" />
                                                    <MenuItem Header="打开新剧名目录" Click="OnOpenNewProjectFolderClick" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <TextBlock Text="{Binding NewTitle}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding DramaTitleBrush}" />
                                        </Button>
                                        <TextBlock Grid.Column="5" Text="{Binding EpisodeCount}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="6" Text="{Binding QueuedAt}" VerticalAlignment="Center" Margin="6,0" FontSize="12" TextTrimming="CharacterEllipsis" ClipToBounds="True" ToolTip.Tip="{Binding QueuedAtTooltip}" />
                                        <Border Grid.Column="7" Classes="stepStatusBadge" Background="{Binding DownloadStatusBackgroundBrush}" BorderBrush="{Binding DownloadStatusBorderBrush}" ToolTip.Tip="{Binding DownloadStatus}">
                                            <TextBlock Text="{Binding DownloadStatus}" Foreground="{Binding DownloadStatusBrush}" Classes="stepStatusText" />
                                        </Border>
                                        <Border Grid.Column="8" Classes="stepStatusBadge" Background="{Binding RewriteStatusBackgroundBrush}" BorderBrush="{Binding RewriteStatusBorderBrush}" ToolTip.Tip="{Binding RewriteStatus}">
                                            <TextBlock Text="{Binding RewriteStatus}" Foreground="{Binding RewriteStatusBrush}" Classes="stepStatusText" />
                                        </Border>
                                        <Border Grid.Column="9" Classes="stepStatusBadge" Background="{Binding PosterStatusBackgroundBrush}" BorderBrush="{Binding PosterStatusBorderBrush}" ToolTip.Tip="{Binding PosterStatus}">
                                            <TextBlock Text="{Binding PosterStatus}" Foreground="{Binding PosterStatusBrush}" Classes="stepStatusText" />
                                        </Border>
                                        <Border Grid.Column="10" Classes="stepStatusBadge" Background="{Binding RepairStatusBackgroundBrush}" BorderBrush="{Binding RepairStatusBorderBrush}" ToolTip.Tip="{Binding RepairStatus}">
                                            <TextBlock Text="{Binding RepairStatus}" Foreground="{Binding RepairStatusBrush}" Classes="stepStatusText" />
                                        </Border>
                                        <Border Grid.Column="11" Classes="stepStatusBadge" Background="{Binding SilenceDetectStatusBackgroundBrush}" BorderBrush="{Binding SilenceDetectStatusBorderBrush}" ToolTip.Tip="{Binding SilenceDetectStatus}">
                                            <TextBlock Text="{Binding SilenceDetectStatus}" Foreground="{Binding SilenceDetectStatusBrush}" Classes="stepStatusText" />
                                        </Border>
                                        <Border Grid.Column="12" Classes="stepStatusBadge" Background="{Binding SilenceRepairStatusBackgroundBrush}" BorderBrush="{Binding SilenceRepairStatusBorderBrush}" ToolTip.Tip="{Binding SilenceRepairStatus}">
                                            <TextBlock Text="{Binding SilenceRepairStatus}" Foreground="{Binding SilenceRepairStatusBrush}" Classes="stepStatusText" />
                                        </Border>
                                        <Border Grid.Column="13" Classes="stepStatusBadge" Background="{Binding ValidateStatusBackgroundBrush}" BorderBrush="{Binding ValidateStatusBorderBrush}" ToolTip.Tip="{Binding ValidateStatus}">
                                            <TextBlock Text="{Binding ValidateStatus}" Foreground="{Binding ValidateStatusBrush}" Classes="stepStatusText" />
                                        </Border>
                                        <Border Grid.Column="14" Classes="stepStatusBadge" Background="{Binding DeleteSourceStatusBackgroundBrush}" BorderBrush="{Binding DeleteSourceStatusBorderBrush}" ToolTip.Tip="{Binding DeleteSourceStatus}">
                                            <TextBlock Text="{Binding DeleteSourceStatus}" Foreground="{Binding DeleteSourceStatusBrush}" Classes="stepStatusText" />
                                        </Border>
                                        <Border Grid.Column="15" Classes="stepStatusBadge" Background="{Binding UploadStatusBackgroundBrush}" BorderBrush="{Binding UploadStatusBorderBrush}" ToolTip.Tip="{Binding DetailText}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="标记上传成功" Click="OnMarkUploadCompletedClick" />
                                                    <MenuItem Header="标记上传失败" Click="OnMarkUploadFailedClick" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <TextBlock Text="{Binding UploadStatus}" Foreground="{Binding UploadStatusBrush}" Classes="stepStatusText" />
                                        </Border>
                                        <Border Grid.Column="16" IsVisible="False" Classes="stepStatusBadge" Background="{Binding StatusTextBackgroundBrush}" BorderBrush="{Binding StatusTextBorderBrush}" ToolTip.Tip="{Binding DetailText}">
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusTextBrush}" Classes="stepStatusText" />
                                        </Border>
                                        <TextBox Grid.Column="16"
                                                 Classes="queueRemarkBox"
                                                 Text="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Watermark="备注"
                                                 Margin="6,5" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
