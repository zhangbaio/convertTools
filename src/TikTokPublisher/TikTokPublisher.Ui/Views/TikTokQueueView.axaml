<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TikTokPublisher.Ui.ViewModels"
             x:Class="TikTokPublisher.Ui.Views.TikTokQueueView"
             x:Name="QueueViewRoot"
             x:DataType="vm:MainViewModel"
             Background="{StaticResource PythonPageBgBrush}">

    <UserControl.Styles>
        <Style Selector="Button.queueLink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.queueLink:pointerover">
            <Setter Property="Background" Value="#EEF6FF" />
        </Style>
        <Style Selector="Button.queueLink:pressed">
            <Setter Property="Background" Value="#DCEBFF" />
        </Style>
        <Style Selector="Button.compactAction">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.menuAction">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style Selector="Border.stepSummaryPill">
            <Setter Property="Background" Value="#F3F7FC" />
            <Setter Property="BorderBrush" Value="#D6E5F7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="16,14,16,16">
        <!-- 顶部控制区：紧凑保留高频操作，低频操作收进菜单 -->
        <Border DockPanel.Dock="Top" Classes="controlsFrame" Margin="0,0,0,8" Padding="16,10">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="工作目录" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Text="{Binding WorkspacePath}" IsReadOnly="True" Watermark="选择工作目录" />
                    <Button Grid.Column="2" Content="选择工作目录" Click="OnPickWorkspaceClick" Classes="compactAction" />
                    <Button Grid.Column="3" x:Name="StartQueueButton" Content="执行选中队列" Click="OnStartQueueClick" Classes="primaryAction compactAction" />
                    <Button Grid.Column="4" x:Name="StartAllQueuesButton" Content="执行全部账号工作目录" Click="OnStartAllQueuesClick" Classes="primaryAction compactAction" />
                    <Button Grid.Column="5" x:Name="StopQueueButton" Content="停止" Click="OnStopQueueClick" Classes="dangerAction compactAction" IsEnabled="False" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="搜索" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1"
                             Watermark="搜索原剧名 / 新剧名 / 时间 / 状态 / 问题"
                             Text="{Binding QueueSearchText, Mode=TwoWay}" />
                    <WrapPanel Grid.Column="2" Orientation="Horizontal">
                        <CheckBox Content="仅待上传" IsChecked="{Binding ShowOnlyPendingUpload}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Content="全选" Click="OnSelectAllQueueClick" Classes="compactAction" Margin="0,0,8,0" />
                        <Button Content="取消" Click="OnClearQueueSelectionClick" Classes="compactAction" />
                    </WrapPanel>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Button Grid.Column="0" Content="步骤设置" Classes="secondaryAction compactAction">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel MinWidth="520" Spacing="10" Margin="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="启用步骤" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Content="全选步骤" Command="{Binding SelectAllQueueStepsCommand}" Classes="compactAction" />
                                            <Button Content="取消全选" Command="{Binding ClearAllQueueStepsCommand}" Classes="compactAction" />
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel Orientation="Horizontal">
                                        <CheckBox Content="下载剧集" IsChecked="{Binding QueueDownloadEnabled}" Margin="0,0,12,6" />
                                        <CheckBox Content="改写信息" IsChecked="{Binding QueueRewriteEnabled}" Margin="0,0,12,6" />
                                        <CheckBox Content="生成海报" IsChecked="{Binding QueueGeneratePosterEnabled}" Margin="0,0,12,6" />
                                        <CheckBox Content="小文件修复" IsChecked="{Binding QueueSmallVideoRepairEnabled}" Margin="0,0,12,6" />
                                        <CheckBox Content="静音检测" IsChecked="{Binding QueueSilenceDetectEnabled}" Margin="0,0,12,6" />
                                        <CheckBox Content="静音修复" IsChecked="{Binding QueueSilenceRepairEnabled}" Margin="0,0,12,6" />
                                        <CheckBox Content="素材校验" IsChecked="{Binding QueueMaterialValidateEnabled}" Margin="0,0,12,6" />
                                        <CheckBox Content="删除源视频" IsChecked="{Binding QueueDeleteSourceVideosEnabled}" Margin="0,0,12,6" />
                                        <CheckBox Content="上传剧集" IsChecked="{Binding QueueUploadEnabled}" Margin="0,0,12,6" />
                                    </WrapPanel>
                                    <WrapPanel Orientation="Horizontal">
                                        <CheckBox Content="上传完成后自动归档" IsChecked="{Binding AutoArchiveAfterUpload}" Margin="0,0,16,0" />
                                        <CheckBox Content="强制重跑已完成步骤" IsChecked="{Binding ForceRerunCompletedSteps}" Margin="0,0,16,0" />
                                        <CheckBox Content="有待上传项目时优先上传" IsChecked="{Binding PreferUploadWhenReady}" Margin="0,0,16,0" />
                                        <CheckBox Content="同步管理系统" IsChecked="{Binding SyncManagementAfterUpload}" Margin="0,0,16,0" />
                                    </WrapPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Border Grid.Column="1" Classes="stepSummaryPill" VerticalAlignment="Center">
                        <TextBlock Text="{Binding QueueStepSummary}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#335C81" />
                    </Border>

                    <WrapPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="打开浏览器" Click="OnOpenBrowserClick" Classes="secondaryAction compactAction" Margin="0,0,8,0" />
                        <Button Content="运行日志" Click="OnOpenLogsClick" Classes="compactAction" Margin="0,0,8,0" />
                        <Button Content="发布配置" Click="OnPublishConfigClick" Classes="compactAction" Margin="0,0,8,0" />
                        <Button Content="项目操作 ▾" Classes="compactAction" Margin="0,0,8,0">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Spacing="6" Margin="4">
                                        <Button Content="刷新项目" Click="OnScanWorkspaceClick" Classes="menuAction" />
                                        <Button Content="上传短剧" Click="OnUploadTitlesClick" Classes="menuAction" />
                                        <Button Content="编辑剧集" Click="OnEditSelectedClick" Classes="menuAction" />
                                        <Button Content="修复静音视频" Click="OnRepairSilenceClick" Classes="menuAction" />
                                        <Button Content="归档选中" Click="OnArchiveSelectedClick" Classes="menuAction" />
                                        <Button Content="从队列移除" Click="OnRemoveSelectedClick" Classes="menuAction" />
                                        <Button Content="删除勾选" Click="OnDeleteSelectedClick" Classes="dangerAction menuAction" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Content="账号操作 ▾" Classes="compactAction" Margin="0,0,8,0">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Spacing="6" Margin="4">
                                        <Button Content="绑定选中账号" Click="OnBindSelectedAccountClick" Classes="menuAction" />
                                        <Button Content="绑定全部待上传" Click="OnBindAllPendingClick" Classes="menuAction" />
                                        <Button Content="勾选到当前项目" Click="OnSelectToCurrentProjectClick" Classes="menuAction" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Content="工具 ▾" Classes="compactAction">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Spacing="6" Margin="4">
                                        <Button Content="导出 Excel" Click="OnExportExcelClick" Classes="menuAction" />
                                        <Button Content="打开 Excel" Click="OnOpenExcelClick" Classes="menuAction" />
                                        <Button Content="同步勾选任务" Click="OnSyncSelectedManagementClick" Classes="menuAction" />
                                        <Button Content="手动发布测试" Click="OnPublishClick" Classes="menuAction" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </WrapPanel>
                </Grid>

                <TextBlock Text="{Binding RunningWorkspacesSummary}"
                           Foreground="#1A5F8A"
                           IsVisible="{Binding IsQueueRunning}"
                           TextWrapping="Wrap" Margin="0,-2,0,0" />
                <TextBlock x:Name="ManualInterventionHint"
                           Text="{Binding ManualInterventionHint}"
                           Foreground="#B94218"
                           IsVisible="{Binding ManualInterventionPending}"
                           TextWrapping="Wrap" Margin="0,-4,0,0" />

                <WrapPanel Orientation="Horizontal">
                    <TextBlock Classes="pageSummary" Text="{Binding WorkspaceBindingSummary}" Margin="0,0,12,0" />
                    <TextBlock Classes="pageSummary" Text="{Binding QueueSummaryText}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 手动发布区暂时隐藏：保留代码，后续需要时移除 IsVisible 即可恢复 -->
        <Border DockPanel.Dock="Bottom" Classes="controlsFrame" MaxHeight="220" Margin="0,10,0,0" IsVisible="False">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="手动发布（多账号并发）" FontWeight="SemiBold" Margin="0,0,0,8" />
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="添加素材" Click="OnAddMaterialsClick" Margin="0,0,8,8" />
                    <Button Content="导入任务(JSON)" Click="OnImportTasksClick" Margin="0,0,8,8" />
                    <TextBlock Text="结束动作" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <ComboBox ItemsSource="{Binding FinalActionChoices}" SelectedItem="{Binding SelectedFinalAction}" MinWidth="150" Margin="0,0,8,8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FinalActionChoice">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="并发账号" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <NumericUpDown Value="{Binding MaxParallel}" Minimum="1" Maximum="8" Increment="1" Width="110" Margin="0,0,8,8" />
                    <Button x:Name="StartPublishButton" Content="开始发布" Click="OnStartPublishClick" Classes="primaryAction" Margin="0,0,8,8" />
                    <Button x:Name="StopPublishButton" Content="停止" Click="OnStopPublishClick" Classes="dangerAction" IsEnabled="False" Margin="0,0,8,8" />
                    <Button Content="清空已完成" Click="OnClearDoneClick" Margin="0,0,8,8" />
                    <Button Content="清除续传记录" Click="OnClearResumeClick" Margin="0,0,8,8" />
                </WrapPanel>

                <Grid DockPanel.Dock="Top" ColumnDefinitions="140,*,150,80,*" Margin="0,0,0,4">
                    <TextBlock Grid.Column="0" Text="账号" Classes="pageSummary" />
                    <TextBlock Grid.Column="1" Text="视频" Classes="pageSummary" />
                    <TextBlock Grid.Column="2" Text="剧集" Classes="pageSummary" />
                    <TextBlock Grid.Column="3" Text="状态" Classes="pageSummary" />
                    <TextBlock Grid.Column="4" Text="信息" Classes="pageSummary" />
                </Grid>

                <ListBox ItemsSource="{Binding Tasks}" MaxHeight="100" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PublishTaskItemViewModel">
                            <Grid ColumnDefinitions="140,*,150,80,*">
                                <TextBlock Grid.Column="0" Text="{Binding AccountName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding VideoName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding DramaName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{Binding StatusText}" />
                                <TextBlock Grid.Column="4" Text="{Binding Message}" TextTrimming="CharacterEllipsis" Classes="pageSummary" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 队列表格：作为 DockPanel 最后一个未指定 Dock 的子项，自动填充剩余空间 -->
        <Border BorderBrush="#DFD1C0" BorderThickness="1" CornerRadius="6">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid RowDefinitions="Auto,*" Width="1620">
                    <Grid Grid.Row="0" ColumnDefinitions="56,64,128,220,220,72,140,72,72,72,72,72,72,72,72,72,72">
                        <TextBlock Grid.Column="0" Text="序号" Classes="tableHeader" />
                        <TextBlock Grid.Column="1" Text="启用" Classes="tableHeader" />
                        <TextBlock Grid.Column="2" Text="账号槽" Classes="tableHeader" />
                        <TextBlock Grid.Column="3" Text="原剧名" Classes="tableHeader" />
                        <TextBlock Grid.Column="4" Text="新剧名" Classes="tableHeader" />
                        <TextBlock Grid.Column="5" Text="集数" Classes="tableHeader" />
                        <TextBlock Grid.Column="6" Text="加入时间" Classes="tableHeader" />
                        <TextBlock Grid.Column="7" Text="下载" Classes="tableHeader" />
                        <TextBlock Grid.Column="8" Text="改写" Classes="tableHeader" />
                        <TextBlock Grid.Column="9" Text="海报" Classes="tableHeader" />
                        <TextBlock Grid.Column="10" Text="修复" Classes="tableHeader" />
                        <TextBlock Grid.Column="11" Text="静音检测" Classes="tableHeader" />
                        <TextBlock Grid.Column="12" Text="静音修复" Classes="tableHeader" />
                        <TextBlock Grid.Column="13" Text="校验" Classes="tableHeader" />
                        <TextBlock Grid.Column="14" Text="删源" Classes="tableHeader" />
                        <TextBlock Grid.Column="15" Text="上传" Classes="tableHeader" />
                        <TextBlock Grid.Column="16" Text="状态" Classes="tableHeader" />
                    </Grid>

                    <ListBox x:Name="QueueProjectList"
                             Grid.Row="1"
                             ItemsSource="{Binding FilteredQueueProjectRows}"
                             Background="{StaticResource PythonInputBg}"
                             SelectionMode="Multiple"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:QueueProjectRowViewModel">
                                <Grid ColumnDefinitions="56,64,128,220,220,72,140,72,72,72,72,72,72,72,72,72,72" MinHeight="36" Width="1620">
                                    <TextBlock Grid.Column="0" Text="{Binding RowIndex}" VerticalAlignment="Center" Margin="8,0" />
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding AccountName}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" FontSize="12" />
                                    <Button Grid.Column="3"
                                            Classes="queueLink"
                                            Click="OnOpenOriginalProjectFolderClick"
                                            ToolTip.Tip="{Binding OriginalProjectDir}">
                                        <TextBlock Text="{Binding OriginalTitle}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="#0F63C7" />
                                    </Button>
                                    <Button Grid.Column="4"
                                            Classes="queueLink"
                                            Click="OnOpenNewProjectFolderClick"
                                            ToolTip.Tip="{Binding NewProjectDir}">
                                        <TextBlock Text="{Binding NewTitle}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="#0F63C7" />
                                    </Button>
                                    <TextBlock Grid.Column="5" Text="{Binding EpisodeCount}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBlock Grid.Column="6" Text="{Binding QueuedAt}" VerticalAlignment="Center" Margin="8,0" FontSize="12" />
                                    <TextBlock Grid.Column="7" Text="{Binding DownloadStatus}" Foreground="{Binding DownloadStatusBrush}" VerticalAlignment="Center" Margin="8,0" FontSize="12" />
                                    <TextBlock Grid.Column="8" Text="{Binding RewriteStatus}" Foreground="{Binding RewriteStatusBrush}" VerticalAlignment="Center" Margin="8,0" FontSize="12" />
                                    <TextBlock Grid.Column="9" Text="{Binding PosterStatus}" Foreground="{Binding PosterStatusBrush}" VerticalAlignment="Center" Margin="8,0" FontSize="12" />
                                    <TextBlock Grid.Column="10" Text="{Binding RepairStatus}" Foreground="{Binding RepairStatusBrush}" VerticalAlignment="Center" Margin="8,0" FontSize="12" />
                                    <TextBlock Grid.Column="11" Text="{Binding SilenceDetectStatus}" Foreground="{Binding SilenceDetectStatusBrush}" VerticalAlignment="Center" Margin="8,0" FontSize="12" />
                                    <TextBlock Grid.Column="12" Text="{Binding SilenceRepairStatus}" Foreground="{Binding SilenceRepairStatusBrush}" VerticalAlignment="Center" Margin="8,0" FontSize="12" />
                                    <TextBlock Grid.Column="13" Text="{Binding ValidateStatus}" Foreground="{Binding ValidateStatusBrush}" VerticalAlignment="Center" Margin="8,0" FontSize="12" />
                                    <TextBlock Grid.Column="14" Text="{Binding DeleteSourceStatus}" Foreground="{Binding DeleteSourceStatusBrush}" VerticalAlignment="Center" Margin="8,0" FontSize="12" />
                                    <TextBlock Grid.Column="15" Text="{Binding UploadStatus}" Foreground="{Binding UploadStatusBrush}" VerticalAlignment="Center" Margin="8,0" FontSize="12" />
                                    <TextBlock Grid.Column="16" Text="{Binding StatusText}" Foreground="{Binding StatusTextBrush}" VerticalAlignment="Center" Margin="8,0" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
