<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TikTokPublisher.Ui.Controls"
             x:Class="TikTokPublisher.Ui.Views.TikTokAccountAnalyticsView"
             Background="{StaticResource PythonPanelBgBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="16" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto,Auto">
            <StackPanel>
                <TextBlock Text="数据统计" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" Text="显示全部账号。剧集每日新增从第一次同步那天开始计算。"
                           Foreground="#6B7280" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="LastFetchedText" Foreground="#475569" FontSize="12" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="更新全部账号" MinWidth="120" Margin="0,0,8,0" Click="OnRefreshClick" />
            <Button x:Name="StopButton" Grid.Column="2" Content="停止" MinWidth="72" IsEnabled="False" Click="OnStopClick" />
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <controls:AnalyticsDashboardSummary x:Name="DashboardSummary" />
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="2*,*" ColumnSpacing="12">
            <Border Background="White" CornerRadius="8" Padding="14">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="有效播放趋势" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel x:Name="DailyRangePanel" Orientation="Horizontal" Spacing="6" />
                        <ToggleButton x:Name="CompareToggle" Content="账号对比" IsChecked="True" Margin="8,0,0,0" IsCheckedChanged="OnCompareToggleChanged" />
                        <ToggleButton x:Name="MonthlyToggle" Content="按月" Margin="8,0,0,0" IsCheckedChanged="OnMonthlyToggleChanged" />
                    </WrapPanel>
                    <TextBlock x:Name="DailyHoverText" DockPanel.Dock="Top" Foreground="#475569" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ChartScopeText" DockPanel.Dock="Top" Foreground="#475569" FontSize="12" />
                    <Panel Height="245">
                        <controls:AnalyticsLineChart x:Name="DailyChart" />
                        <controls:AnalyticsLineChart x:Name="MonthlyChart" IsVisible="False" />
                    </Panel>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="账号排行 · 区间有效播放" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ScrollViewer MaxHeight="270">
                        <controls:AnalyticsAccountRanking x:Name="AccountRanking" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Expander Grid.Row="3" Header="账号收益与上架明细" HorizontalAlignment="Stretch">
            <StackPanel x:Name="RevenuePanel" />
        </Expander>

        <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="12" Height="480">
            <TabControl x:Name="SeriesTabs" />
        </Border>

        <Border Grid.Row="5" Background="White" CornerRadius="8" Padding="12" Margin="0,8,0,0" Height="200">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <TextBlock x:Name="GrowthTitle" Text="点一部剧，查看每日增长" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="GrowthMetricPanel" Grid.Column="1" Orientation="Horizontal" Spacing="6" />
                </Grid>
                <controls:AnalyticsLineChart x:Name="GrowthChart" />
            </DockPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Grid.Row="6" Foreground="#B45309" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
    </ScrollViewer>
</UserControl>
