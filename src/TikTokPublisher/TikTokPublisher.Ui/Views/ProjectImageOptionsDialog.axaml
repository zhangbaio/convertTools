<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TikTokPublisher.Ui.Views.ProjectImageOptionsDialog"
        Title="工程图生成参数" Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <StyleInclude Source="avares://TikTokPublisher.Ui/Themes/ConfigurationFormStyles.axaml" />
    </Window.Styles>
    <StackPanel Margin="20" Spacing="16">
        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
            <TextBlock Text="工程图 AI 台词" VerticalAlignment="Center" />
            <ComboBox x:Name="SubtitleModeBox" Grid.Column="1" HorizontalAlignment="Stretch"
                      Classes="configurationInput">
                <ComboBoxItem Content="快速（推荐）" Tag="fast" />
                <ComboBoxItem Content="准确" Tag="accurate" />
                <ComboBoxItem Content="关闭" Tag="off" />
            </ComboBox>
            <TextBlock Grid.Row="1" Text="工程图数量" VerticalAlignment="Center" />
            <NumericUpDown x:Name="CountBox" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="20"
                           Classes="configurationInput" />
            <TextBlock Grid.Row="2" Text="工程图导入集数" VerticalAlignment="Center" />
            <NumericUpDown x:Name="EpisodeLimitBox" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="200"
                           Classes="configurationInput" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="取消" IsCancel="True" Click="OnCancelClick" />
            <Button Content="确定" IsDefault="True" Classes="primaryAction" Click="OnConfirmClick" />
        </StackPanel>
    </StackPanel>
</Window>
