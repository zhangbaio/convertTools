<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TikTokPublisher.Ui.Views"
        x:Class="TikTokPublisher.Ui.Views.AccountSettingsDialog"
        Width="640" Height="620"
        WindowStartupLocation="CenterOwner"
        Title="账号设置">
    <Window.Styles>
        <StyleInclude Source="avares://TikTokPublisher.Ui/Themes/ConfigurationFormStyles.axaml" />
    </Window.Styles>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0">
            <Button Content="取消" Click="OnCancel" />
            <Button Content="保存" Click="OnSave" Background="#E67E22" Foreground="White" />
        </StackPanel>

        <TabControl>
            <TabItem Header="基本信息">
                <ScrollViewer>
                    <StackPanel Spacing="8" Margin="4">
                        <TextBox Classes="configurationInput" x:Name="NameBox" Watermark="账号名称" />
                        <TextBox Classes="configurationInput" x:Name="NicknameBox" Watermark="TikTok 昵称" />
                        <TextBox Classes="configurationInput" x:Name="LoginEmailBox" Watermark="登录邮箱/用户名" />
                        <TextBox Classes="configurationInput" x:Name="SeriesUrlBox" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Classes="configurationInput" x:Name="WorkspaceBox" Watermark="上传工作目录" MinWidth="420" />
                            <Button Content="浏览…" Click="OnBrowseWorkspaceClick" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Classes="configurationInput" x:Name="ArchiveRootBox" Watermark="归档目录（留空时默认使用上传工作目录下的 archive）" MinWidth="420" />
                            <Button Content="浏览…" Click="OnBrowseArchiveRootClick" />
                        </StackPanel>
                        <TextBox Classes="configurationInput" x:Name="DownloadWorkspaceBox" Watermark="下载工作目录（last_download_workspace，可选）" />
                        <CheckBox x:Name="DeleteVideosOnArchiveBox" Content="归档时删除视频文件" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="远程分发" VerticalAlignment="Center" />
                            <CheckBox x:Name="RemoteDispatchBox" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="关闭后归档目录会保留视频，占用更多磁盘" Foreground="#6B7280" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="发布">
                <ScrollViewer>
                    <StackPanel Spacing="8" Margin="4">
                        <Grid ColumnDefinitions="130,*" ColumnSpacing="10">
                            <TextBlock Grid.Column="0" Text="剧集类型" VerticalAlignment="Center" />
                            <ComboBox Classes="configurationInput" Grid.Column="1"
                                      x:Name="DramaMarketCombo"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnDramaMarketSelectionChanged">
                                <ComboBoxItem Tag="local">本土剧</ComboBoxItem>
                                <ComboBoxItem Tag="overseas">海外剧</ComboBoxItem>
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="130,*"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              RowSpacing="8"
                              ColumnSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="合同 ID" VerticalAlignment="Center" />
                            <TextBox Classes="configurationInput" Grid.Row="0" Grid.Column="1" x:Name="ContractIdBox" Watermark="合同 ID" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="提交动作" VerticalAlignment="Center" />
                            <ComboBox Classes="configurationInput" Grid.Row="2" Grid.Column="1" x:Name="SubmitActionCombo" HorizontalAlignment="Stretch">
                                <ComboBoxItem Tag="none">不提交</ComboBoxItem>
                                <ComboBoxItem Tag="save">保存</ComboBoxItem>
                                <ComboBoxItem Tag="submit">提交</ComboBoxItem>
                            </ComboBox>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="发布模式" VerticalAlignment="Center" />
                            <ComboBox Classes="configurationInput" Grid.Row="3" Grid.Column="1" x:Name="PublishModeCombo" HorizontalAlignment="Stretch">
                                <ComboBoxItem Tag="auto_after_review">过审后自动发布</ComboBoxItem>
                                <ComboBoxItem Tag="manual">手动发布</ComboBoxItem>
                                <ComboBoxItem Tag="scheduled">定时发布</ComboBoxItem>
                            </ComboBox>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="目标观众" VerticalAlignment="Center" />
                            <ComboBox Classes="configurationInput" Grid.Row="4" Grid.Column="1" x:Name="AudienceCombo" HorizontalAlignment="Stretch">
                                <ComboBoxItem Tag="female">女性</ComboBoxItem>
                                <ComboBoxItem Tag="male">男性</ComboBoxItem>
                                <ComboBoxItem Tag="ai_recommend">AI 推荐</ComboBoxItem>
                            </ComboBox>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="源语言" VerticalAlignment="Center" />
                            <ComboBox Classes="configurationInput" Grid.Row="5" Grid.Column="1" x:Name="SourceLanguageCombo" HorizontalAlignment="Stretch">
                                <ComboBoxItem Tag="auto">AI识别语言</ComboBoxItem>
                                <ComboBoxItem Tag="zh">中文</ComboBoxItem>
                                <ComboBoxItem Tag="en">英语 / English</ComboBoxItem>
                                <ComboBoxItem Tag="id">印尼语 / Indonesian</ComboBoxItem>
                                <ComboBoxItem Tag="pt">葡语 / Portuguese</ComboBoxItem>
                                <ComboBoxItem Tag="ja">日语 / Japanese</ComboBoxItem>
                                <ComboBoxItem Tag="th">泰语 / Thai</ComboBoxItem>
                                <ComboBoxItem Tag="es">西语 / Spanish</ComboBoxItem>
                                <ComboBoxItem Tag="ko">韩语 / Korean</ComboBoxItem>
                                <ComboBoxItem Tag="tr">土耳其语 / Turkish</ComboBoxItem>
                                <ComboBoxItem Tag="hi">印地语 / Hindi</ComboBoxItem>
                            </ComboBox>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="上传方式" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="6" Grid.Column="1" Spacing="8">
                                <ComboBox Classes="configurationInput" x:Name="UploadStrategyCombo" HorizontalAlignment="Stretch" SelectionChanged="UploadStrategyCombo_SelectionChanged">
                                    <ComboBoxItem Tag="playwright">网页上传</ComboBoxItem>
                                    <ComboBoxItem Tag="api">接口上传</ComboBoxItem>
                                </ComboBox>
                                <StackPanel x:Name="PlaywrightDeliveryPanel" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="正片投递" VerticalAlignment="Center" />
                                    <ComboBox Classes="configurationInput" x:Name="PlaywrightDeliveryCombo" MinWidth="280">
                                        <ComboBoxItem Tag="classic">经典（一次传完全部）</ComboBoxItem>
                                        <ComboBoxItem Tag="batch">分批（卡死就整批重传）</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="7" Grid.Column="1" Spacing="5">
                                <ToggleSwitch x:Name="PaidEnabledBox" OnContent="付费模式" OffContent="付费模式" AutomationProperties.Name="付费模式" />
                                <StackPanel Spacing="5" IsVisible="{Binding IsChecked, ElementName=PaidEnabledBox}">
                                    <WrapPanel>
                                        <RadioButton x:Name="PaidRatioModeBox" GroupName="DialogPaidStrategy" Content="按比例付费" IsChecked="True" Margin="0,0,16,0" />
                                        <RadioButton x:Name="PaidAllModeBox" GroupName="DialogPaidStrategy" Content="全部付费" />
                                    </WrapPanel>
                                    <StackPanel Spacing="4" IsVisible="{Binding IsChecked, ElementName=PaidRatioModeBox}">
                                        <TextBlock Text="付费比例（按剧计算）" />
                                        <NumericUpDown Classes="configurationInput" x:Name="PaidRatioPercentBox" Minimum="0" Maximum="100" Value="20"
                                                       AutomationProperties.Name="付费比例 %" FormatString="0.##'%'" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="AI 短剧" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="10" Grid.Column="1" x:Name="AiDramaBox" Content="是" IsChecked="True" />

                            <TextBlock Grid.Row="11" Grid.Column="0" Text="AI 改写简介" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="11" Grid.Column="1" x:Name="AiRewriteSynopsisBox" Content="启用" />

                            <TextBlock Grid.Row="12" Grid.Column="0" Text="新剧名随机度" VerticalAlignment="Center" />
                            <ComboBox Classes="configurationInput" Grid.Row="12" Grid.Column="1" x:Name="AiNewTitleRandomnessCombo" Width="160" HorizontalAlignment="Left">
                                <ComboBoxItem Tag="low">低</ComboBoxItem>
                                <ComboBoxItem Tag="medium">中（默认）</ComboBoxItem>
                                <ComboBoxItem Tag="high">高</ComboBoxItem>
                            </ComboBox>

                            <TextBlock Grid.Row="14" Grid.Column="0" Text="寄售模式" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="14" Grid.Column="1" x:Name="ConsignmentBox" Content="启用" />

                            <TextBlock Grid.Row="15" Grid.Column="0" Text="锚点推广" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="15" Grid.Column="1" x:Name="AnchorPromotionBox" Content="启用" />

                            <views:PublishAccountSelector Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="2" LabelColumnWidth="130" x:Name="PublishAccounts" />

                            <TextBlock Grid.Row="17" Grid.Column="0" Text="个人页预览集数" VerticalAlignment="Center" />
                            <NumericUpDown Classes="configurationInput" Grid.Row="17" Grid.Column="1" x:Name="ProfilePreviewBox" Minimum="1" Maximum="999" Value="3" />

                            <TextBlock Grid.Row="18" Grid.Column="0" Text="免费预览集数" VerticalAlignment="Center" />
                            <NumericUpDown Classes="configurationInput" Grid.Row="18" Grid.Column="1" x:Name="FreePreviewBox" Minimum="1" Maximum="999" Value="3" />

                            <TextBlock Grid.Row="19" Grid.Column="0" Text="题材数量" VerticalAlignment="Center" />
                            <NumericUpDown Classes="configurationInput" Grid.Row="19" Grid.Column="1" x:Name="GenreCountBox" Minimum="1" Maximum="8" Value="3" />

                            <TextBlock Grid.Row="21" Grid.Column="0" Text="项目并发数" VerticalAlignment="Center" />
                            <NumericUpDown Classes="configurationInput" Grid.Row="21" Grid.Column="1" x:Name="ProjectConcurrencyBox" Minimum="1" Maximum="8" Value="4" />

                            <TextBlock x:Name="BatchSizeLabel" Grid.Row="22" Grid.Column="0" Text="分批·每批数量" VerticalAlignment="Center" />
                            <NumericUpDown Classes="configurationInput" Grid.Row="22" Grid.Column="1" x:Name="UploadBatchSizeBox" Minimum="1" Maximum="20" Value="3" />

                            <TextBlock x:Name="BatchStallLabel" Grid.Row="23" Grid.Column="0" Text="分批·卡死秒数" VerticalAlignment="Center" />
                            <NumericUpDown Classes="configurationInput" Grid.Row="23" Grid.Column="1" x:Name="UploadBatchStallBox" Minimum="20" Maximum="600" Value="75" />

                            <TextBlock x:Name="BatchRetriesLabel" Grid.Row="24" Grid.Column="0" Text="分批·重试次数" VerticalAlignment="Center" />
                            <NumericUpDown Classes="configurationInput" Grid.Row="24" Grid.Column="1" x:Name="UploadBatchRetriesBox" Minimum="1" Maximum="10" Value="3" />

                            <TextBlock Grid.Row="25" Grid.Column="0" Text="预期价格" VerticalAlignment="Center" />
                            <TextBox Classes="configurationInput" Grid.Row="25" Grid.Column="1" x:Name="ExpectedPriceValueBox" Watermark="0.3" />


                            <TextBlock Grid.Row="32" Grid.Column="0" Text="上传浏览器" VerticalAlignment="Center" />
                            <ComboBox Classes="configurationInput" Grid.Row="32" Grid.Column="1" x:Name="UploadBrowserModeCombo" HorizontalAlignment="Stretch">
                                <ComboBoxItem Tag="embedded">内置浏览器（WebView2）</ComboBoxItem>
                                <ComboBoxItem Tag="playwright">外部浏览器（显示窗口）</ComboBoxItem>
                                <ComboBoxItem Tag="playwright_headless">外部浏览器（无头）</ComboBoxItem>
                            </ComboBox>

                            <TextBlock Grid.Row="34" Grid.Column="0" Text="原始权利人" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="34" Grid.Column="1" x:Name="OriginalRightsHolderBox" Content="是" IsChecked="True" />

                            <TextBlock Grid.Row="35" Grid.Column="0" Text="内容原创类型" VerticalAlignment="Center" />
                            <ComboBox Classes="configurationInput" Grid.Row="35" Grid.Column="1" x:Name="ContentOriginalityCombo" HorizontalAlignment="Stretch">
                                <ComboBoxItem Tag="original">原创</ComboBoxItem>
                                <ComboBoxItem Tag="adapted">改编</ComboBoxItem>
                            </ComboBox>

                            <TextBlock Grid.Row="37" Grid.Column="0" Text="0 元投放" VerticalAlignment="Top" Margin="0,5,0,0" />
                            <StackPanel Grid.Row="37" Grid.Column="1" Spacing="8">
                                <CheckBox x:Name="ZeroCostAdsBox" Content="启用" />
                                <Grid ColumnDefinitions="110,*"
                                      ColumnSpacing="10"
                                      IsVisible="{Binding IsChecked, ElementName=ZeroCostAdsBox}">
                                    <TextBlock Grid.Column="0" Text="第 0 天 ROI" VerticalAlignment="Center" />
                                    <NumericUpDown Classes="configurationInput" Grid.Column="1"
                                                   x:Name="DayZeroRoiBox"
                                                   Minimum="1.00"
                                                   Maximum="1.50"
                                                   Increment="0.01"
                                                   FormatString="0.00"
                                                   Value="1.05"
                                                   Width="160"
                                                   HorizontalAlignment="Left" />
                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="38" Grid.Column="0" Text="内容创作类型" VerticalAlignment="Center" />
                            <ComboBox Classes="configurationInput" Grid.Row="38" Grid.Column="1" x:Name="ContentCreationTypeCombo" HorizontalAlignment="Stretch">
                                <ComboBoxItem Tag="original">原创</ComboBoxItem>
                                <ComboBoxItem Tag="remake">成片重制</ComboBoxItem>
                                <ComboBoxItem Tag="novel_adaptation">小说改编</ComboBoxItem>
                            </ComboBox>

                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="上传材料">
                <ScrollViewer>
                    <views:CopyrightMaterialSelector x:Name="CopyrightMaterials" Margin="4" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="代理">
                <ScrollViewer>
                    <StackPanel Spacing="8" Margin="4">
                        <CheckBox x:Name="ProxyEnabledBox" Content="启用代理" />
                        <ComboBox Classes="configurationInput" x:Name="ProxyTypeCombo" HorizontalAlignment="Stretch">
                            <ComboBoxItem Tag="http">HTTP</ComboBoxItem>
                            <ComboBoxItem Tag="socks5">SOCKS5</ComboBoxItem>
                        </ComboBox>
                        <TextBox Classes="configurationInput" x:Name="ProxyHostBox" Watermark="代理主机" />
                        <NumericUpDown Classes="configurationInput" x:Name="ProxyPortBox" Minimum="0" Maximum="65535" Value="0" Width="160" HorizontalAlignment="Left" />
                        <TextBox Classes="configurationInput" x:Name="ProxyUsernameBox" Watermark="代理用户名" />
                        <TextBox Classes="configurationInput" x:Name="ProxyPasswordBox" Watermark="代理密码" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
