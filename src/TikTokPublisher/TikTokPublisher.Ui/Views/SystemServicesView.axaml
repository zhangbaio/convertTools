<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TikTokPublisher.Ui.ViewModels"
             xmlns:views="using:TikTokPublisher.Ui.Views"
             x:Class="TikTokPublisher.Ui.Views.SystemServicesView"
             x:DataType="vm:SystemServicesViewModel"
             Background="{StaticResource PythonPageBgBrush}">
    <UserControl.Styles>
        <StyleInclude Source="avares://TikTokPublisher.Ui/Themes/ConfigurationFormStyles.axaml" />
    </UserControl.Styles>


    <ScrollViewer>
        <StackPanel Spacing="12" Margin="4" MaxWidth="1080">
            <TextBlock Text="{Binding ServiceSummaryText}" Classes="pageSummary" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="120,*"
                  RowDefinitions="Auto,Auto,Auto"
                  RowSpacing="10"
                  ColumnSpacing="10">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="授权状态" VerticalAlignment="Top" Margin="0,6,0,0" />
                <TextBox Classes="configurationInput" Grid.Row="0"
                         Grid.Column="1"
                         Text="{Binding LicenseSummary}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="120" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="服务器地址" VerticalAlignment="Center" />
                <TextBox Classes="configurationInput" Grid.Row="1"
                         Grid.Column="1"
                         Text="{Binding AuthServerUrl}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="联网校验间隔" VerticalAlignment="Center" />
                <NumericUpDown Classes="configurationInput" Grid.Row="2"
                               Grid.Column="1"
                               Value="{Binding LicenseVerifyIntervalHours, Mode=OneWay}"
                               Minimum="1"
                               Maximum="1"
                               IsEnabled="False"
                               Width="170"
                               HorizontalAlignment="Left"
                               FormatString="0 小时（系统固定）" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="保存授权配置" Command="{Binding SaveAuthServerUrlCommand}" />
                <Button Content="登录 / 更换账号" Click="OnLicenseLoginClick" Classes="primaryAction" />
                <Button Content="退出登录 / 清除本机登录" Click="OnLicenseLogoutClick" />
                <Button Content="导出配置" Click="OnExportConfigClick" />
                <Button Content="导入配置" Click="OnImportConfigClick" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="上传配置到云端"
                        Click="OnUploadCloudConfigClick"
                        Classes="primaryAction"
                        IsEnabled="{Binding CloudConfigSyncEnabled}" />
                <Button Content="从云端下载配置"
                        Click="OnDownloadCloudConfigClick"
                        IsEnabled="{Binding CloudConfigSyncEnabled}" />
            </StackPanel>
            <TextBlock Text="上传和下载使用当前软件登录账号。云端只保留一份配置，后一次上传会覆盖前一次。另一台电脑登录同一账号后，可以手动下载并合并。"
                       Classes="compactHint"
                       TextWrapping="Wrap" />

            <TextBlock Text="软件每次启动及运行期间都会联网校验账号和设备授权；网络失败、未登录、授权过期、设备不匹配或服务器拒绝授权时，软件将直接退出。登录信息保存在 ~/.tiktok_publisher/license_state.bin。"
                       Classes="compactHint"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding LoginStatus}" Classes="pageSummary" TextWrapping="Wrap" />

            <Separator />
            <TextBlock Text="客户端更新" Classes="configurationHeading" />
            <TextBlock Text="{Binding ClientUpdateStatus}" Classes="pageSummary" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ClientUpdateDetail}" Classes="compactHint" TextWrapping="Wrap" />
            <TextBlock Text="已用自动升级包装过的程序会从管理系统拿到阿里云 OSS 目录并下载新版本。队列运行时只下载，不重启。"
                       Classes="compactHint"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="检查更新"
                        Command="{Binding CheckClientUpdateCommand}"
                        Classes="primaryAction"
                        IsEnabled="{Binding !ClientUpdateBusy}" />
                <Button Content="升级并重启"
                        Command="{Binding RestartClientUpdateCommand}"
                        IsEnabled="{Binding ClientUpdateCanRestart}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
