<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TikTokPublisher.Ui.ViewModels"
             x:Class="TikTokPublisher.Ui.Views.SystemServicesView"
             x:DataType="vm:SystemServicesViewModel"
             Background="{StaticResource PythonPageBgBrush}">

    <ScrollViewer Margin="16,14,16,16">
        <StackPanel Spacing="12">
            <TextBlock Text="系统服务" Classes="pageTitle" />
            <TextBlock Text="{Binding ServiceSummaryText}"
                       Classes="pageSummary"
                       TextWrapping="Wrap" />

            <TabControl Classes="secondaryTabs">
                <TabItem Header="软件授权">
                    <StackPanel Spacing="12" Margin="12" MaxWidth="1180">
                        <Grid ColumnDefinitions="120,*"
                              RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="10"
                              ColumnSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="授权状态" VerticalAlignment="Top" Margin="0,6,0,0" />
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Text="{Binding LicenseSummary}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="120" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="服务器地址" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding AuthServerUrl}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="联网校验间隔" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2"
                                           Grid.Column="1"
                                           Value="{Binding LicenseVerifyIntervalHours, Mode=OneWay}"
                                           Minimum="1"
                                           Maximum="1"
                                           IsEnabled="False"
                                           Width="170"
                                           HorizontalAlignment="Left"
                                           FormatString="0 小时（系统固定）" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="登录 / 更换账号" Click="OnLicenseLoginClick" Classes="primaryAction" />
                            <Button Content="退出登录 / 清除本机登录" Click="OnLicenseLogoutClick" />
                        </StackPanel>

                        <TextBlock Text="软件每次启动都会联网校验账号和设备授权；网络临时失败时会重试，并在离线宽限期内继续使用。未登录、授权过期或设备不匹配时会进入账号登录窗口。登录信息保存在 ~/.tiktok_publisher/license_state.bin。"
                                   Classes="compactHint"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LoginStatus}" Classes="pageSummary" TextWrapping="Wrap" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="飞书命令">
                    <StackPanel Spacing="12" Margin="12" MaxWidth="1180">
                        <TextBlock Text="{Binding FeishuCommandStatus}" Classes="pageSummary" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="140,*"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              RowSpacing="9"
                              ColumnSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="监听开关" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding FeishuCommandEnabled}" Content="启用飞书命令监听" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="App ID" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FeishuCommandAppId}" Watermark="cli_xxx" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="App Secret" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FeishuCommandAppSecret}" PasswordChar="*" RevealPassword="False" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="机器人名称" VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FeishuCommandBotName}" Watermark="群里 @ 的机器人名称" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="机器人别名" VerticalAlignment="Center" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding FeishuCommandBotAliases}" Watermark="多个别名可用逗号分隔" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="群聊规则" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding FeishuCommandRequireBotMention}" Content="群聊必须 @ 机器人后才处理" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="允许群 ID" VerticalAlignment="Top" Margin="0,6,0,0" />
                            <TextBox Grid.Row="6" Grid.Column="1"
                                     Text="{Binding FeishuCommandAllowedChatIds}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="88"
                                     Watermark="每行一个 chat_id，例如：oc_xxx" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="私聊开关" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="7" Grid.Column="1" IsChecked="{Binding FeishuCommandDirectMessageEnabled}" Content="允许机器人私聊命令" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="允许私聊 ID" VerticalAlignment="Top" Margin="0,6,0,0" />
                            <TextBox Grid.Row="8" Grid.Column="1"
                                     Text="{Binding FeishuCommandAllowedUserIds}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="88"
                                     Watermark="可选，每行一个私聊 chat_id；也兼容 open_id / user_id" />

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="默认工作目录" VerticalAlignment="Center" />
                            <TextBox Grid.Row="9" Grid.Column="1"
                                     Text="{Binding FeishuCommandDefaultWorkspace}"
                                     Watermark="未在命令里指定时，默认使用这个工作目录" />

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="结果回传" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="10" Grid.Column="1" IsChecked="{Binding FeishuCommandReplyEnabled}" Content="执行结果自动回复到飞书" />

                            <TextBlock Grid.Row="11" Grid.Column="0" Text="命令有效期" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="11" Grid.Column="1"
                                           Value="{Binding FeishuCommandCommandTtlSeconds}"
                                           Minimum="10"
                                           Maximum="3600"
                                           Increment="10"
                                           Width="120"
                                           HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="12" Grid.Column="0" Text="帮助文案" VerticalAlignment="Top" Margin="0,6,0,0" />
                            <TextBox Grid.Row="12" Grid.Column="1"
                                     Text="{Binding FeishuCommandHelpText}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="160" />
                        </Grid>

                        <Border BorderBrush="{StaticResource PythonBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="本地命令测试" FontWeight="SemiBold" />
                                <TextBox Text="{Binding RemoteCommandPreviewText}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="86"
                                         Watermark="例如：上传剧集 剧名A" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="测试命令" Command="{Binding RunRemoteCommandPreviewCommand}" />
                                    <TextBlock Text="{Binding RemoteCommandPreviewResult}" VerticalAlignment="Center" Classes="pageSummary" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="XINGE">
                    <StackPanel Spacing="12" Margin="12" MaxWidth="1180">
                        <TextBlock Text="{Binding XingeRemoteStatus}" Classes="pageSummary" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="140,*"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              RowSpacing="9"
                              ColumnSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="监听开关" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding XingeRemoteEnabled}" Content="启用 XINGE 远程命令" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="XINGE 地址" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding XingeServerUrl}" Watermark="http://127.0.0.1:8080" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="用户名/邮箱" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding XingeAccount}" Watermark="填写 XINGE 登录账号" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="密码" VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding XingePassword}" PasswordChar="*" RevealPassword="False" Watermark="填写 XINGE 登录密码" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="客户端名称" VerticalAlignment="Center" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding XingeClientName}" Watermark="TikTokPublisher" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="轮询间隔" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="5"
                                           Grid.Column="1"
                                           Value="{Binding XingePollIntervalSeconds}"
                                           Minimum="1"
                                           Maximum="60"
                                           Increment="1"
                                           Width="120"
                                           HorizontalAlignment="Left"
                                           FormatString="0 秒" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="客户端 ID（兼容）" VerticalAlignment="Center" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding XingeClientId}" Watermark="账号登录后自动生成，也可手工填写" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="客户端 Token（兼容）" VerticalAlignment="Center" />
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding XingeClientToken}" PasswordChar="*" RevealPassword="False" Watermark="账号登录后自动生成，也可手工填写" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="测试账号并生成凭证" Command="{Binding TestXingeLoginCommand}" />
                            <TextBlock Text="保存配置后也会自动登录；账号或密码变化时自动重新签发客户端凭证。"
                                       Classes="compactHint"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Text="启用后客户端会用账号登录 XINGE，注册当前工作目录和 TikTok 账号列表，并接收 XINGE 下发的 TikTok 上传命令。客户端 ID/Token 仅用于兼容旧配置。"
                                   Classes="compactHint"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="翻译配置">
                    <TabControl Classes="secondaryTabs" Margin="8">
                      <TabItem Header="通用配置">
                       <StackPanel Margin="8" Spacing="10">
                        <TextBlock Text="视频本地化处理链路" FontWeight="Bold" />
                        <TextBlock Text="选择字幕擦除与视频配音服务，并配置最终字幕样式。" Classes="compactHint" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto" RowSpacing="8">
                            <TextBlock Grid.Row="0" Text="去字幕服务" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" SelectedIndex="{Binding SubtitleRemovalProviderIndex}">
                                <ComboBoxItem Content="火山引擎" Tag="volc" />
                                <ComboBoxItem Content="百度智能云 VOD" Tag="baidu" />
                                <ComboBoxItem Content="阿里云 IMS" Tag="aliyun" />
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto" RowSpacing="8">
                            <TextBlock Grid.Row="0" Text="视频配音服务" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" SelectedIndex="{Binding VideoDubbingProviderIndex}">
                                <ComboBoxItem Content="ElevenLabs Dubbing V1" />
                                <ComboBoxItem Content="火山声影智译（字幕＋语音翻译，¥4/分钟）" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Text="添加字幕样式" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                            <TextBlock Grid.Row="0" Text="字幕字体" VerticalAlignment="Center" /><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding VideoTranslateFont}" />
                            <TextBlock Grid.Row="1" Text="字幕字号" VerticalAlignment="Center" /><NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding VideoTranslateFontSize}" Minimum="12" Maximum="120" Width="120" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="2" Text="底部边距" VerticalAlignment="Center" /><NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding VideoTranslateMarginV}" Minimum="0" Maximum="600" Width="120" HorizontalAlignment="Left" />
                        </Grid>
                       </StackPanel>
                      </TabItem>

                      <TabItem Header="ElevenLabs">
                       <StackPanel Margin="8" Spacing="10">
                        <TextBlock Text="ElevenLabs 配音配置" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                            <TextBlock Grid.Row="0" Text="API Key" VerticalAlignment="Center" /><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ElevenLabsApiKey}" PasswordChar="●" />
                            <TextBlock Grid.Row="1" Text="配音源语言" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ElevenLabsSourceLanguage}" Watermark="zh" />
                            <TextBlock Grid.Row="2" Text="配音目标语言" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ElevenLabsTargetLanguage}" Watermark="en" />
                            <TextBlock Grid.Row="3" Text="轮询秒数" VerticalAlignment="Center" /><NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding ElevenLabsPollSeconds}" Minimum="3" Maximum="60" Width="120" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="4" Text="背景音策略" VerticalAlignment="Center" /><CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding ElevenLabsDropBackgroundAudio}" Content="移除原背景音" />
                            <TextBlock Grid.Row="5" Text="声音克隆" VerticalAlignment="Center" /><CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding ElevenLabsDisableVoiceCloning}" Content="禁用声音克隆" />
                            <TextBlock Grid.Row="6" Text="语速处理模式" VerticalAlignment="Center" /><CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding ElevenLabsSpeechRateRepairEnabled}" Content="自动修复语速过快片段（不勾选则保持原始配音）" />
                            <TextBlock Grid.Row="7" Text="目标语速" VerticalAlignment="Center" /><NumericUpDown Grid.Row="7" Grid.Column="1" Value="{Binding ElevenLabsSpeechRateTarget}" Minimum="2" Maximum="4" Increment="0.1" FormatString="0.0" Width="120" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="8" Text="修复阈值" VerticalAlignment="Center" /><NumericUpDown Grid.Row="8" Grid.Column="1" Value="{Binding ElevenLabsSpeechRateThreshold}" Minimum="2" Maximum="5" Increment="0.1" FormatString="0.0" Width="120" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="9" Text="最大延长倍率" VerticalAlignment="Center" /><NumericUpDown Grid.Row="9" Grid.Column="1" Value="{Binding ElevenLabsSpeechRateMaxStretch}" Minimum="1" Maximum="1.3" Increment="0.05" FormatString="0.00" Width="120" HorizontalAlignment="Left" />
                        </Grid>
                       </StackPanel>
                      </TabItem>

                      <TabItem Header="火山引擎">
                       <StackPanel Margin="8" Spacing="10">
                        <TextBlock Text="火山视频翻译配置" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                            <TextBlock Grid.Row="0" Text="翻译源语言" VerticalAlignment="Center" /><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ElevenLabsSourceLanguage}" Watermark="zh" />
                            <TextBlock Grid.Row="1" Text="翻译目标语言" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ElevenLabsTargetLanguage}" Watermark="en" />
                            <TextBlock Grid.Row="2" Text="翻译方式" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                                <CheckBox IsChecked="{Binding VolcVideoTranslateVoice}" Content="语音翻译" />
                                <CheckBox IsChecked="{Binding VolcVideoTranslateFacial}" Content="面容翻译（Beta）" />
                                <CheckBox Content="字幕翻译（必选）"
                                          IsChecked="True"
                                          IsEnabled="False" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="字幕来源" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="3" Grid.Column="1" SelectedIndex="{Binding VolcVideoTranslateSubtitleSourceIndex}">
                                <ComboBoxItem Content="识别画面文字（OCR）" />
                                <ComboBoxItem Content="自动语音识别（ASR）" />
                                <ComboBoxItem Content="上传字幕文件（VOD FileName）" />
                            </ComboBox>
                            <TextBlock Grid.Row="4" Text="字幕 FileName" VerticalAlignment="Center" /><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding VolcVideoTranslateSubtitleFileName}" Watermark="仅字幕来源为上传文件时填写，文件须已上传到同一 VOD 空间" />
                            <TextBlock Grid.Row="5" Text="开启双字幕" VerticalAlignment="Center" /><CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding VideoTranslateBilingual}" Content="保留源语言和目标语言字幕" />
                            <TextBlock Grid.Row="6" Text="压制字幕" VerticalAlignment="Center" /><CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding VolcVideoTranslateHardSubtitle}" Content="将翻译字幕压制到成片" />
                            <TextBlock Grid.Row="7" Text="字幕字号" VerticalAlignment="Center" /><NumericUpDown Grid.Row="7" Grid.Column="1" Value="{Binding VolcVideoTranslateFontSize}" Minimum="16" Maximum="36" Increment="2" Width="120" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="8" Text="擦除原字幕" VerticalAlignment="Center" /><CheckBox Grid.Row="8" Grid.Column="1" IsChecked="{Binding VolcVideoTranslateEraseSourceSubtitle}" Content="识别并擦除视频中的原字幕" />
                            <TextBlock Grid.Row="9" Text="上传并发数" VerticalAlignment="Center" /><NumericUpDown Grid.Row="9" Grid.Column="1" Value="{Binding VolcVideoTranslateUploadConcurrency}" Minimum="1" Maximum="10" Width="120" HorizontalAlignment="Left" />
                        </Grid>
                        <TextBlock Text="火山引擎字幕擦除配置" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto" RowSpacing="8">
                            <TextBlock Grid.Row="0" Text="火山擦除方式" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" SelectedIndex="{Binding VolcSubtitleEraseModeIndex}">
                                <ComboBoxItem Content="StartExecution（精细化字幕擦除）" Tag="start_execution" />
                                <ComboBoxItem Content="Aideo Agent（低成本自动擦除）" Tag="aideo" />
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                            <TextBlock Grid.Row="0" Text="火山 AccessKeyId" VerticalAlignment="Center" /><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding VolcSubtitleAccessKeyId}" />
                            <TextBlock Grid.Row="1" Text="火山 SecretKey" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding VolcSubtitleSecretAccessKey}" PasswordChar="●" />
                            <TextBlock Grid.Row="2" Text="火山 Region" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding VolcSubtitleRegion}" Watermark="cn-north-1" />
                            <TextBlock Grid.Row="3" Text="VOD 空间名" VerticalAlignment="Center" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding VolcSubtitleSpaceName}" Watermark="例如 space24txr1" />
                            <TextBlock Grid.Row="4" Text="VOD 播放域名" VerticalAlignment="Center" /><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding VolcSubtitlePlaybackDomain}" Watermark="https://play.example.com" />
                            <TextBlock Grid.Row="5" Text="Vid 映射文件" VerticalAlignment="Center" /><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding VolcSubtitleVidManifestPath}" Watermark="默认自动维护 .tiktok/volc-vod-vids.json" />
                            <TextBlock Grid.Row="6" Text="火山轮询秒数" VerticalAlignment="Center" /><NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding VolcSubtitlePollSeconds}" Minimum="3" Maximum="60" Width="120" HorizontalAlignment="Left" />
                        </Grid>
                       </StackPanel>
                      </TabItem>

                      <TabItem Header="百度智能云">
                       <StackPanel Margin="8" Spacing="10">
                        <TextBlock Text="百度智能云字幕擦除配置" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                            <TextBlock Grid.Row="0" Text="百度 AccessKeyId" VerticalAlignment="Center" /><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BaiduSubtitleAccessKeyId}" />
                            <TextBlock Grid.Row="1" Text="百度 SecretKey" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BaiduSubtitleSecretAccessKey}" PasswordChar="●" />
                            <TextBlock Grid.Row="2" Text="VOD Endpoint" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BaiduSubtitleEndpoint}" Watermark="https://vod.bj.baidubce.com" />
                            <TextBlock Grid.Row="3" Text="模型版本" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="3" Grid.Column="1" SelectedIndex="{Binding BaiduSubtitleModelTypeIndex}">
                                <ComboBoxItem Content="V4（推荐，质量更好）" Tag="v4" />
                                <ComboBoxItem Content="V3（速度较快）" Tag="v3" />
                            </ComboBox>
                            <TextBlock Grid.Row="4" Text="擦除类型" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="4" Grid.Column="1" SelectedIndex="{Binding BaiduSubtitleTypeIndex}">
                                <ComboBoxItem Content="对白字幕" Tag="dialog" />
                                <ComboBoxItem Content="全局字幕" Tag="global" />
                            </ComboBox>
                            <TextBlock Grid.Row="5" Text="MediaId 映射文件" VerticalAlignment="Center" /><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding BaiduSubtitleMediaManifestPath}" Watermark="默认自动维护 .tiktok/baidu-vod-media-ids.json" />
                            <TextBlock Grid.Row="6" Text="百度轮询秒数" VerticalAlignment="Center" /><NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding BaiduSubtitlePollSeconds}" Minimum="3" Maximum="60" Width="120" HorizontalAlignment="Left" />
                        </Grid>
                        <TextBlock Text="所选服务缺少媒资映射时会自动上传到对应 VOD；百度需开通字幕擦除白名单，默认使用 V4 对白字幕模式。" Classes="compactHint" TextWrapping="Wrap" />
                       </StackPanel>
                      </TabItem>

                      <TabItem Header="阿里云">
                       <StackPanel Margin="8" Spacing="10">
                        <TextBlock Text="阿里云 IMS 字幕擦除配置" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                            <TextBlock Grid.Row="0" Text="阿里 AccessKeyId" VerticalAlignment="Center" /><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AliyunSubtitleAccessKeyId}" />
                            <TextBlock Grid.Row="1" Text="阿里 AccessKeySecret" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AliyunSubtitleAccessKeySecret}" PasswordChar="●" />
                            <TextBlock Grid.Row="2" Text="IMS/OSS 地域" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AliyunSubtitleRegion}" Watermark="cn-shanghai" />
                            <TextBlock Grid.Row="3" Text="OSS Bucket" VerticalAlignment="Center" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AliyunSubtitleOssBucket}" Watermark="必须与 IMS 同地域" />
                            <TextBlock Grid.Row="4" Text="OSS 对象前缀" VerticalAlignment="Center" /><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding AliyunSubtitleOssPrefix}" Watermark="tiktok-subtitle-removal" />
                            <TextBlock Grid.Row="5" Text="擦除模型" VerticalAlignment="Center" /><CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding AliyunSubtitleAdvancedModel}" Content="高级版（效果更好，0.8 元/分钟刊例价）" />
                            <TextBlock Grid.Row="6" Text="字幕检测区域" VerticalAlignment="Center" /><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding AliyunSubtitleLimitRegion}" Watermark="留空检测底部 30%；例如 [[0,0.65,1,0.35]]" />
                            <TextBlock Grid.Row="7" Text="对象映射文件" VerticalAlignment="Center" /><TextBox Grid.Row="7" Grid.Column="1" Text="{Binding AliyunSubtitleObjectManifestPath}" Watermark="默认 .tiktok/aliyun-oss-objects.json" />
                            <TextBlock Grid.Row="8" Text="阿里云轮询秒数" VerticalAlignment="Center" /><NumericUpDown Grid.Row="8" Grid.Column="1" Value="{Binding AliyunSubtitlePollSeconds}" Minimum="3" Maximum="60" Width="120" HorizontalAlignment="Left" />
                        </Grid>
                        <TextBlock Text="阿里云会把本地视频上传到 OSS，再通过 IMS VideoDetext 异步擦除；OSS Bucket、IMS 项目必须位于同一地域。" Classes="compactHint" TextWrapping="Wrap" />
                       </StackPanel>
                      </TabItem>
                    </TabControl>
                </TabItem>

                <TabItem Header="远程命令">
                    <StackPanel Spacing="12" Margin="12" MaxWidth="1180">
                        <TextBlock Text="飞书上传 TikTok 剧集" FontWeight="SemiBold" />
                        <TextBlock Text="配置飞书命令触发“上传 TikTok 剧集”时默认执行的步骤。命令文本里单独传“步骤”时会优先使用命令里的步骤；下面的队列选项仍按这里的配置生效。"
                                   Classes="pageSummary"
                                   TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="全选步骤" Command="{Binding SelectAllRemoteStepsCommand}" />
                            <Button Content="恢复默认" Command="{Binding ResetRemoteStepsCommand}" />
                            <Button Content="取消全选" Command="{Binding ClearRemoteStepsCommand}" />
                        </StackPanel>

                        <WrapPanel>
                            <CheckBox Content="下载剧集" IsChecked="{Binding RemoteDownloadEnabled}" Margin="0,0,16,10" />
                            <CheckBox Content="改写信息" IsChecked="{Binding RemoteRewriteEnabled}" Margin="0,0,16,10" />
                            <CheckBox Content="生成海报" IsChecked="{Binding RemoteGeneratePosterEnabled}" Margin="0,0,16,10" />
                            <CheckBox Content="生成证明材料" IsChecked="{Binding RemoteGenerateProofMaterialEnabled}" Margin="0,0,16,10" />
                            <CheckBox Content="小文件修复" IsChecked="{Binding RemoteSmallVideoRepairEnabled}" Margin="0,0,16,10" />
                            <CheckBox Content="静音检测" IsChecked="{Binding RemoteSilenceDetectEnabled}" Margin="0,0,16,10" />
                            <CheckBox Content="静音修复" IsChecked="{Binding RemoteSilenceRepairEnabled}" Margin="0,0,16,10" />
                            <CheckBox Content="素材校验" IsChecked="{Binding RemoteMaterialValidateEnabled}" Margin="0,0,16,10" />
                            <CheckBox Content="删除源视频" IsChecked="{Binding RemoteDeleteSourceVideosEnabled}" Margin="0,0,16,10" />
                            <CheckBox Content="去字幕" IsChecked="{Binding RemoteRemoveSubtitlesEnabled}" IsVisible="False" Margin="0,0,16,10" />
                            <CheckBox Content="视频配音" IsChecked="{Binding RemoteDubVideoEnabled}" Margin="0,0,16,10" />
                            <CheckBox Content="添加字幕" IsChecked="{Binding RemoteAddSubtitlesEnabled}" IsVisible="False" Margin="0,0,16,10" />
                            <CheckBox Content="上传剧集" IsChecked="{Binding RemoteUploadEnabled}" Margin="0,0,16,10" />
                        </WrapPanel>

                        <WrapPanel>
                            <CheckBox Content="上传完成后自动归档" IsChecked="{Binding RemoteAutoArchiveAfterUpload}" Margin="0,0,18,10" />
                            <CheckBox Content="强制重跑已完成步骤" IsChecked="{Binding RemoteForceRerunCompletedSteps}" Margin="0,0,18,10" />
                            <CheckBox Content="有待上传项目时优先上传" IsChecked="{Binding RemotePreferUploadWhenReady}" Margin="0,0,18,10" />
                        </WrapPanel>

                        <TextBlock Text="这组配置仅用于飞书远程命令里的“上传 TikTok 剧集”。本地 TikTok 上传页上的勾选步骤不会被这里覆盖。"
                                   Classes="compactHint"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </TabItem>
            </TabControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存系统服务配置" Command="{Binding SaveSystemServicesCommand}" Classes="primaryAction" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
