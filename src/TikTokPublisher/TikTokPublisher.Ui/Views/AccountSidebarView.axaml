<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TikTokPublisher.Ui.ViewModels"
             x:Class="TikTokPublisher.Ui.Views.AccountSidebarView"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="Border.accountDropIndicator">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Height" Value="2" />
            <Setter Property="Background" Value="#0078D4" />
        </Style>
        <Style Selector="ListBoxItem.accountDropBefore Border.accountDropTop">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="ListBoxItem.accountDropAfter Border.accountDropBottom">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </UserControl.Styles>

    <Border Classes="accountSidebarFrame" Padding="8,10">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="7" Margin="0,0,0,10">
                <TextBlock Text="账号" Classes="pageSummary accountSidebarHeading" />

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="添加账号" Click="OnAddClick" />
                    <Button Content="删除" Classes="dangerAction" Click="OnDeleteClick" />
                </StackPanel>
                <TextBox Watermark="昵称/ID/邮箱" Text="{Binding AccountSearchText, Mode=TwoWay}" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom"
                       Classes="pageSummary"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Text="{Binding SelectedAccount.DisplayName, TargetNullValue='未选择账号', StringFormat='当前：{0}'}" />

            <ListBox x:Name="AccountList"
                     Classes="uploadAccountList"
                     ItemsSource="{Binding FilteredAccounts}"
                     SelectedItem="{Binding SidebarSelectedAccount, Mode=OneWay}"
                     SelectionChanged="OnAccountSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountItemViewModel">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Classes="pageSummary" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="Transparent" Cursor="Hand" Padding="5,0,0,0"
                                    ToolTip.Tip="拖动调整账号顺序" AutomationProperties.Name="拖动调整账号顺序"
                                    PointerPressed="OnDragGripPressed" PointerMoved="OnDragGripMoved"
                                    PointerReleased="OnDragGripReleased" PointerCaptureLost="OnDragGripCaptureLost">
                                <TextBlock Text="⋮⋮" VerticalAlignment="Center" Classes="pageSummary" />
                            </Border>
                            <Border Grid.ColumnSpan="2" Classes="accountDropIndicator accountDropTop"
                                    VerticalAlignment="Top" IsHitTestVisible="False" />
                            <Border Grid.ColumnSpan="2" Classes="accountDropIndicator accountDropBottom"
                                    VerticalAlignment="Bottom" IsHitTestVisible="False" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
