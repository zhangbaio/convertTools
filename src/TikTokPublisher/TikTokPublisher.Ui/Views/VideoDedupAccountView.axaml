<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:TikTokPublisher.Ui.Views"
             x:Class="TikTokPublisher.Ui.Views.VideoDedupAccountView">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8" Margin="10,8,10,8">
        <Border Classes="controlsFrame" Padding="10,8">
            <StackPanel Spacing="8">
                <TextBlock x:Name="AccountSummary" TextWrapping="Wrap" Classes="pageSummary" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid ColumnDefinitions="Auto,2*,Auto,3*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="去重模板" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <ComboBox x:Name="TemplateSelector" Grid.Column="1" MinWidth="110" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnTemplateSelectionChanged" AutomationProperties.Name="去重模板" />
                        <TextBlock Grid.Column="2" Text="模板名称" VerticalAlignment="Center" />
                        <TextBox x:Name="TemplateName" Grid.Column="3" MinWidth="110" Watermark="例如 保留原分集"
                                 AutomationProperties.Name="模板名称" />
                        <Button x:Name="NewButton" Grid.Column="4" Content="新建" Click="OnNewClick" Classes="secondaryAction" />
                        <Button x:Name="CopyButton" Grid.Column="5" Content="复制" Click="OnCopyClick" Classes="secondaryAction" />
                        <Button x:Name="DeleteButton" Grid.Column="6" Content="删除模板" Click="OnDeleteClick" Classes="dangerSoftAction" />
                        <TextBlock x:Name="UsageSummary" Grid.Column="7" Classes="pageSummary" VerticalAlignment="Center" />
                    </Grid>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <views:VideoDedupPresetEditor x:Name="PresetEditor" Grid.Row="1" />
        <Border Grid.Row="2" Classes="controlsFrame" Padding="10,8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock x:Name="FeedbackText" Classes="pageSummary" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button x:Name="SaveButton" Grid.Column="1" Content="保存配置" Classes="primaryAction" Click="OnSaveClick" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
