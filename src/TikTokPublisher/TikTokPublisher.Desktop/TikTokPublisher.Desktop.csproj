<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\tiktok-shortdrama-logo.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- 素材发布视图/控件/VM/自动化已抽到 TikTokPublisher.Ui 库 -->
    <ProjectReference Include="..\TikTokPublisher.Ui\TikTokPublisher.Ui.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\..\ShortDrama\ShortDrama.Infrastructure\Tools\hongguo-high\provision_startup_masters.py">
      <Link>tools\hongguo-high\provision_startup_masters.py</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\packaging\dependencies\tools\win-x64\ffmpeg')">
    <Content Include="$(MSBuildThisFileDirectory)..\..\..\packaging\dependencies\tools\win-x64\ffmpeg\ffmpeg.exe">
      <Link>tools\win-x64\ffmpeg\ffmpeg.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)..\..\..\packaging\dependencies\tools\win-x64\ffmpeg\ffprobe.exe">
      <Link>tools\win-x64\ffmpeg\ffprobe.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\packaging\dependencies\tools\win-x64\python\python.exe')">
    <Content Include="$(MSBuildThisFileDirectory)..\..\..\packaging\dependencies\tools\win-x64\python\**\*">
      <Link>tools\win-x64\python\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <!-- PreserveNewest keeps leftover Frida 17 files when the cache is pinned back to 16.7.19. -->
  <Target Name="ResetStaleBundledFrida17" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_BundledPythonOut>$(OutputPath)tools\win-x64\python</_BundledPythonOut>
    </PropertyGroup>
    <ItemGroup>
      <_StaleFrida17 Include="$(_BundledPythonOut)\Lib\site-packages\frida-17.*" />
    </ItemGroup>
    <RemoveDir Directories="$(_BundledPythonOut)"
               Condition="'@(_StaleFrida17)' != '' or Exists('$(_BundledPythonOut)\Lib\site-packages\frida-17.17.0.dist-info')" />
  </Target>
</Project>
