<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:TikTokPublisher.Ui.Views"
        xmlns:kuaishou="using:PlatformPublisher.Desktop.Views"
        x:Class="TikTokPublisher.Desktop.Views.MainWindow"
        Width="1496" Height="860"
        MinWidth="800" MinHeight="560"
        Title="TikTok 短剧上传助手"
        Icon="/Assets/tiktok-shortdrama-logo.ico"
        Background="{StaticResource PythonPageBgBrush}">

    <Window.Styles>
        <Style Selector="Button.moduleNavItem">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="10,6,7,6" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#253C56" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Button.moduleNavItem PathIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Foreground" Value="#377BCC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.moduleNavItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E5EFFA" />
        </Style>
        <Style Selector="Button.moduleNavItem.moduleNavActive">
            <Setter Property="Background" Value="#CFE4FF" />
            <Setter Property="BorderBrush" Value="{StaticResource PythonPrimaryBrush}" />
            <Setter Property="Foreground" Value="#064A90" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.moduleNavItem.moduleNavActive:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C6DEFC" />
            <Setter Property="BorderBrush" Value="{StaticResource PythonPrimaryBrush}" />
            <Setter Property="Foreground" Value="#064A90" />
        </Style>
        <Style Selector="Button.moduleNavItem.moduleNavActive PathIcon">
            <Setter Property="Foreground" Value="#075FAF" />
        </Style>
        <Style Selector="Grid.moduleRailCollapsed TextBlock.moduleRailLabel">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid.moduleRailCollapsed Grid#ModuleHeader">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6" />
        </Style>
        <Style Selector="Grid.moduleRailCollapsed Button.moduleNavItem">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="5,6,8,6" />
        </Style>
    </Window.Styles>

    <Grid x:Name="WindowLayout" RowDefinitions="*,Auto" ColumnDefinitions="148,198,*">
        <Grid x:Name="ModuleRail" RowDefinitions="Auto,*,Auto" Background="#EEF4FC">
            <Grid x:Name="ModuleHeader" ColumnDefinitions="*,Auto" MinHeight="44" Margin="12,6,8,6">
                <TextBlock Text="TikTok 短剧助手" Classes="topBrandLabel moduleRailLabel"
                           Margin="0,0,5,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button x:Name="ModuleRailToggleButton" Grid.Column="1"
                        Width="28" Height="28" MinHeight="28" Padding="0" VerticalAlignment="Center"
                        ToolTip.Tip="收起全局导航" AutomationProperties.Name="收起全局导航"
                        Click="OnModuleRailToggleClick">
                    <PathIcon Width="16" Height="16" Data="F0 M2,4 H22 V20 H2 Z M4,6 V18 H8 V6 Z M10,6 V18 H20 V6 Z" />
                </Button>
            </Grid>
            <StackPanel Grid.Row="1" x:Name="ModuleNav" Margin="7,5,7,8" Spacing="4" VerticalAlignment="Top">
                <Button Tag="download" Classes="moduleNavItem" AutomationProperties.Name="短剧下载" ToolTip.Tip="短剧下载" Click="OnNavItemClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M12,1.5 A1.5,1.5 0 0 1 13.5,3 V11.4 L16.1,8.8 A1.5,1.5 0 0 1 18.2,10.9
                                        L13.1,16 A1.55,1.55 0 0 1 10.9,16 L5.8,10.9 A1.5,1.5 0 0 1 7.9,8.8 L10.5,11.4 V3
                                        A1.5,1.5 0 0 1 12,1.5 Z
                                        M2.5,14 A1.5,1.5 0 0 1 4,15.5 V18.5 Q4,19.5 5,19.5 H19 Q20,19.5 20,18.5 V15.5
                                        A1.5,1.5 0 0 1 23,15.5 V18.5 A4,4 0 0 1 19,22.5 H5 A4,4 0 0 1 1,18.5 V15.5
                                        A1.5,1.5 0 0 1 2.5,14 Z" />
                        <TextBlock Text="短剧下载" Classes="moduleRailLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Tag="material-clip" Classes="moduleNavItem" AutomationProperties.Name="素材剪辑" ToolTip.Tip="素材剪辑" Click="OnNavItemClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="F0 M2.4,5.5 L18.5,1.4 Q20.6,0.9 21.2,3 L21.7,5 L2,10 L1.5,8
                                        Q1,6.1 2.4,5.5 Z
                                        M2,11.8 H22 V18.7 A4,4 0 0 1 18,22.7 H6 A4,4 0 0 1 2,18.7 Z
                                        M10.3,14.2 Q9.5,13.7 9.5,14.7 V19.8 Q9.5,20.8 10.3,20.3 L15,17.8 Q16,17.25 15,16.7 Z" />
                        <TextBlock Text="素材剪辑" Classes="moduleRailLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Tag="queue" Classes="moduleNavItem" AutomationProperties.Name="TikTok 上传" ToolTip.Tip="TikTok 上传" Click="OnNavItemClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M17.8,4.81 C16.51,3.97 15.58,2.62 15.29,1.05 C15.22,0.71 15.19,0.36 15.19,0
                                        H11.06 V16.54 C10.99,18.39 9.46,19.87 7.59,19.87 C7.01,19.87 6.47,19.73 5.99,19.48
                                        C4.88,18.89 4.13,17.74 4.13,16.41 C4.13,14.49 5.68,12.94 7.59,12.94 C7.95,12.94 8.29,13 8.62,13.1
                                        V8.89 C8.28,8.84 7.94,8.81 7.59,8.81 C3.41,8.81 0,12.22 0,16.41 C0,18.97 1.28,21.25 3.24,22.62
                                        C4.48,23.49 5.98,24 7.59,24 C11.78,24 15.19,20.59 15.19,16.41 V8.02
                                        C16.81,9.18 18.79,9.87 20.93,9.87 V5.74 C19.78,5.74 18.7,5.4 17.8,4.81 Z" />
                        <TextBlock Text="TikTok 上传" Classes="moduleRailLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Tag="kuaishou" Classes="moduleNavItem" AutomationProperties.Name="快手上传" ToolTip.Tip="快手上传" Click="OnNavItemClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="F0 M12.65,2.9 C11.61,1.15 9.74,0 7.6,0 C4.5,0 2,2.5 2,5.6
                                        C2,8.7 4.5,11.2 7.6,11.2 C9.39,11.2 11.03,10.35 12.07,9.28
                                        C13,10.54 14.43,11.2 15.97,11.2 C18.65,11.2 20.84,9.04 20.84,6.37
                                        C20.84,3.7 18.65,1.55 15.97,1.55 C14.72,1.55 13.55,2.01 12.65,2.9 Z
                                        M4.25,5.6 A3.35,3.35 0 1 0 10.95,5.6 A3.35,3.35 0 1 0 4.25,5.6 Z
                                        M13.37,6.37 A2.6,2.6 0 1 0 18.57,6.37 A2.6,2.6 0 1 0 13.37,6.37 Z
                                        M6.6,15.2 L2.7,13.35 Q0,12.1 0,15.1 V21.25 Q0,24.1 2.7,22.95 L6.6,21.1
                                        C7.4,23 8.85,24 10.65,24 H16.7 C19,24 20.84,22.2 20.84,19.9 V16.45
                                        C20.84,14.2 19,12.35 16.7,12.35 H10.65 C8.85,12.35 7.4,13.35 6.6,15.2 Z
                                        M2.6,15.7 L6.35,17.45 V18.8 L2.6,20.6 Q2.1,20.85 2.1,20.3 V16 Q2.1,15.45 2.6,15.7 Z
                                        M10.65,14.55 H16.7 A1.94,1.94 0 0 1 18.64,16.49 V19.85 A1.94,1.94 0 0 1 16.7,21.79
                                        H10.65 A1.94,1.94 0 0 1 8.71,19.85 V16.49 A1.94,1.94 0 0 1 10.65,14.55 Z" />
                        <TextBlock Text="快手上传" Classes="moduleRailLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Tag="weixin" Classes="moduleNavItem" AutomationProperties.Name="微信视频号上传"
                        ToolTip.Tip="微信视频号上传" Click="OnNavItemClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="F0 M5,2 H19 A4,4 0 0 1 23,6 V14 A4,4 0 0 1 19,18 H10.8 L6.2,21.6
                                        Q4.5,22.9 4.5,20.8 V18 A4,4 0 0 1 1,14 V6 A4,4 0 0 1 5,2 Z
                                        M9.6,6 Q8.6,5.4 8.6,6.6 V13.4 Q8.6,14.6 9.6,14 L15.6,10.7 Q16.8,10 15.6,9.3 Z" />
                        <TextBlock Text="视频号上传" Classes="moduleRailLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Tag="analytics" Classes="moduleNavItem" AutomationProperties.Name="数据统计" ToolTip.Tip="数据统计" Click="OnNavItemClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M3.5,13 H4.5 Q6.5,13 6.5,15 V20 Q6.5,22 4.5,22 H3.5 Q1.5,22 1.5,20 V15 Q1.5,13 3.5,13 Z
                                        M11.5,8 H12.5 Q14.5,8 14.5,10 V20 Q14.5,22 12.5,22 H11.5 Q9.5,22 9.5,20 V10 Q9.5,8 11.5,8 Z
                                        M19.5,2 H20.5 Q22.5,2 22.5,4 V20 Q22.5,22 20.5,22 H19.5 Q17.5,22 17.5,20 V4 Q17.5,2 19.5,2 Z" />
                        <TextBlock Text="数据统计" Classes="moduleRailLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Tag="settings" Classes="moduleNavItem" AutomationProperties.Name="系统设置" ToolTip.Tip="系统设置" Click="OnNavItemClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M2.5,3.25 H5.2 A3,3 0 0 1 10.8,3.25 H21.5 A1.25,1.25 0 0 1 21.5,5.75
                                        H10.8 A3,3 0 0 1 5.2,5.75 H2.5 A1.25,1.25 0 0 1 2.5,3.25 Z
                                        M2.5,10.75 H13.2 A3,3 0 0 1 18.8,10.75 H21.5 A1.25,1.25 0 0 1 21.5,13.25
                                        H18.8 A3,3 0 0 1 13.2,13.25 H2.5 A1.25,1.25 0 0 1 2.5,10.75 Z
                                        M2.5,18.25 H5.2 A3,3 0 0 1 10.8,18.25 H21.5 A1.25,1.25 0 0 1 21.5,20.75
                                        H10.8 A3,3 0 0 1 5.2,20.75 H2.5 A1.25,1.25 0 0 1 2.5,18.25 Z" />
                        <TextBlock Text="系统设置" Classes="moduleRailLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Button x:Name="SidebarToggleButton" Grid.Row="2" Content="‹"
                    Width="30" Height="30" MinHeight="30" Padding="0" Margin="0,6,0,8"
                    FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                    ToolTip.Tip="收起账号栏" AutomationProperties.Name="收起账号栏" Click="OnSidebarToggleClick" />
        </Grid>

        <Panel x:Name="AccountPanelHost" Grid.Column="1" ClipToBounds="True">
            <views:AccountSidebarView x:Name="AccountSidebar" />
        </Panel>

        <Panel x:Name="ContentHostPanel" Grid.Column="2" Grid.IsSharedSizeScope="True" Background="{StaticResource PythonPageBgBrush}">
            <Panel x:Name="BrowserHostMount"
                   IsHitTestVisible="False"
                   ClipToBounds="True"
                   Width="1"
                   Height="1"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   ZIndex="5" />
            <views:DramaDownloadView x:Name="DownloadView" IsVisible="False" />
            <views:MaterialClipView x:Name="MaterialClipPage" IsVisible="False" />
            <Grid x:Name="TikTokWorkspace">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" SharedSizeGroup="UploadTabs" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TikTokSubNavigation" Orientation="Horizontal" Spacing="5" Margin="10,5,10,3">
                        <Button Content="任务队列" Tag="queue" Classes="topNavItem" Click="OnTikTokSubPageClick" />
                        <Button Content="发布配置" Tag="accounts" Classes="topNavItem" Click="OnTikTokSubPageClick" />
                        <Button x:Name="TikTokBasicSettingsButton" Content="基础设置" Tag="basics" Classes="topNavItem"
                                IsVisible="False" Click="OnTikTokSubPageClick" />
                        <Button Content="已归档项目" Tag="archived" Classes="topNavItem" Click="OnTikTokSubPageClick" />
                        <Button Content="运行日志" Tag="logs" Classes="topNavItem" Click="OnTikTokSubPageClick" />
                        <Button Content="浏览器" Tag="browser" Classes="topNavItem" Click="OnTikTokSubPageClick" />
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto">
                    <CheckBox x:Name="TikTokAllLogAccounts" Content="全部账号" Margin="12,4" IsVisible="False"
                              IsCheckedChanged="OnTikTokLogScopeChanged" />
                    <CheckBox x:Name="TikTokAllArchiveAccounts" Content="全部账号" Margin="16,4" IsVisible="False"
                              HorizontalAlignment="Right" IsCheckedChanged="OnTikTokArchiveScopeChanged" />
                    <Panel Grid.Row="1">
                        <views:TikTokQueueView x:Name="QueueView" />
                        <views:AccountProfilesView x:Name="AccountsView" IsVisible="False" />
                        <views:LogView x:Name="LogView" IsVisible="False" />
                        <views:ArchivedProjectsView x:Name="ArchivedView" IsVisible="False" />
                        <views:TikTokBrowserView x:Name="BrowserView" IsVisible="False" />
                    </Panel>
                    <Grid x:Name="TikTokQueueFooter" Grid.Row="2" Classes="uploadQueueFooter">
                        <TextBlock Text="{Binding QueueSummaryText}" Classes="pageSummary" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>
            </Grid>
            <kuaishou:KuaishouUploadWorkspace x:Name="KuaishouWorkspace" IsVisible="False" />
            <kuaishou:WeixinUploadWorkspace x:Name="WeixinWorkspace" IsVisible="False" />
            <views:SystemSettingsView x:Name="SettingsView" IsVisible="False" />
            <Grid x:Name="HistoryWorkspace" RowDefinitions="Auto,Auto,*" IsVisible="False">
                <TabStrip x:Name="AnalyticsPlatformTabs" Margin="10,5,10,3"
                          AutomationProperties.Name="统计平台" SelectionChanged="OnAnalyticsPlatformChanged">
                    <TabStrip.Styles>
                        <Style Selector="TabStripItem">
                            <Setter Property="Padding" Value="18,8" />
                            <Setter Property="FontSize" Value="16" />
                        </Style>
                        <Style Selector="TabStripItem:selected">
                            <Setter Property="Foreground" Value="{StaticResource PythonPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </TabStrip.Styles>
                    <TabStripItem x:Name="TikTokAnalyticsTab" Content="TikTok" />
                    <TabStripItem x:Name="KuaishouAnalyticsTab" Content="快手" />
                </TabStrip>
                <Border Grid.Row="1" Background="#172C46" CornerRadius="8" Margin="16,4,16,0" Padding="14,9">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <TextBlock Text="运行状态" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="#E2E8F0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusMessage}" />
                        <WrapPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="{Binding SystemServices.XingeRemoteStatus, StringFormat='XINGE {0}'}" Foreground="#E2E8F0" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding #CpuUsageText.Text}" Foreground="#E2E8F0" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding #GpuUsageText.Text}" Foreground="#E2E8F0" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding #MemUsageText.Text}" Foreground="#E2E8F0" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding TodayUploadCount, StringFormat='今日上传完成 {0}'}" Foreground="White" />
                        </WrapPanel>
                    </Grid>
                </Border>
                <Panel Grid.Row="2">
                    <views:TikTokAccountAnalyticsView x:Name="AnalyticsView" IsVisible="False" />
                    <kuaishou:AnalyticsView x:Name="KuaishouAnalyticsView" IsVisible="False" />
                    <TextBlock x:Name="HistoryUnavailable" Text="请先打开快手上传工作区。" Margin="16" Classes="pageSummary" IsVisible="False" />
                </Panel>
            </Grid>
        </Panel>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Classes="statusBarFrame" Height="28">
            <Grid ColumnDefinitions="*,*,*,Auto,Auto" Margin="12,0">
                <TextBlock x:Name="PrimaryStatusText" Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="{Binding StatusMessage}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="WeixinStatusText" Grid.Column="0"
                           IsVisible="False" VerticalAlignment="Center" FontSize="12"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Margin="12,0,0,0"
                           Text="{Binding OtherRunningStatusMessage}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Margin="12,0,0,0"
                           Text="{Binding AccountConfigSyncStatus}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel x:Name="ResourceUsagePanel" Grid.Column="3" Orientation="Horizontal" Spacing="14"
                            VerticalAlignment="Center" Margin="16,0">
                    <TextBlock x:Name="CpuUsageText" Text="CPU  --" Classes="pageSummary" ToolTip.Tip="整机占用，去重编码也算在里面。" />
                    <TextBlock x:Name="GpuUsageText" Text="GPU  --" Classes="pageSummary" ToolTip.Tip="整机占用，去重编码也算在里面。" />
                    <TextBlock x:Name="MemUsageText" Text="MEM  --" Classes="pageSummary" ToolTip.Tip="整机占用，去重编码也算在里面。" />
                </StackPanel>
                <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="12" Classes="pageSummary"
                           Text="{Binding TodayUploadCount, StringFormat='今日上传完成: {0}'}" />
            </Grid>
        </Border>
    </Grid>
</Window>
