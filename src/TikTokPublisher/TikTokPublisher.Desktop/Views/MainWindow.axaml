<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:TikTokPublisher.Ui.Views"
        xmlns:kuaishou="using:PlatformPublisher.Desktop.Views"
        x:Class="TikTokPublisher.Desktop.Views.MainWindow"
        Width="1496" Height="860"
        MinWidth="800" MinHeight="560"
        Title="TikTok 短剧上传助手"
        Icon="/Assets/tiktok-shortdrama-logo.ico"
        Background="{StaticResource PythonPageBgBrush}">

    <Window.Styles>
        <Style Selector="Button.moduleNavItem">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.moduleNavItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F0F7FF" />
        </Style>
        <Style Selector="Button.moduleNavItem.moduleNavActive">
            <Setter Property="Background" Value="#EAF4FF" />
            <Setter Property="Foreground" Value="{StaticResource PythonPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <Grid x:Name="WindowLayout" RowDefinitions="*,Auto" ColumnDefinitions="198,*">
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Background="{StaticResource PythonPanelBgBrush}">
            <Grid ColumnDefinitions="*,Auto" Margin="12,8,8,8">
                <TextBlock x:Name="BrandLabel" Text="TikTok 短剧助手" Classes="topBrandLabel"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button x:Name="SidebarToggleButton" Grid.Column="1" Content="‹"
                        Width="28" Height="28" MinHeight="28" Padding="0" Margin="5,0,0,0"
                        FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                        ToolTip.Tip="收起账号栏" AutomationProperties.Name="收起账号栏" Click="OnSidebarToggleClick" />
            </Grid>
            <StackPanel Grid.Row="1" x:Name="ModuleNav" Margin="8,0,8,8" Spacing="2">
                <Button Content="浏览器" Tag="browser" Classes="moduleNavItem" Click="OnNavItemClick" />
                <Button Content="短剧下载" Tag="download" Classes="moduleNavItem" Click="OnNavItemClick" />
                <Button Content="TikTok 上传" Tag="queue" Classes="moduleNavItem" Click="OnNavItemClick" />
                <Button Content="快手上传" Tag="kuaishou" Classes="moduleNavItem" Click="OnNavItemClick" />
                <Button Content="数据统计" Tag="analytics" Classes="moduleNavItem" Click="OnNavItemClick" />
                <Button Content="系统设置" Tag="settings" Classes="moduleNavItem" Click="OnNavItemClick" />
            </StackPanel>
            <Panel x:Name="AccountPanelHost" Grid.Row="2" ClipToBounds="True">
                <views:AccountSidebarView x:Name="AccountSidebar" />
            </Panel>
        </Grid>

        <Panel x:Name="ContentHostPanel" Grid.Column="1" Background="{StaticResource PythonPageBgBrush}">
            <Panel x:Name="BrowserHostMount"
                   IsHitTestVisible="False"
                   ClipToBounds="True"
                   Width="1"
                   Height="1"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   ZIndex="5" />
            <views:TikTokBrowserView x:Name="BrowserView" IsVisible="False" ZIndex="10" />
            <views:DramaDownloadView x:Name="DownloadView" IsVisible="False" />
            <Grid x:Name="TikTokWorkspace" RowDefinitions="Auto,*">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TikTokSubNavigation" Orientation="Horizontal" Spacing="5" Margin="10,5,10,3">
                        <Button Content="任务队列" Tag="queue" Classes="topNavItem" Click="OnTikTokSubPageClick" />
                        <Button Content="发布配置" Tag="accounts" Classes="topNavItem" Click="OnTikTokSubPageClick" />
                        <Button Content="上传材料" Tag="materials" Classes="topNavItem" Click="OnTikTokSubPageClick" />
                        <Button x:Name="TikTokBasicSettingsButton" Content="基础设置" Tag="basics" Classes="topNavItem"
                                IsVisible="False" Click="OnTikTokSubPageClick" />
                        <Button Content="视频去重" Tag="dedup" Classes="topNavItem" Click="OnTikTokSubPageClick" />
                        <Button Content="剧集列表" Tag="series" Classes="topNavItem" Click="OnTikTokSubPageClick" />
                        <Button Content="运行日志" Tag="logs" Classes="topNavItem" Click="OnTikTokSubPageClick" />
                        <Button Content="已归档项目" Tag="archived" Classes="topNavItem" Click="OnTikTokSubPageClick" />
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="1" RowDefinitions="Auto,*">
                    <CheckBox x:Name="TikTokAllHistoryAccounts" Content="全部账号" Margin="12,4" IsVisible="False"
                              IsCheckedChanged="OnTikTokHistoryScopeChanged" />
                    <Panel Grid.Row="1">
                        <views:TikTokQueueView x:Name="QueueView" />
                        <views:AccountProfilesView x:Name="AccountsView" IsVisible="False" />
                        <views:LogView x:Name="LogView" IsVisible="False" />
                        <views:ArchivedProjectsView x:Name="ArchivedView" IsVisible="False" />
                    </Panel>
                </Grid>
            </Grid>
            <kuaishou:KuaishouUploadWorkspace x:Name="KuaishouWorkspace" IsVisible="False" />
            <views:SystemSettingsView x:Name="SettingsView" IsVisible="False" />
            <Grid x:Name="HistoryWorkspace" RowDefinitions="Auto,*" IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,10,16,4">
                    <TextBlock Text="平台" VerticalAlignment="Center" />
                    <ComboBox x:Name="AnalyticsPlatformPicker" MinWidth="120"
                              AutomationProperties.Name="统计平台" SelectionChanged="OnAnalyticsPlatformChanged">
                        <ComboBoxItem x:Name="TikTokAnalyticsOption" Content="TikTok" />
                        <ComboBoxItem x:Name="KuaishouAnalyticsOption" Content="快手" />
                    </ComboBox>
                </StackPanel>
                <Panel Grid.Row="1">
                    <views:TikTokAccountAnalyticsView x:Name="AnalyticsView" IsVisible="False" />
                    <kuaishou:AnalyticsView x:Name="KuaishouAnalyticsView" IsVisible="False" />
                    <TextBlock x:Name="HistoryUnavailable" Text="请先打开快手上传工作区。" Margin="16" Classes="pageSummary" IsVisible="False" />
                </Panel>
            </Grid>
        </Panel>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="statusBarFrame" Height="28">
            <Grid ColumnDefinitions="*,*,*,Auto,Auto" Margin="12,0">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="{Binding StatusMessage}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Margin="12,0,0,0"
                           Text="{Binding OtherRunningStatusMessage}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Margin="12,0,0,0"
                           Text="{Binding AccountConfigSyncStatus}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel x:Name="ResourceUsagePanel" Grid.Column="3" Orientation="Horizontal" Spacing="14"
                            VerticalAlignment="Center" Margin="16,0">
                    <TextBlock x:Name="CpuUsageText" Text="CPU  --" Classes="pageSummary" ToolTip.Tip="整机占用，去重编码也算在里面。" />
                    <TextBlock x:Name="GpuUsageText" Text="GPU  --" Classes="pageSummary" ToolTip.Tip="整机占用，去重编码也算在里面。" />
                    <TextBlock x:Name="MemUsageText" Text="MEM  --" Classes="pageSummary" ToolTip.Tip="整机占用，去重编码也算在里面。" />
                </StackPanel>
                <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="12" Classes="pageSummary"
                           Text="{Binding TodayUploadCount, StringFormat='今日上传完成: {0}'}" />
            </Grid>
        </Border>
    </Grid>
</Window>
