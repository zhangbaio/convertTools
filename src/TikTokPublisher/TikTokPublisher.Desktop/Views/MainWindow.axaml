<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:TikTokPublisher.Ui.Views"
        xmlns:kuaishou="using:PlatformPublisher.Desktop.Views"
        x:Class="TikTokPublisher.Desktop.Views.MainWindow"
        Width="1496" Height="860"
        MinWidth="800" MinHeight="560"
        Title="TikTok 短剧上传助手"
        Icon="/Assets/tiktok-shortdrama-logo.ico"
        Background="{StaticResource PythonPageBgBrush}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 顶部：品牌 + 水平一级 TAB -->
        <Border Grid.Row="0" Classes="topNavFrame">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="BrandPane" Grid.Column="0" Padding="12,0,10,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="BrandLabel" Grid.Column="0" Text="TikTok 短剧助手" Classes="topBrandLabel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="SidebarToggleButton"
                                Grid.Column="1"
                                Content="‹"
                                Width="30"
                                Height="30"
                                MinHeight="30"
                                Padding="0"
                                Margin="8,0,0,0"
                                FontSize="16"
                                FontWeight="Bold"
                                VerticalAlignment="Center"
                                ToolTip.Tip="收起左侧面板"
                                Click="OnSidebarToggleClick" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              AllowAutoHide="True">
                    <StackPanel x:Name="ModuleNav" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="8,0,8,0">
                        <Button Content="浏览器" Tag="browser" Classes="topNavItem" Click="OnNavItemClick" />
                        <Button Content="短剧下载" Tag="download" Classes="topNavItem" Click="OnNavItemClick" />
                        <Button Content="TikTok 上传" Tag="queue" Classes="topNavItem" Click="OnNavItemClick" />
                        <Button Content="快手上传" Tag="kuaishou" Classes="topNavItem" Click="OnNavItemClick" />
                        <Button Content="系统设置" Tag="settings" Classes="topNavItem" Click="OnNavItemClick" />
                        <Button Content="数据统计" Tag="analytics" Classes="topNavItem" Click="OnNavItemClick" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Panel x:Name="ContentHostPanel" Grid.Row="1" Background="{StaticResource PythonPageBgBrush}">
            <Panel x:Name="BrowserHostMount"
                   IsHitTestVisible="False"
                   ClipToBounds="True"
                   Width="1"
                   Height="1"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   ZIndex="5" />
            <Grid x:Name="BrowserWorkspace" ColumnDefinitions="198,*" IsVisible="False" ZIndex="10">
                <views:AccountSidebarView x:Name="BrowserAccountSidebar" />
                <views:TikTokBrowserView x:Name="BrowserView" Grid.Column="1" />
            </Grid>
            <views:DramaDownloadView x:Name="DownloadView" IsVisible="False" />
            <Grid x:Name="TikTokWorkspace" RowDefinitions="Auto,*" ColumnDefinitions="198,*">
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TikTokSubNavigation" Orientation="Horizontal" Spacing="5" Margin="10,5,10,3">
                        <Button Content="任务队列" Tag="queue" Classes="topNavItem" Click="OnTikTokSubPageClick" />
                        <Button Content="发布配置" Tag="accounts" Classes="topNavItem" Click="OnTikTokSubPageClick" />
                        <Button Content="上传材料" Tag="materials" Classes="topNavItem" Click="OnTikTokSubPageClick" />
                        <Button x:Name="TikTokBasicSettingsButton" Content="基础设置" Tag="basics" Classes="topNavItem"
                                IsVisible="False" Click="OnTikTokSubPageClick" />
                        <Button Content="视频去重" Tag="dedup" Classes="topNavItem" Click="OnTikTokSubPageClick" />
                        <Button Content="剧集列表" Tag="series" Classes="topNavItem" Click="OnTikTokSubPageClick" />
                        <Button Content="运行日志" Tag="logs" Classes="topNavItem" Click="OnTikTokSubPageClick" />
                        <Button Content="已归档项目" Tag="archived" Classes="topNavItem" Click="OnTikTokSubPageClick" />
                    </StackPanel>
                </ScrollViewer>
                <views:AccountSidebarView x:Name="AccountSidebar" Grid.RowSpan="2" />
                <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*">
                    <CheckBox x:Name="TikTokAllHistoryAccounts" Content="全部账号" Margin="12,4" IsVisible="False"
                              IsCheckedChanged="OnTikTokHistoryScopeChanged" />
                    <Panel Grid.Row="1">
                        <views:TikTokQueueView x:Name="QueueView" />
                        <views:AccountProfilesView x:Name="AccountsView" IsVisible="False" />
                        <views:LogView x:Name="LogView" IsVisible="False" />
                        <views:ArchivedProjectsView x:Name="ArchivedView" IsVisible="False" />
                    </Panel>
                </Grid>
            </Grid>
            <kuaishou:KuaishouUploadWorkspace x:Name="KuaishouWorkspace" IsVisible="False" />
            <views:SystemSettingsView x:Name="SettingsView" IsVisible="False" />
            <Grid x:Name="HistoryWorkspace" RowDefinitions="Auto,*" IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="5" Margin="10,5,10,3">
                    <Button x:Name="TikTokHistoryButton" Content="TikTok" Tag="tiktok" Classes="topNavItem" Click="OnHistoryPlatformClick" />
                    <Button x:Name="KuaishouHistoryButton" Content="快手" Tag="kuaishou" Classes="topNavItem" Click="OnHistoryPlatformClick" />
                </StackPanel>
                <Panel Grid.Row="1">
                    <views:TikTokAccountAnalyticsView x:Name="AnalyticsView" IsVisible="False" />
                    <kuaishou:AnalyticsView x:Name="KuaishouAnalyticsView" IsVisible="False" />
                    <TextBlock x:Name="HistoryUnavailable" Text="请先打开快手上传工作区。" Margin="16" Classes="pageSummary" IsVisible="False" />
                </Panel>
            </Grid>
        </Panel>

        <Border Grid.Row="2" Classes="statusBarFrame" Height="28">
            <Grid ColumnDefinitions="*,*,*,Auto,Auto" Margin="12,0">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="{Binding StatusMessage}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Margin="12,0,0,0"
                           Text="{Binding OtherRunningStatusMessage}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Margin="12,0,0,0"
                           Text="{Binding AccountConfigSyncStatus}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel x:Name="ResourceUsagePanel" Grid.Column="3" Orientation="Horizontal" Spacing="14"
                            VerticalAlignment="Center" Margin="16,0">
                    <TextBlock x:Name="CpuUsageText" Text="CPU  --" Classes="pageSummary" ToolTip.Tip="整机占用，去重编码也算在里面。" />
                    <TextBlock x:Name="GpuUsageText" Text="GPU  --" Classes="pageSummary" ToolTip.Tip="整机占用，去重编码也算在里面。" />
                    <TextBlock x:Name="MemUsageText" Text="MEM  --" Classes="pageSummary" ToolTip.Tip="整机占用，去重编码也算在里面。" />
                </StackPanel>
                <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="12" Classes="pageSummary"
                           Text="{Binding TodayUploadCount, StringFormat='今日上传完成: {0}'}" />
            </Grid>
        </Border>
    </Grid>
</Window>
