<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChannelsPublisher.Desktop.ViewModels"
             xmlns:views="using:ChannelsPublisher.Desktop.Views"
             x:Class="ChannelsPublisher.Desktop.Views.MaterialPublishView"
             x:DataType="vm:MainViewModel"
             Background="#F3F6FA">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PythonPanelBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PythonPanelBorderBrush" Color="#D9E2EC" />
        <SolidColorBrush x:Key="PythonMutedBrush" Color="#64748B" />
        <SolidColorBrush x:Key="PythonStatusBarBrush" Color="#EEF3F8" />
    </UserControl.Resources>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid x:Name="RootLayout"
          RowDefinitions="Auto,*,190,150,30"
          ColumnSpacing="12"
          Margin="12,10,12,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="198" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧整列统一为账号区域。 -->
        <views:AccountSidebarView x:Name="AccountSidebar"
                                  Grid.Column="0"
                                  Grid.RowSpan="5"
                                  AccountSettingsRequested="OnAccountSettingsRequested" />

        <TabControl x:Name="WorkspaceTabs" Grid.Column="1" Grid.RowSpan="5" Classes="secondaryTabs" SelectedIndex="0">
        <TabItem Header="一键发布">
        <Grid>
        <ContentControl x:Name="UnifiedPublishContentHost" />
        <Grid RowDefinitions="Auto,*,190,150,30" IsVisible="False">

        <!-- 所有发布与配置按钮统一置于右侧顶部。 -->
        <Border Grid.Row="0"
                Background="{StaticResource PythonPanelBgBrush}"
                BorderBrush="{StaticResource PythonPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,8"
                Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="发布控制" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Content="添加素材" Click="OnAddMaterialsClick" Classes="secondaryAction" Margin="0,0,8,6"
                        ToolTip.Tip="选视频，分配给当前选中账号" />
                <Button Content="导入任务(JSON)" Click="OnImportTasksClick" Classes="secondaryAction" Margin="0,0,8,6"
                        ToolTip.Tip="导入 prep 产出的发布任务清单" />
                <TextBlock Text="结束动作" VerticalAlignment="Center" Margin="4,0,6,6" />
                <ComboBox ItemsSource="{Binding FinalActionChoices}"
                          SelectedItem="{Binding SelectedFinalAction}"
                          MinWidth="150" Margin="0,0,8,6">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FinalActionChoice">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="并发账号" VerticalAlignment="Center" Margin="0,0,6,6" />
                <NumericUpDown Value="{Binding MaxParallel}" Minimum="1" Maximum="8" Increment="1"
                               Width="104" Margin="0,0,8,6" />
                <Button x:Name="StartPublishButton" Content="开始发布" Click="OnStartPublishClick"
                        Classes="primaryAction" Margin="0,0,8,6" />
                <Button x:Name="StopPublishButton" Content="停止" Click="OnStopPublishClick" IsEnabled="False"
                        Margin="0,0,8,6"
                        ToolTip.Tip="停止发布：当前素材发完即停，已完成的保留，可再次开始续传" />
                <Button Content="清空已完成" Click="OnClearDoneClick" Classes="secondaryAction" Margin="0,0,8,6" />
                <Button Content="清除续传记录" Click="OnClearResumeClick" Classes="secondaryAction" Margin="0,0,8,6"
                        ToolTip.Tip="清空断点续传的已发布记录" />
                <Button Content="发表配置" Click="OnPublishConfigClick" Classes="secondaryAction" Margin="0,0,8,6" />
                <Button Content="全局剪辑配置" Click="OnClipConfigClick" Classes="secondaryAction" Margin="0,0,0,6" />
            </WrapPanel>
        </Border>

        <!-- 当前账号内嵌浏览器。 -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource PythonPanelBorderBrush}"
                BorderThickness="1"
                Background="#FFFFFF"
                CornerRadius="8"
                ClipToBounds="True"
                Margin="0,0,0,10">
            <Panel x:Name="BrowserArea">
                <TextBlock x:Name="EmptyHint"
                           Text="点击左侧「添加账号」，选中后在此加载该账号的视频号会话（扫码登录后长期保持在线）"
                           IsVisible="True"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="480"
                           TextAlignment="Center"
                           Foreground="{StaticResource PythonMutedBrush}"
                           FontSize="14" />
            </Panel>
        </Border>

        <!-- 发布任务只占右侧，不再穿过账号栏。 -->
        <Border Grid.Row="2"
                Background="{StaticResource PythonPanelBgBrush}"
                BorderBrush="{StaticResource PythonPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True"
                Margin="0,0,0,10">
            <Grid RowDefinitions="Auto,Auto,*">
                <TextBlock Text="发布任务" FontWeight="SemiBold" Margin="10,8,10,6" />
                <Border Grid.Row="1" Background="#EDF3F9"
                        BorderBrush="{StaticResource PythonPanelBorderBrush}"
                        BorderThickness="0,1,0,1"
                        Padding="10,6">
                    <Grid ColumnDefinitions="140,*,150,90,*">
                        <TextBlock Text="账号" Foreground="{StaticResource PythonMutedBrush}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="视频" Foreground="{StaticResource PythonMutedBrush}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="剧集" Foreground="{StaticResource PythonMutedBrush}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="状态" Foreground="{StaticResource PythonMutedBrush}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="信息" Foreground="{StaticResource PythonMutedBrush}" FontSize="12" FontWeight="SemiBold" />
                    </Grid>
                </Border>
                <ListBox Grid.Row="2" ItemsSource="{Binding Tasks}"
                         Background="{StaticResource PythonPanelBgBrush}"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PublishTaskItemViewModel">
                            <Grid ColumnDefinitions="140,*,150,90,*" Margin="10,5">
                                <TextBlock Text="{Binding AccountName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding VideoName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding DramaName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{Binding StatusText}" />
                                <TextBlock Grid.Column="4" Text="{Binding Message}" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource PythonMutedBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 新增运行日志面板。 -->
        <Border Grid.Row="3"
                Background="{StaticResource PythonPanelBgBrush}"
                BorderBrush="{StaticResource PythonPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True"
                Margin="0,0,0,8">
            <Grid RowDefinitions="Auto,*">
                <Border Background="#EDF3F9" Padding="10,6"
                        BorderBrush="{StaticResource PythonPanelBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="运行日志" FontWeight="SemiBold" />
                        <Button Grid.Column="1" Content="清空日志"
                                Command="{Binding ClearLogsCommand}"
                                Classes="secondaryAction"
                                Padding="8,3" MinHeight="26" />
                    </Grid>
                </Border>
                <ListBox Grid.Row="1" ItemsSource="{Binding Logs}"
                         Background="#FBFCFE" BorderThickness="0"
                         FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                         FontSize="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="8,3"
                                       Foreground="#334155" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Background="{StaticResource PythonStatusBarBrush}"
                BorderBrush="{StaticResource PythonPanelBorderBrush}"
                BorderThickness="1,0,1,1">
            <TextBlock Margin="10,0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource PythonMutedBrush}"
                       Text="{Binding StatusMessage}" />
        </Border>

        </Grid>
        </Grid>
        </TabItem>

        <TabItem Header="账号配置">
            <Grid RowDefinitions="Auto,*" Margin="0,4,0,0">
                <Border Classes="panel" Padding="14" Margin="0,0,0,10">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8" ColumnSpacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding CurrentAccountTitle}" FontSize="16" FontWeight="Bold" Foreground="#0B74D1" />
                            <TextBlock Text="（当前账号）" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="保存账号配置" Command="{Binding SaveAccountConfigCommand}" Classes="primaryAction" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="登录状态" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="●" Foreground="#047857" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentLoginStatusText}" VerticalAlignment="Center" />
                            <TextBlock Text="最近登录" Foreground="#64748B" VerticalAlignment="Center" Margin="14,0,0,0" />
                            <TextBlock Text="{Binding CurrentLastLoginText}" Foreground="#64748B" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="登录账号" Command="{Binding LoginCommand}" Classes="secondaryAction compactAction" />
                            <Button Content="重新登录账号" Command="{Binding LoginCommand}" Classes="secondaryAction compactAction" />
                            <Border Background="#EEF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                <TextBlock Text="{Binding CurrentRuntimeStatusText}" Foreground="#0B74D1" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Classes="panel" Padding="12">
                    <TabControl>
                        <TabItem Header="基础信息">
                            <Grid Margin="12" ColumnDefinitions="150,560,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                                <TextBlock Text="账号名称" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBox Grid.Column="1" Text="{Binding SelectedAccount.Name}" Watermark="用于左侧列表和任务归属展示" />
                                <TextBlock Grid.Row="1" Text="视频号昵称" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAccount.Nickname}" Watermark="可选；填写平台显示昵称" />
                                <TextBlock Grid.Row="2" Text="稳定账号 ID" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedAccount.Id}" IsReadOnly="True" />
                                <TextBlock Grid.Row="3" Text="独立会话目录" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedAccount.ProfileDir}" IsReadOnly="True" />
                                <TextBlock Grid.Row="4" Text="最近登录" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedAccount.LastLoginText}" VerticalAlignment="Center" Foreground="#64748B" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="成本报表">
                            <Grid Margin="12" ColumnDefinitions="150,560,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                                <TextBlock Text="制作公司" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBox Grid.Column="1" Text="{Binding SelectedAccount.CostReportCompanyName}" Watermark="成本报表公司名称" />
                                <TextBlock Grid.Row="1" Text="报表模板" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedAccount.CostReportTemplatePath}" Watermark="成本报表模板 DOCX 路径" />
                                <TextBlock Grid.Row="2" Text="签名图片" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedAccount.CostReportSignPath}" Watermark="签名图片路径" />
                                <TextBlock Grid.Row="3" Text="印章图片" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedAccount.CostReportSealPath}" Watermark="印章图片路径" />
                                <TextBlock Grid.Row="4" Text="法定代表人" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedAccount.CostReportLegalRepresentative}" />
                                <TextBlock Grid.Row="5" Text="演员薪酬占比" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedAccount.CostReportActorPayRatio}" Watermark="例如：30%" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="快手账号">
                            <Grid Margin="12" ColumnDefinitions="150,560,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                                <TextBlock Text="快手分账个人" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBox Grid.Column="1" Text="{Binding SelectedAccount.KuaishouPersonalAccount}" Watermark="快手个人版账号或备注" />
                                <TextBlock Grid.Row="1" Text="个人版配置" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedAccount.KuaishouPersonalConfigPath}" Watermark="快手个人版配置 JSON 路径" />
                                <TextBlock Grid.Row="2" Text="快手分账企业" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedAccount.KuaishouEnterpriseAccount}" Watermark="快手企业版账号或备注" />
                                <TextBlock Grid.Row="3" Text="企业版配置" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedAccount.KuaishouEnterpriseConfigPath}" Watermark="快手企业版配置 JSON 路径" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="工作目录">
                            <Grid Margin="12" ColumnDefinitions="150,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                                <TextBlock Text="工作根目录" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBox Grid.Column="1" Text="{Binding SelectedAccount.WorkRootDirectory}" Watermark="该账号默认项目工作根目录" />
                                <TextBlock Grid.Row="1" Text="下载目录" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAccount.DownloadDirectory}" Watermark="该账号默认短剧下载目录" />
                                <TextBlock Grid.Row="2" Text="归档目录" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedAccount.ArchiveRootDirectory}" Watermark="上传完成后的默认归档根目录" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="剧集上架">
            <ContentControl x:Name="SeriesPublishContentHost">
                <TextBlock Text="当前宿主尚未绑定视频号剧集上架服务。"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#64748B" />
            </ContentControl>
        </TabItem>

        <TabItem Header="项目流水线">
            <ContentControl x:Name="WorkflowContentHost">
                <TextBlock Text="当前宿主尚未绑定视频号项目流水线。"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#64748B" />
            </ContentControl>
        </TabItem>

        <TabItem Header="素材上传">
            <ContentControl x:Name="MaterialWorkflowContentHost">
                <TextBlock Text="当前宿主尚未绑定视频号素材上传工作台。"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#64748B" />
            </ContentControl>
        </TabItem>

        <TabItem Header="运行日志">
            <ContentControl x:Name="RuntimeLogContentHost">
                <TextBlock Text="当前宿主尚未绑定统一运行日志面板。"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#64748B" />
            </ContentControl>
        </TabItem>

        <TabItem Header="短剧下载">
            <ContentControl x:Name="DramaDownloadContentHost">
                <TextBlock Text="当前宿主尚未绑定短剧搜索与下载。"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#64748B" />
            </ContentControl>
        </TabItem>

        <TabItem Header="已归档项目">
            <ContentControl x:Name="ArchivedProjectsContentHost">
                <TextBlock Text="当前宿主尚未绑定视频号归档项目。"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#64748B" />
            </ContentControl>
        </TabItem>
        </TabControl>
    </Grid>
</UserControl>
