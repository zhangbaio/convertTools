<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChannelsPublisher.Desktop.ViewModels"
             x:Class="ChannelsPublisher.Desktop.Views.AccountSidebarView"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="Border.standaloneAccountFrame">
            <Setter Property="Background" Value="#FBFCFE" />
            <Setter Property="BorderBrush" Value="#D9E2EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.standaloneAccountFrame TextBlock.pageSummary">
            <Setter Property="Foreground" Value="#64748B" />
        </Style>
        <Style Selector="ListBox.standaloneAccountList ListBoxItem">
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ListBox.standaloneAccountList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#DDEEFF" />
        </Style>
    </UserControl.Styles>

    <Border x:Name="SidebarFrame" Classes="accountSidebarFrame standaloneAccountFrame" Padding="8,10" ClipToBounds="True">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="7" Margin="0,0,0,10">
                <TextBlock Text="账号" Classes="pageSummary" />
                <WrapPanel Orientation="Horizontal">
                    <Button x:Name="AddAccountButton" Content="添加账号" Command="{Binding AddAccountCommand}"
                            Classes="sidebarPrimaryAction" Margin="0,0,4,0" />
                    <Button x:Name="AccountSettingsButton" Content="账号设置" Click="OnAccountSettingsClick"
                            Classes="secondaryAction" />
                    <Button x:Name="RemoveAccountButton" Content="删除" Command="{Binding RemoveAccountCommand}"
                            Classes="dangerAction" Margin="4,0,0,0" />
                </WrapPanel>
                <TextBox x:Name="AccountSearchBox" Watermark="昵称/ID" Text="{Binding AccountSearchText, Mode=TwoWay}" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom" Classes="pageSummary" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="{Binding SelectedAccount.Name, TargetNullValue='未选择账号', StringFormat='当前：{0}'}" />

            <ListBox x:Name="AccountList" Classes="uploadAccountList standaloneAccountList"
                     ItemsSource="{Binding FilteredAccounts}"
                     SelectedItem="{Binding SidebarSelectedAccount, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountItemViewModel">
                        <StackPanel Spacing="2">
                            <ToolTip.Tip>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding SidebarSubtitle}" />
                                    <TextBlock Text="{Binding PlatformSummary}" />
                                </StackPanel>
                            </ToolTip.Tip>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SidebarSubtitle}" FontSize="12" Classes="pageSummary"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
