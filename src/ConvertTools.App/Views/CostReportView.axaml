<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ConvertTools.App.Views.CostReportView">
    <StackPanel Margin="20" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Text="成本报告" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="按项目生成剧目资质/成本报告文档（公司名/公章/签名/AI 改写）。" Foreground="#666" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="460" Watermark="选择项目目录" IsReadOnly="True" />
            <Button Content="选择目录" />
            <Button Content="生成报告" Background="#E67E22" Foreground="White" />
        </StackPanel>
        <TextBlock Text="（脚手架：UI 已就位，后端沿用 shortdrama CostReportBuilder，接入后可运行）"
                   Foreground="#AAA" FontSize="12" />
    </StackPanel>
</UserControl>
