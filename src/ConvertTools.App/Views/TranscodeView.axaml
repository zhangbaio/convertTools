<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ConvertTools.App.Views.TranscodeView">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Spacing="10">
            <TextBlock Text="批量转码 → H.264 / AAC（视频号友好格式）" FontSize="16" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="FolderBox" Width="560" Watermark="选择包含视频的文件夹" IsReadOnly="True" />
                <Button Content="选择文件夹" Click="OnPickFolder" />
                <Button x:Name="StartBtn" Content="开始转码" Click="OnStart" Background="#E67E22" Foreground="White" />
            </StackPanel>
            <TextBlock Text="输出到 所选文件夹/_transcoded/。ffmpeg 路径在「设置」里配置（默认用 PATH 中的 ffmpeg）。"
                       Foreground="#999" FontSize="12" />
            <TextBlock x:Name="Status" Text="就绪" Foreground="#666" />
        </StackPanel>
        <Border Margin="0,10,0,0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3">
            <ListBox x:Name="LogList" Background="Transparent" />
        </Border>
    </DockPanel>
</UserControl>
