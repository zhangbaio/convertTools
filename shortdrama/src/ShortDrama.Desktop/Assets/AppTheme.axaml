<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <SolidColorBrush x:Key="DesktopBackgroundBrush">#F3F6FA</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopPanelBrush">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopPanelAltBrush">#F7F9FC</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopSurfaceBrush">#EEF3F8</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopSurfaceHoverBrush">#E6EDF7</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopBorderBrush">#D7E0EC</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopDividerBrush">#E6ECF3</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopTextPrimaryBrush">#182131</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopTextSecondaryBrush">#5E6B80</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopTextMutedBrush">#8B96A8</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopAccentBrush">#2B6FF2</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopAccentHoverBrush">#4A84F5</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopAccentPressedBrush">#1F5ED8</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopAccentSoftBrush">#E8F0FF</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopSuccessBrush">#1F9D63</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopWarningBrush">#D68A1F</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopDangerBrush">#D94B4B</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopPreviewBrush">#E9EEF5</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopSelectionBrush">#DCE9FF</SolidColorBrush>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource DesktopBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DesktopTextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DesktopTextPrimaryBrush}" />
    </Style>

    <Style Selector="SelectableTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DesktopTextPrimaryBrush}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Foreground" Value="{DynamicResource DesktopTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource DesktopSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource DesktopSurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopAccentBrush}" />
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource DesktopAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DesktopAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopAccentBrush}" />
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Foreground" Value="{DynamicResource DesktopTextMutedBrush}" />
        <Setter Property="Background" Value="{DynamicResource DesktopPanelAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopBorderBrush}" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource DesktopTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource DesktopSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource DesktopTextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource DesktopAccentBrush}" />
    </Style>

    <Style Selector="TextBox:pointerover">
        <Setter Property="Background" Value="{DynamicResource DesktopSurfaceHoverBrush}" />
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource DesktopPanelBrush}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource DesktopTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource DesktopSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ComboBox:pointerover">
        <Setter Property="Background" Value="{DynamicResource DesktopSurfaceHoverBrush}" />
    </Style>

    <Style Selector="ComboBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource DesktopPanelBrush}" />
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="{DynamicResource DesktopPanelAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource DesktopTextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DesktopSelectionBrush}" />
    </Style>

    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DesktopSelectionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TabControl">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource DesktopTextSecondaryBrush}" />
    </Style>

    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource DesktopAccentBrush}" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>
</Styles>
