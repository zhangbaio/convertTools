<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <LinearGradientBrush x:Key="DesktopBackgroundGradientBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E6EBEE" Offset="0" />
            <GradientStop Color="#EFF2ED" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="DesktopBackgroundBrush">#EAEFF3</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopPanelBrush">#F8F6F1</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopPanelAltBrush">#F1F4F6</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopSurfaceBrush">#E7ECEF</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopSurfaceHoverBrush">#DDE4E9</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopBorderBrush">#C8D0D7</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopDividerBrush">#D7DDE2</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopTextPrimaryBrush">#1F2733</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopTextSecondaryBrush">#627080</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopTextMutedBrush">#8C96A5</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopAccentBrush">#516B8E</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopAccentHoverBrush">#617EA3</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopAccentPressedBrush">#405878</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopAccentSoftBrush">#E1E8F0</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopSidebarBrush">#E3E8EC</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopSidebarHoverBrush">#EDF1F4</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopSidebarSelectedBrush">#D8E0E8</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopSuccessBrush">#4B886B</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopWarningBrush">#A97D3C</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopDangerBrush">#B86565</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopPreviewBrush">#E2E6EA</SolidColorBrush>
        <SolidColorBrush x:Key="DesktopSelectionBrush">#D7E0EA</SolidColorBrush>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource DesktopBackgroundGradientBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DesktopTextPrimaryBrush}" />
    </Style>

    <Style Selector="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="0 6 18 0 #10141B22" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DesktopTextPrimaryBrush}" />
    </Style>

    <Style Selector="SelectableTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DesktopTextPrimaryBrush}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Foreground" Value="{DynamicResource DesktopTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource DesktopSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource DesktopPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopAccentBrush}" />
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource DesktopAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DesktopAccentPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopAccentPressedBrush}" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="{DynamicResource DesktopAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopAccentBrush}" />
    </Style>

    <Style Selector="Button.primary:pointerover">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="{DynamicResource DesktopAccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopAccentHoverBrush}" />
    </Style>

    <Style Selector="Button.primary:pressed">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="{DynamicResource DesktopAccentPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopAccentPressedBrush}" />
    </Style>

    <Style Selector="Button.primary:disabled">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="#B8C3CF" />
        <Setter Property="BorderBrush" Value="#B8C3CF" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Foreground" Value="{DynamicResource DesktopTextMutedBrush}" />
        <Setter Property="Background" Value="{DynamicResource DesktopPanelAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopBorderBrush}" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource DesktopTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource DesktopSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource DesktopTextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource DesktopAccentBrush}" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="TextBox:pointerover">
        <Setter Property="Background" Value="{DynamicResource DesktopPanelBrush}" />
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource DesktopPanelBrush}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource DesktopTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource DesktopSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="ComboBox:pointerover">
        <Setter Property="Background" Value="{DynamicResource DesktopPanelBrush}" />
    </Style>

    <Style Selector="ComboBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource DesktopPanelBrush}" />
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="{DynamicResource DesktopPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource DesktopTextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DesktopPanelAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DesktopSelectionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DesktopAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TabControl">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource DesktopTextSecondaryBrush}" />
    </Style>

    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource DesktopAccentBrush}" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>
</Styles>
