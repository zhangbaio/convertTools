<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localviews="using:ShortDrama.Desktop.Views"
        xmlns:taskqueue="using:ShortDrama.Desktop.Views.TaskQueue"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="ShortDrama.Desktop.Views.MainWindow"
        Width="1680"
        Height="980"
        MinWidth="1420"
        MinHeight="860"
        Icon="/Assets/avalonia-logo.ico"
        Title="ShortDrama Desktop">

    <Window.Styles>
        <Style Selector="TabControl.sidebar">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="TabControl.sidebar TabItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="MinWidth" Value="188" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DesktopTextSecondaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource DesktopSidebarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DesktopDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="TabControl.sidebar TabItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource DesktopSidebarHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DesktopTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DesktopDividerBrush}" />
        </Style>
        <Style Selector="TabControl.sidebar TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource DesktopSidebarSelectedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DesktopSidebarSelectedTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DesktopSidebarSelectedBrush}" />
        </Style>
    </Window.Styles>

    <Grid Margin="16">
        <TabControl x:Name="SidebarTabs"
                    Classes="sidebar"
                    TabStripPlacement="Left"
                    SelectedIndex="{Binding SelectedSidebarTabIndex}">
            <TabItem Header="短剧搜索">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Border Classes="page-panel">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <TextBlock VerticalAlignment="Center"
                                           Text="下载目录" />
                                <TextBox Grid.Column="1"
                                         Classes="compact"
                                         Text="{Binding RootDir}"
                                         IsReadOnly="True" />
                                <Button Grid.Column="2"
                                        Classes="compact"
                                        MinWidth="126"
                                        Click="PickRootDir_Click"
                                        Content="选择下载目录" />
                            </Grid>

                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <TextBox Grid.Column="0"
                                         Classes="compact"
                                         Text="{Binding SearchKeyword}"
                                         Watermark="输入短剧名称，例如: 婆婆、闪婚、逆袭...">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter"
                                                    Command="{Binding SearchDramaCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Grid.Column="1"
                                        Classes="primary compact"
                                        MinWidth="92"
                                        Command="{Binding SearchDramaCommand}"
                                        Content="搜索" />
                                <CheckBox Grid.Column="2"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding ExactSearchEnabled}"
                                          Content="精确搜索" />
                            </Grid>

                            <Border Grid.Row="2" Classes="toolbar-panel">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="compact"
                                                MinWidth="104"
                                                Margin="0,0,8,8"
                                                Command="{Binding LoadTodayDramaCommand}"
                                                Content="今日上新" />
                                        <Button Classes="compact"
                                                MinWidth="104"
                                                Margin="0,0,8,8"
                                                Command="{Binding LoadMangaTodayDramaCommand}"
                                                Content="漫剧上新" />
                                        <Button Classes="compact"
                                                MinWidth="112"
                                                Margin="0,0,8,8"
                                                Command="{Binding LoadAiTodayDramaCommand}"
                                                Content="AI短剧上新" />
                                        <Button Classes="compact"
                                                MinWidth="104"
                                                Margin="0,0,8,8"
                                                Command="{Binding LoadHistoryDramaCommand}"
                                                Content="历史上新" />
                                        <Border Classes="status-pill"
                                                Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="查询天数" />
                                                <TextBox Classes="compact"
                                                         Width="56"
                                                         Text="{Binding SearchQueryDays}" />
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="天" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="status-pill"
                                                MinWidth="118"
                                                Margin="0,0,8,8">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding SearchPageText}" />
                                        </Border>
                                        <Button Classes="compact"
                                                MinWidth="88"
                                                Margin="0,0,8,8"
                                                Command="{Binding GoPreviousSearchPageCommand}"
                                                Content="上一页" />
                                        <Button Classes="compact"
                                                MinWidth="88"
                                                Margin="0,0,8,8"
                                                Command="{Binding GoNextSearchPageCommand}"
                                                Content="下一页" />
                                    </WrapPanel>

                                    <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,8"
                                                   VerticalAlignment="Center"
                                                   Text="最小集数" />
                                        <TextBox Classes="compact"
                                                 Width="84"
                                                 Margin="0,0,12,8"
                                                 Text="{Binding SearchMinEpisodeCount}"
                                                 Watermark="不限" />
                                        <TextBlock Margin="0,0,8,8"
                                                   VerticalAlignment="Center"
                                                   Text="最大集数" />
                                        <TextBox Classes="compact"
                                                 Width="84"
                                                 Margin="0,0,12,8"
                                                 Text="{Binding SearchMaxEpisodeCount}"
                                                 Watermark="不限" />
                                        <Button Classes="compact"
                                                MinWidth="98"
                                                Margin="0,0,16,8"
                                                Command="{Binding ApplySearchFiltersCommand}"
                                                Content="应用筛选" />
                                        <TextBlock Margin="0,0,8,8"
                                                   VerticalAlignment="Center"
                                                   Text="集数范围" />
                                        <ComboBox Classes="compact"
                                                  Width="152"
                                                  Margin="0,0,8,8"
                                                  ItemsSource="{Binding DownloadEpisodeRangeOptions}"
                                                  SelectedItem="{Binding SelectedDownloadEpisodeRangeOption}"
                                                  DisplayMemberBinding="{Binding Label}" />
                                        <TextBox Classes="compact"
                                                 Width="210"
                                                 Margin="0,0,8,8"
                                                 Text="{Binding CustomDownloadEpisodeRange}"
                                                 Watermark="如：1-5 或 1,3,5"
                                                 IsEnabled="{Binding IsCustomDownloadEpisodeRange}" />
                                        <Button Classes="primary compact"
                                                MinWidth="106"
                                                Margin="0,0,8,8"
                                                Command="{Binding DownloadCheckedDramaCommand}"
                                                Content="下载选中" />
                                        <Button Classes="compact"
                                                MinWidth="126"
                                                Margin="0,0,8,8"
                                                Command="{Binding AddCheckedToVideoChannelQueueCommand}"
                                                Content="加入视频号队列" />
                                        <Button Classes="compact"
                                                MinWidth="126"
                                                Margin="0,0,8,8"
                                                Command="{Binding AddCheckedToMiniprogramQueueCommand}"
                                                Content="加入小程序队列" />
                                        <Button Classes="compact"
                                                MinWidth="118"
                                                Margin="0,0,8,8"
                                                Command="{Binding AddCheckedToKuaishouQueueCommand}"
                                                Content="加入快手队列" />
                                        <Border Classes="status-pill"
                                                Margin="0,0,0,8">
                                            <TextBlock Text="{Binding CheckedSearchResultsSummary}" />
                                        </Border>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="3" Classes="status-pill">
                                <TextBlock Text="{Binding SearchSummary}"
                                           Foreground="{DynamicResource DesktopTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Classes="table-shell">
                        <Grid RowDefinitions="Auto,*">
                            <Border Classes="table-header">
                                <Grid ColumnDefinitions="64,2.2*,1.2*,90,110,120,150,2.8*" ColumnSpacing="12">
                                    <TextBlock Text="勾选" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="剧名" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="作者" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="集数" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="收藏量" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="类型" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="6" Text="上线时间" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="7" Text="简介" FontWeight="SemiBold" />
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="1"
                                     Classes="table-list"
                                     ItemsSource="{Binding SearchResults}"
                                     SelectedItem="{Binding SelectedSearchResult}"
                                      MinHeight="420"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="table-row">
                                            <Grid ColumnDefinitions="64,2.2*,1.2*,90,110,120,150,2.8*" ColumnSpacing="12">
                                                <CheckBox IsChecked="{Binding IsChecked}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Author}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding EpisodeTotal}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding FavoriteCountText}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="5"
                                                           Text="{Binding Category}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="6"
                                                           Text="{Binding PublishTime}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="7"
                                                           Text="{Binding Intro}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="配置">
                <localviews:ConfigView />
            </TabItem>

            <TabItem Header="素材上传">
                <localviews:MaterialUploadView />
            </TabItem>

            <TabItem Header="任务队列">
                <taskqueue:TaskQueueView />
            </TabItem>

            <TabItem Header="运行日志">
                <taskqueue:TaskQueueRunLogView />
            </TabItem>

            <TabItem Header="转码模板">
                <localviews:TranscodeTemplateView />
            </TabItem>

            <TabItem Header="已归档项目">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Border Classes="page-panel">
                        <Border Classes="toolbar-panel">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="12">
                                <Button Classes="compact"
                                        MinWidth="112"
                                        Command="{Binding RefreshArchivedProjectsCommand}"
                                        Content="刷新归档列表" />
                                <Button Grid.Column="1"
                                        Classes="compact"
                                        MinWidth="148"
                                        Click="DeleteCheckedArchivedProjects_Click"
                                        Content="删除勾选归档项目" />
                                <Border Grid.Column="2" Classes="status-pill"
                                        MinWidth="126">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="{Binding ArchivedProjects.Count, StringFormat=已归档 {0}}" />
                                </Border>
                                <TextBlock Grid.Column="3"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Text="{Binding RootDir, StringFormat=归档根目录: {0}/archive}"
                                           Foreground="{DynamicResource DesktopTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </Border>

                    <Border Grid.Row="1" Classes="table-shell">
                        <Grid RowDefinitions="Auto,*">
                            <Border Classes="table-header">
                                <Grid ColumnDefinitions="56,2.3*,170,90,1.8*" ColumnSpacing="12">
                                    <TextBlock Text="勾选" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="项目名" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="归档时间" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="已删视频" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="操作" FontWeight="SemiBold" />
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="1"
                                     Classes="table-list"
                                     ItemsSource="{Binding ArchivedProjects}"
                                     SelectedItem="{Binding SelectedArchivedProject}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="table-row">
                                            <Grid ColumnDefinitions="56,2.3*,170,90,1.8*" ColumnSpacing="12">
                                                <CheckBox IsChecked="{Binding IsChecked}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding ArchivedAtText}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding DeletedVideoFileCount}"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="4"
                                                            Orientation="Horizontal"
                                                            Spacing="18"
                                                            VerticalAlignment="Center">
                                                    <Button Classes="inline-action"
                                                            Content="归档目录"
                                                            Click="OpenArchivedProjectRow_Click" />
                                                    <Button Classes="inline-action"
                                                            Content="原目录"
                                                            Click="OpenArchivedSourceRow_Click" />
                                                    <Button Classes="inline-action"
                                                            Content="生成目录"
                                                            Click="OpenArchivedWorkflowRow_Click" />
                                                    <Button Classes="inline-action"
                                                            Foreground="{DynamicResource DesktopDangerBrush}"
                                                            Content="删除"
                                                            Click="DeleteArchivedProjectRow_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
