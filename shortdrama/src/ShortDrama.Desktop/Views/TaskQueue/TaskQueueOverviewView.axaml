<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShortDrama.Desktop.ViewModels"
             x:Class="ShortDrama.Desktop.Views.TaskQueue.TaskQueueOverviewView">
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        <Border Classes="page-panel">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="96,*,Auto" ColumnSpacing="10">
                    <TextBlock VerticalAlignment="Center"
                               Text="&#x5DE5;&#x4F5C;&#x76EE;&#x5F55;"
                               Foreground="{DynamicResource DesktopTextSecondaryBrush}" />
                    <TextBox Grid.Column="1"
                             Classes="compact"
                             Text="{Binding RootDir}"
                             Watermark="&#x8BF7;&#x9009;&#x62E9;&#x6216;&#x8F93;&#x5165;&#x9879;&#x76EE;&#x6839;&#x76EE;&#x5F55;" />
                    <Button Grid.Column="2"
                            Classes="primary compact"
                            MinWidth="126"
                            Click="PickRootDir_Click"
                            Content="&#x9009;&#x62E9;&#x5DE5;&#x4F5C;&#x76EE;&#x5F55;" />
                </Grid>

                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Classes="compact"
                            MinWidth="126"
                            Margin="0,0,8,8"
                            Command="{Binding OpenWeixinBrowserCommand}"
                            Content="&#x6253;&#x5F00;&#x6D4F;&#x89C8;&#x5668;" />
                    <Button Classes="compact"
                            MinWidth="108"
                            Margin="0,0,8,8"
                            Command="{Binding ScanCommand}"
                            Content="&#x626B;&#x63CF;&#x9879;&#x76EE;" />
                    <Button Classes="compact"
                            MinWidth="136"
                            Margin="0,0,8,8"
                            Command="{Binding RunSelectedProjectCommand}"
                            Content="&#x6267;&#x884C;&#x9009;&#x4E2D;&#x9879;&#x76EE;" />
                    <Button Classes="compact"
                            MinWidth="136"
                            Margin="0,0,8,8"
                            Command="{Binding RunRootWorkflowCommand}"
                            Content="&#x6267;&#x884C;&#x6574;&#x4E2A;&#x76EE;&#x5F55;" />
                    <Button Classes="compact"
                            MinWidth="136"
                            Margin="0,0,8,8"
                            Command="{Binding RunSelectedProjectMaterialCommand}"
                            Content="&#x751F;&#x6210;&#x9879;&#x76EE;&#x7D20;&#x6750;" />
                    <Button Classes="compact"
                            MinWidth="126"
                            Margin="0,0,8,8"
                            Command="{Binding RunSelectedWeixinUploadCommand}"
                            Content="&#x5267;&#x96C6;&#x4E0A;&#x4F20;" />
                    <Button Classes="compact"
                            MinWidth="126"
                            Margin="0,0,8,8"
                            Command="{Binding RunSelectedWeixinMaterialUploadCommand}"
                            Content="&#x7D20;&#x6750;&#x4E0A;&#x4F20;" />
                    <Button Classes="compact"
                            MinWidth="126"
                            Margin="0,0,0,8"
                            Command="{Binding StopCurrentRunCommand}"
                            Content="&#x505C;&#x6B62;&#x5F53;&#x524D;&#x6B65;&#x9AA4;" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="page-panel">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="10">
                    <Button Classes="compact"
                            MinWidth="98"
                            Click="CheckAllProjects_Click"
                            Content="&#x5168;&#x9009;&#x7ED3;&#x679C;" />
                    <Button Grid.Column="1"
                            Classes="compact"
                            MinWidth="98"
                            Click="UncheckAllProjects_Click"
                            Content="&#x53D6;&#x6D88;&#x52FE;&#x9009;" />
                    <Button Grid.Column="2"
                            Classes="compact"
                            MinWidth="126"
                            Command="{Binding RunCheckedQueueCommand}"
                            Content="&#x6267;&#x884C;&#x52FE;&#x9009;&#x961F;&#x5217;" />
                    <Button Grid.Column="3"
                            Classes="compact"
                            MinWidth="118"
                            Command="{Binding RunCurrentTaskCommand}"
                            Content="&#x6267;&#x884C;&#x5F53;&#x524D;&#x4EFB;&#x52A1;" />

                    <WrapPanel Grid.Column="4"
                               Orientation="Horizontal"
                               HorizontalAlignment="Right">
                        <Button Classes="compact"
                                MinWidth="126"
                                Margin="0,0,8,0"
                                Command="{Binding SyncCheckedProjectsToXingeCommand}"
                                Content="&#x540C;&#x6B65;&#x5230; Xinge" />
                        <Button Classes="compact"
                                MinWidth="126"
                                Margin="0,0,0,0"
                                Click="ArchiveCheckedProjects_Click"
                                Content="&#x5F52;&#x6863;&#x52FE;&#x9009;&#x9879;&#x76EE;" />
                    </WrapPanel>
                </Grid>

                <Border Grid.Row="1" Classes="toolbar-panel">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <TextBlock VerticalAlignment="Center"
                                       Text="&#x542F;&#x7528;&#x6B65;&#x9AA4;"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <Button Grid.Column="1"
                                    Classes="compact"
                                    MinWidth="96"
                                    Click="CheckAllQueueSteps_Click"
                                    Content="&#x5168;&#x9009;&#x6B65;&#x9AA4;" />
                            <Button Grid.Column="2"
                                    Classes="compact"
                                    MinWidth="96"
                                    Click="UncheckAllQueueSteps_Click"
                                    Content="&#x53D6;&#x6D88;&#x5168;&#x9009;" />
                        </Grid>

                        <WrapPanel Grid.Row="1" Orientation="Horizontal">
                            <CheckBox Margin="0,0,16,8"
                                      Content="&#x4E0B;&#x8F7D;&#x5267;&#x96C6;"
                                      IsChecked="{Binding QueueStepDownloadEnabled}" />
                            <CheckBox Margin="0,0,16,8"
                                      Content="&#x6539;&#x5199;&#x4FE1;&#x606F;"
                                      IsChecked="{Binding QueueStepRewriteEnabled}" />
                            <CheckBox Margin="0,0,16,8"
                                      Content="&#x751F;&#x6210;&#x6D77;&#x62A5;"
                                      IsChecked="{Binding QueueStepPosterRenameEnabled}" />
                            <CheckBox Margin="0,0,16,8"
                                      Content="&#x7D20;&#x6750;&#x8F6C;&#x7801;"
                                      IsChecked="{Binding QueueStepMaterialTranscodeEnabled}" />
                            <CheckBox Margin="0,0,16,8"
                                      Content="&#x4E00;&#x952E;&#x4FEE;&#x590D;"
                                      IsChecked="{Binding QueueStepMaterialAutoRepairEnabled}" />
                            <CheckBox Margin="0,0,16,8"
                                      Content="&#x8865;&#x9F50;&#x5B57;&#x6BB5;"
                                      IsChecked="{Binding QueueStepAutoFillInfoEnabled}" />
                            <CheckBox Margin="0,0,16,8"
                                      Content="&#x751F;&#x6210;&#x6210;&#x672C;&#x62A5;&#x8868;"
                                      IsChecked="{Binding QueueStepCostReportEnabled}" />
                            <CheckBox Margin="0,0,16,8"
                                      Content="&#x751F;&#x6210;&#x5DE5;&#x7A0B;&#x56FE;"
                                      IsChecked="{Binding QueueStepProjectImageEnabled}" />
                            <CheckBox Margin="0,0,16,8"
                                      Content="&#x7D20;&#x6750;&#x6821;&#x9A8C;"
                                      IsChecked="{Binding QueueStepMaterialValidateEnabled}" />
                        </WrapPanel>

                        <WrapPanel Grid.Row="2" Orientation="Horizontal">
                            <CheckBox Margin="0,0,16,0"
                                      Content="&#x65E0;&#x635F;&#x91CD;&#x5C01;&#x88C5;"
                                      IsChecked="{Binding QueueStepUploadRemuxEnabled}" />
                            <CheckBox Margin="0,0,16,0"
                                      Content="&#x4E0A;&#x4F20;&#x5267;&#x96C6;"
                                      IsChecked="{Binding QueueStepEpisodeUploadEnabled}" />
                            <CheckBox Margin="0,0,16,0"
                                      Content="&#x540C;&#x6B65;&#x7BA1;&#x7406;&#x7CFB;&#x7EDF;"
                                      IsChecked="{Binding QueueSyncManagementOnUploadSuccessEnabled}" />
                            <CheckBox Margin="0,0,16,0"
                                      Content="&#x4E0A;&#x4F20;&#x5B8C;&#x6210;&#x540E;&#x81EA;&#x52A8;&#x5F52;&#x6863;"
                                      IsChecked="{Binding QueueAutoArchiveAfterUploadEnabled}" />
                            <CheckBox Margin="0,0,16,0"
                                      Content="&#x5F3A;&#x5236;&#x91CD;&#x8DD1;&#x5DF2;&#x5B8C;&#x6210;&#x6B65;&#x9AA4;"
                                      IsChecked="{Binding QueueForceRerunCompletedStepsEnabled}" />
                            <CheckBox Content="&#x6709;&#x5F85;&#x4E0A;&#x4F20;&#x9879;&#x76EE;&#x65F6;&#x4F18;&#x5148;&#x4E0A;&#x4F20;"
                                      IsChecked="{Binding QueuePreferUploadWhenReadyEnabled}" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Classes="page-panel">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                <TextBox Classes="compact"
                         Text="{Binding TaskQueueFilterText}"
                         Watermark="&#x641C;&#x7D22;&#x539F;&#x5267;&#x540D; / &#x65B0;&#x5267;&#x540D; / &#x72B6;&#x6001; / &#x8DEF;&#x5F84; / &#x7B80;&#x4ECB; / &#x6765;&#x6E90;" />
                <TextBlock Grid.Row="1"
                           Text="{Binding TaskQueueSummary}"
                           Foreground="{DynamicResource DesktopTextSecondaryBrush}" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Classes="table-shell">
            <Grid RowDefinitions="Auto,*">
                <Border Classes="table-header"
                        ClipToBounds="True">
                    <ScrollViewer x:Name="HeaderScrollViewer"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  IsHitTestVisible="False">
                        <Grid MinWidth="2360"
                              ColumnDefinitions="56,220,220,110,72,112,132,132,132,92,92,108,108,108,108,132,132,96"
                              ColumnSpacing="12">
                            <TextBlock Text="&#x52FE;&#x9009;" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="&#x539F;&#x5267;&#x540D;" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="&#x65B0;&#x5267;&#x540D;" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="&#x6765;&#x6E90;" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="&#x96C6;&#x6570;" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="5" Text="&#x89C6;&#x9891;&#x5927;&#x5C0F;" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="6" Text="&#x52A0;&#x5165;&#x65F6;&#x95F4;" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="7" Text="&#x4E0B;&#x8F7D;&#x5267;&#x96C6;" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="8" Text="&#x751F;&#x6210;&#x7D20;&#x6750;" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="9" Text="&#x6539;&#x5199;&#x4FE1;&#x606F;" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="10" Text="&#x751F;&#x6210;&#x6D77;&#x62A5;" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="11" Text="&#x6210;&#x672C;&#x62A5;&#x8868;" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="12" Text="&#x751F;&#x6210;&#x5DE5;&#x7A0B;&#x56FE;" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="13" Text="&#x89C6;&#x9891;&#x8F6C;&#x7801;" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="14" Text="&#x7D20;&#x6750;&#x8F6C;&#x7801;" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="15" Text="&#x4E0A;&#x4F20;&#x5267;&#x96C6;" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="16" Text="&#x7D20;&#x6750;&#x4E0A;&#x4F20;" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="17" Text="&#x64CD;&#x4F5C;" FontWeight="SemiBold" />
                        </Grid>
                    </ScrollViewer>
                </Border>

                <ScrollViewer x:Name="ProjectsScrollViewer"
                              Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ScrollChanged="ProjectsScrollViewer_ScrollChanged">
                    <ListBox Classes="table-list"
                             ItemsSource="{Binding FilteredProjects}"
                             SelectedItem="{Binding SelectedProject}"
                             MinWidth="2360"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectListItemViewModel">
                                <Border Classes="table-row">
                                    <Grid ColumnDefinitions="56,220,220,110,72,112,132,132,132,92,92,108,108,108,108,132,132,96"
                                          ColumnSpacing="12">
                                        <CheckBox IsChecked="{Binding IsChecked}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />

                                        <Button Grid.Column="1"
                                                Classes="inline-action"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Click="OpenTaskQueueSourceFolder_Click">
                                            <TextBlock Text="{Binding OriginalTitle}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2" />
                                        </Button>

                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <Button Classes="inline-action"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Click="OpenTaskQueueWorkflowFolder_Click">
                                                <TextBlock Text="{Binding NewTitle}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2" />
                                            </Button>
                                            <TextBlock Text="{Binding SchedulingStatus}"
                                                       Foreground="{Binding SchedulingStatusBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding SourceSummary}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding EpisodeCountText}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding VideoSizeSummary}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="6"
                                                   Text="{Binding CreatedAtSummary}"
                                                   VerticalAlignment="Center" />

                                        <Button Grid.Column="7"
                                                Classes="compact"
                                                Background="{Binding DownloadNodeBackgroundBrush}"
                                                Foreground="{Binding DownloadNodeForegroundBrush}"
                                                Click="OpenTaskQueueDownloadDetail_Click"
                                                Content="{Binding DownloadNodeStatus}" />

                                        <Button Grid.Column="8"
                                                Classes="compact"
                                                Background="{Binding ProjectMaterialNodeBackgroundBrush}"
                                                Foreground="{Binding ProjectMaterialNodeForegroundBrush}"
                                                Click="OpenTaskQueueProjectMaterialDetail_Click"
                                                Content="{Binding ProjectMaterialNodeStatus}" />

                                        <TextBlock Grid.Column="9"
                                                   Text="{Binding RewriteStepStatus}"
                                                   Foreground="{Binding RewriteStepStatusBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="10"
                                                   Text="{Binding PosterRenameStepStatus}"
                                                   Foreground="{Binding PosterRenameStepStatusBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="11"
                                                   Text="{Binding CostReportStepStatus}"
                                                   Foreground="{Binding CostReportStepStatusBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="12"
                                                   Text="{Binding ProjectImageStepStatus}"
                                                   Foreground="{Binding ProjectImageStepStatusBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="13"
                                                   Text="{Binding TranscodeStepStatus}"
                                                   Foreground="{Binding TranscodeStepStatusBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="14"
                                                   Text="{Binding MaterialConvertStepStatus}"
                                                   Foreground="{Binding MaterialConvertStepStatusBrush}"
                                                   VerticalAlignment="Center" />

                                        <Button Grid.Column="15"
                                                Classes="compact"
                                                Background="{Binding EpisodeUploadNodeBackgroundBrush}"
                                                Foreground="{Binding EpisodeUploadNodeForegroundBrush}"
                                                Click="OpenTaskQueueEpisodeUploadDetail_Click"
                                                Content="{Binding EpisodeUploadNodeStatus}" />

                                        <Button Grid.Column="16"
                                                Classes="compact"
                                                Background="{Binding MaterialUploadNodeBackgroundBrush}"
                                                Foreground="{Binding MaterialUploadNodeForegroundBrush}"
                                                Click="OpenTaskQueueMaterialUploadDetail_Click"
                                                Content="{Binding MaterialUploadNodeStatus}" />

                                        <Button Grid.Column="17"
                                                Classes="inline-action"
                                                Click="OpenTaskQueueProjectFolder_Click"
                                                Content="&#x6253;&#x5F00;&#x76EE;&#x5F55;" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
