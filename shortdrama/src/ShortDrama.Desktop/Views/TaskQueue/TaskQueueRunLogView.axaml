<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShortDrama.Desktop.ViewModels"
             xmlns:models="using:ShortDrama.Desktop.Models"
             x:Class="ShortDrama.Desktop.Views.TaskQueue.TaskQueueRunLogView">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Border Background="{DynamicResource DesktopPanelBrush}"
                CornerRadius="18"
                Padding="12,10">
            <TabStrip ItemsSource="{Binding RunLogTabOptions}"
                      SelectedItem="{Binding SelectedRunLogTabOption}">
                <TabStrip.ItemTemplate>
                    <DataTemplate x:DataType="models:WorkflowStepOption">
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </TabStrip.ItemTemplate>
            </TabStrip>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource DesktopPanelBrush}"
                CornerRadius="18"
                Padding="18">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding RunLogHeaderTitle}"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RunLogHeaderContextText}"
                                   Foreground="{DynamicResource DesktopTextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              Content="跟随最近活跃项目"
                              IsVisible="{Binding IsRunLogFollowControlsVisible}"
                              IsChecked="{Binding FollowLatestActiveLogProject}"
                              VerticalAlignment="Center" />
                    <CheckBox Grid.Column="2"
                              Content="仅看问题"
                              IsVisible="{Binding IsRunLogFollowControlsVisible}"
                              IsChecked="{Binding OnlyShowFailedLogs}"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="10">
                        <Button MinWidth="100"
                                IsVisible="{Binding IsRunLogStopButtonVisible}"
                                Command="{Binding StopCurrentRunCommand}"
                                Content="停止" />
                        <Button MinWidth="120"
                                Click="CopyRunLog_Click"
                                Content="复制日志" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding RunLogHeaderSummaryText}"
                           Foreground="{DynamicResource DesktopTextSecondaryBrush}" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="2"
                   LastChildFill="True">
            <Border DockPanel.Dock="Left"
                    Width="300"
                    Margin="0,0,14,0"
                    IsVisible="{Binding IsRunLogProjectPaneVisible}"
                    Background="{DynamicResource DesktopPanelBrush}"
                    CornerRadius="18"
                    Padding="12">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Button Content="全部已勾选项目"
                            Click="ShowAllProjectsLog_Click" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding RunLogProjects}"
                             SelectedItem="{Binding SelectedRunLogProject}"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectListItemViewModel">
                                <Border Margin="0,0,0,8"
                                        Padding="12"
                                        CornerRadius="12"
                                        Background="{DynamicResource DesktopPanelAltBrush}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SchedulingStatus}"
                                                   Foreground="{Binding SchedulingStatusBrush}" />
                                        <TextBlock Text="{Binding CurrentStepLabel}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding CurrentStepProgressText}"
                                                   Foreground="{DynamicResource DesktopTextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Background="{DynamicResource DesktopPanelBrush}"
                    CornerRadius="18"
                    Padding="16">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding ActivityTitle}"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding RunLogCurrentScopeLabel, StringFormat=当前范围: {0}}"
                                       Foreground="{DynamicResource DesktopTextSecondaryBrush}" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  Width="180"
                                  IsVisible="{Binding IsRunLogStepFilterVisible}"
                                  ItemsSource="{Binding StepLogFilters}"
                                  SelectedItem="{Binding SelectedStepLogFilter}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{DynamicResource DesktopPanelAltBrush}"
                            CornerRadius="14"
                            Padding="10">
                        <TextBox Text="{Binding VisibleActivityLogText}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="Consolas, Cascadia Mono, monospace"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="Transparent"
                                 VerticalContentAlignment="Top"
                                 MinHeight="420"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>
            </Border>
        </DockPanel>

        <TextBlock Grid.Row="2"
                   Margin="0,0,18,12"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Foreground="{DynamicResource DesktopTextSecondaryBrush}"
                   Text="{Binding RunLogFooterHintText}" />
    </Grid>
</UserControl>
