<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ShortDrama.Desktop.Views.TaskQueue.TaskQueueMaterialUploadDetailView">
    <Border Classes="page-panel">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
            <Border Classes="toolbar-panel">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding SelectedProject.DisplayName}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedProject.MaterialUploadNodeStatus}"
                                   Foreground="{Binding SelectedProject.MaterialUploadNodeForegroundBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="primary compact"
                            MinWidth="136"
                            Command="{Binding RunSelectedWeixinMaterialUploadCommand}"
                            Content="&#x5F00;&#x59CB;&#x4E0A;&#x4F20;&#x7D20;&#x6750;" />
                    <Button Grid.Column="2"
                            Classes="compact"
                            MinWidth="118"
                            Command="{Binding OpenWeixinBrowserCommand}"
                            Content="&#x6253;&#x5F00;&#x6D4F;&#x89C8;&#x5668;" />
                    <Button Grid.Column="3"
                            Classes="compact"
                            MinWidth="126"
                            Click="MarkMaterialUploadCompleted_Click"
                            Content="&#x6807;&#x8BB0;&#x5DF2;&#x5B8C;&#x6210;" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Classes="toolbar-panel">
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                    <TextBlock Text="&#x5F53;&#x524D;&#x72B6;&#x6001;" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding SelectedProject.MaterialUploadNodeStatus}"
                               Foreground="{Binding SelectedProject.MaterialUploadNodeForegroundBrush}" />
                    <TextBlock Grid.Row="1" Text="&#x5F53;&#x524D;&#x8FDB;&#x5EA6;" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding SelectedProject.MaterialUploadStepStatus}" />
                    <TextBlock Grid.Row="2" Text="&#x5F53;&#x524D;&#x7B56;&#x7565;" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding SelectedProject.MaterialUploadStrategySummary}" />
                    <TextBlock Grid.Row="3" Text="&#x5F85;&#x53D1;&#x8303;&#x56F4;" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="3" Grid.Column="1"
                               Text="{Binding SelectedProject.MaterialUploadSelectionSummary}" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Classes="table-shell">
                <Grid RowDefinitions="Auto,*">
                    <Border Classes="table-header">
                        <TextBlock Text="&#x672C;&#x6B21;&#x5F85;&#x53D1;&#x89C6;&#x9891;"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                    </Border>
                    <ListBox Grid.Row="1"
                             Classes="table-list"
                             ItemsSource="{Binding SelectedProject.MaterialPublishVideos}"
                             MaxHeight="180"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="table-row">
                                    <Grid ColumnDefinitions="100,*,100" ColumnSpacing="12">
                                        <TextBlock Text="{Binding EpisodeLabel}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding VideoName}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding StatusText}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Row="3" Classes="table-shell">
                <Grid RowDefinitions="Auto,*">
                    <Border Classes="table-header">
                        <TextBlock Text="&#x7D20;&#x6750;&#x4E0A;&#x4F20;&#x65E5;&#x5FD7;"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                    </Border>
                    <ListBox Grid.Row="1"
                             Classes="table-list"
                             ItemsSource="{Binding ActivityLog}"
                             MaxHeight="360"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="table-row">
                                    <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
